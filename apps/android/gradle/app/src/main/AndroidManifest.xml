<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 内核(ANDROID_PARANOID_NETWORK)把 AF_INET socket 的创建权限绑在
         AID_INET(gid 3003)上,而这个组由 INTERNET 权限授予。没有它,socket() 直接
         EACCES —— 连 bind 127.0.0.1 都不行,不只是访问外网。
         本 app 两处都要:api crate 的「Check server」(HTTP 打开发机),以及 mcp
         feature 下内嵌的 MCP server(监听 127.0.0.1,见 apps/android/src/lib.rs)。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 系统媒体控件(见 docs/adr/0020 与 src/main/java/.../MediaControls.java)。
         锁屏与通知栏的媒体卡片必须挂在一条通知上,而通知要活过切后台就必须挂在
         前台服务上。targetSdk 34 起 mediaPlayback 这个类型是强制声明的,少了
         FOREGROUND_SERVICE_MEDIA_PLAYBACK 会在 startForeground 那一刻被系统拒掉。
         顺带解决的是另一件事:没有前台服务时进程切后台会被冻住,声音跟着停。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- API 33 起这是运行期权限,第一次要出声时才申请。用户拒了就没有通知、
         也没有锁屏控件,但 MediaSession 还在 —— 耳机线控与蓝牙按键照常。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.SlintStudy"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <!-- NativeActivity 加载这个库,并调用 android-activity 胶水代码,
                 后者会运行我们的 android_main。 -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="osmosis" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 与 Activity 同进程:音频仍在 Rust 那边出声,这个服务只是一张
             「别冻我」的凭据加一块显示区。不导出 —— 没有跨进程的客户端。 -->
        <service
            android:name=".MediaControlsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
