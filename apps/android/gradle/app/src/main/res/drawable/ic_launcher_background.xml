<!--
    自适应图标的背景层。系统会按各家启动器的形状去裁它(圆、方、squircle),
    所以这一层只能是纯色 —— 画上任何东西都可能被裁掉一角。

    颜色取 app 自己的夜色(crates/ui/slint/widgets.slint 里 DayNightSwitch 的
    night 底色),图标与界面因此是同一套色板。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#191E32"
        android:pathData="M0,0h108v108h-108z" />
</vector>
