{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noEmit": true,
    // WebGPU 的类型 TypeScript 6 的 lib.dom 已经自带,不要再装 @webgpu/types —— 两份定义
    // 会冲突到编译不过。
    "types": ["node"]
  },
  "exclude": ["node_modules"]
}
