// Minimal single-window phone UI: a tap counter.
// The count lives in Rust and is pushed here as a property; the button tap
// flows back through the `bump` callback — the same UI<->Rust glue ntrack uses,
// stripped to one value.
import { Palette } from "std-widgets.slint";

// Button with a hover lift: on hover the background lightens and a soft shadow
// grows so it reads as raised; on press it darkens and sinks. All animated.
component HoverButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    property <bool> hovered: touch.has-hover;
    property <bool> down: touch.pressed;

    height: 56px;
    width: 220px;
    border-radius: 14px;
    background: down ? #2f45c5 : hovered ? #5c7cfa : #4263eb;
    drop-shadow-color: #4263eb80;
    drop-shadow-blur: down ? 4px : hovered ? 24px : 10px;
    drop-shadow-offset-y: down ? 1px : hovered ? 8px : 3px;
    animate background, drop-shadow-blur, drop-shadow-offset-y {
        duration: 160ms;
        easing: ease-out;
    }

    Text {
        text: root.text;
        color: #ffffff;
        font-size: 18px;
        font-weight: 600;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    // Pushed from Rust.
    in property <int> count: 0;
    // Frames per second, measured and pushed from Rust.
    in property <float> fps: 0;
    // Tapped by the user; handled in Rust.
    callback bump();

    title: "Slint Study";
    background: #0f1117;

    // Frame-rate readout, pinned to the top-left inside the safe area.
    Text {
        x: 12px + root.safe-area-insets.left;
        y: 8px + root.safe-area-insets.top;
        text: "FPS " + round(root.fps);
        color: #51cf66;
        font-size: 14px;
        font-weight: 700;
    }

    VerticalLayout {
        alignment: center;
        spacing: 24px;
        // Base padding plus the safe-area insets, so content clears the status
        // and navigation bars on the edge-to-edge Android window.
        padding-top: 32px + root.safe-area-insets.top;
        padding-bottom: 32px + root.safe-area-insets.bottom;
        padding-left: 32px + root.safe-area-insets.left;
        padding-right: 32px + root.safe-area-insets.right;

        Text {
            text: "Slint on Android";
            color: #e6e8ef;
            font-size: 22px;
            horizontal-alignment: center;
        }

        Text {
            text: root.count;
            color: #7aa2f7;
            font-size: 72px;
            horizontal-alignment: center;
        }

        HoverButton {
            text: "Tap me";
            clicked => { root.bump(); }
        }
    }
}
