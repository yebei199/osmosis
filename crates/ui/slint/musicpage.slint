import { ListView } from "std-widgets.slint";
import { Palette } from "std-widgets.slint";

import { Theme, Type, Space, TextSize, Radius, Layout, Weight, Tracking } from "theme.slint";
import { TrackRow, PlaylistRow, ArtistRow } from "types.slint";
import { Button, ButtonKind, Chip, ChipKind, IconButton, Sheet, TextField, FactsLine, EmptyState } from "widgets.slint";
import { Destinations, SearchTabBar } from "musicnav.slint";
import { FacetBar, FilteredEmpty, TrackList, TrackHeader } from "tracklist.slint";
import { PlaylistList } from "playlists.slint";
import { ArtistList } from "artists.slint";
import { WallView, WallToggle } from "wallview.slint";
import { Library } from "globals/library.slint";
import { Player } from "globals/player.slint";
import { Shell } from "globals/shell.slint";
import { Icon, Icons } from "icons.slint";
import { Viz } from "globals/viz.slint";
import { BarMetrics } from "playerbar.slint";

// 本地下载管理独有的投影，不向壳添加属性或回调。
export struct DownloadRow {
    id: string,
    file-name: string,
    title: string,
    artist: string,
    size: string,
    selected: bool,
}

// 音乐模块持有状态；平台权限与目录操作由 Rust 回调完成。
export global Downloads {
    // 已下载是一级目的地之一(编号 5),这里只是它的投影。
    out property <bool> active: Shell.destination == 5;
    in-out property <bool> confirming: false;
    // 离开这一页就收起删除确认,回来不该还挂着上次那个框。
    changed active => { self.confirming = false; }
    in property <[DownloadRow]> rows;
    in property <string> total;
    in property <string> note;
    in property <int> selected-count;
    in property <bool> busy;
    callback show;
    callback refresh;
    callback search(string);
    callback toggle(string);
    callback delete-selected;
}

// 管理器只显示本机文件；每行点击切换选择，不发起播放。
export component DownloadManager inherits Rectangle {
    VerticalLayout {
        spacing: Space.sm;
        HorizontalLayout {
            spacing: Space.sm;
            keyword := TextField {
                horizontal-stretch: 1;
                icon: Icons.magnifying-glass;
                placeholder: "搜索歌名、歌手或文件名";
                enabled: !Downloads.busy;
                edited => { Downloads.search(self.text); }
            }
            refresh-button := Button {
                kind: ButtonKind.secondary;
                icon: Icons.arrow-clockwise;
                text: "刷新";
                enabled: !Downloads.busy;
                clicked => { Downloads.refresh(); }
            }
        }
        // 总数在页头那行事实里(`facts`),这里不再重复一行。
        if Downloads.note != "": Text {
            text: Downloads.note;
            accessible-label: self.text;
            color: Theme.text-dim;
            wrap: word-wrap;
            font-size: TextSize.small;
        }
        HorizontalLayout {
            Text {
                text: Downloads.busy ? "等待系统删除确认" : "已选择 " + Downloads.selected-count + " 首";
                color: Theme.text-dim;
                font-size: TextSize.small;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            delete-button := Button {
                kind: ButtonKind.secondary;
                small: true;
                icon: Icons.trash;
                text: "删除所选";
                enabled: Downloads.selected-count > 0 && !Downloads.busy;
                clicked => { Downloads.confirming = true; }
            }
        }
        if Downloads.rows.length == 0: Text {
            text: "没有符合的已下载歌曲";
            color: Theme.text-dim;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        // ListView 而不是 ScrollView + 布局:后者的内容按整宽排,竖向滚动条一出现
        // 右缘那一列(文件大小)就被它压住,还多出一条横向滚动条。
        if Downloads.rows.length > 0: ListView {
            vertical-stretch: 1;
            // 与曲目行同一套:行不画框,选中垫 accent-wash,宽版式悬停垫 hover。
            for row in Downloads.rows: Rectangle {
                height: 64px;
                background: row.selected ? Theme.accent-wash
                    : entry-touch.has-hover && !Shell.compact ? Theme.hover : transparent;
                border-radius: Radius.sm;
                HorizontalLayout {
                    padding: Space.sm;
                    spacing: Space.sm;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            source: row.selected ? Icons.check-circle-fill : Icons.circle;
                            colorize: row.selected ? Theme.accent-ink : Theme.text-faint;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;
                        Text { text: row.title; color: Theme.text; font-size: TextSize.row; overflow: elide; }
                        Text { text: row.artist == "" ? row.file-name : row.artist; color: Theme.text-dim; font-size: TextSize.small; overflow: elide; }
                    }
                    Text { text: row.size; color: Theme.text-faint; font-size: TextSize.small; vertical-alignment: center; }
                }
                entry-touch := TouchArea {
                    enabled: !Downloads.busy;
                    accessible-role: checkbox;
                    accessible-label: row.file-name;
                    accessible-checked: row.selected;
                    accessible-action-default => { Downloads.toggle(row.id); }
                    clicked => { Downloads.toggle(row.id); }
                }
            }
        }
    }
    // 覆层截获输入，确认前不会向平台发删除请求。
    if Downloads.confirming: confirmation := Rectangle {
        background: Theme.scrim;
        TouchArea {}
        Sheet {
            width: min(parent.width - 32px, 380px);
            height: confirm-body.preferred-height;
            x: (parent.width - self.width) / 2;
            y: max(0px, (parent.height - self.height) / 2);
            confirm-body := VerticalLayout {
                padding: Space.xl;
                spacing: Space.sm;
                Text {
                    text: "删除选中的 " + Downloads.selected-count + " 首歌曲？";
                    color: Theme.text;
                    wrap: word-wrap;
                    font-size: TextSize.title;
                    font-weight: Weight.bold;
                }
                Text { text: "本机文件将被删除，无法撤销。"; color: Theme.text-dim; wrap: word-wrap; font-size: TextSize.small; }
                Rectangle { height: Space.sm; }
                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: end;
                    cancel-button := Button { kind: ButtonKind.secondary; text: "取消"; clicked => { Downloads.confirming = false; } }
                    confirm-button := Button {
                        kind: ButtonKind.primary; text: "确认删除";
                        enabled: !Downloads.busy && Downloads.selected-count > 0;
                        clicked => { Downloads.confirming = false; Downloads.delete-selected(); }
                    }
                }
            }
        }
    }
}

// 音乐页:每日推荐到已下载这七个目的地共用的一页 —— 搜索、歌单详情、卡墙与列表。
// 导航不在这里,它在窗口那一层(musicnav.slint,MEO-1876)。
//
// 属性面全在 global 里,这一页因此不从窗口根接一个字段 —— 拆出来时
// 一处转发都不必写(见 docs/adr/0027)。
//
// 版式(docs/design.md「页面」):页头是大标题 + 一行事实 + 右边的动作(卡墙/列表、播放),
// 下面一排 chips,再下面是列表;宽版式多一行表头。
export component MusicPage inherits VerticalLayout {
    padding-left: Shell.compact ? Layout.page-x-compact : Layout.page-x;
    padding-right: self.padding-left;
    padding-top: Shell.compact ? Layout.page-top-compact : Layout.page-top;
    // 控制条不在这一页里 —— 它是窗口持有的那一根,一个实例管所有目的地
    // (app.slint,docs/adr/0029)。条在时页底让出它那一块,免得列表最后
    // 几行藏在条底下;条不在就一分不留,凭空的空白看起来就是渲染坏了
    // (#116)。条件与 app.slint 摆条那一行是同一个。
    padding-bottom: Player.has-track && !Shell.play-page-open
        ? BarMetrics.page-reserve
        : 16px;
    spacing: 0px;

    // 每次进这一页都触发(切页时整块重建)。当天还没拉过推荐就
    // 替用户拉一次 —— 空着一页只有一行「点一首歌开始」不是个好开局。
    // 「当天拉过就不动」的判断在 Rust 侧,搜索结果因此不会被冲掉。
    // 已下载的列表由切过来那一下的 load_section 刷新,这里不重复喊。
    init => { if (!Downloads.active) { Player.music-shown(); } }

    // 这一页摆不摆一列歌(列表或卡墙)。页头的「播放」、表头、chips 都看它。
    property <bool> detail: Library.open-playlist-name != "";
    property <bool> song-view: root.detail
        || Shell.destination == 0
        || Shell.destination == 3
        || Shell.destination == 4
        || Shell.destination == 6
        || (Shell.destination == 2 && Library.search-tab == 0);
    property <bool> list-shown: Player.tracks.length > 0 && root.song-view && !Shell.wall-visible;
    // 页头那一行事实:几首、日推几点换批、此刻在放什么。
    property <bool> counted: root.song-view && Player.track-count > 0;
    property <string> count-fact: Player.track-count + " 首";
    property <bool> daily-page: Shell.destination == 0 && !root.detail;
    property <[string]> facts: Downloads.active ? [Downloads.total]
        : root.daily-page
            ? (root.counted ? [root.count-fact, "早上 6 点换一批"] : ["早上 6 点换一批"])
            : root.counted ? [root.count-fact]
            : [];

    // ── 页头 ──
    // 搜索页没有大标题,搜索框就是它的页头。
    if Shell.destination != 2 || root.detail: page-header := HorizontalLayout {
        spacing: Space.xl;

        // 详情那一层(歌单、歌手)左边一颗返回键。
        if root.detail: VerticalLayout {
            alignment: center;
            back := IconButton {
                icon: Icons.caret-left;
                label: "返回";
                icon-size: 22px;
                clicked => { Library.close-playlist(); }
            }
        }
        // 详情页那张封面。比列表里那张大一档,但不铺满 —— 这一层的主体是曲目,不是图。
        if root.detail && Library.open-playlist-cover.width > 0 && !Shell.compact: Rectangle {
            width: 72px;
            height: 72px;
            border-radius: Radius.md;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                image-fit: cover;
                source: Library.open-playlist-cover;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Shell.compact ? 6px : Space.sm;

            // 改名时标题就地变成输入框。另开一层对话框的话,
            // 那一层要盖住的正是「原来叫什么」。
            if !Library.renaming: page-title := Text {
                text: root.detail ? Library.open-playlist-name : Destinations.label-of(Shell.destination);
                accessible-role: text;
                accessible-label: self.text;
                font-size: Shell.compact ? TextSize.display-compact : TextSize.display;
                font-weight: Weight.bold;
                letter-spacing: Shell.compact ? Tracking.display-compact : Tracking.display;
                color: Theme.text;
                overflow: elide;
            }
            if Library.renaming: rename-box := TextField {
                text: Library.open-playlist-name;
                accepted => {
                    Library.rename-playlist(self.text);
                    Library.renaming-for = "";
                }
            }
            if root.facts.length > 0: FactsLine { facts: root.facts; }
        }

        // 动作区:卡墙/列表、播放;详情页的改名、删除、屏蔽歌手。
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            if Shell.wall-supported
                && Shell.destination == 0
                && !root.detail
                && Player.tracks.length > 0: VerticalLayout {
                alignment: end;
                WallToggle { }
            }
            // 改名与删除只给本地歌单 —— 平台那两种的真相
            // 不在这边,摆上去只会让人点了才知道。
            if Library.open-playlist-local: VerticalLayout {
                alignment: end;
                rename-button := Button {
                    kind: ButtonKind.ghost;
                    text: Library.renaming ? "取消" : "改名";
                    icon: Icons.pencil-simple;
                    clicked => {
                        Library.renaming-for =
                            Library.renaming ? "" : Library.open-playlist-name;
                        Library.confirming-for = "";
                    }
                }
            }
            if Library.open-playlist-local: VerticalLayout {
                alignment: end;
                delete-button := Button {
                    kind: ButtonKind.ghost;
                    // 点两下才真删:一下就删的话,手指滑一下
                    // 就没了一个歌单,而歌单没有回收站。
                    text: Library.confirming-delete ? "确认删除?" : "删除";
                    icon: Icons.trash;
                    clicked => {
                        if (Library.confirming-delete) {
                            Library.delete-playlist();
                            Library.confirming-for = "";
                        } else {
                            Library.confirming-for =
                                Library.open-playlist-name;
                            Library.renaming-for = "";
                        }
                    }
                }
            }
            // 歌手页才有(#161)。按名字屏蔽:曲目上只带歌手名,不带 id。
            // 两个名字对得上才算歌手页 —— 点开歌单时标题就换了。
            if Library.open-artist-name != ""
                && Library.open-artist-name == Library.open-playlist-name: VerticalLayout {
                alignment: end;
                block-artist-button := Button {
                    kind: ButtonKind.ghost;
                    text: "屏蔽该歌手";
                    icon: Icons.prohibit;
                    clicked => { Library.block-artist(Library.open-artist-name); }
                }
            }
            if Player.tracks.length > 0 && root.song-view: VerticalLayout {
                alignment: end;
                if !Shell.compact: play-all := Button {
                    kind: ButtonKind.primary;
                    text: "播放";
                    icon: Icons.play-fill;
                    clicked => { Player.play-all(); }
                }
                if Shell.compact: play-all-compact := IconButton {
                    solid: true;
                    icon: Icons.play-fill;
                    label: "播放";
                    clicked => { Player.play-all(); }
                }
            }
        }
        // 紧凑版式里播放组胶囊收起后落在这一行的右端,有组时让出它那一块
        // (56px,其中一截是这一行的间距)。
        if Shell.compact && Shell.group-banner != "": Rectangle { width: 56px - Space.xl; }
    }

    // ── 搜索页的页头:大号搜索框 + 结果页签 ──
    if Shell.destination == 2 && !root.detail: VerticalLayout {
        spacing: Shell.compact ? Space.md : 18px;
        HorizontalLayout {
            spacing: 0px;
            // 歌名是任意 CJK:Osmosis Sans 按标准字符集裁过,生僻字走系统字体回退。
            // 框先吃满,长到 720px 封顶,余下的给后面那块空白 —— `alignment: start`
            // 会让它缩回自己的 preferred 宽度,只剩一颗放大镜。
            keyword := TextField {
                horizontal-stretch: 1000;
                max-width: 720px;
                large: true;
                icon: Icons.magnifying-glass;
                enter-hint: !Shell.compact;
                placeholder: "搜歌名、歌手或歌单";
                accepted => { Player.search(self.text); }
            }
            if Shell.compact && Shell.group-banner != "": Rectangle { width: 56px; }
            Rectangle { horizontal-stretch: 1; }
        }
        // 搜索结果的三个页签。与搜索框同进同出 ——
        // 没搜过时它们也在,那是有意的:告诉人这一页能搜三类东西。
        search-tabs := SearchTabBar {
            current: Library.search-tab;
            counts: [Player.tracks.length, Library.found-artists.length, Library.found-playlists.length];
            selected(tab) => {
                Library.select-search-tab(tab);
            }
        }
    }

    Rectangle { height: Shell.compact ? Space.lg : Space.xl; }

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: Space.md;

        if Downloads.active: downloads-manager := DownloadManager {
            horizontal-stretch: 1;
        }

        if !Downloads.active: VerticalLayout {
            horizontal-stretch: 1;
            spacing: Space.md;

            // 「把刚才那批加进来」。只在本地歌单详情、且刚才
            // 确实有一批歌时出现 —— 进歌单那一刻 Player.tracks 就被
            // 换掉了,所以那一批由 Rust 在打开前存下来。
            if Library.open-playlist-local
                && Library.add-batch-text != "":
            add-batch-row := HorizontalLayout {
                alignment: start;
                Button {
                    kind: ButtonKind.secondary;
                    small: true;
                    icon: Icons.plus;
                    text: Library.add-batch-text;
                    clicked => { Library.add-batch(); }
                }
            }

            // 平台给不出详情的那几首。它说的是「这批之外还有」,不是一个可点的条目。
            if Library.unavailable-note != "":
            unavailable-row := Text {
                text: Library.unavailable-note;
                color: Theme.text-faint;
                font-size: TextSize.small;
            }

            // 新建歌单。摆在列表那一层的顶上 ——
            // 名字由回调带出来,因为这个输入框在 `if` 里,
            // Rust 引用不到它。
            if Shell.destination == 1 && !root.detail:
            new-playlist-row := HorizontalLayout {
                spacing: Space.sm;

                new-name := TextField {
                    horizontal-stretch: 1;
                    max-width: 420px;
                    icon: Icons.plus;
                    placeholder: "新建歌单";
                    accepted => {
                        Library.create-playlist(self.text);
                        self.text = "";
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        kind: ButtonKind.secondary;
                        text: "新建";
                        clicked => {
                            Library.create-playlist(new-name.text);
                            new-name.text = "";
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            // 歌单分区的列表那一层。
            if Shell.destination == 1 && !root.detail:
            playlist-list := PlaylistList {
                vertical-stretch: 1;
                playlists: Library.playlists;
                open(id, source) => {
                    Library.open-playlist(id, source);
                }
            }

            // 搜索的歌手页签。
            if Shell.destination == 2 && !root.detail
                && Library.search-tab == 1:
            artist-list := ArtistList {
                artists: Library.found-artists;
                open(id, name) => {
                    Library.open-artist(id, name);
                }
            }

            // 搜索的歌单页签。与「我的歌单」同一个组件、
            // 不同的一份数据 —— 点开走的也是同一条路。
            if Shell.destination == 2 && !root.detail
                && Library.search-tab == 2:
            found-playlist-list := PlaylistList {
                vertical-stretch: 1;
                playlists: Library.found-playlists;
                open(id, source) => {
                    Library.open-playlist(id, source);
                }
            }

            // 电台区(#186):账号一份的共享歌单。「加载新歌」让服务端追加一批,
            // 哪台加的所有设备都刷新;「已听过」切去摆听过的那些,还能点。
            // 摆在空状态之上:「已听过」里一首都没有时,切回去的键不能跟着消失。
            if Shell.destination == 4 && !root.detail:
            radio-row := HorizontalLayout {
                spacing: Space.sm;
                alignment: start;

                radio-load-more := Button {
                    kind: ButtonKind.secondary;
                    small: true;
                    icon: Icons.plus;
                    text: Player.radio-loading ? "加载中" : "加载新歌";
                    enabled: !Player.radio-loading;
                    clicked => { Player.radio-load-more(); }
                }
                radio-heard := Chip {
                    kind: ChipKind.toggle;
                    icon: Icons.headphones;
                    text: "已听过";
                    selected: Player.radio-heard;
                    clicked => { Player.radio-toggle-heard(); }
                }
            }

            // 分组条与筛选(#160):凡是摆一批歌单类曲目的地方都有 —— 日推、最近、
            // 电台、某个歌单、某位歌手。搜索结果不是歌单,不挂。卡墙在它下面,
            // 于是卡墙也能筛;选了分组 Rust 会把卡墙切回列表。
            // 日推的「已听过」开关排在这一行的最前面(与电台那颗同一个用法)。
            if (Player.facets-enabled
                && (root.detail
                    || Shell.destination == 0
                    || Shell.destination == 3
                    || Shell.destination == 4
                    || Shell.destination == 6))
                || (Shell.destination == 0 && !root.detail):
            facet-bar := FacetBar {
                show-groups: Player.facets-enabled;
                daily-heard-toggle: Shell.destination == 0 && !root.detail;
            }

            if Player.chosen-count > 0 && Player.tracks.length == 0: filtered-empty := FilteredEmpty { }

            // 空状态:该有一批歌的地方一首都没有。图标、一句标题、一句怎么填上它,
            // 一颗次要按钮去能填上它的地方。设计稿里的「打开本地文件夹」等入口
            // 等功能存在了再上(硬规则 8)。
            if Shell.music-empty:
            empty-state := VerticalLayout {
                vertical-stretch: 1;
                alignment: center;

                // 这个视图还一份都没有、正在取:说「在路上」,不说「一首都没有」,
                // 也不摆换一批推荐 —— 那会把人从正在进的视图拽走(#137 ④)。
                if Player.tracks-loading: empty-loading := Text {
                    text: "正在取这一页的歌…";
                    accessible-role: text;
                    accessible-label: self.text;
                    font-size: TextSize.body;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                }

                if !Player.tracks-loading: EmptyState {
                    compact: Shell.compact;
                    icon: root.detail ? Icons.playlist
                        : Shell.destination == 6 ? Icons.heart
                        : Shell.destination == 3 ? Icons.clock-counter-clockwise
                        : Shell.destination == 2 ? Icons.magnifying-glass
                        : Icons.calendar-blank;
                    title: root.detail ? "这里还没有歌"
                        : Shell.destination == 6 ? "还没有喜欢的歌"
                        : Shell.destination == 3 ? "还没有播放记录"
                        : Shell.destination == 2 ? "没有找到歌"
                        : "点一首歌开始";
                    body: root.detail ? "在别的列表里长按一首歌,可以把它加进来。"
                        : Shell.destination == 6 ? "在列表里点红心,歌会收进这里。"
                        : Shell.destination == 3 ? "放过的歌会按时间排在这里。"
                        : Shell.destination == 2 ? "换个关键词,或者搜歌手和歌单。"
                        : "点云在待机,选一首它就活过来。";
                    action: Shell.destination == 0 && !root.detail ? "换一批推荐"
                        : Shell.destination == 6 || Shell.destination == 3 ? "去每日推荐挑歌"
                        : "";
                    action-icon: Shell.destination == 0 ? Icons.arrow-clockwise : Icons.calendar-blank;
                    act => {
                        if (Shell.destination == 0) {
                            Player.daily();
                        } else {
                            Destinations.go(0);
                        }
                    }
                }
            }

            // 墙只在每日推荐分区才有东西可摆。别处也实例化的话,
            // 空的它仍占一格间距,列表底下凭空多一条缝(#130)。
            if Shell.wall-supported
                && Shell.destination == 0
                && !root.detail:
            WallView { }

            // 宽版式的表头,与行同一套列宽。
            if root.list-shown && Shell.wide: TrackHeader { }

            // 它们都是「一批歌」。墙可见时列表让位 ——
            // 同一批卡的两种摆法,不同时出现。一首都没有时让位给上面的
            // 空状态:两个都在的话各分一截,下半页是一张空列表(#116)。
            if root.list-shown:
            track-list := TrackList {
                vertical-stretch: 1;
                tracks: Player.tracks;
                current: Player.now-id;
                // 换模型时钉住眼前那一行、打开日推时滚到在放那一行(见 ui/src/music/list.rs)
                scroll-to-y: Player.list-scroll-to;
                scroll-seq: Player.list-scroll-seq;
                scroll-done <=> Player.list-scroll-done;
                changed content-y => { Player.list-scroll-y = self.content-y; }
                init => { Player.list-scroll-y = self.content-y; }
                // 只有本地歌单的内容能移出去
                removable: Library.open-playlist-local;
                play(id) => { Player.play(id); }
                toggle-liked(id, liked) => {
                    Library.toggle-liked(id, liked);
                }
                remove(id) => { Library.remove-track(id); }
                long-press(id, title) => {
                    Library.track-menu-id = id;
                    Library.track-menu-title = title;
                }
                needs-cover(url) => {
                    Player.needs-cover(url);
                }
                toggle-pile(label) => { Player.toggle-pile(label); }
            }
        }
    }
}
