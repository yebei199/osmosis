import { Palette } from "std-widgets.slint";

import { Theme, Type } from "theme.slint";
import { TrackRow, PlaylistRow, ArtistRow } from "types.slint";
import { HoverButton } from "widgets.slint";
import { MusicBar, MusicRail, SearchTabBar } from "musicnav.slint";
import { TrackList } from "tracklist.slint";
import { PlaylistList } from "playlists.slint";
import { ArtistList } from "artists.slint";
import { WallView } from "wallview.slint";
import { GlassCard } from "glass.slint";
import { LineEdit } from "std-widgets.slint";
import { Library } from "globals/library.slint";
import { Player } from "globals/player.slint";
import { Shell } from "globals/shell.slint";
import { Viz } from "globals/viz.slint";

// 音乐页(tab 1):二级导航、搜索、歌单详情、卡墙与列表,以及两套控制条。
//
// 属性面全在 global 里,这一页因此不从窗口根接一个字段 —— 拆出来时
// 一处转发都不必写(见 docs/adr/0027)。
export component MusicPage inherits VerticalLayout {
    padding: 16px;
    spacing: 12px;

    // 每次进这一页都触发(切页时整块重建)。当天还没拉过推荐就
    // 替用户拉一次 —— 空着一页只有一行「点一首歌开始」不是个好开局。
    // 「当天拉过就不动」的判断在 Rust 侧,搜索结果因此不会被冲掉。
    init => { Player.music-shown(); }

    // 紧凑版式:分段条在顶部。竖栏在这个宽度上会把内容挤没。
    if Shell.compact: music-bar := MusicBar {
        current: Shell.music-section;
        selected(section) => { Shell.select-section(section); }
    }

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 12px;

        // 宽版式:可收缩竖栏。
        if !Shell.compact: music-rail := MusicRail {
            current: Shell.music-section;
            collapsed <=> Shell.rail-collapsed;
            selected(section) => { Shell.select-section(section); }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 12px;

            // 搜索框只在搜索分区出现 —— 其余三个分区没有关键词可填,
            // 常驻一个空框会让人以为那三页也要先搜一下。
            // 进了歌手详情也收起来:那一层有自己的标题行与返回键。
            if Shell.music-section == 2
                && Library.open-playlist-name == "":
            HorizontalLayout {
                spacing: 8px;

                // 歌名是任意 CJK,不能指定子集字体,
                // 否则输入的字大多不在子集里,直接是豆腐块。
                keyword := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "搜索";
                    accepted => { Player.search(self.text); }
                }
                HoverButton {
                    width: Shell.compact ? 60px : 84px;
                    text: "Go";
                    clicked => { Player.search(keyword.text); }
                }
            }

            // 搜索结果的三个页签。与搜索框同进同出 ——
            // 没搜过时它们也在,那是有意的:告诉人这一页能搜三类东西。
            if Shell.music-section == 2
                && Library.open-playlist-name == "":
            search-tabs := SearchTabBar {
                current: Library.search-tab;
                selected(tab) => {
                    Library.select-search-tab(tab);
                }
            }

            // 播放状态行。文案是硬编码中文,走子集字体;
            // 高度钉死,免得文案变长把下面的列表顶来顶去。
            Text {
                text: Player.playback-text;
                font-family: "Maple Mono NF CN";
                color: Theme.text-dim;
                font-size: 13px;
                height: 20px;
                vertical-alignment: center;
                overflow: elide;
            }

            // 同播状态行:推给几台 / 正在收听谁 / 出了什么错。
            Text {
                text: Shell.sync-text;
                font-family: "Maple Mono NF CN";
                color: Theme.text-dim;
                font-size: 13px;
                height: 20px;
                vertical-alignment: center;
                overflow: elide;
            }

            // 详情那一层的标题行 + 返回。歌单与歌手共用 ——
            // 两者摊开之后都是「一批歌」,再造一套标题行只会
            // 让返回键有两种写法。
            // 与列表**互斥**:两个都在的话,返回键该收哪一层
            // 就说不清了。
            if Library.open-playlist-name != "":
            playlist-header := HorizontalLayout {
                spacing: 8px;
                height: 28px;

                back := TouchArea {
                    width: 28px;

                    Text {
                        text: "‹";
                        color: Theme.text-dim;
                        font-size: 20px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    clicked => { Library.close-playlist(); }
                }

                // 详情页那张封面。比列表里那张大一档,
                // 但不铺满 —— 这一层的主体是曲目,不是图。
                if Library.open-playlist-cover.width > 0:
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 5px;
                        clip: true;

                        Image {
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                            source: Library.open-playlist-cover;
                        }
                    }
                }

                // 改名时标题就地变成输入框。另开一层对话框的话,
                // 那一层要盖住的正是「原来叫什么」。
                if !Library.renaming: Text {
                    text: Library.open-playlist-name;
                    color: Theme.text;
                    font-size: 15px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if Library.renaming: rename-box := LineEdit {
                    horizontal-stretch: 1;
                    text: Library.open-playlist-name;
                    accepted => {
                        Library.rename-playlist(self.text);
                        Library.renaming-for = "";
                    }
                }

                // 改名与删除只给本地歌单 —— 平台那两种的真相
                // 不在这边,摆上去只会让人点了才知道。
                if Library.open-playlist-local:
                rename-button := HoverButton {
                    width: 56px;
                    text: Library.renaming ? "取消" : "改名";
                    clicked => {
                        Library.renaming-for =
                            Library.renaming ? "" : Library.open-playlist-name;
                        Library.confirming-for = "";
                    }
                }
                if Library.open-playlist-local:
                delete-button := HoverButton {
                    width: Library.confirming-delete ? 96px : 56px;
                    // 点两下才真删:一下就删的话,手指滑一下
                    // 就没了一个歌单,而歌单没有回收站。
                    text: Library.confirming-delete ? "确认删除?" : "删除";
                    clicked => {
                        if (Library.confirming-delete) {
                            Library.delete-playlist();
                            Library.confirming-for = "";
                        } else {
                            Library.confirming-for =
                                Library.open-playlist-name;
                            Library.renaming-for = "";
                        }
                    }
                }
            }

            // 「把刚才那批加进来」。只在本地歌单详情、且刚才
            // 确实有一批歌时出现 —— 进歌单那一刻 Player.tracks 就被
            // 换掉了,所以那一批由 Rust 在打开前存下来。
            if Library.open-playlist-local
                && Library.add-batch-text != "":
            add-batch-row := HoverButton {
                height: 30px;
                text: Library.add-batch-text;
                clicked => { Library.add-batch(); }
            }

            // 平台给不出详情的那几首。摆在列表末尾:它说的是
            // 「上面那批之外还有」,不是一个可点的条目。
            if Library.unavailable-note != "":
            unavailable-row := Text {
                height: 30px;
                text: Library.unavailable-note;
                color: Theme.text-dim;
                vertical-alignment: center;
            }

            // 新建歌单。摆在列表那一层的顶上 ——
            // 名字由回调带出来,因为这个输入框在 `if` 里,
            // Rust 引用不到它。
            if Shell.music-section == 1
                && Library.open-playlist-name == "":
            new-playlist-row := HorizontalLayout {
                spacing: 8px;
                height: 32px;

                new-name := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "新建歌单";
                    accepted => {
                        Library.create-playlist(self.text);
                        self.text = "";
                    }
                }
                HoverButton {
                    width: 56px;
                    text: "新建";
                    clicked => {
                        Library.create-playlist(new-name.text);
                        new-name.text = "";
                    }
                }
            }

            // 歌单分区的列表那一层。
            if Shell.music-section == 1
                && Library.open-playlist-name == "":
            playlist-list := PlaylistList {
                vertical-stretch: 1;
                playlists: Library.playlists;
                open(id, source) => {
                    Library.open-playlist(id, source);
                }
            }

            // 搜索的歌手页签。
            if Shell.music-section == 2
                && Library.open-playlist-name == ""
                && Library.search-tab == 1:
            artist-list := ArtistList {
                artists: Library.found-artists;
                open(id, name) => {
                    Library.open-artist(id, name);
                }
            }

            // 搜索的歌单页签。与「我的歌单」同一个组件、
            // 不同的一份数据 —— 点开走的也是同一条路。
            if Shell.music-section == 2
                && Library.open-playlist-name == ""
                && Library.search-tab == 2:
            found-playlist-list := PlaylistList {
                vertical-stretch: 1;
                playlists: Library.found-playlists;
                open(id, source) => {
                    Library.open-playlist(id, source);
                }
            }

            // 曲目列表。四种情况摆它:每日推荐、最近播放、
            // 搜索的歌曲页签,以及任何一层详情(歌单或歌手)——
            // 空状态:该有一批歌的地方一首都没有。大标题 +
            // 一个真动作(拉一批推荐);设计稿里的「打开本地
            // 文件夹」等入口等功能存在了再上(硬规则 8)。
            if Player.tracks.length == 0
                && (Library.open-playlist-name != ""
                    || Shell.music-section == 0
                    || Shell.music-section == 3
                    || (Shell.music-section == 2
                        && Library.search-tab == 0)):
            empty-state := VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 12px;

                Text {
                    text: "点一首歌开始";
                    font-family: Type.display-cjk;
                    font-weight: 900;
                    font-size: 34px;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Text {
                    text: "点云在待机,选一首它就活过来";
                    font-family: "Maple Mono NF CN";
                    font-size: 13px;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    empty-daily := Rectangle {
                        // 定宽:光带纹理的尺寸在 lib.rs 有一份镜像,跟着 preferred-width
                        // 走的话两边会各算各的。
                        width: 150px;
                        height: 38px;
                        border-radius: 999px;
                        clip: true;
                        background: empty-daily-touch.has-hover
                            ? Theme.accent.darker(0.2) : Theme.accent;
                        accessible-role: button;
                        accessible-label: "换一批推荐";
                        accessible-action-default => { Player.daily(); }

                        // §9:光带纹理垫底(ribbon 绿板)。
                        if Shell.aurora-buttons-on && Shell.empty-daily-bg.width > 0: Image {
                            width: 100%;
                            height: 100%;
                            source: Shell.empty-daily-bg;
                        }

                        empty-daily-label := Text {
                            text: "换一批推荐";
                            font-family: "Maple Mono NF CN";
                            font-size: 14px;
                            // 光带底是深的,字换近白;关掉开关回 accent 实底的深墨。
                            color: Shell.aurora-buttons-on && Shell.empty-daily-bg.width > 0
                                ? Theme.immersive-text : Theme.accent-text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        empty-daily-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Player.daily(); }
                            changed has-hover => {
                                Shell.empty-daily-hover = self.has-hover;
                            }
                            moved => {
                                Shell.empty-daily-px = self.mouse-x / max(self.width, 1px);
                                Shell.empty-daily-py = 1 - self.mouse-y / max(self.height, 1px);
                            }
                        }
                    }
                }
            }

            WallView { }


            // 它们都是「一批歌」。墙可见时列表让位 ——
            // 同一批卡的两种摆法,不同时出现。
            if (Library.open-playlist-name != ""
                || Shell.music-section == 0
                || Shell.music-section == 3
                || (Shell.music-section == 2
                    && Library.search-tab == 0))
                && !Shell.wall-visible:
            track-list := TrackList {
                vertical-stretch: 1;
                tracks: Player.tracks;
                // 最近播放画成时间轴,别的分区还是平列表。
                timeline: Shell.music-section == 3
                    && Library.open-playlist-name == "";
                // 只有本地歌单的内容能移出去
                removable: Library.open-playlist-local;
                play(id) => { Player.play(id); }
                toggle-liked(id, liked) => {
                    Library.toggle-liked(id, liked);
                }
                remove(id) => { Library.remove-track(id); }
                needs-cover(url) => {
                    Player.needs-cover(url);
                }
            }
        }
    }


    // 控制条不在这一页里 —— 它是壳持有的那一根,一个实例管四个页签
    // (app.slint,docs/adr/0029)。这里只把页尾垫高,免得列表最后几行
    // 藏在条底下。垫的量 = 条高 + 底边距 + 富余。
    Rectangle { height: 100px; }
}
