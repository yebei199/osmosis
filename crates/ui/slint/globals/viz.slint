import { LyricRow, TrackRow } from "../types.slint";

// 播放页视觉的状态面:糊封面背景、每帧推来的场景图、效果的选择与指针。
//
// **不含窗口几何派生的那几条**(歌词块高度、控制条高度、标题纵位) —— 它们要读
// root.height 与 safe-area-insets,而 global 拿不到窗口上下文,那批留在 MainWindow。
// 这条界线与代价见 docs/adr/0027。
export global Viz {
    // 播放页的 3D 场景(透明底,铺满整窗),render3d 每帧推送。
    // 无 GPU 的端恒为空图(width == 0),覆层只剩糊封面背景,`.slint` 里
    // 零平台判断 —— 这就是「余端 graceful 缺省」的落点。
    in property <image> viz-scene;

    // 播放页的效果:0 封面实物(默认)、1 点云。编号与 render3d 的 `Effect::from_index`、
    // crates/ui/src/viz/effect.rs 的落盘映射手工对齐 —— 三处按下标说话,加档时一起动。
    // 启动时由 Rust 从设置文件恢复;菜单里点一档就直接改它,下一帧生效(docs/adr/0041)。
    in-out property <int> viz-effect: 0;
    out property <[string]> viz-effect-names: ["封面实物", "点云"];
    // 效果菜单开着。Esc / 返回先收它,再收播放页。
    in-out property <bool> effect-menu-open: false;
    // 菜单里选了一档(已经写进 viz-effect)。Rust 侧只管落盘。
    callback viz-effect-chosen(int);

    // 视觉区里的指针,位置归一到 0..1(左上原点)。Rust 每帧在 seam 处读它,
    // 换算成拖动量交给当前效果(点云转、封面实物偏转回弹,见 crates/render3d)。
    // `active` 在指针离开时落回假 —— 指针不在了就当松手。
    in-out property <float> viz-pointer-x: 0.5;
    in-out property <float> viz-pointer-y: 0.5;
    in-out property <bool> viz-pointer-down: false;
    in-out property <bool> viz-pointer-active: false;

    in property <image> cover-art;
    // 同一张封面缩小糊开(imagery/cover.rs 的 blurred_of),播放页铺满当背景光。
    in property <image> cover-blur;
    // 正在播的歌名与歌手,play_current 推送。任意 CJK,不指定子集字体。
    in property <string> now-title;
    in property <string> now-artists;
    // 当前歌词行与其译文,Rust 每帧按播放位置选出后推送(见 app_core::current_line)。
    // 没有歌词、或还在前奏时为空串,歌词区整块让位。
    in property <string> lyric-line;
    in property <string> lyric-translation;
    // 歌词页(#73):整窗的行由 Rust 按 `app_core::window` 选好推来,
    // 浏览偏移由界面在拖动里改、Rust 读它算窗口。
    in property <[LyricRow]> lyric-rows;
    in property <bool> lyric-has-translation;
    in-out property <bool> lyrics-page-open: false;
    in-out property <int> lyric-browse: 0;

    // 队列页(#109 AC-15):摆当前执行副本的那一份队列。
    //
    // 行里那个 `TrackRow.id` 装的是 **`entry-id`**,不是曲目 id ——
    // 队列允许同一首歌出现多次,按曲目认的话点第二次出现的那一条会放到
    // 第一条上去。条目号是从服务端读回来的,不是拿下标猜的。
    in property <[TrackRow]> queue-rows;
    // 正在放的那一条的 `entry-id`。
    in property <string> queue-current;
    // 队列一共几首。不从 `queue-rows.length` 读:遥控时列表可能还在下载,
    // 而这个数小状态里早就报过来了。
    in property <int> queue-total;
    // 列表还在下载。与「队列是空的」分开 —— 两种长得一样的话,
    // 用户会以为自己的歌没了。
    in property <bool> queue-loading;
    in-out property <bool> queue-page-open: false;
    // 点了某一条。参数是 `entry-id`。
    callback queue-pick(string);
    // 这一行要它的封面了。与列表页同一条路。
    callback queue-needs-cover(string);
}
