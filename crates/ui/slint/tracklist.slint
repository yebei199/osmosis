// 一列可滚的曲目。
//
// 每日推荐、搜索结果、最近播放、歌单详情摆的都是这一个 —— 它们的差别在
// 「这批歌是哪来的」,而那是 Rust 侧的事,不是列表的事。
//
// 行内的字段都是**已经格式化好的字符串**:歌手怎么拼、时长怎么写由 Rust 决定
// 并测过(见 types.slint)。

import { ListView } from "std-widgets.slint";
import { TrackRow } from "types.slint";
import { Theme, Glass, Radius, Motion, Space, TextSize, Type, Layout, Weight, Tracking } from "theme.slint";
import { Player } from "globals/player.slint";
import { Shell } from "globals/shell.slint";
import { Icon, Icons } from "icons.slint";
import { Chip, ChipKind } from "widgets.slint";

// ListView 而不是 Flickable + for:后者会把整批歌全部实例化,而歌单详情能到
// 近千行 —— 每行还要配一张封面的话,那就是上千张图同时在内存里。
export component TrackList inherits ListView {
    in property <[TrackRow]> tracks;
    // 这一批歌是不是某个本地歌单的内容。是的话每行多一个「−」——
    // 从每日推荐里「移除」一首没有意义,那不是一个能改的集合。
    in property <bool> removable: false;
    // 时间轴档:最近播放用。左侧一条竖线,每行一个圆点,最新那条
    // (第一行)是 accent 实心加光晕 —— 列表还是同一个列表,只多一列装饰。
    in property <bool> timeline: false;
    // 正在放的是哪一行,按 `TrackRow.id` 认。空串 = 不标(别的页面都不标)。
    //
    // 与 `loading` 分开:那一位说的是「点下去了、正在办」,这一位说的是
    // 「就是它在响」。共用一位的话,队列页上会出现一首永远在加载的歌。
    in property <string> current: "";

    callback play(string);
    // 点红心。参数是曲目 id 与**点完之后**的状态 —— 让 Rust 再去读一遍当前
    // 状态的话,两边对「现在是红还是没红」的理解就有了两个来源。
    callback toggle-liked(string, bool);
    // 把这一首移出当前歌单。与红心是两件事:红心说的是「我喜欢这首歌」,
    // 共用一个键的话,取消红心时会连带把歌从歌单里删掉。
    callback remove(string);
    // 这一行要它的封面了。由 Rust 去取、缓存、回填(见 ui/src/thumbnail.rs)。
    callback needs-cover(string);
    // 按住这一行不放。参数是曲目 id 与标题 —— 菜单要显示标题,而这一行随时
    // 会被 ListView 复用到别的歌上去,菜单开着的时候回头来读就已经不是它了。
    callback long-press(string, string);
    // 点了一个堆头(#160):折叠或展开它。参数是堆名。
    callback toggle-pile(string);
    // 滚到内容顶端往下 `scroll-to-y` 那里:`scroll-seq` 与 `scroll-done` 不等就是
    // 还有一次没滚。`scroll-done` 由外面接到一个比列表活得久的地方 —— 列表随
    // 「有没有歌」重建,请求可能发在它建出来之前,建出来、内容有了高度再补滚;
    // 已经滚过的,重建时不再滚一遍。兜底在这里做:不滚出内容的底,也不滚到顶之上。
    in property <length> scroll-to-y: 0px;
    in property <int> scroll-seq: 0;
    in-out property <int> scroll-done: 0;
    function apply-scroll() {
        if (root.scroll-done != root.scroll-seq && root.content-height > 0) {
            root.content-y = max(
                min(0px, root.visible-height - root.content-height),
                -root.scroll-to-y);
            root.scroll-done = root.scroll-seq;
        }
    }
    changed scroll-seq => { root.apply-scroll(); }
    changed content-height => { root.apply-scroll(); }

    vertical-stretch: 1;

    // 一行(docs/design.md「曲目行」):不再是一格一格的卡片,只在悬停时铺一层淡底。
    // 宽版式:序号 | 封面 | 歌名/歌手 | 专辑 | 红心 | 时长 | 更多;紧凑版式:
    // 封面 | 歌名/歌手 | 红心与更多。正在放的那一行歌名换强调色,封面变成透镜。
    for row[i] in root.tracks: line := Rectangle {
        height: row.header ? Player.pile-row-height : Player.track-row-height;
        // 行宽钉在可见宽度上。ListView 按行的 preferred 宽排视口,宽屏多列的
        // preferred 归零之后,不钉的话整行缩成文字最小宽(MEO-1878)。
        width: root.visible-width;

        // 就是它在响 —— 与 root.current 绑的那一首比对,空串不算(见上面
        // `current` 的注释)。
        property <bool> is-current: root.current != "" && row.id == root.current;
        property <bool> hovered: touch.has-hover && !Shell.compact;

        Rectangle {
            border-radius: Radius.sm;
            background: row.header ? transparent
                : row.loading ? Theme.accent-wash
                : line.hovered ? Theme.hover : transparent;
            animate background { duration: Motion.fast; easing: Motion.ease; }
        }

        // 报封面需求的那条线。ListView 会把滚出去的行**复用**到新行上,
        // 而复用不会重跑 init —— 只有这个 changed 才追得上第 500 行。
        // 反过来 init 也少不了:首屏那几行是创建出来的,不经过 changed。
        property <string> wanted: row.cover-url;
        changed wanted => { root.needs-cover(self.wanted); }
        init => { root.needs-cover(self.wanted); }

        // 按住不放 → 菜单。Slint 没有内置的长按:按下起表,松手或取消撤表,
        // 表响了就把这一次点击算作"开菜单",于是松手时不会顺带把歌放出来。
        //
        // 表长在行里而不是列表上:列表只有一个的话,两行先后按下会共用同一个
        // 计时,后按的那行接管前一行的进度。ListView 只实例化可见的十几行,
        // 而它们平时 `running: false`,不产生唤醒。
        property <bool> pressing: false;
        property <bool> menu-opened: false;

        // 点一下这一行该干什么;手指点(clicked)与读屏/MCP 的默认动作
        // (accessible-action-default)共用同一条逻辑,别各写一份。
        function activate() {
            if (row.header) {
                root.toggle-pile(row.title);
            } else if (!self.menu-opened) {
                root.play(row.id);
            }
        }

        function open-menu() {
            if (!row.header) {
                self.menu-opened = true;
                self.pressing = false;
                root.long-press(row.id, row.title);
            }
        }

        touch := TouchArea {
            // 颜色读屏看不见 —— 正在播的那一行额外报一个可查的选中态。
            accessible-role: button;
            // 读屏要念出这一行是哪首;端到端脚本也按它认出列表里摆的是哪一批
            accessible-label: row.header ? row.title + " " + row.duration : row.title;
            accessible-checkable: true;
            // 堆头报的是「展开着」,歌报的是「正在放」
            accessible-checked: row.header ? !row.collapsed : line.is-current;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    parent.pressing = true;
                    parent.menu-opened = false;
                }
                if (event.kind == PointerEventKind.up
                    || event.kind == PointerEventKind.cancel) {
                    parent.pressing = false;
                }
            }
            // 读屏与 MCP 的默认动作走这里,和手指点是同一条逻辑(#168)。
            accessible-action-default => { parent.activate(); }
            accessible-action-expand => { line.open-menu(); }
            clicked => { parent.activate(); }
        }

        Timer {
            interval: 450ms;
            running: parent.pressing && !row.header;
            triggered => {
                line.open-menu();
            }
        }

        // 堆头(日推的推荐日、分组的一堆):粗体小字,右边一句几首,再一个折叠箭头。
        if row.header: HorizontalLayout {
            padding-left: Shell.compact ? Space.xs : Space.md;
            padding-right: Shell.compact ? Space.xs : Space.md;
            padding-top: Shell.compact ? 14px : 18px;
            spacing: 10px;
            Text {
                text: row.title;
                color: Theme.text;
                font-size: TextSize.small;
                font-weight: Weight.bold;
                letter-spacing: 0.6px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: row.duration;
                color: Theme.text-faint;
                font-size: TextSize.caption;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Icon {
                    size: 14px;
                    source: row.collapsed ? Icons.caret-right : Icons.caret-down;
                    colorize: Theme.text-faint;
                }
            }
        }

        if !row.header: HorizontalLayout {
            padding-left: Shell.compact ? Space.xs : Space.md;
            padding-right: Shell.compact ? Space.xs : Space.md;
            spacing: 14px;

            // 序号。悬停换成播放三角,正在放的那一行是强调色。
            if !Shell.compact: Rectangle {
                width: 32px;
                if !line.hovered: Text {
                    width: 100%;
                    height: 100%;
                    text: row.number > 0 ? "\{row.number}" : "";
                    color: line.is-current ? Theme.accent-ink : Theme.text-faint;
                    font-size: TextSize.small;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                if line.hovered: Icon {
                    x: parent.width - self.width;
                    size: 16px;
                    source: Icons.play-fill;
                    colorize: Theme.text;
                }
            }

            // 封面。取不到就是一块占位色 —— 留个空洞会让整列参差不齐,
            // 而封面取不到是常态(与歌单行同一条规矩,见 playlists.slint)。
            VerticalLayout {
                alignment: center;
                cover-slot := Rectangle {
                    width: Shell.compact ? 48px : 40px;
                    height: self.width;
                    border-radius: Radius.xs;
                    background: Theme.line;
                    clip: true;

                    if row.cover.width > 0: Image {
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                        source: row.cover;
                    }
                    // 正在放:封面压暗成透镜,上面三根强调色的电平条。电平条是静态的 ——
                    // 循环动画会让空闲时也在出帧(docs/adr/0035)。暂停时三根都落到底。
                    if line.is-current: Rectangle {
                        background: #040a066b;
                        border-radius: Radius.xs;
                        border-width: 1px;
                        border-color: Glass.rim;
                        Rectangle {
                            x: 2px;
                            y: -3px - (self.width - 12px) / 2;
                            width: 34px;
                            height: self.width;
                            transform-scale-y: 12px / 34px;
                            background: @radial-gradient(circle, #ffffff5c 0%, transparent 70%);
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 2.5px;
                            for bar in [8px, 14px, 10px]: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 3px;
                                    height: Player.is-playing ? bar : 3px;
                                    border-radius: 1.5px;
                                    background: Theme.accent;
                                }
                            }
                        }
                    }
                }
            }

            // 歌名在上、歌手在下。宽版式右边多一列专辑(比例 1.5 : 1)。
            title-cell := VerticalLayout {
                horizontal-stretch: 3;
                preferred-width: 0px;
                alignment: center;
                spacing: 2px;

                // 歌名与歌手来自平台,是任意 CJK/日文;Osmosis Sans 按标准字符集裁过,
                // 漏的生僻字走系统字体回退。
                Text {
                    text: row.title;
                    color: line.is-current ? Theme.accent-ink : Theme.text;
                    font-size: TextSize.row;
                    font-weight: line.is-current ? Weight.semibold : Weight.regular;
                    overflow: elide;
                }
                Text {
                    text: row.artists;
                    color: Theme.text-dim;
                    font-size: TextSize.small;
                    overflow: elide;
                }
            }
            if Shell.wide: album-cell := Text {
                horizontal-stretch: 2;
                preferred-width: 0px;
                text: row.album;
                color: Theme.text-dim;
                font-size: TextSize.small;
                vertical-alignment: center;
                overflow: elide;
            }

            // 红心。宽版式:红了常亮,没红只在悬停时出现;紧凑版式只摆红了的。
            // 两态画得不一样 —— 都一样的话,点了也不知道成没成。
            if !Shell.compact || row.liked: heart := TouchArea {
                width: 32px;
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: row.liked ? "取消喜欢" : "喜欢";
                accessible-action-default => { root.toggle-liked(row.id, !row.liked); }

                Icon {
                    size: 18px;
                    source: row.liked ? Icons.heart-fill : Icons.heart;
                    colorize: row.liked ? Theme.accent-ink : Theme.text-faint;
                    opacity: row.liked || line.hovered ? 1 : 0;
                }

                // 不冒泡到整行那个 TouchArea —— 否则点红心的同时会把这首歌
                // 放出来。Slint 里子 TouchArea 先收到点击且不再往下传。
                clicked => {
                    root.toggle-liked(row.id, !row.liked);
                }
            }

            // 移出歌单。只在本地歌单详情里出现。
            if root.removable: remove-hit := TouchArea {
                width: 28px;
                mouse-cursor: pointer;

                Icon {
                    size: 18px;
                    source: Icons.minus;
                    colorize: Theme.text-faint;
                }

                // 同红心:不冒泡到整行,否则移除的同时会把这首放出来
                clicked => { root.remove(row.id); }
            }

            // 时长让位给「加载中」:正在加载时时长不是用户在等的信息。
            // 紧凑版式不摆时长,只在加载时摆那一句。
            if !Shell.compact || row.loading: Text {
                text: row.loading ? "加载中…" : row.duration;
                color: row.loading ? Theme.accent-ink : Theme.text-faint;
                font-size: TextSize.small;
                vertical-alignment: center;
                width: Shell.compact ? self.preferred-width : Layout.duration-col;
                horizontal-alignment: right;
            }

            // 更多:与长按是同一个菜单。宽版式悬停才出现,紧凑版式常驻。
            more-hit := TouchArea {
                width: Shell.compact ? 32px : 28px;
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: "更多操作";
                accessible-action-default => { line.open-menu(); }
                Icon {
                    size: Shell.compact ? 18px : 20px;
                    source: Icons.dots-three;
                    colorize: Shell.compact ? Theme.text-faint : Theme.text-dim;
                    opacity: Shell.compact || line.hovered ? 1 : 0;
                }
                clicked => { line.open-menu(); }
            }
        }
    }
}

// 宽版式列表的表头:与行同一套列宽,只有序号、标题、专辑与时钟图标四格有字。
export component TrackHeader inherits Rectangle {
    height: 34px;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: 14px;
        Text {
            width: 32px;
            text: "#";
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: TextSize.micro;
            font-weight: Weight.semibold;
            color: Theme.text-faint;
        }
        Rectangle { width: 40px; }
        Text {
            horizontal-stretch: 3;
            preferred-width: 0px;
            text: "标题";
            vertical-alignment: center;
            font-size: TextSize.micro;
            font-weight: Weight.semibold;
            letter-spacing: Tracking.cjk-label;
            color: Theme.text-faint;
        }
        Text {
            horizontal-stretch: 2;
            preferred-width: 0px;
            text: "专辑";
            vertical-alignment: center;
            font-size: TextSize.micro;
            font-weight: Weight.semibold;
            letter-spacing: Tracking.cjk-label;
            color: Theme.text-faint;
        }
        Rectangle { width: 32px; }
        HorizontalLayout {
            width: Layout.duration-col;
            alignment: end;
            VerticalLayout {
                alignment: center;
                Icon {
                    size: 15px;
                    source: Icons.clock;
                    colorize: Theme.text-faint;
                }
            }
        }
        Rectangle { width: 28px; }
    }
}

// ── 分组条与筛选 chips(#160) ──
//
// 一排可横滑的 chips(docs/design.md「工具条」):日推的「已听过」开关、分组方式、
// 再是各个筛选 chip。分组是一颗选择型 chip,点开就地摆出几种分法。分堆、筛选、
// 每个 chip 数几首都在 Rust(app_core::facets),这里只摆、只喊回调。

// 横滑行右缘的渐隐:还有内容在右边。只是提示,不挡点击。
component OverflowFade inherits Rectangle {
    width: 48px;
    background: @linear-gradient(90deg, Theme.base.with-alpha(0) 0%, Theme.base 100%);
}

// chips 之间的竖线分隔。
component ChipSeparator inherits VerticalLayout {
    alignment: center;
    padding-left: 6px;
    padding-right: 6px;
    Rectangle {
        width: 1px;
        height: 20px;
        background: Theme.line-strong;
    }
}

export component FacetBar inherits Rectangle {
    // 摆分组与筛选那几颗(这个视图有 facets)。
    in property <bool> show-groups: true;
    // 行首摆日推的「已听过」开关。
    in property <bool> daily-heard-toggle: false;
    // 分组那颗选择型 chip 展开着:几种分法就地摆在它后面。
    in-out property <bool> grouping-open: false;

    height: Shell.compact ? 44px : 32px;

    // 手机上看不出这一排能横滑:最后一颗被齐刷刷切掉,像是没有了。
    // 右边还有没露出来的 chip 时,盖一道渐隐提示「还能往左划」(MEO-1878)。
    flick := Flickable {
        // 显式铺满:不写的话 Flickable 把 chips 那一排的宽当成自己的上限报给
        // 外层,整列(连同底下的列表)被卡在那一排的宽度上(MEO-1878)。
        width: 100%;
        height: 100%;
        content-width: chip-row.preferred-width;
        chip-row := HorizontalLayout {
            spacing: Space.sm;
            if root.daily-heard-toggle: daily-heard := Chip {
                kind: ChipKind.toggle;
                touch-tall: Shell.compact;
                icon: Icons.headphones;
                text: "已听过";
                selected: Player.daily-heard;
                clicked => { Player.daily-toggle-heard(); }
            }
            if root.daily-heard-toggle && root.show-groups: ChipSeparator { }
            if root.show-groups: grouping-select := Chip {
                kind: ChipKind.select;
                touch-tall: Shell.compact;
                key: "分组";
                text: Player.grouping-labels[Player.grouping];
                checkable: false;
                description: Player.grouping > 0 ? Player.pile-count + " 堆" : "";
                clicked => { root.grouping-open = !root.grouping-open; }
            }
            if root.show-groups && root.grouping-open: HorizontalLayout {
                spacing: Space.xs;
                for label[i] in Player.grouping-labels: grouping-pill := Chip {
                    touch-tall: Shell.compact;
                    text: label;
                    selected: Player.grouping == i;
                    clicked => {
                        Player.set-grouping(i);
                        root.grouping-open = false;
                    }
                }
            }
            if root.show-groups: HorizontalLayout {
                spacing: Space.sm;
                for chip[i] in Player.chips: chip-pill := Chip {
                    touch-tall: Shell.compact;
                    text: chip.text;
                    count: chip.count;
                    selected: chip.chosen;
                    clicked => { Player.toggle-chip(i); }
                }
            }
        }
    }
    if flick.content-x > flick.width - flick.content-width + 1px: chips-fade := OverflowFade {
        x: parent.width - self.width;
        height: parent.height;
    }
}

// 筛空了:说清楚是筛选的结果,不摆开局那句「点一首歌开始」。
export component FilteredEmpty inherits Text {
    text: "没有符合筛选的歌";
    accessible-role: text;
    accessible-label: self.text;
    font-size: TextSize.small;
    color: Theme.text-dim;
    horizontal-alignment: center;
}
