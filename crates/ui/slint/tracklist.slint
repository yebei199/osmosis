// 一列可滚的曲目。
//
// 每日推荐、搜索结果、最近播放、歌单详情摆的都是这一个 —— 它们的差别在
// 「这批歌是哪来的」,而那是 Rust 侧的事,不是列表的事。
//
// 行内的字段都是**已经格式化好的字符串**:歌手怎么拼、时长怎么写由 Rust 决定
// 并测过(见 types.slint)。

import { ListView } from "std-widgets.slint";
import { TrackRow } from "types.slint";
import { Theme } from "theme.slint";
import { Player } from "globals/player.slint";
import { Shell } from "globals/shell.slint";

// ListView 而不是 Flickable + for:后者会把整批歌全部实例化,而歌单详情能到
// 近千行 —— 每行还要配一张封面的话,那就是上千张图同时在内存里。
export component TrackList inherits ListView {
    in property <[TrackRow]> tracks;
    // 这一批歌是不是某个本地歌单的内容。是的话每行多一个「−」——
    // 从每日推荐里「移除」一首没有意义,那不是一个能改的集合。
    in property <bool> removable: false;
    // 时间轴档:最近播放用。左侧一条竖线,每行一个圆点,最新那条
    // (第一行)是 accent 实心加光晕 —— 列表还是同一个列表,只多一列装饰。
    in property <bool> timeline: false;
    // 正在放的是哪一行,按 `TrackRow.id` 认。空串 = 不标(别的页面都不标)。
    //
    // 与 `loading` 分开:那一位说的是「点下去了、正在办」,这一位说的是
    // 「就是它在响」。共用一位的话,队列页上会出现一首永远在加载的歌。
    in property <string> current: "";

    callback play(string);
    // 点红心。参数是曲目 id 与**点完之后**的状态 —— 让 Rust 再去读一遍当前
    // 状态的话,两边对「现在是红还是没红」的理解就有了两个来源。
    callback toggle-liked(string, bool);
    // 把这一首移出当前歌单。与红心是两件事:红心说的是「我喜欢这首歌」,
    // 共用一个键的话,取消红心时会连带把歌从歌单里删掉。
    callback remove(string);
    // 这一行要它的封面了。由 Rust 去取、缓存、回填(见 ui/src/thumbnail.rs)。
    callback needs-cover(string);
    // 按住这一行不放。参数是曲目 id 与标题 —— 菜单要显示标题,而这一行随时
    // 会被 ListView 复用到别的歌上去,菜单开着的时候回头来读就已经不是它了。
    callback long-press(string, string);
    // 点了一个堆头(#160):折叠或展开它。参数是堆名。
    callback toggle-pile(string);

    vertical-stretch: 1;

    // 加载中的那一行自己亮起来,并在行尾标出来。这是用户
    // 手指底下唯一看得见的反馈 —— 没有它,网络一慢人就会连点。
    for row[i] in root.tracks: Rectangle {
        // 堆头(#160)比歌矮一截,没有卡片底,读起来是分隔而不是又一首歌。
        height: row.header ? 44px : 56px;

        // 就是它在响 —— 与 root.current 绑的那一首比对,空串不算(见上面
        // `current` 的注释)。background/border/无障碍态共用同一个判断,
        // 别各写一遍。
        property <bool> is-current: root.current != "" && row.id == root.current;

        // ListView 把行贴着排,没有 spacing —— 原来那 4px 的间隔改由卡片
        // 上下各让 2px 让出来,行本身仍占满一整格。先声明所以画在最底下。
        Rectangle {
            y: 2px;
            height: 52px;
            background: row.header ? transparent
                : row.loading ? Theme.accent.with-alpha(0.15)
                : (parent.is-current
                    ? Theme.accent.with-alpha(0.22)
                    : (touch.has-hover ? Theme.overlay : Theme.overlay-weak));
            border-radius: 8px;
            border-width: row.loading || parent.is-current ? 1px : 0;
            border-color: Theme.accent.with-alpha(0.4);
            animate background { duration: 160ms; easing: ease-out; }
        }

        // 报封面需求的那条线。ListView 会把滚出去的行**复用**到新行上,
        // 而复用不会重跑 init —— 只有这个 changed 才追得上第 500 行。
        // 反过来 init 也少不了:首屏那几行是创建出来的,不经过 changed。
        property <string> wanted: row.cover-url;
        changed wanted => { root.needs-cover(self.wanted); }
        init => { root.needs-cover(self.wanted); }

        // 按住不放 → 菜单。Slint 没有内置的长按:按下起表,松手或取消撤表,
        // 表响了就把这一次点击算作"开菜单",于是松手时不会顺带把歌放出来。
        //
        // 表长在行里而不是列表上:列表只有一个的话,两行先后按下会共用同一个
        // 计时,后按的那行接管前一行的进度。ListView 只实例化可见的十几行,
        // 而它们平时 `running: false`,不产生唤醒。
        property <bool> pressing: false;
        property <bool> menu-opened: false;

        // 点一下这一行该干什么;手指点(clicked)与读屏/MCP 的默认动作
        // (accessible-action-default)共用同一条逻辑,别各写一份。
        function activate() {
            if (row.header) {
                root.toggle-pile(row.title);
            } else if (!self.menu-opened) {
                root.play(row.id);
            }
        }

        touch := TouchArea {
            // 颜色读屏看不见 —— 正在播的那一行额外报一个可查的选中态。
            accessible-role: button;
            // 读屏要念出这一行是哪首;端到端脚本也按它认出列表里摆的是哪一批
            accessible-label: row.header ? row.title + " " + row.duration : row.title;
            accessible-checkable: true;
            // 堆头报的是「展开着」,歌报的是「正在放」
            accessible-checked: row.header ? !row.collapsed : parent.is-current;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    parent.pressing = true;
                    parent.menu-opened = false;
                }
                if (event.kind == PointerEventKind.up
                    || event.kind == PointerEventKind.cancel) {
                    parent.pressing = false;
                }
            }
            // 读屏与 MCP 的默认动作走这里,和手指点是同一条逻辑(#168)。
            accessible-action-default => { parent.activate(); }
            clicked => { parent.activate(); }
        }

        Timer {
            interval: 450ms;
            running: parent.pressing && !row.header;
            triggered => {
                parent.menu-opened = true;
                parent.pressing = false;
                root.long-press(row.id, row.title);
            }
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;

            // 时间轴那一列:竖线贯穿整行,圆点盖在线上。
            if root.timeline && !row.header: Rectangle {
                width: 20px;

                Rectangle {
                    x: (parent.width - 2px) / 2;
                    width: 2px;
                    height: 100%;
                    background: Theme.overlay;
                }
                Rectangle {
                    width: i == 0 ? 12px : 8px;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: i == 0 ? Theme.accent : Theme.overlay;
                    // 最新那条的光晕:一圈半透明的强调色描边。
                    border-width: i == 0 ? 4px : 0;
                    border-color: Theme.accent.with-alpha(0.18);
                }
            }

            // 封面。取不到就是一块占位色 —— 留个空洞会让整列参差不齐,
            // 而封面取不到是常态(与歌单行同一条规矩,见 playlists.slint)。
            if !row.header: VerticalLayout {
                alignment: center;
                cover-slot := Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 6px;
                    background: Theme.divider;
                    clip: true;

                    if row.cover.width > 0: Image {
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                        source: row.cover;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                // 歌名与歌手来自平台,是任意 CJK/日文 ——
                // 不指定 font-family,落到系统字体。
                // web 端 wasm 里没有系统字体,那边会是豆腐块,
                // 已知缺口,见 README「音乐链路」。
                Text {
                    text: row.title;
                    color: row.header ? Theme.text-dim : Theme.text;
                    font-size: row.header ? 13px : 14px;
                    font-weight: row.header ? 700 : 400;
                    overflow: elide;
                }
                if !row.header: Text {
                    text: row.artists;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            // 红心。两态画得不一样 —— 都一样的话,点了也不知道成没成。
            if !row.header: heart := TouchArea {
                width: 32px;

                Text {
                    text: row.liked ? "♥" : "♡";
                    color: row.liked ? Theme.liked : Theme.text-faint;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // 不冒泡到整行那个 TouchArea —— 否则点红心的同时会把这首歌
                // 放出来。Slint 里子 TouchArea 先收到点击且不再往下传。
                clicked => {
                    root.toggle-liked(row.id, !row.liked);
                }
            }

            // 移出歌单。只在本地歌单详情里出现。
            if root.removable && !row.header: remove-hit := TouchArea {
                width: 28px;

                Text {
                    text: "−";
                    color: Theme.text-dim;
                    font-size: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // 同红心:不冒泡到整行,否则移除的同时会把这首放出来
                clicked => { root.remove(row.id); }
            }

            // 时长让位给「加载中」:两个都摆会把歌名挤窄,
            // 而正在加载时时长不是用户在等的信息。
            Text {
                text: row.loading ? "加载中…" : row.duration;
                font-family: row.loading ? "Maple Mono NF CN" : "";
                color: row.loading ? Theme.accent-ink.darker(0.15) : Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }

            // 堆头的折叠指示:展开朝下,折起朝右。画成矢量,不用 ▾ 这类字形 ——
            // 系统字体不一定有它(#158 的勾选框吃过这个亏)。
            if row.header: VerticalLayout {
                alignment: center;
                Path {
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: row.collapsed ? "M 3 1 L 7 5 L 3 9" : "M 1 3 L 5 7 L 9 3";
                    stroke: Theme.text-dim;
                    stroke-width: 1.5px;
                }
            }
        }
    }
}

// ── 分组条与筛选 chips(#160) ──
//
// 两排可横滑的药丸:上排「筛选」开关 + 分组方式,下排是 chip(开着筛选或已选了
// 几个时才出现 —— 手机上两排常驻太占地方)。分堆、筛选、每个 chip 数几首都在
// Rust(app_core::facets),这里只摆、只喊回调。

// 一颗药丸。紧凑版式下触摸区 44px 高(docs/design.md「版式」),画出来的仍是
// 细细一条 —— 44px 的实心药丸一排下来像一行按钮。
component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    // 只给读屏的补充说明,不上屏。
    in property <string> description;
    callback clicked;

    height: Shell.compact ? 44px : 32px;
    width: label.preferred-width + 24px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-description: root.description;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 28px;
        border-radius: 14px;
        background: root.selected
            ? Theme.accent
            : (touch.has-hover ? Theme.overlay : Theme.surface);
    }
    label := Text {
        // 药丸自己已经报了标签,字不再报一遍
        accessible-role: none;
        text: root.text;
        font-family: "Maple Mono NF CN";
        font-size: 12px;
        color: root.selected ? Theme.accent-text : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component FacetBar inherits VerticalLayout {
    // 筛选那一排开着。已选了 chip 时不论开关都摆着,否则看不见筛了什么。
    in-out property <bool> filters-open: false;
    property <length> row-height: Shell.compact ? 44px : 32px;

    spacing: 2px;

    Flickable {
        height: root.row-height;
        content-width: groups.preferred-width;
        groups := HorizontalLayout {
            spacing: 6px;
            filter-toggle := Pill {
                text: Player.chosen-count > 0
                    ? "筛选 · " + Player.chosen-count
                    : "筛选";
                selected: root.filters-open || Player.chosen-count > 0;
                clicked => { root.filters-open = !root.filters-open; }
            }
            for label[i] in Player.grouping-labels: grouping-pill := Pill {
                text: label;
                selected: Player.grouping == i;
                description: Player.grouping == i && i > 0
                    ? Player.pile-count + " 堆" : "";
                clicked => { Player.set-grouping(i); }
            }
        }
    }

    if root.filters-open || Player.chosen-count > 0: Flickable {
        height: root.row-height;
        content-width: chip-row.preferred-width;
        chip-row := HorizontalLayout {
            spacing: 6px;
            for chip[i] in Player.chips: chip-pill := Pill {
                text: chip.text;
                selected: chip.chosen;
                clicked => { Player.toggle-chip(i); }
            }
        }
    }

    // 筛空了:说清楚是筛选的结果,不摆开局那句「点一首歌开始」。
    if Player.chosen-count > 0 && Player.tracks.length == 0: filtered-empty := Text {
        text: "没有符合筛选的歌";
        accessible-role: text;
        accessible-label: self.text;
        font-family: "Maple Mono NF CN";
        font-size: 13px;
        color: Theme.text-dim;
        horizontal-alignment: center;
    }
}
