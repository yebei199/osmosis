// 一列可滚的曲目。
//
// 每日推荐、搜索结果、最近播放、歌单详情摆的都是这一个 —— 它们的差别在
// 「这批歌是哪来的」,而那是 Rust 侧的事,不是列表的事。
//
// 行内的字段都是**已经格式化好的字符串**:歌手怎么拼、时长怎么写由 Rust 决定
// 并测过(见 types.slint)。

import { TrackRow } from "types.slint";

export component TrackList inherits Flickable {
    in property <[TrackRow]> tracks;
    // 这一批歌是不是某个本地歌单的内容。是的话每行多一个「−」——
    // 从每日推荐里「移除」一首没有意义,那不是一个能改的集合。
    in property <bool> removable: false;

    callback play(string);
    // 点红心。参数是曲目 id 与**点完之后**的状态 —— 让 Rust 再去读一遍当前
    // 状态的话,两边对「现在是红还是没红」的理解就有了两个来源。
    callback toggle-liked(string, bool);
    // 把这一首移出当前歌单。与红心是两件事:红心说的是「我喜欢这首歌」,
    // 共用一个键的话,取消红心时会连带把歌从歌单里删掉。
    callback remove(string);

    vertical-stretch: 1;
    content-height: results.preferred-height;

    results := VerticalLayout {
        spacing: 4px;
        alignment: start;

        // 加载中的那一行自己亮起来,并在行尾标出来。这是用户
        // 手指底下唯一看得见的反馈 —— 没有它,网络一慢人就会连点。
        for row[i] in root.tracks: Rectangle {
            height: 52px;
            background: row.loading ? #d9a86c26
                : (touch.has-hover ? #ffffff14 : #ffffff08);
            border-radius: 8px;
            border-width: row.loading ? 1px : 0;
            border-color: #d9a86c66;
            animate background { duration: 160ms; easing: ease-out; }

            touch := TouchArea {
                clicked => { root.play(row.id); }
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    // 歌名与歌手来自平台,是任意 CJK/日文 ——
                    // 不指定 font-family,落到系统字体。
                    // web 端 wasm 里没有系统字体,那边会是豆腐块,
                    // 已知缺口,见 README「音乐链路」。
                    Text {
                        text: row.title;
                        color: #e6e8ef;
                        font-size: 14px;
                        overflow: elide;
                    }
                    Text {
                        text: row.artists;
                        color: #9aa0b4;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                // 红心。两态画得不一样 —— 都一样的话,点了也不知道成没成。
                heart := TouchArea {
                    width: 32px;

                    Text {
                        text: row.liked ? "♥" : "♡";
                        color: row.liked ? #d96c8a : #6f7688;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // 不冒泡到整行那个 TouchArea —— 否则点红心的同时会把这首歌
                    // 放出来。Slint 里子 TouchArea 先收到点击且不再往下传。
                    clicked => {
                        root.toggle-liked(row.id, !row.liked);
                    }
                }

                // 移出歌单。只在本地歌单详情里出现。
                if root.removable: remove-hit := TouchArea {
                    width: 28px;

                    Text {
                        text: "−";
                        color: #9aa0b4;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // 同红心:不冒泡到整行,否则移除的同时会把这首放出来
                    clicked => { root.remove(row.id); }
                }

                // 时长让位给「加载中」:两个都摆会把歌名挤窄,
                // 而正在加载时时长不是用户在等的信息。
                Text {
                    text: row.loading ? "加载中…" : row.duration;
                    font-family: row.loading ? "Maple Mono NF CN" : "";
                    color: row.loading ? #d9cdbd : #9aa0b4;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
