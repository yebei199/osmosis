// 设置页:分组卡片流(docs/design.md「页面清单」)。
//
// 只摆背后真有东西的组:外观(日夜开关、跟随系统、动态效果)、账号(退出登录)、
// 快捷键、关于。没有数据源的卡不上屏(硬规则 8)。

import { Theme, Type, Radius, Motion, Space, TextSize, Weight, Tracking, Layout } from "theme.slint";
import { Card, CardRow, SectionLabel, Switch, Button, ButtonKind, Kbd } from "widgets.slint";
import { BarMetrics } from "playerbar.slint";
import { DayNight } from "globals/daynight.slint";
import { Icon, Icons } from "icons.slint";
import { UnicatSwitch } from "@unicat/unicat-switch.slint";

export component SettingsPage inherits Flickable {
    // 「Osmosis 0.1.16 · Slint + Bevy」,由 Rust 拼好推进来。
    in property <string> about-line;
    // 档位与升级(#129),语义见 globals/profile.slint。
    in property <string> tier-line;
    in property <string> update-status;
    in property <string> update-action;
    callback update-requested();
    // 「动态效果」开着没有(真相在 api::settings,Rust 写回)。关掉就是减弱动效:
    // 弹簧临界阻尼、不回弹,透镜静止,日夜开关的弹簧也一起收。
    in property <bool> motion-on;
    callback motion-toggled();
    // 主题三档:选了喊一声(0 深 1 浅 2 跟随系统),值由 Rust 写回 Theme.mode。
    callback theme-mode-selected(int);
    // 账号那一行的用户名。
    in property <string> username;
    // 退出登录:清会话是 Rust 的活,这里只喊。
    callback logout();

    // 控制条此刻在不在,条件与 app.slint 摆条那一行是同一个
    // (见 profile.slint 同名属性)。
    in property <bool> bar-visible;

    content-height: column.preferred-height;

    // 日夜开关自己记着 night(拨动时它先翻自己,再喊 toggled)。主题从别处变了
    // (跟随系统、Rust 写回)时,把它对回 Theme.dark —— 绑定在第一次拨动后就断了。
    property <bool> dark-mirror: Theme.dark;
    changed dark-mirror => { theme-switch.night = self.dark-mirror; }

    column := VerticalLayout {
        // 宽窗口里居中(MEO-1878):贴左摆的话,一列之外的右半边全是空白。
        x: max(Layout.page-x-compact, (root.width - self.width) / 2);
        width: min(root.width - Layout.page-x-compact * 2, Layout.column-max);
        alignment: start;
        spacing: 0px;
        padding-top: root.width < Layout.compact ? Layout.page-top-compact : Layout.page-top;
        // 控制条压在页面底部,「检查更新」是这一页常见的最后一个可点项。
        // 页尾本来的那段空气另算:条在时整段 page-reserve 都是额外的。
        padding-bottom: Space.xl + (root.bar-visible ? BarMetrics.page-reserve : 0px);

        Text {
            text: "设置";
            font-weight: Weight.bold;
            font-size: root.width < Layout.compact ? TextSize.display-compact : TextSize.display;
            letter-spacing: root.width < Layout.compact ? Tracking.display-compact : Tracking.display;
            color: Theme.text;
        }

        Rectangle { height: Space.xl; }
        SectionLabel { text: "外观"; }
        Rectangle { height: 10px; }
        Card {
            // 日夜开关是这一组的主视觉:拨 = 显式明 / 暗。跟随系统时它显示当前生效态,
            // 拨动即退出跟随。
            CardRow {
                title: "主题";
                detail: Theme.dark ? "现在是夜晚。拨一下天就亮了,跟随系统打开时由系统决定。"
                    : "现在是白天。拨一下就入夜,跟随系统打开时由系统决定。";
                row-min: 104px;
                VerticalLayout {
                    alignment: center;
                    theme-switch := UnicatSwitch {
                        // 设计稿 196 宽 / 紧凑 140 宽;高按组件自己的 315:143 外框比例。
                        width: root.width < Layout.compact ? 140px : 196px;
                        height: self.width * 143 / 315;
                        night: Theme.dark;
                        label: "深浅主题";
                        tick: DayNight.tick;
                        render(w, h, pad, scale, night, tick) => {
                            return DayNight.render(w, h, pad, scale, night, tick);
                        }
                        input(kind, x) => {
                            return DayNight.input(kind, x);
                        }
                        toggled(night) => {
                            root.theme-mode-selected(night ? 0 : 1);
                        }
                    }
                }
            }
            CardRow {
                title: "跟随系统";
                detail: "目前只有桌面端能读到系统设置";
                VerticalLayout {
                    alignment: center;
                    follow-toggle := Switch {
                        on: Theme.mode == 2;
                        label: "跟随系统";
                        // 退出跟随时落在当前生效的那档,外观不跳变。
                        toggled => {
                            root.theme-mode-selected(Theme.mode == 2
                                ? (Theme.dark ? 0 : 1)
                                : 2);
                        }
                    }
                }
            }
            CardRow {
                title: "动态效果";
                detail: "关掉后弹簧不再回弹,封面镜头静止,省电";
                last: true;
                VerticalLayout {
                    alignment: center;
                    motion-toggle := Switch {
                        on: root.motion-on;
                        label: "动态效果";
                        toggled => { root.motion-toggled(); }
                    }
                }
            }
        }

        Rectangle { height: Space.xl; }
        SectionLabel { text: "账号"; }
        Rectangle { height: 10px; }
        Card {
            HorizontalLayout {
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: Theme.accent;
                        Icon {
                            size: 22px;
                            source: Icons.user-fill;
                            colorize: Theme.accent-text;
                        }
                    }
                }
                signed-in := VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: root.username == "" ? "已登录" : root.username;
                        color: Theme.text;
                        font-size: TextSize.row;
                        overflow: elide;
                    }
                    Text {
                        text: "已登录 · 本设备";
                        color: Theme.text-dim;
                        font-size: TextSize.small;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    logout-button := Button {
                        kind: ButtonKind.secondary;
                        small: true;
                        text: "退出登录";
                        clicked => { root.logout(); }
                    }
                }
            }
        }

        Rectangle { height: Space.xl; }
        SectionLabel { text: "快捷键"; }
        Rectangle { height: 10px; }
        Card {
            CardRow {
                title: "收起播放页";
                last: true;
                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: end;
                    VerticalLayout { alignment: center; Kbd { text: "Esc"; } }
                    VerticalLayout { alignment: center; Kbd { text: "Back"; } }
                }
            }
        }

        Rectangle { height: Space.xl; }
        SectionLabel { text: "关于"; }
        Rectangle { height: 10px; }
        Card {
            CardRow {
                title: root.about-line;
                detail: root.tier-line;
            }
            CardRow {
                detail: root.update-status;
                last: true;
                if root.update-action != "": VerticalLayout {
                    alignment: center;
                    update-button := Button {
                        kind: ButtonKind.secondary;
                        small: true;
                        text: root.update-action;
                        clicked => { root.update-requested(); }
                    }
                }
            }
        }
    }
}
