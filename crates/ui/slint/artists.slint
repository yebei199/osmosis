// 歌手列表。搜索结果的「歌手」页签摆它。
//
// 与 PlaylistList 长得像,但不是同一个:歌单行要标来源(同名的本地歌单与收藏
// 来的能做的事不同),歌手只有平台一个来源,没有那一栏。硬合成一个的话,
// 那个来源标记就得靠一个恒为假的值关掉,而那种字段迟早有人当真。
//
// 点一位歌手出的是他此刻的热门曲目,不是全部作品 —— 平台给的就是那几首。

import { ListView } from "std-widgets.slint";
import { ArtistRow } from "types.slint";
import { Theme, Radius, Motion, Space, TextSize } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { Shell } from "globals/shell.slint";

export component ArtistList inherits ListView {
    in property <[ArtistRow]> artists;

    callback open(string, string);

    vertical-stretch: 1;

    for row[i] in root.artists: line := Rectangle {
        // 与曲目行同一套:不画框,宽版式悬停垫 hover。
        property <bool> hovered: touch.has-hover && !Shell.compact;
        height: Shell.compact ? 64px : 56px;

        Rectangle {
            border-radius: Radius.sm;
            background: line.hovered ? Theme.hover : transparent;
            animate background { duration: Motion.fast; easing: Motion.ease; }
        }

        touch := TouchArea {
            // 名字一起传:详情页的标题要它,而那一层拿不到这一行。
            clicked => { root.open(row.id, row.name); }
        }

        HorizontalLayout {
            padding-left: Space.sm;
            padding-right: Space.sm;
            spacing: Space.md;

            // 平台不给歌手头像,这里只画一枚圆形的占位:列表左缘与歌单、曲目对齐。
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.surface;
                    Icon {
                        size: 20px;
                        source: Icons.user;
                        colorize: Theme.text-faint;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;

                Text {
                    text: row.name;
                    color: Theme.text;
                    font-size: TextSize.row;
                    overflow: elide;
                }
                Text {
                    text: row.subtitle;
                    color: Theme.text-dim;
                    font-size: TextSize.small;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;
                Icon {
                    size: 18px;
                    source: Icons.caret-right;
                    colorize: Theme.text-faint;
                }
            }
        }
    }
}
