// 进度与音量:控制条下缘那道细轨,以及抽屉里的音量滑块。
//
// 两者共用同一套「按下即拖、松手才喊」的手势 —— 拖动中只动本地镜像,
// 松手才把最终比例交出去,免得一次拖动打出几十次请求。
// (音量是例外:每动一下就该听见,那正是人调音量时在等的反馈。)

import { Theme, Space, Radius, Motion, Type, TextSize } from "theme.slint";
import { Icon, Icons } from "icons.slint";


// 进度条:已放到哪、还能拖。
//
// 拖动期间**手指说了算**:位置每秒由 Rust 推一次,拖的时候要让位给手指,
// 否则滑块会在手指底下自己往回跳。松手才把最终位置交出去 —— 拖动过程中
// 每帧都 seek 一次,等于让解码器跟着手指来回跑。
export component ProgressBar inherits Rectangle {
    // 已放到全曲的几分之几,0..=1。由 Rust 夹好(见 ui/src/progress.rs)。
    in property <float> ratio;
    // 「1:23 / 3:41」,同样已在 Rust 侧排好。
    in property <string> text;
    // 跳转还没落地。占的是时间那一行 —— 缓冲期间位置本来就不动,
    // 让一个僵住的数字待在那里,恰恰是最像卡死的样子。
    in property <bool> buffering: false;
    // 细轨档:进度的常态显示已由环形键承担,这条只管**精确拖动**,
    // 悬停或拖动时才现形,时间行也不画(时间在条身上)。
    in property <bool> slim: false;
    // 细轨常驻。触屏没有悬停,一条要指过来才现形的轨道在手机上等于不存在。
    in property <bool> pinned: false;

    // 松手时交出去的位置,仍是 0..=1。
    callback seek(float);

    // 拖动中,以及手指当前落在哪。Rust 不关心手指的过程,只要松手那一下的值。
    property <bool> dragging: false;
    property <float> drag-ratio: 0;
    // 画出来的那个值:拖动时用手指的,否则用每秒推来的。
    //
    // **这一行没有测试盖着。** 无头测试驱动不了真实指针,而这个组件既不是
    // 独立编译的类型、又长在一个 `if` 里,Rust 侧引用不到它的属性。写成一个
    // 声明式表达式而不是在 moved 里赋值,是为了让它没有"忘了某条路径"的余地 ——
    // 但那是靠形状,不是靠断言。改这里要手动验:拖住不放,看滑块会不会自己往回跳。
    property <float> shown: root.dragging ? root.drag-ratio : root.ratio;

    height: root.slim ? 14px : 26px;

    VerticalLayout {
        alignment: root.slim ? center : start;
        spacing: Space.xs;

        groove := Rectangle {
            height: root.slim ? 3px : 4px;
            background: Theme.line-strong;
            border-radius: Radius.pill;
            // 细轨档平时隐身,指过来或拖着才现形 —— 环形键已经报着进度,
            // 这条只在要精确落点的那一刻出现。
            opacity: !root.slim || root.pinned || seek-touch.has-hover || root.dragging ? 1 : 0;
            animate opacity { duration: Motion.fast; easing: Motion.ease; }

            Rectangle {
                x: 0;
                width: parent.width * clamp(root.shown, 0.0, 1.0);
                height: parent.height;
                background: Theme.accent;
                border-radius: Radius.pill;
            }
            // 把手:悬停或拖着时才出现,9px 的圆点。
            if seek-touch.has-hover || root.dragging: Rectangle {
                width: 9px;
                height: 9px;
                x: parent.width * clamp(root.shown, 0.0, 1.0) - self.width / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 4.5px;
                background: Theme.text;
                drop-shadow-offset-y: 1px;
                drop-shadow-blur: 3px;
                drop-shadow-color: #00000080;
            }
        }

        if !root.slim: Text {
            text: root.buffering ? "缓冲中…" : root.text;
            // 缓冲时提亮:这一行在别的时候是背景信息,那一刻却是唯一
            // 说明「还在动」的东西。
            color: root.buffering ? Theme.accent : Theme.text-dim;
            font-size: TextSize.caption;
            horizontal-alignment: center;
        }
    }

    // 覆在整块上,比那条 4px 的槽好点得多 —— 手指按不准 4 个像素。
    // 起个 id(#157 F-002):e2e 脚本要靠它精确拖到曲尾附近,验证「播满」
    // 记为完播;别处不靠 id 找它,改名不影响功能。
    seek-touch := TouchArea {
        mouse-cursor: pointer;

        moved => {
            root.dragging = true;
            root.drag-ratio = clamp(self.mouse-x / root.width, 0.0, 1.0);
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                // 没拖过就是点了一下:点哪跳哪
                root.seek(root.dragging
                    ? root.drag-ratio
                    : clamp(self.mouse-x / root.width, 0.0, 1.0));
                root.dragging = false;
            }
        }
    }
}

// 音量:一颗喇叭键,点开就地展开滑块。
//
// 不常驻滑块:控制条宽版一排的最小宽度已经约 470px,而手机内容区只有 ~360px
// (那正是紧凑版拆两行的原因)。再塞一条常驻滑块进去,两种版式都要重排。
// 抽屉里那份(`expanded` + `fill`)是一整行:小喇叭、拉满的滑块、大喇叭、数字。
export component VolumeControl inherits HorizontalLayout {
    in property <float> volume;
    // 滑块常驻。抽屉里有横向空间,不必让人先点开喇叭再拖 —— 那一层
    // 折叠是当初为一排塞不下才有的,抽屉里没有那个约束。
    in property <bool> expanded: false;
    // 滑块拉满这一行,后面跟大喇叭和数字(抽屉那一行)。
    in property <bool> fill: false;
    // 读屏念的名字。输出设备那一排每台一个,得念得出是哪一台的(#151)。
    in property <string> label: "音量";
    callback changed(float);

    property <bool> open: false;

    spacing: root.fill ? Space.md : Space.xs;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: Radius.pill;
            background: speaker.has-hover ? Theme.hover : transparent;

            // 三态:静音 / 小声 / 大声。都一样的话,调完了看不出调没调。
            Icon {
                source: root.volume <= 0.001 ? Icons.speaker-x
                    : root.volume < 0.5 || root.fill ? Icons.speaker-low : Icons.speaker-high;
                colorize: Theme.text-dim;
            }

            speaker := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open = !root.open; }

                // 屏幕阅读器要认得出这是个能按的东西;顺带让无头测试点得动它 ——
                // 少了这一段,测试只能验"键在不在",验不了"点开之后展开没有"。
                accessible-role: button;
                accessible-label: root.label;
                accessible-expandable: true;
                accessible-expanded: root.open;
                accessible-action-default => {
                    root.open = !root.open;
                }
            }
        }
    }

    if root.open || root.expanded: VerticalLayout {
        alignment: center;
        horizontal-stretch: root.fill ? 1 : 0;

        slider := Rectangle {
            min-width: 92px;
            max-width: root.fill ? 100000px : 92px;
            horizontal-stretch: 1;
            height: 20px;

            Rectangle {
                y: (parent.height - 4px) / 2;
                height: 4px;
                background: Theme.line-strong;
                border-radius: Radius.pill;

                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.volume, 0.0, 1.0);
                    height: parent.height;
                    background: Theme.text;
                    border-radius: Radius.pill;
                }
            }
            // 把手:白色的圆,压一道影。
            Rectangle {
                width: 16px;
                height: 16px;
                x: parent.width * clamp(root.volume, 0.0, 1.0) - self.width / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: #ffffff;
                drop-shadow-offset-y: 2px;
                drop-shadow-blur: 6px;
                drop-shadow-color: #00000073;
            }

            // 音量没有「松手才生效」的问题:每动一下就该听见,
            // 那正是人调音量时在等的反馈。
            drag := TouchArea {
                mouse-cursor: pointer;
                moved => {
                    root.changed(clamp(self.mouse-x / slider.width, 0.0, 1.0));
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.changed(clamp(self.mouse-x / slider.width, 0.0, 1.0));
                    }
                }
            }
        }
    }

    if root.fill: VerticalLayout {
        alignment: center;
        Icon {
            source: Icons.speaker-high;
            colorize: Theme.text-dim;
        }
    }
    if root.fill: Text {
        width: 28px;
        text: round(clamp(root.volume, 0.0, 1.0) * 100);
        color: Theme.text-dim;
        font-size: TextSize.small;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// 竖向进度滑条(#75)已退场:播放页曾经同时有它与条上那道细轨,
// 两套槽宽、颜色、把手规则,而 seek 只该有一个面(docs/adr/0029)。
