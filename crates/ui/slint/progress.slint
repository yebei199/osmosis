// 进度与音量:横向进度条、音量条,以及播放页那条竖向滑条。
//
// 三者共用同一套「按下即拖、松手才喊」的手势 —— 拖动中只动本地镜像,
// 松手才把最终比例交出去,免得一次拖动打出几十次请求。

// 常驻控制条那一簇:播放控制与同播条。
//
// 它们是「正在播放」这个状态的操作面,与页面内容无关 —— 播放页展开时,
// 覆层里的另一份实例走同一组回调(见 docs/adr/0010 的「功能等价路径」)。

import { DeviceRow } from "types.slint";
import { Theme } from "theme.slint";
import { HoverButton, RoundControl, OutlinedText } from "widgets.slint";


// 进度条:已放到哪、还能拖。
//
// 拖动期间**手指说了算**:位置每秒由 Rust 推一次,拖的时候要让位给手指,
// 否则滑块会在手指底下自己往回跳。松手才把最终位置交出去 —— 拖动过程中
// 每帧都 seek 一次,等于让解码器跟着手指来回跑。
export component ProgressBar inherits Rectangle {
    // 已放到全曲的几分之几,0..=1。由 Rust 夹好(见 ui/src/progress.rs)。
    in property <float> ratio;
    // 「1:23 / 3:41」,同样已在 Rust 侧排好。
    in property <string> text;
    // 跳转还没落地。占的是时间那一行 —— 缓冲期间位置本来就不动,
    // 让一个僵住的数字待在那里,恰恰是最像卡死的样子。
    in property <bool> buffering: false;
    // 细轨档:进度的常态显示已由环形键承担,这条只管**精确拖动**,
    // 悬停或拖动时才现形,时间行也不画(时间在条身上)。
    in property <bool> slim: false;
    // 细轨常驻。触屏没有悬停,一条要指过来才现形的轨道在手机上等于不存在。
    in property <bool> pinned: false;

    // 松手时交出去的位置,仍是 0..=1。
    callback seek(float);

    // 拖动中,以及手指当前落在哪。Rust 不关心手指的过程,只要松手那一下的值。
    property <bool> dragging: false;
    property <float> drag-ratio: 0;
    // 画出来的那个值:拖动时用手指的,否则用每秒推来的。
    //
    // **这一行没有测试盖着。** 无头测试驱动不了真实指针,而这个组件既不是
    // 独立编译的类型、又长在一个 `if` 里,Rust 侧引用不到它的属性。写成一个
    // 声明式表达式而不是在 moved 里赋值,是为了让它没有"忘了某条路径"的余地 ——
    // 但那是靠形状,不是靠断言。改这里要手动验:拖住不放,看滑块会不会自己往回跳。
    property <float> shown: root.dragging ? root.drag-ratio : root.ratio;

    height: root.slim ? 14px : 26px;

    VerticalLayout {
        alignment: root.slim ? center : start;
        spacing: 3px;

        groove := Rectangle {
            height: 4px;
            background: Theme.overlay;
            border-radius: 2px;
            // 细轨档平时隐身,指过来或拖着才现形 —— 环形键已经报着进度,
            // 这条只在要精确落点的那一刻出现。
            opacity: !root.slim || root.pinned || touch.has-hover || root.dragging ? 1 : 0;
            animate opacity { duration: 120ms; easing: ease-out; }

            Rectangle {
                x: 0;
                width: parent.width * clamp(root.shown, 0.0, 1.0);
                height: parent.height;
                background: Theme.accent;
                border-radius: 2px;
            }
        }

        if !root.slim: Text {
            text: root.buffering ? "缓冲中…" : root.text;
            font-family: "Maple Mono NF CN";
            // 缓冲时提亮:这一行在别的时候是背景信息,那一刻却是唯一
            // 说明「还在动」的东西。
            color: root.buffering ? Theme.accent : Theme.text-dim;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }

    // 覆在整块上,比那条 4px 的槽好点得多 —— 手指按不准 4 个像素。
    touch := TouchArea {
        mouse-cursor: pointer;

        moved => {
            root.dragging = true;
            root.drag-ratio = clamp(self.mouse-x / root.width, 0.0, 1.0);
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                // 没拖过就是点了一下:点哪跳哪
                root.seek(root.dragging
                    ? root.drag-ratio
                    : clamp(self.mouse-x / root.width, 0.0, 1.0));
                root.dragging = false;
            }
        }
    }
}

// 音量:一颗喇叭键,点开就地展开滑块。
//
// 不常驻滑块:控制条宽版一排的最小宽度已经约 470px,而手机内容区只有 ~360px
// (那正是紧凑版拆两行的原因)。再塞一条常驻滑块进去,两种版式都要重排。
export component VolumeControl inherits HorizontalLayout {
    in property <float> volume;
    callback changed(float);

    property <bool> open: false;

    spacing: 6px;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: speaker.has-hover ? Theme.overlay : transparent;

            Text {
                // 三态:静音 / 小声 / 大声。都一样的话,调完了看不出调没调。
                text: root.volume <= 0.001 ? "🔇"
                    : root.volume < 0.5 ? "🔈" : "🔊";
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            speaker := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open = !root.open; }

                // 屏幕阅读器要认得出这是个能按的东西;顺带让无头测试点得动它 ——
                // 少了这一段,测试只能验"键在不在",验不了"点开之后展开没有"
                // (同 widgets.slint 里的 HoverButton)。
                accessible-role: button;
                accessible-label: "音量";
                accessible-expandable: true;
                accessible-expanded: root.open;
                accessible-action-default => {
                    root.open = !root.open;
                }
            }
        }
    }

    if root.open: VerticalLayout {
        alignment: center;

        slider := Rectangle {
            width: 92px;
            height: 20px;

            Rectangle {
                y: (parent.height - 4px) / 2;
                height: 4px;
                background: Theme.overlay;
                border-radius: 2px;

                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.volume, 0.0, 1.0);
                    height: parent.height;
                    background: Theme.accent;
                    border-radius: 2px;
                }
            }

            // 音量没有「松手才生效」的问题:每动一下就该听见,
            // 那正是人调音量时在等的反馈。
            drag := TouchArea {
                mouse-cursor: pointer;
                moved => {
                    root.changed(clamp(self.mouse-x / slider.width, 0.0, 1.0));
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.changed(clamp(self.mouse-x / slider.width, 0.0, 1.0));
                    }
                }
            }
        }
    }
}

// 播放页右侧的竖向进度滑条(#75)。进度从控制簇里剥出来单独成条:
// 环形键继续报比例,精确落点交给这条,时间读数跟着搬过来。
//
// 从**顶**往下填:时间线读下来,与滚动条同一个心智模型。
export component VerticalSeekBar inherits Rectangle {
    // 已放到全曲的几分之几,0..=1。由 Rust 夹好(见 ui/src/progress.rs)。
    in property <float> ratio: 0;
    // 「1:23 / 3:41」,同样已在 Rust 侧排好。
    in property <string> text;
    in property <bool> buffering: false;

    // 松手时交出去的位置,仍是 0..=1。界面不自己置位:位置的真相在播放器,
    // 先斩后奏会在 seek 失败时留下一个骗人的进度。
    callback seek(float);

    property <bool> dragging: false;
    property <float> drag-ratio: 0;
    property <float> shown: root.dragging ? root.drag-ratio : clamp(root.ratio, 0.0, 1.0);
    // 手指按不准 6 个像素,整条的宽度是触控面,轨道只是它中间那道。
    width: 44px;

    // 读屏与键盘的入口。一条只能用手指拖的进度条,对这两类用户等于不存在。
    accessible-role: slider;
    accessible-label: root.buffering ? "缓冲中…" : root.text;
    accessible-value: root.shown;
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;
    accessible-value-step: 0.05;
    accessible-action-set-value(v) => { root.seek(clamp(v.to-float(), 0.0, 1.0)); }
    accessible-action-increment => { root.seek(clamp(root.shown + 0.05, 0.0, 1.0)); }
    accessible-action-decrement => { root.seek(clamp(root.shown - 0.05, 0.0, 1.0)); }

    groove := Rectangle {
        width: 6px;
        height: 100%;
        // 暗底而不是 `Theme.overlay`:那是一层 8% 的白,压在亮封面的点云上
        // 一点也看不见(小米13 真机实拍)。这一层要在任何背景上都自带对比。
        background: Theme.immersive.with-alpha(0.55);
        border-radius: 3px;

        fill := Rectangle {
            y: 0;
            width: parent.width;
            height: parent.height * root.shown;
            background: root.buffering ? Theme.immersive-accent : Theme.accent;
            border-radius: parent.border-radius;
        }

        // 拖动把手:只在指过来或拖着时现形,平时那道 6px 的轨道自己就够读。
        Rectangle {
            y: parent.height * root.shown - self.height / 2;
            width: 14px;
            height: 14px;
            x: (parent.width - self.width) / 2;
            border-radius: self.width / 2;
            background: Theme.accent;
            opacity: touch.has-hover || root.dragging ? 1 : 0;
            animate opacity { duration: 120ms; easing: ease-out; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;

        moved => {
            root.dragging = true;
            root.drag-ratio = clamp(self.mouse-y / root.height, 0.0, 1.0);
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                // 没拖过就是点了一下:点哪跳哪。
                root.seek(root.dragging
                    ? root.drag-ratio
                    : clamp(self.mouse-y / root.height, 0.0, 1.0));
                root.dragging = false;
            }
        }
    }
}
