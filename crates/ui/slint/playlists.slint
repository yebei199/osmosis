// 歌单列表。
//
// 两种来源一张列表,靠 `source` 区分(见 docs/adr/0016)。「我喜欢的」在最前、
// 不可删 —— 它就是平台的红心列表,不是本地副本。
//
// 每行右侧标出来源,因为同名的本地歌单与收藏来的歌单看上去一模一样,
// 而它们能做的事不同。

import { ListView } from "std-widgets.slint";
import { PlaylistRow } from "types.slint";
import { Theme } from "theme.slint";

export component PlaylistList inherits ListView {
    in property <[PlaylistRow]> playlists;

    callback open(string, int);

    for row[i] in root.playlists: Rectangle {
        height: 60px;

        // 与曲目行同一条:ListView 没有 spacing,4px 的间隔靠卡片上下各让 2px。
        Rectangle {
            y: 2px;
            height: 56px;
            background: touch.has-hover ? Theme.overlay : Theme.overlay-weak;
            border-radius: 8px;
            animate background { duration: 160ms; easing: ease-out; }
        }

        touch := TouchArea {
            clicked => { root.open(row.id, row.source); }
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;

            // 封面。取不到就是一块占位色 —— 留个空洞会让整列参差不齐,
            // 而封面取不到是常态(CDN 会过期)。
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 6px;
                    background: Theme.divider;
                    clip: true;

                    if row.cover.width > 0: Image {
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                        source: row.cover;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                // 歌单名来自平台或用户,是任意 CJK —— 不指定 font-family,
                // 落到系统字体(与曲目行同一个理由)。
                Text {
                    text: row.name;
                    color: Theme.text;
                    font-size: 14px;
                    overflow: elide;
                }
                Text {
                    text: row.subtitle;
                    font-family: "Maple Mono NF CN";
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
            }

            // 只读徽标。平台侧的歌单(红心与收藏)真相在平台,这边只能看
            // (`playlist::is_editable`,docs/adr/0016)—— 摆出来,右键菜单里
            // 少了改名/删除才不显得像坏了。本地歌单没有徽标。
            if row.source != 2: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: badge.preferred-width + 16px;
                    height: 22px;
                    border-radius: 11px;
                    background: Theme.overlay;
                    badge := Text {
                        text: "只读";
                        font-family: "Maple Mono NF CN";
                        color: Theme.text-faint;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // 来源标记。同名的本地歌单与收藏来的歌单看上去一样,
            // 但能做的事不同 —— 不标的话,删除键出现在哪一行全靠猜。
            Text {
                text: row.source == 0 ? "红心"
                    : row.source == 2 ? "本地" : "平台";
                font-family: "Maple Mono NF CN";
                color: Theme.text-faint;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}
