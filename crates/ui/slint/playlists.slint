// 歌单列表。
//
// 两种来源一张列表,靠 `source` 区分(见 docs/adr/0016)。「我喜欢的」在最前、
// 不可删 —— 它就是平台的红心列表,不是本地副本。
//
// 每行右侧标出来源,因为同名的本地歌单与收藏来的歌单看上去一模一样,
// 而它们能做的事不同。

import { ListView } from "std-widgets.slint";
import { PlaylistRow } from "types.slint";
import { Theme, Radius, Motion, Space, TextSize } from "theme.slint";
import { Tag } from "widgets.slint";
import { Icon, Icons } from "icons.slint";
import { Shell } from "globals/shell.slint";

export component PlaylistList inherits ListView {
    in property <[PlaylistRow]> playlists;

    callback open(string, int);

    for row[i] in root.playlists: line := Rectangle {
        // 与曲目行同一套:行本身不画框,只在宽版式悬停时垫一层 hover。
        // 触屏没有悬停,紧凑版式不留这一档。
        property <bool> hovered: touch.has-hover && !Shell.compact;
        height: Shell.compact ? 72px : 64px;

        Rectangle {
            border-radius: Radius.sm;
            background: line.hovered ? Theme.hover : transparent;
            animate background { duration: Motion.fast; easing: Motion.ease; }
        }

        touch := TouchArea {
            accessible-role: button;
            accessible-label: row.name;
            accessible-action-default => { root.open(row.id, row.source); }
            clicked => { root.open(row.id, row.source); }
        }

        HorizontalLayout {
            padding-left: Space.sm;
            padding-right: Space.sm;
            spacing: Space.md;

            // 封面。取不到就是一块占位色 —— 留个空洞会让整列参差不齐,
            // 而封面取不到是常态(CDN 会过期)。
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: Radius.sm;
                    background: Theme.surface;
                    clip: true;

                    if row.cover.width > 0: Image {
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                        source: row.cover;
                    }
                    if row.cover.width == 0: Icon {
                        size: 22px;
                        source: Icons.playlist;
                        colorize: Theme.text-faint;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;

                Text {
                    text: row.name;
                    color: Theme.text;
                    font-size: TextSize.row;
                    overflow: elide;
                }
                // 来源写在副标题里:同名的本地歌单与收藏来的歌单看上去一样,
                // 但能做的事不同 —— 不标的话,删除键出现在哪一行全靠猜。
                Text {
                    text: (row.source == 0 ? "红心" : row.source == 2 ? "本地" : "平台")
                        + " · " + row.subtitle;
                    color: Theme.text-dim;
                    font-size: TextSize.small;
                    overflow: elide;
                }
            }

            // 只读徽标。平台侧的歌单(红心与收藏)真相在平台,这边只能看
            // (`playlist::is_editable`,docs/adr/0016)—— 摆出来,右键菜单里
            // 少了改名/删除才不显得像坏了。本地歌单没有徽标。
            if row.source != 2: VerticalLayout {
                alignment: center;
                Tag { text: "只读"; }
            }

            VerticalLayout {
                alignment: center;
                Icon {
                    size: 18px;
                    source: Icons.caret-right;
                    colorize: Theme.text-faint;
                }
            }
        }
    }
}
