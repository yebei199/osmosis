// 歌单列表。
//
// 两种来源一张列表,靠 `source` 区分(见 docs/adr/0016)。「我喜欢的」在最前、
// 不可删 —— 它就是平台的红心列表,不是本地副本。
//
// 每行右侧标出来源,因为同名的本地歌单与收藏来的歌单看上去一模一样,
// 而它们能做的事不同。

import { PlaylistRow } from "types.slint";

export component PlaylistList inherits Flickable {
    in property <[PlaylistRow]> playlists;

    callback open(string, int);

    content-height: rows.preferred-height;

    rows := VerticalLayout {
        spacing: 4px;
        alignment: start;

        for row[i] in root.playlists: Rectangle {
            height: 56px;
            background: touch.has-hover ? #ffffff14 : #ffffff08;
            border-radius: 8px;
            animate background { duration: 160ms; easing: ease-out; }

            touch := TouchArea {
                clicked => { root.open(row.id, row.source); }
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    // 歌单名来自平台或用户,是任意 CJK —— 不指定 font-family,
                    // 落到系统字体(与曲目行同一个理由)。
                    Text {
                        text: row.name;
                        color: #e6e8ef;
                        font-size: 14px;
                        overflow: elide;
                    }
                    Text {
                        text: row.subtitle;
                        font-family: "Maple Mono NF CN";
                        color: #9aa0b4;
                        font-size: 12px;
                        overflow: elide;
                    }
                }

                // 来源标记。同名的本地歌单与收藏来的歌单看上去一样,
                // 但能做的事不同 —— 不标的话,删除键出现在哪一行全靠猜。
                Text {
                    text: row.source == 0 ? "红心"
                        : row.source == 2 ? "本地" : "平台";
                    font-family: "Maple Mono NF CN";
                    color: #6f7688;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
