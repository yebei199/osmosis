// 界面与 Rust 之间的数据形状。
//
// 单独成文件是因为它们被多处引用:主窗口摆列表要用,控制条里的同播条也要用 ——
// 留在 app.slint 里的话,controls.slint 引它就会让两个文件互相 import 成环。
//
// 字段一律是**已经格式化好的字符串**:歌手怎么拼、时长怎么写由 Rust 侧决定
// 并测过,`.slint` 里不做任何计算。

// 导航的三项。**唯一真相** —— 侧栏(宽版式)和底栏(紧凑版式)都 `for` 它,
// 免得两处各抄一份图标 path,改了一处忘另一处。
export struct NavEntry {
    label: string,
    icon: string, // SVG path 数据,viewbox 24×24
}

// 搜索结果里的一行。字段都是**已经格式化好的字符串** —— 歌手怎么拼、时长怎么写
// 由 Rust 侧决定并测过,`.slint` 里不做任何计算。
export struct TrackRow {
    id: string,
    title: string,
    artists: string,
    duration: string,
    // 这一首正在加载。网络慢时点了看不出反应,用户就会连点 —— 状态行那句
    // 「加载中…」在列表上方、13px 灰字,离手指太远(见 crates/ui/src/music.rs)。
    loading: bool,
    // 这一首在红心列表里。由 Rust 拿红心的全量标识比对后填(见 ui/src/liked.rs)——
    // 服务端给的曲目本身不带这个字段,那要让每个列表接口都多问一次上游。
    liked: bool,
}

// 同播名册里的一台设备。名字由对端自报,是任意文本 —— 与歌名同理,
// 这里不指定子集字体。
// 歌单列表里的一行。
//
// `source` 是编号而不是枚举:Slint 的枚举跨不到 Rust 那边来,而这个值要在
// 两侧对齐(见 ui/src/playlist.rs 的 Source)。0=我喜欢的、1=平台、2=本地。
export struct PlaylistRow {
    id: string,
    name: string,
    // 「12 首」或「暂无曲目」,已在 Rust 侧格式化好。
    subtitle: string,
    source: int,
}

// 搜索结果里的一位歌手。
//
// 没有 source:歌手只有平台一个来源,自家不造歌手。副标题(专辑数)已在
// Rust 侧格式化好,与 PlaylistRow 同理。
export struct ArtistRow {
    id: string,
    name: string,
    subtitle: string,
}

export struct DeviceRow {
    id: string,
    name: string,
}
