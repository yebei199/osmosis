import { Palette } from "std-widgets.slint";

import { Theme, Type } from "theme.slint";
import { LyricRow } from "types.slint";
import { OutlinedText } from "widgets.slint";
import { PlayerBar } from "playerbar.slint";
import { LyricsPage } from "lyrics.slint";
import { Player } from "globals/player.slint";
import { Shell } from "globals/shell.slint";
import { Viz } from "globals/viz.slint";

// 播放页:盖住包括导航在内的整个窗口的全屏沉浸层(CONTEXT.md「播放页」)。
//
// 五层合成:warp 背景 → 封面点云 → 标注卡 → 遮挡层(裁到标注卡)→ 控制簇。
// 标注卡是深度卡片:遮挡层只含比它更近的粒子,盖上来就是「粒子从卡前面掠过」。
// 歌名与歌词不走这条,它们画在粒子之上(docs/adr/0010 的「歌词是例外」)。
// 功能(控制簇)永远在最上层 2D、点得到 —— docs/adr/0010。
//
// 安全区由外面传进来:`safe-area-insets` 只有 `Window` 有,组件拿不到。
// 其余状态一律走 global,不从窗口根转发(见 docs/adr/0027)。
export component PlayPage inherits FocusScope {
    in property <length> safe-left;
    in property <length> safe-right;
    in property <length> safe-top;
    in property <length> safe-bottom;
    // 控制条内缩,由窗口根给 —— 全应用一个数。
    in property <length> bar-inset: 24px;

    // 歌词块的几何量,逻辑像素。**这里是唯一真相**:歌词摆位与遮挡层的裁剪
    // 负偏移都从这几个值算,别在别处重抄。
    //
    // 歌词块的高度**钉死**,不随文本长度变。平台会把整段词压成「一行」(实测见过
    // 198 字符的行),放任折行会撑破布局、压到控制条上;超出的部分省略号收掉。
    out property <length> viz-lyric-line-h: Shell.compact ? 84px : 120px;
    out property <length> viz-lyric-tr-h: Shell.compact ? 40px : 46px;
    out property <length> viz-lyric-h: root.viz-lyric-line-h + 10px + root.viz-lyric-tr-h;
    out property <length> viz-lyric-y: (root.height - root.viz-lyric-h) / 2 + 60px;
    // 歌名与歌手在歌词块上方,与它一起居中成一组。
    out property <length> viz-title-y: root.viz-lyric-y - 96px;

    // 抢焦点是这层能收到按键的前提 —— 焦点留在搜索框上的话,下面那个
    // key-pressed 一次都不会触发。
    init => { self.focus(); }

    // 安卓的返回键、桌面的 Esc:都先收起播放页。
    //
    // 安卓那条不是锦上添花 —— 上游把 Back 派成 Key.Back,**只有我们不接**
    // 才去 finish_activity()(见 slint 的 android-activity 后端
    // callback_on_back_invoked)。不接就是「按返回直接退应用」,而播放页是
    // 全屏沉浸层,那不是任何人对返回的预期。
    key-pressed(event) => {
        if (event.text == Key.Back || event.text == Key.Escape) {
            Shell.play-page-open = false;
            return accept;
        }
        return reject;
    }

  Rectangle {
    // 纯深色底。反馈 warp 曾铺在这里当全屏背景,现在收进了播放键 ——
    // 封面点云自己就有颜色,再叠两圈青紫只是把主体糊掉。
    background: Theme.immersive;

    // 封面点云:透明底,叠在 warp 上。远侧粒子在这层被歌词盖住,
    // 近侧粒子由下面的遮挡层重新盖回字之上 —— 深度由此闭环。
    if Viz.viz-scene.width > 0: Image {
        width: 100%;
        height: 100%;
        image-fit: fill;
        source: Viz.viz-scene;
        // 歌词页打开时退成背景光:整页字压在一片满亮的粒子上读不动(#73)。
        opacity: Viz.lyrics-page-open ? 0.3 : 1.0;
        animate opacity { duration: 260ms; easing: ease-out; }
    }

    // §8 的扫描线与噪点 2026-08-13 定为去除(#74):复古质感与产品方向不合。
    // vignette 留下 —— 它是把注意力拢回中心的手段,与复古无关。
    Rectangle {
        width: 100%;
        height: 100%;
        background: @radial-gradient(circle, transparent 55%, Theme.shadow.with-alpha(0.20) 100%);
    }

    // 世界空间标注卡(docs/note/vision.md「下一面旗子」)。锚点是封面点云上的
    // 一个局部点,点云被拖着自转时它跟着转,卡片于是跟着物体走而不是钉在画面
    // 某处。转出画面就整块收起,不贴边钳制 —— 粘在屏幕边缘的卡片是在假装
    // 自己还指着那个物体。
    // 歌词页打开时整块让位:点云已退成背景光,卡片再浮着就是标一个
    // 看不见的物体。
    if Viz.viz-anchor-visible && !Viz.lyrics-page-open: Rectangle {
        width: 100%;
        height: 100%;

        viz-anchor-card := Rectangle {
            // 中心挂在锚点上:挂左上角的话卡片整体偏出半个身位,就指不准了。
            //
            // 再钳进窗口内。锚点在画面里不等于卡片在画面里 —— 锚点是卡片的
            // 中心,它贴着边时卡片已经探出去半个身位了(真机实拍切掉过右边
            // 约 20%)。轨道半径按竖屏算过,正常不会碰到这道钳位;窗口更窄时
            // 它兜住,代价是卡片在极端处会与锚点脱开一点。
            x: Math.clamp(Viz.viz-anchor-x * root.width - self.width / 2,
                          0px, max(0px, root.width - self.width));
            y: Math.clamp(Viz.viz-anchor-y * root.height - self.height / 2,
                          0px, max(0px, root.height - self.height));
            width: Shell.compact ? 132px : 160px;
            height: 36px;
            border-radius: 10px;
            background: Theme.immersive.with-alpha(0.62);
            border-width: 1px;
            border-color: Theme.immersive-text.with-alpha(0.22);

            Text {
                width: parent.width - 20px;
                text: Viz.now-title;
                color: Theme.immersive-text;
                font-size: 13px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        // 遮挡层裁到卡片自己。那张图铺的是整个视口,只有卡片这一块该露出来,
        // 不裁就是把整幅点云盖在播放页上。图内偏移取负的卡片位置,于是它与
        // 下面那层点云逐像素对齐,卡片被更近的粒子挡住(docs/adr/0010)。
        if Viz.viz-occluder.width > 0: viz-anchor-occluder := Rectangle {
            x: viz-anchor-card.x;
            y: viz-anchor-card.y;
            width: viz-anchor-card.width;
            height: viz-anchor-card.height;
            clip: true;

            Image {
                x: -parent.x;
                y: -parent.y;
                width: root.width;
                height: root.height;
                image-fit: fill;
                source: Viz.viz-occluder;
            }
        }
    }

    // 视觉区的指针:位置归一化后交给点云(见 crates/render3d::cloud),
    // **不**收起播放页 —— 点这里是在拨弄粒子,收起走控制簇里的向下三角。
    // 压在视觉之上、内容之下;控制键各有自己的 TouchArea,不会误触到这层。
    TouchArea {
        moved => {
            Viz.viz-pointer-x = self.mouse-x / root.width;
            Viz.viz-pointer-y = self.mouse-y / root.height;
            Viz.viz-pointer-down = self.pressed;
        }
        pointer-event(event) => {
            Viz.viz-pointer-x = self.mouse-x / root.width;
            Viz.viz-pointer-y = self.mouse-y / root.height;
            Viz.viz-pointer-down = self.pressed;
            Viz.viz-pointer-active = event.kind != PointerEventKind.up;
        }
    }

    // 歌名与歌手:歌词块上方。平台数据任意 CJK,不指定子集字体。
    // 歌词页打开时整组让位 —— 它们与歌词页画在同一片区域,留着就是两层字
    // 叠在一起(小米13 真机实拍)。
    if !Viz.lyrics-page-open: play-title := OutlinedText {
        y: root.viz-title-y;
        width: 100%;
        height: 42px;
        text: Viz.now-title;
        text-color: Theme.immersive-text;
        // display 字体只有拉丁字形;中文歌名按字形回退,得到的是
        // 「拉丁 display + 中文系统字」的混排,与设计稿一致。
        font-family: Type.display-latin;
        font-size: Shell.compact ? 26px : 34px;
    }
    if !Viz.lyrics-page-open: OutlinedText {
        y: root.viz-title-y + 46px;
        width: 100%;
        height: 20px;
        text: Viz.now-artists;
        text-color: Theme.immersive-text-dim;
        font-size: 14px;
    }

    // 取直链/开流的那几秒:点下去了、正在办。
    // 只在加载时存在 —— 常驻一个空文本会让播放页每帧多一层要合成的东西,
    // 而这一层还压在点云上。文案硬编码中文,走子集字体。
    if Player.now-loading && !Viz.lyrics-page-open: OutlinedText {
        y: root.viz-title-y + 70px;
        width: 100%;
        height: 18px;
        text: "加载中…";
        font-family: "Maple Mono NF CN";
        text-color: Theme.immersive-accent;
        font-size: 13px;
    }

    // 歌词:当前行 + 译文,居中排在歌名下方;画在粒子之上,不参与深度合成
    // (docs/adr/0010 的「歌词是例外」)。播放页的深度卡片是上面那块标注卡。
    // 取不到歌词或还在前奏时为空串,这块自然让位(粒子也就没有可穿的字)。
    // 这块同时是歌词页的入口(#73):点它横向滑出整页歌词。
    if Viz.lyric-line != "" && !Viz.lyrics-page-open: lyric-entry := Rectangle {
        y: root.viz-lyric-y;
        height: root.viz-lyric-h;

        TouchArea {
            clicked => { Viz.lyrics-page-open = true; }
        }

        VerticalLayout {
            height: 100%;
            alignment: start;
            spacing: 10px;

        // 手机宽度上 30px 会把一行英文歌词截掉一半(小米13 真机实测),故紧凑版式
        // 收一档。折行让整句读得完,高度钉死则让超长的「一行」不至于撑破布局。
        OutlinedText {
            width: root.width - 32px;
            x: 16px;
            height: root.viz-lyric-line-h;
            text: Viz.lyric-line;
            text-color: Theme.immersive-text.brighter(0.1);
            font-size: Shell.compact ? 21px : 30px;
            // 歌词字大,描边跟着粗一档才压得住 —— 细描边在 30px 的笔画上
            // 只是一圈灰边,拉不开对比。
            outline: 2px;
            wrap: word-wrap;
        }
        OutlinedText {
            width: root.width - 32px;
            x: 16px;
            height: root.viz-lyric-tr-h;
            text: Viz.lyric-translation;
            text-color: Theme.immersive-text-dim.brighter(0.1);
            font-size: Shell.compact ? 14px : 16px;
            // 顶对齐而非居中:定高 + elide 时,居中裁的是**中间那一截** ——
            // 开头没了、结尾省略号,读起来是断头话(issue #21 实拍)。顶对齐让
            // 溢出只从末尾省略,至少从头读得起。代价是单行译文比居中低不到 10px。
            vertical-alignment: top;
            wrap: word-wrap;
            }
        }
    }

    // 这里曾有一层「遮挡图」:把比歌词更近的那些粒子重新画到歌词上面,
    // 好让粒子看起来从字的前后穿过。删了 —— 歌词读不了,而它是播放页
    // 唯一没有等价路径的信息(见 docs/adr/0010 的「歌词是例外」)。
    //
    // 现在歌词与**歌名同层**:都画在粒子之上,谁也盖不住它们。
    // 歌名从来没有这层图,所以它一直是清楚的 —— 那就是要的样子。

    // 歌词页:从右侧横向滑出,盖住播放页的内容层(#73)。
    // 控制簇仍排在它之后,于是照旧压在最上层、点得到 —— 歌词页上也要
    // 能切歌暂停,那是 docs/adr/0010 的「功能永远在最上层 2D」。
    if Viz.lyric-rows.length > 0: LyricsPage {
        x: Viz.lyrics-page-open ? 0px : root.width;
        y: 0;
        width: 100%;
        height: 100%;
        animate x { duration: 280ms; easing: ease-out; }
        rows: Viz.lyric-rows;
        has-translation: Viz.lyric-has-translation;
        browse <=> Viz.lyric-browse;
        dismiss => { Viz.lyrics-page-open = false; }
    }

    // 竖向进度滑条与右缘时间读数已退场(docs/adr/0029):同一页两套 seek 面
    // (槽宽、颜色、把手规则各一套)、同一个时间读数显示两遍。seek 归条上
    // 那道细轨,时间归条上那一行。

    // 功能层:全应用共用的那一条(playerbar.slint)。这里只管摆位置,
    // 尺寸一概归组件自己 —— 一根条到处一样(docs/adr/0029)。
    // 功能永远在最上层 2D、点得到 —— docs/adr/0010。
    //
    // **不许套布局。** 条身的高度随抽屉开合变(收起 62px,展开 262px),而布局
    // 会拿自己那一格的高度把它焊死;条内所有摆位都按 parent.height 算,于是抽屉
    // 从条的位置往下铺、盖住主条、越过窗口下缘。按下缘定位、高度让组件自己说,
    // 抽屉才向上长 —— 壳里那根(app.slint)一直是这么摆的。
    PlayerBar {
        immersive: true;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - root.safe-bottom - 24px;
        // 与壳里那根同一个内缩常量,不再各给各的(docs/adr/0029)。
        width-cap: parent.width - root.bar-inset * 2;
    }

    // 视觉预设的选择列表已退场:名册里只剩「封面」一档,列表里那一项恒高亮、
    // 点了等于不点,而开它的那一行只长在播放页 —— 那是两处抽屉唯一的差别。
    // 加档时列表连同抽屉里那一行一起回来,并且回到抽屉里(drawer.slint)。
  }
}
