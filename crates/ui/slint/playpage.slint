import { Palette } from "std-widgets.slint";

import { Theme, Type, Motion, Radius, TextSize, Space, Weight, Tracking } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { LyricRow } from "types.slint";
import { PlayerBar, BarMetrics } from "playerbar.slint";
import { LyricsPage } from "lyrics.slint";
import { QueuePage } from "queue.slint";
import { Player } from "globals/player.slint";
import { Shell } from "globals/shell.slint";
import { Viz } from "globals/viz.slint";

// 播放页:盖住包括导航在内的整个窗口的全屏沉浸层(CONTEXT.md「播放页」)。
//
// 五层合成:糊封面背景 → 封面点云 → 标注卡 → 遮挡层(裁到标注卡)→ 控制簇。
// 标注卡是深度卡片:遮挡层只含比它更近的粒子,盖上来就是「粒子从卡前面掠过」。
// 歌名与歌词不走这条,它们画在粒子之上(docs/adr/0010 的「歌词是例外」)。
// 功能(控制簇)永远在最上层 2D、点得到 —— docs/adr/0010。
//
// 安全区由外面传进来:`safe-area-insets` 只有 `Window` 有,组件拿不到。
// 其余状态一律走 global,不从窗口根转发(见 docs/adr/0027)。
export component PlayPage inherits FocusScope {
    in property <length> safe-left;
    in property <length> safe-right;
    in property <length> safe-top;
    in property <length> safe-bottom;
    // 控制条内缩,由窗口根给 —— 全应用一个数。
    in property <length> bar-inset: 24px;

    property <length> text-x: Shell.compact ? root.safe-left + 20px : root.width * 0.585;
    property <length> text-w: Shell.compact
        ? root.width - root.safe-left - root.safe-right - 40px
        : min(root.width * 0.36, 560px);
    // 宽版式:歌名在上三成处;紧凑版式:压在控制条上方那一截。
    property <length> title-y: Shell.compact
        ? root.height - root.safe-bottom - 120px - root.lyric-block-h - 96px
        : root.safe-top + root.height * 0.13;
    // 内联歌词显示几行:宽版式上下各三行,紧凑版式上下各一行。
    property <int> lyric-reach: Shell.compact ? 1 : 3;
    property <length> lyric-block-h: Shell.compact ? 140px : 380px;

    // 抢焦点是这层能收到按键的前提 —— 焦点留在搜索框上的话,下面那个
    // key-pressed 一次都不会触发。
    init => { self.focus(); }

    // 安卓的返回键、桌面的 Esc:都先收起播放页。
    //
    // 安卓那条不是锦上添花 —— 上游把 Back 派成 Key.Back,**只有我们不接**
    // 才去 finish_activity()(见 slint 的 android-activity 后端
    // callback_on_back_invoked)。不接就是「按返回直接退应用」,而播放页是
    // 全屏沉浸层,那不是任何人对返回的预期。
    key-pressed(event) => {
        if (event.text == Key.Back || event.text == Key.Escape) {
            Shell.play-page-open = false;
            return accept;
        }
        return reject;
    }

  Rectangle {
    // 深色底上铺一层糊开的封面(每首歌在后台算一次,imagery/cover.rs),
    // 让整页带上这首歌的颜色,而不是一片黑。
    background: Theme.immersive;
    if Viz.cover-blur.width > 0: Image {
        width: 100%;
        height: 100%;
        image-fit: cover;
        source: Viz.cover-blur;
        opacity: 0.42;
    }
    Rectangle {
        background: @linear-gradient(180deg, #060c0966 0%, #060c09b3 70%, #060c09f2 100%);
    }

  // 点云与它的标注卡:宽版式让到左边、给右边的歌名与歌词腾地方;紧凑版式往上提,
  // 字摆在它下面。整层一起挪,标注卡与遮挡层仍逐像素对得上点云。
  scene := Rectangle {
    x: Shell.compact ? 0px : -root.width * 0.2;
    y: Shell.compact ? -root.height * 0.14 : 0px;
    width: root.width;
    height: root.height;

    // 封面点云:透明底,叠在糊封面背景上。远侧粒子在这层被歌词盖住,
    // 近侧粒子由下面的遮挡层重新盖回字之上 —— 深度由此闭环。
    if Viz.viz-scene.width > 0: Image {
        width: 100%;
        height: 100%;
        image-fit: fill;
        source: Viz.viz-scene;
        // 歌词页打开时退成背景光:整页字压在一片满亮的粒子上读不动(#73)。
        opacity: Viz.lyrics-page-open ? 0.3 : 1.0;
        animate opacity { duration: Motion.medium; easing: Motion.ease; }
    }


    // 世界空间标注卡(docs/note/vision.md「下一面旗子」)。锚点是封面点云上的
    // 一个局部点,点云被拖着自转时它跟着转,卡片于是跟着物体走而不是钉在画面
    // 某处。转出画面就整块收起,不贴边钳制 —— 粘在屏幕边缘的卡片是在假装
    // 自己还指着那个物体。
    // 歌词页打开时整块让位:点云已退成背景光,卡片再浮着就是标一个
    // 看不见的物体。
    if Viz.viz-anchor-visible && !Viz.lyrics-page-open: Rectangle {
        width: 100%;
        height: 100%;

        viz-anchor-card := Rectangle {
            // 中心挂在锚点上:挂左上角的话卡片整体偏出半个身位,就指不准了。
            //
            // 再钳进窗口内。锚点在画面里不等于卡片在画面里 —— 锚点是卡片的
            // 中心,它贴着边时卡片已经探出去半个身位了(真机实拍切掉过右边
            // 约 20%)。轨道半径按竖屏算过,正常不会碰到这道钳位;窗口更窄时
            // 它兜住,代价是卡片在极端处会与锚点脱开一点。
            x: Math.clamp(Viz.viz-anchor-x * root.width - self.width / 2,
                          0px, max(0px, root.width - self.width));
            y: Math.clamp(Viz.viz-anchor-y * root.height - self.height / 2,
                          0px, max(0px, root.height - self.height));
            width: Shell.compact ? 132px : 160px;
            height: 36px;
            border-radius: Radius.sm;
            background: Theme.immersive.with-alpha(0.62);
            border-width: 1px;
            border-color: Theme.immersive-text.with-alpha(0.22);

            Text {
                width: parent.width - 20px;
                text: Viz.now-title;
                color: Theme.immersive-text;
                font-size: TextSize.small;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        // 遮挡层裁到卡片自己。那张图铺的是整个视口,只有卡片这一块该露出来,
        // 不裁就是把整幅点云盖在播放页上。图内偏移取负的卡片位置,于是它与
        // 下面那层点云逐像素对齐,卡片被更近的粒子挡住(docs/adr/0010)。
        if Viz.viz-occluder.width > 0: viz-anchor-occluder := Rectangle {
            x: viz-anchor-card.x;
            y: viz-anchor-card.y;
            width: viz-anchor-card.width;
            height: viz-anchor-card.height;
            clip: true;

            Image {
                x: -parent.x;
                y: -parent.y;
                width: root.width;
                height: root.height;
                image-fit: fill;
                source: Viz.viz-occluder;
            }
        }
    }
  }

    // vignette:把注意力拢回中心。
    Rectangle {
        width: 100%;
        height: 100%;
        background: @radial-gradient(circle, transparent 55%, #00000047 100%);
    }

    // 视觉区的指针:位置归一化后交给点云(见 crates/render3d::cloud),
    // **不**收起播放页 —— 点这里是在拨弄粒子,收起走控制簇里的向下三角。
    // 压在视觉之上、内容之下;控制键各有自己的 TouchArea,不会误触到这层。
    TouchArea {
        moved => {
            Viz.viz-pointer-x = self.mouse-x / root.width;
            Viz.viz-pointer-y = self.mouse-y / root.height;
            Viz.viz-pointer-down = self.pressed;
        }
        pointer-event(event) => {
            Viz.viz-pointer-x = self.mouse-x / root.width;
            Viz.viz-pointer-y = self.mouse-y / root.height;
            Viz.viz-pointer-down = self.pressed;
            Viz.viz-pointer-active = event.kind != PointerEventKind.up;
        }
    }

    // ── 文字:宽版式在右边一栏,紧凑版式在点云下面 ──
    // 歌名、歌手、内联歌词。都画在粒子之上(docs/adr/0010 的「歌词是例外」),
    // 歌词页打开时整组让位 —— 它们与歌词页画在同一片区域,留着就是两层字叠在一起
    // (小米13 真机实拍)。
    if !Viz.lyrics-page-open: play-title := Text {
        x: root.text-x;
        y: root.title-y;
        width: root.text-w;
        text: Viz.now-title;
        color: Theme.immersive-text;
        font-size: Shell.compact ? TextSize.hero-compact : TextSize.hero;
        font-weight: Weight.bold;
        letter-spacing: Shell.compact ? Tracking.hero-compact : Tracking.hero;
        overflow: elide;
    }
    if !Viz.lyrics-page-open: HorizontalLayout {
        x: root.text-x;
        y: root.title-y + (Shell.compact ? 46px : 66px);
        width: root.text-w;
        height: 24px;
        spacing: 10px;
        Text {
            text: Viz.now-artists;
            color: Theme.immersive-dim;
            font-size: TextSize.title;
            vertical-alignment: center;
            overflow: elide;
        }
        // 取直链/开流的那几秒:点下去了、正在办。
        if Player.now-loading: Text {
            text: "加载中…";
            color: Theme.immersive-accent;
            font-size: TextSize.small;
            vertical-alignment: center;
        }
    }

    // 左上角那一句「正在播放 · 3 / 30」,同时是队列页的入口(#109 AC-15)。
    // 歌词页或队列页打开时让位 —— 它们画在同一片区域。
    if !Viz.lyrics-page-open && !Viz.queue-page-open
            && Viz.queue-total > 0: queue-entry := Rectangle {
        x: root.safe-left + (Shell.compact ? 20px : 48px);
        y: root.safe-top + (Shell.compact ? 14px : 36px);
        width: queue-row.preferred-width + 16px;
        height: 32px;
        border-radius: Radius.pill;
        background: queue-entry-touch.has-hover ? #ffffff14 : transparent;

        queue-row := HorizontalLayout {
            x: 8px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon {
                    size: 18px;
                    source: Icons.music-notes;
                    colorize: Theme.immersive-dim;
                }
            }
            Text {
                text: "正在播放 · 队列 " + Viz.queue-total + " 首";
                color: Theme.immersive-dim;
                font-size: TextSize.caption;
                font-weight: Weight.semibold;
                letter-spacing: Tracking.cjk-label;
                vertical-alignment: center;
            }
        }

        queue-entry-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { Viz.queue-page-open = true; }
        }
    }

    // 内联歌词:当前行大而亮,往外每一行淡一档、小一档。点它横向滑出整页歌词(#73)。
    // 取不到歌词或还在前奏时那一窗是空的,这块自然让位。
    if Viz.lyric-rows.length > 0 && !Viz.lyrics-page-open: lyric-entry := Rectangle {
        x: root.text-x;
        y: root.title-y + (Shell.compact ? 92px : 140px);
        width: root.text-w;
        height: root.lyric-block-h;
        clip: true;

        TouchArea {
            mouse-cursor: pointer;
            clicked => { Viz.lyrics-page-open = true; }
        }

        VerticalLayout {
            alignment: Shell.compact ? start : center;
            spacing: Shell.compact ? 6px : 14px;
            for row in Viz.lyric-rows: VerticalLayout {
                visible: Math.abs(row.offset) <= root.lyric-reach;
                height: Math.abs(row.offset) <= root.lyric-reach ? self.preferred-height : 0px;
                spacing: 4px;
                Text {
                    text: row.text;
                    color: Theme.immersive-text;
                    opacity: row.offset == 0 ? 1.0
                        : Math.abs(row.offset) == 1 ? 0.55
                        : Math.abs(row.offset) == 2 ? 0.4 : 0.25;
                    font-size: row.offset == 0
                        ? (Shell.compact ? TextSize.lyric-compact : TextSize.lyric)
                        : (Shell.compact ? TextSize.title : 20px);
                    font-weight: row.offset == 0 ? Weight.bold : Weight.semibold;
                    wrap: row.offset == 0 ? word-wrap : no-wrap;
                    overflow: elide;
                    animate font-size, opacity { duration: Motion.medium; easing: Motion.ease; }
                }
                if row.offset == 0 && row.translation != "": Text {
                    text: row.translation;
                    color: Theme.immersive-dim;
                    font-size: TextSize.small;
                    overflow: elide;
                }
            }
        }
    }

    // 这里曾有一层「遮挡图」:把比歌词更近的那些粒子重新画到歌词上面,
    // 好让粒子看起来从字的前后穿过。删了 —— 歌词读不了,而它是播放页
    // 唯一没有等价路径的信息(见 docs/adr/0010 的「歌词是例外」)。
    //
    // 现在歌词与**歌名同层**:都画在粒子之上,谁也盖不住它们。
    // 歌名从来没有这层图,所以它一直是清楚的 —— 那就是要的样子。

    // 歌词页:从右侧横向滑出,盖住播放页的内容层(#73)。
    // 控制簇仍排在它之后,于是照旧压在最上层、点得到 —— 歌词页上也要
    // 能切歌暂停,那是 docs/adr/0010 的「功能永远在最上层 2D」。
    if Viz.lyric-rows.length > 0: LyricsPage {
        x: Viz.lyrics-page-open ? 0px : root.width;
        y: root.safe-top;
        width: 100%;
        height: root.height - root.safe-top;
        animate x { duration: Motion.medium; easing: Motion.ease; }
        rows: Viz.lyric-rows;
        has-translation: Viz.lyric-has-translation;
        browse <=> Viz.lyric-browse;
        dismiss => { Viz.lyrics-page-open = false; }
    }

    // 队列页:与歌词页同一种横向滑出。控制簇仍排在它之后,于是照旧压在
    // 最上层、点得到 —— 队列页上也要能切歌暂停(docs/adr/0010)。
    QueuePage {
        x: Viz.queue-page-open ? 0px : root.width;
        y: root.safe-top;
        width: 100%;
        height: root.height - root.safe-top;
        animate x { duration: Motion.medium; easing: Motion.ease; }
        rows: Viz.queue-rows;
        current: Viz.queue-current;
        total: Viz.queue-total;
        loading: Viz.queue-loading;
        // 底部那条手势条。桌面上恒 0,只有真机上看得见。
        safe-bottom: root.safe-bottom;
        pick(entry) => { Viz.queue-pick(entry); }
        needs-cover(url) => { Viz.queue-needs-cover(url); }
        dismiss => { Viz.queue-page-open = false; }
    }

    // 竖向进度滑条与右缘时间读数已退场(docs/adr/0029):同一页两套 seek 面
    // (槽宽、颜色、把手规则各一套)、同一个时间读数显示两遍。seek 归条上
    // 那道细轨,时间归条上那一行。

    // 功能层:全应用共用的那一条(playerbar.slint)。这里只管摆位置,
    // 尺寸一概归组件自己 —— 一根条到处一样(docs/adr/0029)。
    // 功能永远在最上层 2D、点得到 —— docs/adr/0010。
    //
    // **不许套布局。** 条身的高度随抽屉开合变(收起 62px,展开 262px),而布局
    // 会拿自己那一格的高度把它焊死;条内所有摆位都按 parent.height 算,于是抽屉
    // 从条的位置往下铺、盖住主条、越过窗口下缘。按下缘定位、高度让组件自己说,
    // 抽屉才向上长 —— 壳里那根(app.slint)一直是这么摆的。
    player-bar := PlayerBar {
        immersive: true;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - root.safe-bottom - BarMetrics.bottom-gap;
        // 与壳里那根同一个内缩常量,不再各给各的(docs/adr/0029)。
        width-cap: parent.width - root.bar-inset * 2;
    }

    // 视觉预设的选择列表已退场:名册里只剩「封面」一档,列表里那一项恒高亮、
    // 点了等于不点,而开它的那一行只长在播放页 —— 那是两处抽屉唯一的差别。
    // 加档时列表连同抽屉里那一行一起回来,并且回到抽屉里(drawer.slint)。
    //
    // 三态赞踩(#157)不在这里:第一版做过播放页常驻三键,用户看过四状态截图后
    // 定了换个位置 —— 收进「更多」抽屉,挨着已有的喜欢那一行(#157 F-004,
    // 见 `drawer.slint` 的 `feedback-up`/`feedback-down`)。
  }
}
