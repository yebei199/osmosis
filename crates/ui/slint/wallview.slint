import { Theme, Type, Space, Radius, TextSize, Motion, Weight } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { Library } from "globals/library.slint";
import { Player } from "globals/player.slint";
import { Shell } from "globals/shell.slint";

// 卡墙(#66):列表 ⇄ 卡墙的二选一开关,以及卡墙场区本身。
//
// 纹理由 render3d 画,这里只摆图、收指针 —— 硬规则 8:TouchArea 只写镜像与
// 喊回调,命中测试在 Rust(wall_drive.rs)。
//
// 两块合在一处:开关与场区共用同一组 wall-* 判据,分开放会让「墙什么时候在」
// 有两个说法。

// 列表 ⇄ 卡墙的一格。两格是同一个分段控件(docs/design.md「分段」),
// 各自带元素 id,端到端脚本与无头测试按 id 点它们。
component ViewSegment inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> on;
    in property <bool> icon-only;
    callback chosen;

    height: 32px;
    width: seg-row.preferred-width;
    border-radius: Radius.pill;
    background: root.on ? Theme.raised : transparent;
    inner-shadow-offset-y: root.on && Theme.dark ? 1px : 0px;
    inner-shadow-color: root.on && Theme.dark ? Theme.edge : transparent;
    drop-shadow-offset-y: root.on ? (Theme.dark ? 2px : 1px) : 0px;
    drop-shadow-blur: root.on ? (Theme.dark ? 6px : 3px) : 0px;
    drop-shadow-spread: root.on && Theme.dark ? -2px : 0px;
    drop-shadow-color: root.on ? (Theme.dark ? #00000073 : #1428162e) : transparent;
    animate background { duration: Motion.fast; easing: Motion.ease; }
    accessible-role: button;
    accessible-label: root.label + "视图";
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.chosen(); }

    seg-row := HorizontalLayout {
        padding-left: root.icon-only ? 9px : 14px;
        padding-right: self.padding-left;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                size: 16px;
                colorize: root.on ? Theme.text : Theme.text-faint;
            }
        }
        if !root.icon-only: Text {
            text: root.label;
            color: root.on ? Theme.text : Theme.text-faint;
            font-size: TextSize.small;
            font-weight: Weight.semibold;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}

// #66 列表 ⇄ 卡墙的二选一开关,摆在日推页头的动作区。只在每日推荐分区、
// GPU 构建下出现(条件在摆它的地方)—— 别的分区没有墙可切。紧凑版式只摆图标。
export component WallToggle inherits Rectangle {
    width: toggle-row.preferred-width;
    height: 38px;
    border-radius: Radius.pill;
    background: Theme.sunken;
    border-width: 1px;
    border-color: Theme.line;

    toggle-row := HorizontalLayout {
        padding: 3px;
        view-wall-btn := ViewSegment {
            label: "卡墙";
            icon: Icons.squares-four;
            icon-only: Shell.compact;
            on: Shell.view-wall;
            chosen => {
                // 卡墙只筛选、不分组(#160):切过去先清掉分组
                Player.set-grouping(0);
                Shell.set-view-wall(true);
            }
        }
        view-list-btn := ViewSegment {
            label: "列表";
            icon: Icons.list-bullets;
            icon-only: Shell.compact;
            on: !Shell.view-wall;
            chosen => { Shell.set-view-wall(false); }
        }
    }
}

// 卡墙场区本身。开关在页头(WallToggle)。
export component WallView inherits VerticalLayout {
    // #66 卡墙场区:纹理由 render3d 画,这里只摆图、
    // 收指针。硬规则 8:TouchArea 只写镜像与喊回调,
    // 命中测试在 Rust(wall_drive.rs)。
    if Shell.wall-visible:
    wall-area := Rectangle {
        vertical-stretch: 1;
        clip: true;
        // 卡面画在纹理里,没有逐张的元素可点;挪选中与播放挂在场区上。
        accessible-role: list;
        accessible-label: "卡墙";
        accessible-action-increment => {
            Shell.wall-step(1);
        }
        accessible-action-decrement => {
            Shell.wall-step(-1);
        }
        accessible-action-default => {
            Shell.wall-confirm();
        }
        init => {
            Shell.wall-field-w = self.width;
            Shell.wall-field-h = self.height;
        }
        changed width => {
            Shell.wall-field-w = self.width;
        }
        changed height => {
            Shell.wall-field-h = self.height;
        }

        if Shell.wall-bg.width > 0: Image {
            width: 100%;
            height: 100%;
            source: Shell.wall-bg;
        }
        Text {
            x: 4px;
            y: 0;
            text: "拖动翻找 · 点两下播放 · 滚轮上下";
            font-size: TextSize.caption;
            color: Theme.text-faint;
        }
        wall-touch := TouchArea {
            moved => {
                Shell.wall-px = self.mouse-x;
                Shell.wall-py = self.mouse-y;
            }
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down {
                    Shell.wall-px = self.mouse-x;
                    Shell.wall-py = self.mouse-y;
                    Shell.wall-pressed = true;
                }
                if ev.kind == PointerEventKind.up
                    || ev.kind == PointerEventKind.cancel {
                    Shell.wall-pressed = false;
                }
            }
            scroll-event(ev) => {
                Shell.wall-wheel(ev.delta-y);
                return accept;
            }
            clicked => {
                Shell.wall-tap(
                    self.mouse-x, self.mouse-y);
            }
            double-clicked => {
                Shell.wall-double(
                    self.mouse-x, self.mouse-y);
            }
        }
    }
}
