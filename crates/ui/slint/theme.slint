// 色板。界面上每一个颜色都该从这里取,不在别处写死。
//
// 为什么要有这一层:在此之前颜色散在 9 个 .slint 里,133 处、67 种,其中 48 种
// 只出现一次 —— 那些多半不是设计决定,是当时随手调的。要做明暗两套,先得让
// "同一个语义只有一个值"这件事成立。
//
// **不是一一对应的改名**:一次性的色往最近的语义上归,深色因此会有肉眼难辨的
// 位移。严格 1:1 的话浅色那套要配 67 个值,配不出来。
//
// 三族表面,别混:
//
// - **常驻界面**(base/window/surface/raised/hover):导航、列表、控制条、卡片。
//   跟着明暗走。
// - **沉浸层**(immersive*):播放页压在封面与点云上的那块底,连同压在它上面的
//   字与线。**整族两套主题下取值相同** —— 底钉死,字就得跟着钉死。
// - **错误横幅**(danger*):自成一套,不跟别人共用名字 —— 共用了就没法只调它。
//
// 强调色的三种状态由 `accent` 派生(`darker`),不各给一个 token:那是同一个
// 决定的三个亮度,分开写迟早会有一个忘了改。

// 界面只有一族字:Osmosis Sans = Figtree(拉丁与数字,tnum 冻进去了)+ Noto Sans CJK SC
// (汉字、假名、谚文),构建期合并成一个族名(crates/ui/fonts/build.py,docs/design.md「字体」)。
// 一个族名的意义:Slint 不必为中文走进系统回退链 —— 这台桌面上那条链的第一个中文字体是
// Maple Mono,界面就成了等宽观感。窗口根的 default-font-family 设它,页面上不再写 font-family。
export global Type {
    out property <string> sans: "Osmosis Sans";
}

export global Theme {
    // 深色还是浅色。**只有 Rust 写它**(见 crates/ui/src/theme.rs),
    // 日月开关拨一下只喊一声。
    in-out property <bool> dark: true;

    // 三档选择的投影:0 深、1 浅、2 跟随系统。同样**只有 Rust 写它**,
    // 设置页读它画选中态;dark 是它解出来的结论,两个别在 UI 里私改。
    in-out property <int> mode: 0;

    // —— 常驻界面的表面,由深到浅 ——
    //
    // 中性色带强调色的色相(136–146°),不是冷灰:一屏的底和绿是一家人。
    // 深色下每一档约差 4.5 L*。

    // 窗口底:内容面板与导航后面的那层地,也是底栏。
    out property <color> window: root.dark ? #050806 : #e2e8df;
    // 内容面板。离窗口边 8px、圆角 20,分隔靠它而不是一整片绿。
    out property <color> base: root.dark ? #0f1612 : #f8faf6;
    // 卡片、搜索框、开关型 chip。
    out property <color> surface: root.dark ? #17201a : #ffffff;
    // 浮起来的东西:控制条、抽屉、提示、分段控件选中的那一格。浅色下靠阴影浮起。
    out property <color> raised: root.dark ? #1f2a23 : #ffffff;
    // 凹进去的东西:分段控件的槽、键帽、报错原文框。
    out property <color> sunken: root.dark ? #0a0f0c : #eef2eb;

    // —— 叠加与线 ——
    //
    // 深色下往上叠一层带绿的白,浅色下往下叠墨 —— 同一个语义,方向相反。

    // 行悬停、抽屉里的动作块。
    out property <color> hover: root.dark ? #d6ffde0d : #18301c0b;
    // 按下;关着的开关的槽。
    out property <color> press: root.dark ? #d6ffde17 : #18301c16;
    // 细线。
    out property <color> line: root.dark ? #d6ffde13 : #18301c17;
    // 粗一档的线:chip 描边、滑轨。
    out property <color> line-strong: root.dark ? #d6ffde24 : #18301c29;
    // 浮起表面上沿那 1px 的内高光。
    out property <color> edge: root.dark ? #d6ffde0f : #ffffffe6;
    // 抽屉开着时压在页面上的那层。
    out property <color> scrim: root.dark ? #0205038c : #14241638;
    // 内容面板顶上 260px 的一抹渐变,页头因此有一层空气。
    out property <color> header-wash: root.dark ? #142219 : #ecf3e6;

    // —— 沉浸层:播放页那块压在封面与点云上的底 ——

    // **这一族两套主题下取值相同,这是它的定义而不是偷懒。** 那块底托着封面
    // 点云:点云的颜色逐颗取自封面,亮底会把它冲掉。既然底钉死,压在它上面的
    // 字也必须钉死 —— 用会翻的 token 的话,浅色主题下就是深字压深底
    // (歌名曾经是 1.23:1)。`crates/ui/tests/theme.rs` 把这条钉住了。
    out property <color> immersive: #060c09;
    out property <color> immersive-text: #f1f6ef;
    out property <color> immersive-dim: #f1f6ef9e;
    out property <color> immersive-faint: #f1f6ef57;
    out property <color> immersive-line: #ffffff24;
    // 沉浸层上的强调(进度弧、红心):深色那一档的绿,不随主题翻。
    out property <color> immersive-accent: #9dd672;
    // 沉浸层上那根控制条的底。
    out property <color> immersive-raised: #16201aeb;

    // —— 字,由强到弱 ——

    out property <color> text: root.dark ? #ebf2ec : #111a13;
    out property <color> text-dim: root.dark ? #a0afa4 : #4b5a4f;
    // 最弱的一档:时长、计数这类「在那儿但别看我」的字。**从不单独承载意义。**
    out property <color> text-faint: root.dark ? #6b796f : #829086;

    // —— 强调 ——

    // 绿是这个 app 的身份色,也是**唯一的强调色**(docs/adr/0023):主按钮、开着的开关、
    // 进度、均衡条只用它,副色板不承担语义。浅色下压深一档,不然在纸白底上糊掉。
    out property <color> accent: root.dark ? #9dd672 : #3d7d29;
    // 压在**强调色实底**上的字与图标。深色下是深墨(10.6:1),浅色下是近白。
    out property <color> accent-text: root.dark ? #0b1a06 : #f4fbef;
    // **中性底上**表示「选中/强调」的字与图标:在放的那一行、当前目的地的图标、
    // 点亮的红心。与上面那个分开是因为它压的底会跟着主题翻。
    out property <color> accent-ink: root.dark ? #9dd672 : #2e6a1d;
    // 选中的 chip、「已喜欢」那块的底。
    out property <color> accent-wash: root.dark ? #9dd67221 : #3d7d291a;
    // 选中的 chip 与聚焦的输入框的描边。
    out property <color> accent-line: root.dark ? #9dd67273 : #3d7d2973;

    // —— 出错 ——
    //
    // 只给出错提示那颗图标用,自成一族、不跟强调色共用:共用了就没法只调它。
    out property <color> danger: root.dark ? #ff9180 : #c0412e;
    out property <color> danger-wash: root.dark ? #ff918024 : #c0412e1a;

    // —— 副色板:12 对渐变端点,只做封面占位、卡墙卡片、统计数字 ——
    //
    // **不承担任何界面语义**(docs/design.md 硬规则 6):按钮、选中态、链接、
    // 状态色永远只用 accent。取用规则 `hues-bright[i % 12]` 配 `hues-deep[i % 12]`,
    // 渐变从亮端到深端。真实封面到位后,这些只是加载前的占位与失败兜底。
    out property <[color]> hues-deep: [
        #2f6b47, #1f5c5a, #3d6b2f, #5a4a86, #7a4a52, #2f5c86,
        #6b5a2f, #2a6b62, #4a3d6b, #6b3d3d, #3d6b5a, #5c6b2f,
    ];
    out property <[color]> hues-bright: [
        #8fc46a, #6fc2a8, #c3d96a, #a08fd9, #d98fa0, #6fa8d9,
        #d9c46a, #8fd9c4, #8f9fd9, #d9958f, #8fd9b4, #bdd98f,
    ];
}

// 玻璃:唯一的招牌材质,**只用在三处** —— 播放键(封面镜头)、在放那一行的缩略图、
// 导航指示器。别处一律不透明(docs/design.md「材质」)。
// 层次:上下渐变的底 + 1px 边 + 上沿内高光 + 一道投影 + 一个椭圆高光子元素。
export global Glass {
    out property <color> top: Theme.dark ? #ffffff29 : #fffffff2;
    out property <color> bottom: Theme.dark ? #ffffff09 : #ffffff8c;
    out property <color> rim: Theme.dark ? #ffffff12 : #18301c14;
    out property <color> hi: Theme.dark ? #ffffff3d : #ffffff;
    out property <color> spec: Theme.dark ? #ffffff8c : #ffffffe6;
    out property <color> shadow: Theme.dark ? #0000008c : #14281638;
    out property <color> tint: Theme.dark ? #9dd67229 : #3d7d291a;
}

// —— 形状、字号、间距、动效、阴影的档位(MEO-1877)——
//
// 和色板同一个道理:页面上只写 Radius.md、TextSize.body,不写 14px。档位从改之前的
// 分布里取最常用的几个值当锚点,一次性的值往最近的一档归。`crates/ui/tests/literals.rs`
// 在 .slint 里扫字面圆角、字号、时长,豁免逐条带理由。

// 字号阶梯(docs/design.md「字体」)。字重只有 400 / 600 / 700 三档,没有 500。
export global TextSize {
    // 表头、音质标签、底栏标签。配 Weight.semibold 与 Tracking.label。
    out property <length> micro: 11px;
    // 设置页分组名、计数、日期。
    out property <length> caption: 12px;
    // 歌手、专辑、说明行、chip、小按钮。
    out property <length> small: 13px;
    // 导航、条上的歌名、按钮、正文。
    out property <length> body: 14px;
    // 列表里的歌名、设置行的标题。
    out property <length> row: 15px;
    // 区块标题(最佳匹配、歌曲)、品牌字。
    out property <length> title: 17px;
    // 空状态标题。
    out property <length> headline: 22px;
    // 页面标题,窄于 600px 时。
    out property <length> display-compact: 28px;
    // 页面标题(每日推荐、我喜欢、设置……),每一页都有。
    out property <length> display: 34px;
    // 播放页歌名(紧凑版式 32px,即 hero-compact)。
    out property <length> hero: 48px;
    out property <length> hero-compact: 32px;
    // 歌词当前行。
    out property <length> lyric: 30px;
    out property <length> lyric-compact: 22px;
}

export global Weight {
    out property <int> regular: 400;
    out property <int> semibold: 600;
    out property <int> bold: 700;
}

// 字距。大字收紧,小号的标签放开。
export global Tracking {
    // 11–12px 的西文与数字标签,+0.08em。
    out property <length> label: 0.9px;
    // 中文小标题(设置页的「外观」「账号」),+0.12em。
    out property <length> cjk-label: 1.5px;
    out property <length> title: -0.1px;
    out property <length> headline: -0.2px;
    out property <length> display-compact: -0.4px;
    out property <length> display: -0.6px;
    out property <length> hero-compact: -0.6px;
    out property <length> hero: -1.2px;
}

export global Radius {
    // 40px 的缩略图。
    out property <length> xs: 6px;
    // 行、导航行。
    out property <length> sm: 10px;
    // 抽屉里的动作块。
    out property <length> md: 14px;
    // 内容面板、卡片、提示。
    out property <length> lg: 20px;
    // 抽屉。
    out property <length> xl: 28px;
    // 药丸与正圆:取多大都行,渲染时夹到短边一半。头像、圆钮这种「半径等于尺寸一半」
    // 的也走它,别再按像素归档 —— 那样尺寸一改就不圆了。
    out property <length> pill: 999px;
}

// 4 的倍数。数字开头的名字 Slint 不认,两倍三倍写成 xxl / xxxl。
export global Space {
    out property <length> xxs: 2px;
    out property <length> xs: 4px;
    out property <length> sm: 8px;
    out property <length> md: 12px;
    out property <length> lg: 16px;
    out property <length> xl: 24px;
    out property <length> xxl: 32px;
    out property <length> xxxl: 48px;
}

// 版式的分界、上限与几块常驻件的尺寸(MEO-1878)。三档版式由窗口宽推出:< compact 是
// 手机底栏版式,≥ wide 是列表拆多列的宽屏版式,中间是侧栏加两行列表。
export global Layout {
    // 600 是 Material 的标准断点,见 docs/adr/0007。
    out property <length> compact: 600px;
    out property <length> wide: 1000px;
    // 内容区最宽多少。再宽就两侧居中留白,一行歌名到时长不至于横跨整屏。
    out property <length> content-max: 1400px;
    // 设置页那一栏最宽多少。
    out property <length> column-max: 680px;
    // 侧栏宽。
    out property <length> nav-w: 224px;
    // 内容面板离窗口边的那一圈。
    out property <length> gutter: 8px;
    // 页面四周的留白:宽版式左右 32、顶上 36;紧凑版式左右 16、顶上安全区再加 14。
    out property <length> page-x: 32px;
    out property <length> page-top: 36px;
    out property <length> page-x-compact: 16px;
    out property <length> page-top-compact: 14px;
    // 曲目一行多高。
    out property <length> row-h: 56px;
    out property <length> row-h-compact: 64px;
    // 控制条最宽多少、多高。
    out property <length> bar-w: 760px;
    out property <length> bar-h: 72px;
    out property <length> bar-h-compact: 64px;
    // 底栏的图标带多高,手势条的 inset 另加。
    out property <length> tab-h: 64px;
    // 宽屏里时长那一列的定宽,各行的数字才竖着对齐。
    out property <length> duration-col: 48px;
}

// 动效。弹簧取自 unicat-switch 的积分器(质量 1,步长 1/240 s),Slint 的 `animate`
// 用下面这些三次贝塞尔近似;要靠速度的(拖动松手、挤压拉伸)由 Rust 从
// `runtime::pace` 那条唤醒路驱动。`calm` 是设置页「动态效果」关掉的样子:
// 所有弹簧临界阻尼、200ms 落定,不回弹。
export global Motion {
    // 「动态效果」关着。**只有 Rust 写它**(真相在 api::settings)。
    in property <bool> calm: false;

    // 悬停的底色、颜色变化。
    out property <duration> fast: 160ms;
    // 抽屉打开、提示进场、换页淡入。
    out property <duration> medium: 280ms;
    out property <easing> ease: cubic-bezier(0.2, 0, 0, 1);

    // 按下缩到 0.92(镜头、按钮、chip):k420 c26,冲过头 7.6%。
    out property <duration> press: root.calm ? 200ms : 300ms;
    out property <easing> press-ease: root.calm ? ease-out : cubic-bezier(0.3, 1.5, 0.45, 1);
    // 悬停时镜头朝指针偏 ≤ 4px:k220 c22,3%。
    out property <duration> lean: root.calm ? 200ms : 360ms;
    out property <easing> lean-ease: root.calm ? ease-out : cubic-bezier(0.3, 1.3, 0.5, 1);
    // 开关的钮、播放暂停换图、选中 chip:k190 c15,13%。
    out property <duration> spring: root.calm ? 200ms : 520ms;
    out property <easing> spring-ease: root.calm ? ease-out : cubic-bezier(0.3, 1.4, 0.45, 1.2);
    // 导航指示器先动的那条边(lead)与后跟的那条边(trail):两条边各走各的弹簧,
    // 走起来先拉长再落定 —— unicat 那颗球的拉伸,用声明式写出来。
    out property <duration> lead: root.calm ? 200ms : 420ms;
    out property <duration> trail: root.calm ? 200ms : 620ms;
    out property <easing> lead-ease: root.calm ? ease-out : cubic-bezier(0.3, 1.4, 0.45, 1.1);
    // 换主题时颜色跟着 unicat 的天色走,临界阻尼。
    out property <duration> theme: 1200ms;
    out property <easing> theme-ease: cubic-bezier(0.4, 0, 0.2, 1);
}

// 阴影的三档。每个元素最多一道外投影、一道内阴影加一圈边,设计稿从不叠更多。
// 浅色下颜色淡得多:同样的黑在亮底上重得多。负的 spread 让浮起的东西只在下方落影,
// 只有 Skia 画得出(无头测试的软件渲染没有阴影)。
export global Elevation {
    // 面板、设置卡、最佳匹配卡。
    out property <length> card-y: 1px;
    out property <length> card-blur: 2px;
    out property <color> card-color: Theme.dark ? #00000059 : #14281614;
    // 控制条。
    out property <length> float-y: 18px;
    out property <length> float-blur: 40px;
    out property <length> float-spread: Theme.dark ? -14px : -16px;
    out property <color> float-color: Theme.dark ? #000000cc : #14281652;
    // 抽屉、提示。
    out property <length> overlay-y: 30px;
    out property <length> overlay-blur: Theme.dark ? 70px : 64px;
    out property <length> overlay-spread: Theme.dark ? -18px : -20px;
    out property <color> overlay-color: Theme.dark ? #000000d9 : #14281661;
}
