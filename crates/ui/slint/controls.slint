// 播放条的两块积木:环形播放键与同播区。
//
// 条身本身在 playerbar.slint —— 那里只有一个组件,四处实例。这里留下的是
// 两块跨形态复用的零件:环形键迷你条与完整条都用,同播区归面 C。

import { DeviceRow } from "types.slint";
import { Theme } from "theme.slint";
import { HoverButton, RoundControl, OutlinedText } from "widgets.slint";

import { ProgressBar, VolumeControl } from "progress.slint";
export { ProgressBar, VolumeControl }

// 环形进度播放键:外圈 conic 进度环(进度本身就是环,不再要常驻细线),
// 内圈实心圆 + 播放/暂停图标。尺寸两档:条身 48/40,播放页 60/50
// (docs/design.md「播放条」)。
export component RingControl inherits Rectangle {
    in property <bool> is-playing;
    // 已放到全曲的几分之几,0..=1。与 ProgressBar 同一个来源(progress.rs 夹好)。
    in property <float> ratio: 0;
    in property <length> diameter: 48px;
    in property <length> inner-diameter: 40px;
    // 播放键里那圈随音乐跳动的画面(反馈 warp)。空图退回纯色内圈 ——
    // 音乐页不接它,没 GPU 的构建也不接。
    in property <image> pulse;
    callback toggle();

    width: root.diameter;
    height: root.diameter;
    border-radius: self.width / 2;
    // 进度环:走过的弧是 accent,剩下的弧是弱叠加。conic 从 12 点起顺时针。
    background: @conic-gradient(
        Theme.accent 0deg,
        Theme.accent clamp(root.ratio, 0.0, 1.0) * 360deg,
        Theme.overlay clamp(root.ratio, 0.0, 1.0) * 360deg,
        Theme.overlay 360deg);

    inner := Rectangle {
        width: root.inner-diameter;
        height: root.inner-diameter;
        border-radius: self.width / 2;
        background: Theme.surface;
        clip: true;

        if root.pulse.width > 0: Image {
            width: 100%;
            height: 100%;
            image-fit: cover;
            source: root.pulse;
        }

        RoundControl {
            diameter: parent.width;
            // 环里的内圈自己是底,再叠一层灰底会把环糊成同心圆;
            // 接了 warp 时同理,不糊住画面。
            transparent-base: true;
            // ▶ 或 ⏸,随播放状态换。
            icon: root.is-playing
                ? "M8 5 L10.5 5 L10.5 19 L8 19 Z M13.5 5 L16 5 L16 19 L13.5 19 Z"
                : "M8 5 L19 12 L8 19 Z";
            label: root.is-playing ? "暂停" : "播放";
            clicked => { root.toggle(); }
        }
    }
}

// 同播区:有设备列 chips,点一台推过去;一台都没有时写明原因 ——
// **常驻**,不随名册隐藏。上一版设备区在单实例时整块消失,同播功能等于不存在。
//
// 行首那句「同播」也常驻:只在名册为空时才写标题的话,有设备时这一行就是
// 一排光秃秃的设备名,紧跟在「输出 本机 pc1」下面 —— 看起来正是同一台设备
// 被画了两遍(#102 之二)。两行都带标题,才分得出哪行是哪个动作。
export component SyncStrip inherits HorizontalLayout {
    in property <[DeviceRow]> devices;
    callback push-to(string);

    spacing: 8px;

    VerticalLayout {
        alignment: center;
        sync-label := Text {
            text: "同播";
            font-family: "Maple Mono NF CN";
            color: Theme.text-faint;
            font-size: 12px;
        }
    }

    if root.devices.length == 0: VerticalLayout {
        alignment: center;
        sync-empty := Text {
            text: "没有其他设备";
            font-family: "Maple Mono NF CN";
            color: Theme.text-faint;
            font-size: 12px;
        }
    }

    for device in root.devices: VerticalLayout {
        alignment: center;
        Rectangle {
            width: chip-label.preferred-width + 24px;
            height: 30px;
            background: chip.has-hover ? Theme.accent.darker(0.2).with-alpha(0.4) : Theme.overlay-weak;
            border-radius: 15px;

            chip := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.push-to(device.id); }
            }

            // 设备名由对端自报,可能是任意 CJK —— 与歌名同理,
            // 不指定 font-family,落到系统字体。
            chip-label := Text {
                text: device.name;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}

// 一颗输出设备芯片。选中的那颗填强调色 —— 与抽屉里的开关同一套表达:
// 状态由填充底色说,不由文字明暗说。
component OutputChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    width: chip-label.preferred-width + 24px;
    height: 30px;
    border-radius: 15px;
    background: root.selected
        ? Theme.accent
        : (touch.has-hover ? Theme.accent.darker(0.2).with-alpha(0.4) : Theme.overlay-weak);
    animate background { duration: 140ms; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        accessible-role: button;
        // 读屏念得出选中没有 —— 填充底色它看不见。
        accessible-label: "输出到 " + root.label;
        accessible-checkable: true;
        accessible-checked: root.selected;
        accessible-action-default => { root.clicked(); }
    }

    // 设备名由对端自报,可能是任意 CJK —— 与歌名同理,不指定 font-family。
    chip-label := Text {
        text: root.label;
        color: root.selected ? Theme.accent-text : Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// 输出设备区:声音从哪台设备出来。第一颗永远是「本机」—— 选本机就是现在的
// 行为,遥控器模式没有第二个模式开关(docs/adr/0030)。
//
// 与同播那一条分开摆:两者都是「点一台设备」,但语义相反 —— 同播是把本机
// 正在放的推过去,遥控是让那台去放而本机闭嘴。挤在一行里点错了不会报错,
// 只是声音从另一台机器出来。
export component OutputStrip inherits HorizontalLayout {
    in property <[DeviceRow]> devices;
    // 当前选中的设备 id。空串 = 本机。
    in property <string> current;
    callback set-output(string);

    spacing: 8px;

    VerticalLayout {
        alignment: center;
        Text {
            text: "输出";
            font-family: "Maple Mono NF CN";
            color: Theme.text-faint;
            font-size: 12px;
        }
    }

    VerticalLayout {
        alignment: center;
        OutputChip {
            label: "本机";
            selected: root.current == "";
            clicked => { root.set-output(""); }
        }
    }

    for device in root.devices: VerticalLayout {
        alignment: center;
        OutputChip {
            label: device.name;
            selected: root.current == device.id;
            clicked => { root.set-output(device.id); }
        }
    }
}
