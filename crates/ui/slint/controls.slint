// 播放条的积木:环形播放键与输出设备区。
//
// 条身本身在 playerbar.slint —— 那里只有一个组件,四处实例。这里留下的是
// 跨形态复用的零件:环形键迷你条与完整条都用,输出设备区在抽屉与个人页里。

import { DeviceRow } from "types.slint";
import { Theme } from "theme.slint";
import { Shell } from "globals/shell.slint";
import { HoverButton, RoundControl, OutlinedText } from "widgets.slint";

import { ProgressBar, VolumeControl } from "progress.slint";
export { ProgressBar, VolumeControl }

// 环形进度播放键:外圈 conic 进度环(进度本身就是环,不再要常驻细线),
// 内圈实心圆 + 播放/暂停图标。尺寸两档:条身 48/40,播放页 60/50
// (docs/design.md「播放条」)。
export component RingControl inherits Rectangle {
    in property <bool> is-playing;
    // 已放到全曲的几分之几,0..=1。与 ProgressBar 同一个来源(progress.rs 夹好)。
    in property <float> ratio: 0;
    in property <length> diameter: 48px;
    in property <length> inner-diameter: 40px;
    // 播放键里那圈随音乐跳动的画面(反馈 warp)。空图退回纯色内圈 ——
    // 音乐页不接它,没 GPU 的构建也不接。
    in property <image> pulse;
    callback toggle();

    width: root.diameter;
    height: root.diameter;
    border-radius: self.width / 2;
    // 进度环:走过的弧是 accent,剩下的弧是弱叠加。conic 从 12 点起顺时针。
    background: @conic-gradient(
        Theme.accent 0deg,
        Theme.accent clamp(root.ratio, 0.0, 1.0) * 360deg,
        Theme.overlay clamp(root.ratio, 0.0, 1.0) * 360deg,
        Theme.overlay 360deg);

    inner := Rectangle {
        width: root.inner-diameter;
        height: root.inner-diameter;
        border-radius: self.width / 2;
        background: Theme.surface;
        clip: true;

        if root.pulse.width > 0: Image {
            width: 100%;
            height: 100%;
            image-fit: cover;
            source: root.pulse;
        }

        RoundControl {
            diameter: parent.width;
            // 环里的内圈自己是底,再叠一层灰底会把环糊成同心圆;
            // 接了 warp 时同理,不糊住画面。
            transparent-base: true;
            // ▶ 或 ⏸,随播放状态换。
            icon: root.is-playing
                ? "M8 5 L10.5 5 L10.5 19 L8 19 Z M13.5 5 L16 5 L16 19 L13.5 19 Z"
                : "M8 5 L19 12 L8 19 Z";
            label: root.is-playing ? "暂停" : "播放";
            clicked => { root.toggle(); }
        }
    }
}

// 一颗输出设备芯片。选中的那颗填强调色 —— 与抽屉里的开关同一套表达:
// 状态由填充底色说,不由文字明暗说。
component OutputChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    width: chip-label.preferred-width + 24px;
    height: 30px;
    border-radius: 15px;
    background: root.selected
        ? Theme.accent
        : (touch.has-hover ? Theme.accent.darker(0.2).with-alpha(0.4) : Theme.overlay-weak);
    animate background { duration: 140ms; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        accessible-role: button;
        // 读屏念得出选中没有 —— 填充底色它看不见。
        accessible-label: "输出到 " + root.label;
        accessible-checkable: true;
        accessible-checked: root.selected;
        accessible-action-default => { root.clicked(); }
    }

    // 设备名由对端自报,可能是任意 CJK —— 与歌名同理,不指定 font-family。
    chip-label := Text {
        text: root.label;
        color: root.selected ? Theme.accent-text : Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// 芯片旁那颗小键:加入一起播放 / 移出(#137 ⑤)。在组里的显示「−」,不在的显示「+」。
// 点芯片本身仍是「改在这台播放」—— 两个动作分开，不靠长按之类的隐藏手势。
component MemberToggle inherits Rectangle {
    in property <string> label;
    in property <bool> member;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: touch.has-hover ? Theme.accent.darker(0.2).with-alpha(0.4) : Theme.overlay-weak;
    animate background { duration: 140ms; easing: ease-out; }

    Text {
        text: root.member ? "−" : "+";
        color: root.member ? Theme.accent : Theme.text-faint;
        font-size: 14px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        accessible-role: button;
        accessible-label: (root.member ? "移出 " : "加入 ") + root.label;
        accessible-action-default => { root.clicked(); }
    }
}

// 输出设备区:声音从哪台设备出来。第一颗永远是「本机」—— 选本机就是现在的
// 行为,遥控器模式没有第二个模式开关(docs/adr/0030)。每颗芯片旁那颗小键把它加进 /
// 移出播放组，组那一行在芯片下面(#137 ⑤)。
export component OutputStrip inherits VerticalLayout {
    in property <[DeviceRow]> devices;
    // 当前选中的设备 id。空串 = 本机。
    in property <string> current;
    callback set-output(string);

    spacing: 4px;

    HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            Text {
                text: "输出";
                font-family: "Maple Mono NF CN";
                color: Theme.text-faint;
                font-size: 12px;
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 2px;
            OutputChip {
                label: "本机";
                selected: root.current == "";
                clicked => { root.set-output(""); }
            }
            VerticalLayout {
                alignment: center;
                MemberToggle {
                    label: "本机";
                    member: Shell.local-member;
                    clicked => { Shell.toggle-member(""); }
                }
            }
        }

        for device in root.devices: HorizontalLayout {
            alignment: center;
            spacing: 2px;
            OutputChip {
                label: device.name;
                selected: root.current == device.id;
                clicked => { root.set-output(device.id); }
            }
            VerticalLayout {
                alignment: center;
                MemberToggle {
                    label: device.name;
                    member: device.member;
                    clicked => { Shell.toggle-member(device.id); }
                }
            }
        }
    }

    if Shell.group-text != "": group-label := Text {
        text: Shell.group-text;
        color: Theme.text-faint;
        font-size: 12px;
        wrap: word-wrap;
    }
}
