// 常驻控制条那一簇:播放控制与同播条。
//
// 它们是「正在播放」这个状态的操作面,与页面内容无关 —— 播放页展开时,
// 覆层里的另一份实例走同一组回调(见 docs/adr/0010 的「功能等价路径」)。

import { DeviceRow } from "types.slint";
import { Theme } from "theme.slint";
import { HoverButton, RoundControl, OutlinedText } from "widgets.slint";

import { ProgressBar, VolumeControl, VerticalSeekBar } from "progress.slint";
export { ProgressBar, VolumeControl, VerticalSeekBar }

// 环形进度播放键:外圈 conic 进度环(进度本身就是环,不再要常驻细线),
// 内圈实心圆 + 播放/暂停图标。尺寸两档:条身 48/40,播放页 60/50
// (docs/design.md「播放条」)。
export component RingControl inherits Rectangle {
    in property <bool> is-playing;
    // 已放到全曲的几分之几,0..=1。与 ProgressBar 同一个来源(progress.rs 夹好)。
    in property <float> ratio: 0;
    in property <length> diameter: 48px;
    in property <length> inner-diameter: 40px;
    // 播放键里那圈随音乐跳动的画面(反馈 warp)。空图退回纯色内圈 ——
    // 音乐页不接它,没 GPU 的构建也不接。
    in property <image> pulse;
    callback toggle();

    width: root.diameter;
    height: root.diameter;
    border-radius: self.width / 2;
    // 进度环:走过的弧是 accent,剩下的弧是弱叠加。conic 从 12 点起顺时针。
    background: @conic-gradient(
        Theme.accent 0deg,
        Theme.accent clamp(root.ratio, 0.0, 1.0) * 360deg,
        Theme.overlay clamp(root.ratio, 0.0, 1.0) * 360deg,
        Theme.overlay 360deg);

    inner := Rectangle {
        width: root.inner-diameter;
        height: root.inner-diameter;
        border-radius: self.width / 2;
        background: Theme.surface;
        clip: true;

        if root.pulse.width > 0: Image {
            width: 100%;
            height: 100%;
            image-fit: cover;
            source: root.pulse;
        }

        RoundControl {
            diameter: parent.width;
            // 环里的内圈自己是底,再叠一层灰底会把环糊成同心圆;
            // 接了 warp 时同理,不糊住画面。
            transparent-base: true;
            // ▶ 或 ⏸,随播放状态换。
            icon: root.is-playing
                ? "M8 5 L10.5 5 L10.5 19 L8 19 Z M13.5 5 L16 5 L16 19 L13.5 19 Z"
                : "M8 5 L19 12 L8 19 Z";
            label: root.is-playing ? "暂停" : "播放";
            clicked => { root.toggle(); }
        }
    }
}

// 迷你播放条:控制条的最小形态,由壳持有、跨应用常驻(CONTEXT.md「迷你播放条」)。
// 封面 · 曲名/歌手 · 环形键 · 下一首;完整控制在音乐页的胶囊条与播放页。
export component MiniPlayer inherits Rectangle {
    // 不叫 cover:那个名字会把 `image-fit: cover` 里的枚举值遮蔽掉。
    in property <image> cover-art;
    in property <string> title;
    in property <string> artists;
    in property <bool> is-playing;
    in property <float> ratio;
    callback toggle();
    callback next();

    height: 60px;
    border-radius: self.height / 2;
    background: Theme.surface.with-alpha(0.9);
    border-width: 1px;
    border-color: Theme.glass-edge;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 14px;
    drop-shadow-color: Theme.glass-shadow;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                clip: true;
                // 封面没到位时的占位:副色板 0 号渐变。
                background: @linear-gradient(150deg, Theme.hues-bright[0], Theme.hues-deep[0]);
                if root.cover-art.width > 0: Image {
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                    source: root.cover-art;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.artists;
                color: Theme.text-dim;
                font-size: 11px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            RingControl {
                is-playing: root.is-playing;
                ratio: root.ratio;
                diameter: 40px;
                inner-diameter: 32px;
                toggle => { root.toggle(); }
            }
        }
        VerticalLayout {
            alignment: center;
            RoundControl {
                diameter: 36px;
                icon: "M5 5 L13 12 L5 19 Z M15 5 L15 19 M17 5 L17 19";
                label: "下一首";
                clicked => { root.next(); }
            }
        }
    }
}

// 控制键簇:上一首 / 环形播放键 / 下一首 + 随机 + 日月开关。
// 抽成组件是因为宽窄两种版式各摆一次 —— 摆法不同,键是同一套。
export component ControlCluster inherits HorizontalLayout {
    in property <bool> is-playing;
    // 只读:随机的真相在 app_core::Queue 上,这里是它的投影。
    in property <bool> shuffle-on;
    // 只读:循环的真相同样在 Queue 上。0 关,1 列表循环,2 单曲循环 ——
    // builtin 枚举不生成 Rust 访问器,int 镜像(与 ColorScheme 同一个坑)。
    in property <int> loop-mode;
    // 进度,喂给环形键的外圈。
    in property <float> progress-ratio: 0;
    // 播放键里那圈随音乐跳动的画面(反馈 warp,见 crates/render3d/src/warp.wgsl)。
    // 空图就退回普通按钮 —— 音乐页不接它,没 GPU 的构建也不接。
    in property <image> pulse;
    // 环形键的两档尺寸(条身 48/40,播放页 60/50)。
    in property <length> ring-diameter: 48px;
    in property <length> ring-inner-diameter: 40px;
    callback prev();
    callback toggle();
    callback next();
    callback shuffle-toggled();
    // 请求循环换到下一态(关→列表→单曲→关)。loop-mode 那时还是旧值 ——
    // 由 Rust 拨完队列再写回。
    callback loop-cycled();

    spacing: 10px;

    VerticalLayout {
        alignment: center;
        RoundControl {
            // ⏮:竖杠 + 左向三角。
            icon: "M7 5 L7 19 M9 5 L9 19 M19 5 L11 12 L19 19 Z";
            label: "上一首";
            clicked => { root.prev(); }
        }
    }
    VerticalLayout {
        alignment: center;
        RingControl {
            is-playing: root.is-playing;
            ratio: root.progress-ratio;
            diameter: root.pulse.width > 0 ? 68px : root.ring-diameter;
            inner-diameter: root.pulse.width > 0 ? 58px : root.ring-inner-diameter;
            pulse: root.pulse;
            toggle => { root.toggle(); }
        }
    }
    VerticalLayout {
        alignment: center;
        RoundControl {
            // ⏭:右向三角 + 竖杠。
            icon: "M5 5 L13 12 L5 19 Z M15 5 L15 19 M17 5 L17 19";
            label: "下一首";
            clicked => { root.next(); }
        }
    }
    VerticalLayout {
        alignment: center;
        // 随机键。**这一排里唯一有状态的一颗**,所以它报成 checkbox 而不是
        // button,开着时图标换成强调色。
        RoundControl {
            // ⤬:两条交叉的箭头(Material 的 shuffle 字形)。
            icon: "M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm0.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z";
            label: "随机播放";
            checkable: true;
            checked: root.shuffle-on;
            clicked => { root.shuffle-toggled(); }
        }
    }
    VerticalLayout {
        alignment: center;
        // 循环键。与随机键同一条规矩:有状态,报成带 checked 的按钮;
        // 三态念在标签里 —— checked 只说得出「开没开」,说不出列表还是单曲。
        RoundControl {
            // ↻:首尾折返的两条箭头(Material 的 repeat 字形);
            // 单曲循环在中间多一个「1」(repeat_one)。
            icon: root.loop-mode == 2
                ? "M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4zm-4-2V9h-1l-2 1v1h1.5v4H13z"
                : "M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z";
            label: root.loop-mode == 0 ? "循环: 关"
                : (root.loop-mode == 1 ? "循环: 列表" : "循环: 单曲");
            checkable: true;
            checked: root.loop-mode > 0;
            clicked => { root.loop-cycled(); }
        }
    }
    // 日月开关已迁去设置页当主题区主视觉(#68):第五颗循环键进场后
    // 紧凑行装不下它,而它本就等设置页落地后撤离控制簇。
}

// 同播区:有设备列 chips,点一台推过去;一台都没有时写明原因 ——
// **常驻**,不随名册隐藏。上一版设备区在单实例时整块消失,同播功能等于不存在。
export component SyncStrip inherits HorizontalLayout {
    in property <[DeviceRow]> devices;
    callback push-to(string);

    spacing: 8px;

    if root.devices.length == 0: VerticalLayout {
        alignment: center;
        Text {
            text: "同播: 没有其他设备";
            font-family: "Maple Mono NF CN";
            color: Theme.text-faint;
            font-size: 12px;
        }
    }

    for device in root.devices: VerticalLayout {
        alignment: center;
        Rectangle {
            width: chip-label.preferred-width + 24px;
            height: 30px;
            background: chip.has-hover ? Theme.accent.darker(0.2).with-alpha(0.4) : Theme.overlay-weak;
            border-radius: 15px;

            chip := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.push-to(device.id); }
            }

            // 设备名由对端自报,可能是任意 CJK —— 与歌名同理,
            // 不指定 font-family,落到系统字体。
            chip-label := Text {
                text: device.name;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}
