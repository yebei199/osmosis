// 已屏蔽页(#161):命中的歌在所有列表里隐藏,队列与电台跳过。
//
// 规则按当初的屏蔽原因分组,在这里恢复 —— 歌曲菜单与歌手页只管建。
// 版式与设置页同一套:居中的一列,分组标签 + 卡片。

import { Theme, Space, TextSize, Weight, Tracking, Layout } from "theme.slint";
import { Card, CardRow, SectionLabel, Button, ButtonKind, EmptyState } from "widgets.slint";
import { Icons } from "icons.slint";
import { BarMetrics } from "playerbar.slint";
import { Library } from "globals/library.slint";

export component BlockedPage inherits Flickable {
    // 控制条此刻在不在,条件与 app.slint 摆条那一行是同一个(见 settings.slint 同名属性)。
    in property <bool> bar-visible;

    property <bool> narrow: root.width < Layout.compact;

    content-height: column.preferred-height;

    // 每次进页都重拉:启动时那次可能还没登录,别的设备也可能加过
    init => { Library.refresh-blocks(); }

    column := VerticalLayout {
        // 宽窗口里居中,理由同设置页。
        x: max(Layout.page-x-compact, (root.width - self.width) / 2);
        width: min(root.width - Layout.page-x-compact * 2, Layout.column-max);
        alignment: start;
        spacing: 0px;
        padding-top: root.narrow ? Layout.page-top-compact : Layout.page-top;
        // 页尾本来的那段空气另算:条在时整段 page-reserve 都是额外的。
        padding-bottom: Space.xl + (root.bar-visible ? BarMetrics.page-reserve : 0px);

        Text {
            text: "已屏蔽";
            font-weight: Weight.bold;
            font-size: root.narrow ? TextSize.display-compact : TextSize.display;
            letter-spacing: root.narrow ? Tracking.display-compact : Tracking.display;
            color: Theme.text;
        }
        Rectangle { height: Space.sm; }
        if Library.block-groups.length > 0: Text {
            text: "这些歌不会出现在列表里,队列和电台也会跳过";
            font-size: TextSize.small;
            color: Theme.text-dim;
            wrap: word-wrap;
        }

        // 没有规则时摆空状态:页头照留,一句话说清怎么才会有东西。
        if Library.block-groups.length == 0: VerticalLayout {
            padding-top: Space.xxxl;
            EmptyState {
                compact: root.narrow;
                icon: Icons.prohibit;
                title: "还没有屏蔽任何东西";
                body: "在播放抽屉里点「不喜欢」选一个原因,或在歌手页屏蔽歌手,规则会出现在这里";
            }
        }

        for group in Library.block-groups: VerticalLayout {
            padding-top: Space.xl;
            SectionLabel { text: group.reason; }
            Rectangle { height: 10px; }
            Card {
                for row[i] in group.rows: CardRow {
                    title: row.label;
                    row-min: 56px;
                    last: i == group.rows.length - 1;
                    VerticalLayout {
                        alignment: center;
                        unblock-button := Button {
                            kind: ButtonKind.secondary;
                            small: true;
                            text: "恢复";
                            label: "恢复 " + row.label;
                            clicked => { Library.unblock(row.id); }
                        }
                    }
                }
            }
        }
    }
}
