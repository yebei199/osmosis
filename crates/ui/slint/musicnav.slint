// 一级导航(MEO-1876,docs/adr/0038),外加搜索结果的三个页签。
//
// 十个目的地平级,没有 Home,也没有音乐页里的第二套导航。宽版式是带字的侧栏,
// 紧凑版式是「四格 + 更多」的底栏,「更多」点开一块平铺面板。
//
// 编号沿用原音乐分区的 id(0 每日推荐、1 我的歌单、2 搜索、3 最近播放、4 电台、
// 5 已下载),后加的接着排(6 我喜欢、7 个人、8 设置、9 已屏蔽)。编号与摆放顺序分开:
// Rust 侧与测试里按编号判目的地的地方有几十处,插队会让它们全体挪位。
import { Theme, Radius, Motion, Space, Type, TextSize, Weight, Elevation } from "theme.slint";
import { Shell } from "globals/shell.slint";
import { Icon, Icons } from "icons.slint";

export struct Destination {
    // 编号,即 Shell.destination 的取值。
    id: int,
    // 全名。读屏念它、MCP 脚本按它找 —— 底栏显示简称时也报全名。
    label: string,
    // 底栏上显示的字。底栏一格只有窗口宽的五分之一,四个字摆不下。
    short: string,
    // 常态的线条图标与选中时的实心图标(Phosphor 的 Regular 与 Fill)。
    icon: image,
    icon-on: image,
}

export global Destinations {
    // 侧栏三组,从上到下。分组之间只留视觉间隔,没有父级页面。
    out property <[Destination]> listen: [
        { id: 0, label: "每日推荐", short: "推荐", icon: Icons.calendar-blank, icon-on: Icons.calendar-blank-fill },
        { id: 4, label: "电台", short: "电台", icon: Icons.radio, icon-on: Icons.radio-fill },
        { id: 2, label: "搜索", short: "搜索", icon: Icons.magnifying-glass, icon-on: Icons.magnifying-glass-fill },
    ];
    out property <[Destination]> library: [
        { id: 6, label: "我喜欢", short: "我喜欢", icon: Icons.heart, icon-on: Icons.heart-fill },
        { id: 1, label: "我的歌单", short: "歌单", icon: Icons.playlist, icon-on: Icons.playlist-fill },
        { id: 3, label: "最近播放", short: "最近", icon: Icons.clock-counter-clockwise, icon-on: Icons.clock-counter-clockwise-fill },
        { id: 5, label: "已下载", short: "已下载", icon: Icons.download-simple, icon-on: Icons.download-simple-fill },
    ];
    // 沉底那组。
    out property <[Destination]> account: [
        { id: 7, label: "个人", short: "个人", icon: Icons.user, icon-on: Icons.user-fill },
        { id: 9, label: "已屏蔽", short: "已屏蔽", icon: Icons.prohibit, icon-on: Icons.prohibit-fill },
        { id: 8, label: "设置", short: "设置", icon: Icons.gear-six, icon-on: Icons.gear-six-fill },
    ];

    // 紧凑版式底栏的四格与「更多」面板里的六项,从上面三组里取,标签不另抄一份。
    out property <[Destination]> bar: [listen[0], listen[2], library[0], library[1]];
    out property <[Destination]> more: [listen[1], library[2], library[3], account[0], account[1], account[2]];
    out property <Destination> more-entry: {
        id: -1, label: "更多", short: "更多",
        icon: Icons.dots-three, icon-on: Icons.dots-three,
    };

    in-out property <bool> more-open: false;
    // 当前页在「更多」面板里:那时底栏亮的是「更多」。
    out property <bool> in-more: Shell.destination == 4 || Shell.destination == 3
        || Shell.destination == 5 || Shell.destination == 7 || Shell.destination == 8
        || Shell.destination == 9;

    // 某个目的地的全名。紧凑版式的页头用它。
    public pure function label-of(id: int) -> string {
        if (id == 0) { return listen[0].label; }
        if (id == 4) { return listen[1].label; }
        if (id == 2) { return listen[2].label; }
        if (id == 6) { return library[0].label; }
        if (id == 1) { return library[1].label; }
        if (id == 3) { return library[2].label; }
        if (id == 5) { return library[3].label; }
        if (id == 7) { return account[0].label; }
        if (id == 9) { return account[1].label; }
        return account[2].label;
    }

    // 去某个目的地。侧栏、底栏、更多面板、横幅跳转都走这一处;
    // 该取什么数归 Rust(music/list.rs 的 load_section)。
    public function go(id: int) {
        self.more-open = false;
        Shell.destination = id;
        Shell.select-section(id);
    }
}

// 侧栏一行:图标 + 全名。选中态由背后那颗玻璃药丸提供(app.slint 的 nav-lead / nav-lag),
// 行自己只画悬停那一层淡底,不画选中底 —— 画了就和药丸叠两遍。
export component SideNavRow inherits Rectangle {
    in property <Destination> item;
    in property <bool> active;
    callback clicked;

    border-radius: Radius.sm;
    background: touch.has-hover && !root.active ? Theme.hover : transparent;
    animate background { duration: Motion.fast; easing: Motion.ease; }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.active ? root.item.icon-on : root.item.icon;
                colorize: root.active ? Theme.accent-ink : Theme.text-faint;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.label;
            color: root.active || touch.has-hover ? Theme.text : Theme.text-dim;
            font-size: TextSize.body;
            font-weight: root.active ? Weight.semibold : Weight.regular;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        accessible-role: tab;
        accessible-label: root.item.label;
        accessible-checkable: true;
        accessible-checked: root.active;
        accessible-action-default => { root.clicked(); }
    }
}

// 「更多」面板:贴着底栏上沿的一张浮起的卡,六项一行。点一项直达并收起;
// 点面板外面也收起。不常驻,所以不是第二根导航条。
export component MorePanel inherits Rectangle {
    background: Theme.scrim;

    TouchArea {
        clicked => { Destinations.more-open = false; }
    }

    Rectangle {
        x: Space.sm;
        width: parent.width - Space.sm * 2;
        height: grid.preferred-height;
        y: parent.height - self.height - Space.sm;
        background: Theme.raised;
        border-radius: Radius.lg;
        drop-shadow-offset-y: Elevation.overlay-y;
        drop-shadow-blur: Elevation.overlay-blur;
        drop-shadow-spread: Elevation.overlay-spread;
        drop-shadow-color: Elevation.overlay-color;
        border-width: Theme.dark ? 0px : 1px;
        border-color: Theme.line;
        inner-shadow-offset-y: Theme.dark ? 1px : 0px;
        inner-shadow-color: Theme.edge;

        // 吞掉面板上的点击,免得落到下面那层收起面板。
        TouchArea {}

        grid := VerticalLayout {
            padding: Space.sm;

            HorizontalLayout {
                spacing: Space.xs;
                for entry in Destinations.more: Rectangle {
                    horizontal-stretch: 1;
                    height: 68px;
                    border-radius: Radius.md;
                    background: Shell.destination == entry.id ? Theme.accent-wash
                        : (item.has-hover ? Theme.hover : transparent);

                    VerticalLayout {
                        alignment: center;
                        spacing: Space.xs;
                        HorizontalLayout {
                            alignment: center;
                            Icon {
                                size: 22px;
                                source: Shell.destination == entry.id ? entry.icon-on : entry.icon;
                                colorize: Shell.destination == entry.id ? Theme.accent-ink : Theme.text-dim;
                            }
                        }
                        Text {
                            text: entry.label;
                            color: Shell.destination == entry.id ? Theme.text : Theme.text-dim;
                            font-size: TextSize.caption;
                            font-weight: Shell.destination == entry.id ? Weight.semibold : Weight.regular;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }

                    item := TouchArea {
                        clicked => { Destinations.go(entry.id); }
                        accessible-role: tab;
                        accessible-label: entry.label;
                        accessible-checkable: true;
                        accessible-checked: Shell.destination == entry.id;
                        accessible-action-default => { Destinations.go(entry.id); }
                    }
                }
            }
        }
    }
}

// 搜索结果的三个页签:歌曲 / 歌手 / 歌单。
//
// 选的是「搜索结果里看哪一类」,与导航无关,只是同住一个文件。
export struct SearchTab {
    label: string,
}

export global SearchTabs {
    // 顺序即编号,与 ui/src/search.rs 的 Tab 一一对应。
    out property <[SearchTab]> items: [
        { label: "歌曲" },
        { label: "歌手" },
        { label: "歌单" },
    ];
}

// 下划线页签:字 + 淡色计数,选中那个加粗、底下一道强调色的线。
export component SearchTabBar inherits Rectangle {
    in property <int> current;
    // 每一类搜到几条,与 SearchTabs.items 同序。没搜过时都是 0,不画。
    in property <[int]> counts;

    callback selected(int);

    height: 42px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }

    HorizontalLayout {
        alignment: start;
        spacing: Shell.compact ? 22px : 28px;

        for item[i] in SearchTabs.items: tab-cell := Rectangle {
            width: tab-row.preferred-width;
            accessible-role: tab;
            accessible-label: item.label;
            accessible-checkable: true;
            accessible-checked: root.current == i;
            accessible-action-default => { root.selected(i); }

            tab-row := HorizontalLayout {
                spacing: 6px;
                Text {
                    text: item.label;
                    color: root.current == i ? Theme.text : Theme.text-dim;
                    font-size: TextSize.body;
                    font-weight: root.current == i ? Weight.semibold : Weight.regular;
                    vertical-alignment: center;
                }
                if root.counts[i] > 0: Text {
                    text: root.counts[i];
                    color: Theme.text-faint;
                    font-size: TextSize.caption;
                    vertical-alignment: center;
                }
            }
            if root.current == i: Rectangle {
                y: parent.height - 2px;
                height: 2px;
                border-radius: 1px;
                background: Theme.accent;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
        }
    }
}
