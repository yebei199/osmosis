// 最小化单窗口手机 UI:一个点击计数器。
// 计数值保存在 Rust 一侧(crates/app-core),以 property 形式推送到这里;
// 按钮点击通过 `bump` 回调传回去。

// slint 自带的 Inter 没有汉字,wasm 上又没有系统字体可回退,健康状态那行中文
// 会渲染成豆腐块。这里内嵌一份裁到只剩所需字符的子集(见 `just font-subset`),
// 由 slint 编译器把字节打进产物,再按 family 名引用。
import "../fonts/cjk-subset.ttf";

// 原生文本输入:热调 3D 场景参数用。不自己搓文本编辑(光标/选区/IME),用 Slint 自带的。
import { LineEdit } from "std-widgets.slint";

// 玻璃拟态:供 Home / Server 页透出颜色的极光背景,以及装内容的玻璃卡片。
import { AuroraBackground, GlassCard } from "glass.slint";

// 通用零件与控制条各自搬去了一个文件,本文件因此只剩「主窗口在摆什么」。
// 数据结构与 Nav 留在这里:它们是本窗口与 Rust 之间的契约,不是可复用的零件。
import { NavEntry, TrackRow, DeviceRow } from "types.slint";
import { HoverButton, NavItem, RoundControl, OutlinedText, DayNightSwitch, EntryCard } from "widgets.slint";
import { ControlCluster, SyncStrip } from "controls.slint";

global Nav {
    out property <[NavEntry]> items: [
        {
            label: "Home",
            icon: "M3 12 L12 4 L21 12 M5.5 10 L5.5 20 L18.5 20 L18.5 10",
        },
        {
            label: "Music",
            icon: "M9 18 L9 5 L20 3 L20 16 M9 18 A2.5 2.5 0 1 1 6.5 15.5 A2.5 2.5 0 0 1 9 18 M20 16 A2.5 2.5 0 1 1 17.5 13.5 A2.5 2.5 0 0 1 20 16",
        },
    ];
}

export component MainWindow inherits Window {
    // 帧率,由 Rust 测量并推送。仅在 `show-fps` 为真时被推送。
    in property <float> fps: 0;
    // 是否显示帧率读数。由 Rust 按 `SLINT_STUDY_FPS` 环境变量设置(见 lib.rs 的 fps_enabled)。
    in property <bool> show-fps: false;
    // 当前编译目标的平台名(wasm / android / linux / …),由 Rust 推送。
    in property <string> platform;
    // 搜索结果。每个字段都已在 Rust 侧格式化完毕,这里只负责摆。
    in property <[TrackRow]> tracks: [];
    // 播放状态的一行文案,由 Rust 根据 app-core 的 PlaybackState 渲染后推送。
    in property <string> playback-text;
    // 正在为播放页那首歌取直链/开流。播放页只有歌名、歌手、封面,没有别的位置
    // 能表达"按下去了、正在办",而状态行长在音乐页上、被播放页盖住。
    in property <bool> now-loading: false;
    // 断流横幅的文案。空字符串 = 不显示(见 docs/adr/0013)。
    // in-out:关闭按钮由这一侧清空,不必为「关掉一条提示」往 Rust 回一趟。
    in-out property <string> banner-text;
    // 是否正在出声。决定控制条中键画 ⏸ 还是 ▶。
    in property <bool> is-playing: false;
    // 随机播放开关(日月开关的状态)。Rust 读它决定队列洗不洗牌。
    in-out property <bool> shuffle-on: false;
    // 同播名册里除本机之外的在线设备,由信令服务端主动推送(见 crates/syncplay)。
    in property <[DeviceRow]> devices: [];
    // 同播状态的一行文案,由 Rust 根据 syncplay 的 Role 渲染后推送。
    in property <string> sync-text;
    // 当前选中的导航页:0=Home、1=Music。由左侧导航栏点击设置。
    in-out property <int> current-tab: 0;
    // 版式(Layout Mode):窄→紧凑(底部导航),宽→侧栏。**由运行时窗口宽度决定,不由端决定**
    // —— 桌面把窗口拖窄一样变成紧凑版式,这既是要的体验,也是唯一能在桌面验证移动版式的办法。
    // 见 docs/adr/0007。600px 是 Material 的标准断点:手机竖屏(~393dp)紧凑,
    // 手机横屏(~850dp)回到侧栏 —— 横屏本来就矮,底栏再吃 64px 太亏。
    //
    // 用 changed 回调赋值、而不是写成 `compact: root.width < 600px` 的绑定:版式一变,子元素的
    // 约束(侧栏在不在、底栏在不在)就变,窗口的 layoutinfo 跟着变,宽度又回头喂给 compact ——
    // 那是一个真的求值环,Slint 1.18 起会警告并可能在运行时 panic。命令式赋值把环剪断:
    // 宽度先定下来,再单向推出版式。
    property <bool> compact;
    init => { root.compact = root.width < 600px; }
    changed width => { root.compact = root.width < 600px; }

    // ── 播放页(CONTEXT.md「播放页」):控制条展开的全窗沉浸层 ──
    // 展开/收起全在 .slint 内部;操作类功能仍由覆层里的 ControlCluster 走同一组
    // 回调 —— docs/adr/0010 的「功能等价路径」。
    in-out property <bool> play-page-open: false;
    // warp 视觉纹理,render3d 的 WarpPass 每帧推送(见 crates/render3d/src/warp.rs)。
    // 无 GPU 的端(web / ios)恒为空图(width == 0),覆层退回纯色底,`.slint` 里
    // 零平台判断 —— 这就是「余端 graceful 缺省」的落点。
    in property <image> viz-bg;
    // 播放页粒子场景(透明底)与其遮挡层,render3d 的 viz 模式每帧推送。
    // 空图时覆层退回第一步的 warp 形态 —— 同一个「余端 graceful 缺省」。
    in property <image> viz-scene;
    in property <image> viz-occluder;
    // 歌词块的几何量,逻辑像素。**这里是唯一真相**:歌词摆位与遮挡层的裁剪
    // 负偏移都从这几个值算,别在别处重抄。歌词是播放页现在唯一的深度卡片 ——
    // 粒子从字的前后穿过。
    //
    // 曾经这里还有一张 220px 的封面卡,它是第一张深度卡片。封面点云上线之后它成了
    // 同一张图的第二份拷贝,还正压在点云中央,遂删除(见 `docs/adr/0010` 的记录)。
    //
    // 歌词块的高度**钉死**,不随文本长度变。平台会把整段词压成「一行」(实测见过
    // 198 字符的行),放任折行会撑破布局、压到控制条上;超出的部分省略号收掉。
    // 原文最多三行、译文最多两行,按各自字号的行高估。
    // 播放页控制条的高度。紧凑版拆两行(见那一段的注释),故高一档。
    out property <length> viz-controls-h: root.compact ? 128px : 84px;
    // 两颗只在播放页出现的键,图形在宽/紧凑两处版式里各用一次 —— 常量化,
    // 免得改一处漏一处。
    out property <string> preset-icon: "M12 4 A8 8 0 1 1 4 12 L7 12 L3 17 L-1 12 L2 12 A10 10 0 1 0 12 2 Z";
    out property <string> collapse-icon: "M5 8 L19 8 L12 17 Z";

    out property <length> viz-lyric-line-h: root.compact ? 84px : 120px;
    out property <length> viz-lyric-tr-h: root.compact ? 40px : 46px;
    out property <length> viz-lyric-h: root.viz-lyric-line-h + 10px + root.viz-lyric-tr-h;
    out property <length> viz-lyric-y: (root.height - root.viz-lyric-h) / 2 + 60px;
    // 歌名与歌手在歌词块上方,与它一起居中成一组。
    out property <length> viz-title-y: root.viz-lyric-y - 96px;
    // 当前视觉预设的编号。名字见 viz-preset-names,与 render3d 的着色器分支
    // 手工对齐 —— 那边按下标分支,加档时两处都要动。
    out property <int> viz-preset: 0;
    // 预设名,列表里逐项显示。只剩「封面」一档 —— 另外五档让粒子离开封面平面,
    // 那张图就散了,而点云存在的理由正是封面本身(见 docs/adr/0014)。
    out property <[string]> viz-preset-names: ["封面"];
    // 预设列表是不是展开着。私有:只有这一层自己用,Rust 侧不认识它。
    property <bool> viz-preset-list-open: false;
    // 视觉区里的指针,位置归一到 0..1(左上原点)。Rust 每帧在 seam 处读它,
    // 换算成点云平面上的坐标推给涟漪(见 crates/render3d::cloud)。
    // `active` 在指针离开时落回假 —— 指针不在了就不该还有一处粒子被顶着。
    out property <float> viz-pointer-x: 0.5;
    out property <float> viz-pointer-y: 0.5;
    out property <bool> viz-pointer-down: false;
    out property <bool> viz-pointer-active: false;
    // 正在播的封面(已解码)。取不到 / 解不出时为空图 —— 控制条上的小图用它。
    in property <image> cover-art;
    // 正在播的歌名与歌手,play_current 推送。任意 CJK,不指定子集字体。
    in property <string> now-title;
    in property <string> now-artists;
    // 当前歌词行与其译文,Rust 每帧按播放位置选出后推送(见 app_core::current_line)。
    // 没有歌词、或还在前奏时为空串,歌词区整块让位。
    in property <string> lyric-line;
    in property <string> lyric-translation;
    // 省电门的 .slint 半边:展开 ∧ 播放。第三条「窗口可见」在 Rust 侧
    // (lib.rs 渲染通知回调)判,三条齐了才渲 warp,暂停定格在最后一帧。
    out property <bool> viz-active: root.play-page-open && root.is-playing;

    // ── 宽版式侧栏「液态玻璃 metaball 选中器」──
    // 视觉由 render3d 的独立 wgpu pass 画进 nav-bg(见 crates/render3d/src/navglass),Slint 只出
    // 几何与交互。侧栏槽位常量是**唯一真相**:布局与选中块位置都从这里算,不各写各的。
    property <length> nav-pad: 8px;
    property <length> nav-gap: 6px;
    // 单个导航项高,也是选中块的参考高。out:Rust 读它定块尺寸。
    out property <length> nav-slot-h: 68px;
    // 侧栏纹理尺寸(逻辑像素)。Rust 每帧乘缩放系数得物理像素当目标纹理尺寸。
    out property <length> nav-w: 96px;
    out property <length> nav-h: content.height;
    // 紧凑版式(手机底栏)没有这条侧栏,Rust 据此整段跳过导航选中器的渲染。
    out property <bool> nav-visible: !root.compact;
    // 当前选中槽的中心 y(逻辑像素,相对侧栏顶):pad + i·(项高+间距) + 项高/2。
    property <length> nav-target-y: root.nav-pad + root.current-tab * (root.nav-slot-h + root.nav-gap) + root.nav-slot-h / 2;
    // metaball 的头(快)/尾(慢):都朝 nav-target-y 动,快慢不同 → 行走时一前一后被 shader
    // 的 smooth-union 拉出胶着的颈,静止时重合成单块。out:Rust 每帧读这两个动画值喂 shader。
    // 用两个不同时长的 animate,避开「同一处理器里 progress 先置 0 再置 1 会被合并、动不起来」那个坑。
    out property <length> nav-lead-y: root.nav-target-y;
    out property <length> nav-lag-y: root.nav-target-y;
    animate nav-lead-y { duration: 240ms; easing: ease-out; }
    animate nav-lag-y { duration: 440ms; easing: ease-out; }
    // render3d 每帧(转场期间)渲出的侧栏背景纹理。非 GPU 构建恒为空图(width 0),
    // 侧栏退回 Slint 平底 + NavItem 自带高亮(见侧栏与 NavItem)。
    in-out property <image> nav-bg;
    // 用关键词搜歌。
    callback search(string);
    // 取今日推荐,结果落进同一个 tracks 列表。
    callback daily();
    // 取我喜欢的音乐,同上。
    callback liked();
    // 进了 Music 页。当天还没拉过推荐时由 Rust 侧补一次 daily —— 判断在那边,
    // 因为「今天」和「上次拉的日期」都不是界面该记的东西。
    callback music-shown();
    // 放某首歌。参数是 TrackRow 的 id。
    callback play(string);
    // 播放/暂停。正在收听同播时按下等于退出收听(见 CONTEXT.md「听众」)。
    callback toggle-play();
    // 队列内切歌。
    callback next-track();
    callback prev-track();
    // 随机开关拨动之后。新状态在 shuffle-on 里。
    callback shuffle-toggled();
    // 把正在放的这首推给某台设备。参数是 DeviceRow 的 id。
    callback push-to(string);

    title: "Slint Study";
    background: #0f1117;
    // 开窗即宽版式;最小尺寸故意放到手机竖屏那么窄 —— 桌面上把窗口拖窄就能直接看到
    // 紧凑版式,不必开模拟器。
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 360px;
    min-height: 520px;

    // 顶层恒为一个 VerticalLayout(主体行 + 可选底栏)→ 窗口撑满且可调整大小。
    VerticalLayout {

        // ── 主体行:宽版式是「侧栏 + 内容」,紧凑版式只有内容 ──
        HorizontalLayout {
            vertical-stretch: 1;
            padding-top: root.safe-area-insets.top;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            // 紧凑版式的底部 inset 归底栏管 —— 它的背景要铺到手势条底下,不能在这里先留白,
            // 否则手势条那一条会露出窗口底色,全面屏观感碎掉。
            padding-bottom: root.compact ? 0 : root.safe-area-insets.bottom;

            // ── 侧栏(宽版式)──
            // ponytail: 深色底不铺到左刘海底下(padding-left 已经把它推开了)。桌面 inset 恒 0、
            // 安卓竖屏没有左 inset,只有「横屏 + 左刘海」这一种情况会露一条底色,不值得为它
            // 把侧栏也拆成「背景铺满 + 内部 padding」。
            if !root.compact: Rectangle {
                width: root.nav-w;
                // 兜底平底:非 GPU 构建就是这层纯色 + NavItem 自带高亮。
                background: #140f0b;

                // GPU 液态玻璃选中器:转场时 render3d 渲进 nav-bg,盖在平底之上、图标之下。
                // 非 GPU 构建 nav-bg 为空(width 0),这个 Image 不显示,露出上面的平底。
                Image {
                    source: root.nav-bg;
                    width: 100%;
                    height: 100%;
                    image-fit: fill;
                }

                VerticalLayout {
                    padding: root.nav-pad;
                    spacing: root.nav-gap;
                    alignment: start;

                    for item[i] in Nav.items: NavItem {
                        height: root.nav-slot-h;
                        label: item.label;
                        icon: item.icon;
                        active: root.current-tab == i;
                        // GPU 构建里选中高亮由玻璃提供,压掉自带 active 底,免得叠两遍。
                        gpu-selected: root.nav-bg.width > 0;
                        clicked => { root.current-tab = i; }
                    }
                }
            }

            // ── 内容区。两页共用这块矩形,按 current-tab 切换子内容 ──
            content := Rectangle {
                horizontal-stretch: 1;

                // 极光背景:玻璃卡片透出来的颜色全来自这里。3D 页不铺 —— 那边背后是
                // bevy 画面,本来就有内容可透。
                AuroraBackground {
                    width: 100%;
                    height: 100%;
                }

                // Home:入口卡片页。标题 + 两扇门(Music / 3D)。
                // 与左侧导航栏功能重复,是刻意的:这里是"落地页",导航栏是"随时切"。
                if root.current-tab == 0: VerticalLayout {
                    alignment: center;
                    spacing: 28px;

                    Text {
                        text: "Slint on " + root.platform;
                        color: #e6e8ef;
                        font-size: 22px;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 20px;

                        EntryCard {
                            label: "Music";
                            icon: "M9 18 L9 5 L20 3 L20 16 M9 18 A2.5 2.5 0 1 1 6.5 15.5 A2.5 2.5 0 0 1 9 18 M20 16 A2.5 2.5 0 1 1 17.5 13.5 A2.5 2.5 0 0 1 20 16";
                            clicked => { root.current-tab = 1; }
                        }
                    }
                }

                // Music:搜歌 + 点一首放出声。整页可滚,不裹玻璃卡片 ——
                // 列表要吃满可用高度,套进定宽卡片在手机上只剩三四行可见。
                if root.current-tab == 1: VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // 每次进这一页都触发(切页时整块重建)。当天还没拉过推荐就
                    // 替用户拉一次 —— 空着一页只有一行「点一首歌开始」不是个好开局。
                    // 「当天拉过就不动」的判断在 Rust 侧,搜索结果因此不会被冲掉。
                    init => { root.music-shown(); }

                    HorizontalLayout {
                        spacing: 8px;

                        // 搜索框。歌名是任意 CJK,不能指定子集字体,
                        // 否则输入的字大多不在子集里,直接是豆腐块。
                        keyword := LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "Search";
                            accepted => { root.search(self.text); }
                        }
                        // 三个按钮压窄:默认 220px 一排放不下,手机上更是直接溢出。
                        // 紧凑版再收一档,给搜索框留出还能打字的宽度。
                        HoverButton {
                            width: root.compact ? 60px : 84px;
                            text: "Go";
                            clicked => { root.search(keyword.text); }
                        }
                        HoverButton {
                            width: root.compact ? 68px : 92px;
                            text: "Daily";
                            clicked => { root.daily(); }
                        }
                        HoverButton {
                            width: root.compact ? 68px : 92px;
                            text: "Liked";
                            clicked => { root.liked(); }
                        }
                    }

                    // 播放状态行。文案是硬编码中文,走子集字体;
                    // 高度钉死,免得文案变长把下面的列表顶来顶去。
                    Text {
                        text: root.playback-text;
                        font-family: "Maple Mono NF CN";
                        color: #9aa0b4;
                        font-size: 13px;
                        height: 20px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // 同播状态行:推给几台 / 正在收听谁 / 出了什么错。
                    Text {
                        text: root.sync-text;
                        font-family: "Maple Mono NF CN";
                        color: #9aa0b4;
                        font-size: 13px;
                        height: 20px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Flickable {
                        vertical-stretch: 1;
                        content-height: results.preferred-height;

                        results := VerticalLayout {
                            spacing: 4px;
                            alignment: start;

                            // 加载中的那一行自己亮起来,并在行尾标出来。这是用户
                            // 手指底下唯一看得见的反馈 —— 没有它,网络一慢人就会连点。
                            for row[i] in root.tracks: Rectangle {
                                height: 52px;
                                background: row.loading ? #d9a86c26
                                    : (touch.has-hover ? #ffffff14 : #ffffff08);
                                border-radius: 8px;
                                border-width: row.loading ? 1px : 0;
                                border-color: #d9a86c66;
                                animate background { duration: 160ms; easing: ease-out; }

                                touch := TouchArea {
                                    clicked => { root.play(row.id); }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        // 歌名与歌手来自平台,是任意 CJK/日文 ——
                                        // 不指定 font-family,落到系统字体。
                                        // web 端 wasm 里没有系统字体,那边会是豆腐块,
                                        // 已知缺口,见 README「音乐链路」。
                                        Text {
                                            text: row.title;
                                            color: #e6e8ef;
                                            font-size: 14px;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.artists;
                                            color: #9aa0b4;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                    // 时长让位给「加载中」:两个都摆会把歌名挤窄,
                                    // 而正在加载时时长不是用户在等的信息。
                                    Text {
                                        text: row.loading ? "加载中…" : row.duration;
                                        font-family: row.loading ? "Maple Mono NF CN" : "";
                                        color: row.loading ? #d9cdbd : #9aa0b4;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // 控制条:上一首 / 播放暂停 / 下一首 / 日月随机开关 │ 同播设备。
                    //
                    // 宽版一排放下;紧凑版(手机)拆两行 —— 一排的最小宽度约 470px,
                    // 而手机内容区只有 ~360px,硬挤会把按钮画出屏幕右缘。
                    controls := Rectangle {
                        height: root.compact ? 116px : 60px;
                        border-radius: 16px;
                        background: #17110daa;
                        border-width: 1px;
                        border-color: #ffffff10;

                        if !root.compact: HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;

                            ControlCluster {
                                alignment: start;
                                is-playing: root.is-playing;
                                shuffle-on <=> root.shuffle-on;
                                prev => { root.prev-track(); }
                                toggle => { root.toggle-play(); }
                                next => { root.next-track(); }
                                shuffle-toggled => { root.shuffle-toggled(); }
                            }
                            // 展开播放页:向上的小三角。「正在播放」是状态,展开是看它的方式。
                            RoundControl {
                                icon: "M12 7 L19 16 L5 16 Z";
                                clicked => { root.play-page-open = true; }
                            }
                            SyncStrip {
                                alignment: end;
                                devices: root.devices;
                                push-to(id) => { root.push-to(id); }
                            }
                        }

                        if root.compact: VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                ControlCluster {
                                    is-playing: root.is-playing;
                                    shuffle-on <=> root.shuffle-on;
                                    prev => { root.prev-track(); }
                                    toggle => { root.toggle-play(); }
                                    next => { root.next-track(); }
                                    shuffle-toggled => { root.shuffle-toggled(); }
                                }
                                // 展开播放页,同宽版那颗。
                                RoundControl {
                                    icon: "M12 7 L19 16 L5 16 Z";
                                    clicked => { root.play-page-open = true; }
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                SyncStrip {
                                    devices: root.devices;
                                    push-to(id) => { root.push-to(id); }
                                }
                            }
                        }
                    }
                }

                // fps 浮层:content 的最后一个子元素 → 画在最上层。
                // 左上角,所有页可见。诚实即时帧率(见 lib.rs 的 fps 模块)。
                if root.show-fps: Text {
                    x: 8px;
                    y: 8px;
                    text: "FPS " + round(root.fps);
                    color: #51cf66;
                    font-size: 14px;
                    font-weight: 700;
                }
            }
        }

        // ── 底栏(紧凑版式)──
        // 背景铺满到屏幕底边,内部 padding-bottom 把图标顶到手势条之上 —— 与 MainActivity 的
        // edge-to-edge 一致:手势条底下是导航栏的深色,不是一条露出来的窗口底色。
        if root.compact: Rectangle {
            height: 64px + root.safe-area-insets.bottom;
            background: #140f0b;
            HorizontalLayout {
                padding-left: root.safe-area-insets.left + 8px;
                padding-right: root.safe-area-insets.right + 8px;
                padding-bottom: root.safe-area-insets.bottom;
                spacing: 4px;

                for item[i] in Nav.items: NavItem {
                    horizontal-stretch: 1;
                    label: item.label;
                    icon: item.icon;
                    active: root.current-tab == i;
                    clicked => { root.current-tab = i; }
                }
            }
        }
    }

    // ── 播放页覆层:盖住包括导航在内的整个窗口(CONTEXT.md「播放页」)──
    // 五层合成:warp 背景 → 封面点云 → 歌名与歌词 → 遮挡层(裁到歌词)→ 控制簇。
    // 歌词是深度卡片:遮挡层只含比它更近的粒子,盖上来就是「粒子从字前面掠过」;
    // 功能(控制簇)永远在最上层 2D、点得到 —— docs/adr/0010。
    if root.play-page-open: FocusScope {
        // 抢焦点是这层能收到按键的前提 —— 焦点留在搜索框上的话,下面那个
        // key-pressed 一次都不会触发。
        init => { self.focus(); }

        // 安卓的返回键、桌面的 Esc:都先收起播放页。
        //
        // 安卓那条不是锦上添花 —— 上游把 Back 派成 Key.Back,**只有我们不接**
        // 才去 finish_activity()(见 slint 的 android-activity 后端
        // callback_on_back_invoked)。不接就是「按返回直接退应用」,而播放页是
        // 全屏沉浸层,那不是任何人对返回的预期。
        key-pressed(event) => {
            if (event.text == Key.Back || event.text == Key.Escape) {
                root.play-page-open = false;
                return accept;
            }
            return reject;
        }

      Rectangle {
        // 纯深色底。反馈 warp 曾铺在这里当全屏背景,现在收进了播放键 ——
        // 封面点云自己就有颜色,再叠两圈青紫只是把主体糊掉。
        background: #0b0d13;

        // 封面点云:透明底,叠在 warp 上。远侧粒子在这层被歌词盖住,
        // 近侧粒子由下面的遮挡层重新盖回字之上 —— 深度由此闭环。
        if root.viz-scene.width > 0: Image {
            width: 100%;
            height: 100%;
            image-fit: fill;
            source: root.viz-scene;
        }

        // 视觉区的指针:位置归一化后交给点云(见 crates/render3d::cloud),
        // **不**收起播放页 —— 点这里是在拨弄粒子,收起走控制簇里的向下三角。
        // 压在视觉之上、内容之下;控制键各有自己的 TouchArea,不会误触到这层。
        TouchArea {
            moved => {
                root.viz-pointer-x = self.mouse-x / root.width;
                root.viz-pointer-y = self.mouse-y / root.height;
                root.viz-pointer-down = self.pressed;
            }
            pointer-event(event) => {
                root.viz-pointer-x = self.mouse-x / root.width;
                root.viz-pointer-y = self.mouse-y / root.height;
                root.viz-pointer-down = self.pressed;
                root.viz-pointer-active = event.kind != PointerEventKind.up;
            }
        }

        // 歌名与歌手:歌词块上方。平台数据任意 CJK,不指定子集字体。
        OutlinedText {
            y: root.viz-title-y;
            width: 100%;
            height: 30px;
            text: root.now-title;
            text-color: #e6e8ef;
            font-size: 22px;
        }
        OutlinedText {
            y: root.viz-title-y + 34px;
            width: 100%;
            height: 20px;
            text: root.now-artists;
            text-color: #9aa0b4;
            font-size: 14px;
        }

        // 取直链/开流的那几秒:点下去了、正在办。
        // 只在加载时存在 —— 常驻一个空文本会让播放页每帧多一层要合成的东西,
        // 而这一层还压在点云上。文案硬编码中文,走子集字体。
        if root.now-loading: OutlinedText {
            y: root.viz-title-y + 58px;
            width: 100%;
            height: 18px;
            text: "加载中…";
            font-family: "Maple Mono NF CN";
            text-color: #d9a86c;
            font-size: 13px;
        }

        // 歌词:播放页现在唯一的深度卡片。当前行 + 译文,居中排在歌名下方;
        // 取不到歌词或还在前奏时为空串,这块自然让位(粒子也就没有可穿的字)。
        if root.lyric-line != "": VerticalLayout {
            y: root.viz-lyric-y;
            height: root.viz-lyric-h;
            alignment: start;
            spacing: 10px;

            // 手机宽度上 30px 会把一行英文歌词截掉一半(小米13 真机实测),故紧凑版式
            // 收一档。折行让整句读得完,高度钉死则让超长的「一行」不至于撑破布局。
            OutlinedText {
                width: root.width - 32px;
                x: 16px;
                height: root.viz-lyric-line-h;
                text: root.lyric-line;
                text-color: #f2f5ff;
                font-size: root.compact ? 21px : 30px;
                // 歌词字大,描边跟着粗一档才压得住 —— 细描边在 30px 的笔画上
                // 只是一圈灰边,拉不开对比。
                outline: 2px;
                wrap: word-wrap;
            }
            OutlinedText {
                width: root.width - 32px;
                x: 16px;
                height: root.viz-lyric-tr-h;
                text: root.lyric-translation;
                text-color: #aab2c8;
                font-size: root.compact ? 14px : 16px;
                // 顶对齐而非居中:定高 + elide 时,居中裁的是**中间那一截** ——
                // 开头没了、结尾省略号,读起来是断头话(issue #21 实拍)。顶对齐让
                // 溢出只从末尾省略,至少从头读得起。代价是单行译文比居中低不到 10px。
                vertical-alignment: top;
                wrap: word-wrap;
            }
        }

        // 遮挡层:整窗大小的图必须与场景那张逐像素对齐,故用负偏移推回窗口原点,
        // 再裁到歌词矩形 —— 不裁的话近处的粒子会连控制簇一起盖住,而控制簇是
        // 界面外壳、不在场景里。
        if root.viz-occluder.width > 0 && root.lyric-line != "": Rectangle {
            y: root.viz-lyric-y;
            width: root.width;
            height: root.viz-lyric-h;
            clip: true;

            Image {
                y: -root.viz-lyric-y;
                width: root.width;
                height: root.height;
                image-fit: fill;
                source: root.viz-occluder;
            }
        }

        // 功能层:同一组回调,与音乐页的控制条完全等价。
        //
        // 宽版一排放下;紧凑版(手机)拆两行 —— 与音乐页同一个理由,只是这里的
        // 一排更宽:播放键接了 warp 之后是 68px,比别的键大一圈。挤在一排的话
        // 最右边的 ▼ 会被推出屏幕(小米13 真机实测),而那是收起播放页唯一的按键。
        HorizontalLayout {
            y: root.height - root.viz-controls-h
                - root.safe-area-insets.bottom - 24px;
            height: root.viz-controls-h;
            alignment: center;
            Rectangle {
                height: root.viz-controls-h;
                border-radius: 16px;
                background: #17110daa;
                border-width: 1px;
                border-color: #ffffff10;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        ControlCluster {
                            is-playing: root.is-playing;
                            shuffle-on <=> root.shuffle-on;
                            // 只有播放页接 warp:音乐页的那两处控制簇不该为一个
                            // 小圆点养一条 wgpu pass。
                            pulse: root.viz-bg;
                            prev => { root.prev-track(); }
                            toggle => { root.toggle-play(); }
                            next => { root.next-track(); }
                            shuffle-toggled => { root.shuffle-toggled(); }
                        }
                        if !root.compact: RoundControl {
                            icon: root.preset-icon;
                            clicked => { root.viz-preset-list-open = !root.viz-preset-list-open; }
                        }
                        if !root.compact: RoundControl {
                            icon: root.collapse-icon;
                            clicked => { root.play-page-open = false; }
                        }
                    }
                    if root.compact: HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        // 换视觉预设:点开一列名字来选。参照物那整个「视觉控制台」
                        // 是另一件事,这里只要一个选得动的入口。
                        RoundControl {
                            icon: root.preset-icon;
                            clicked => { root.viz-preset-list-open = !root.viz-preset-list-open; }
                        }
                        // 收起播放页:向下的小三角,与展开用的向上三角对称。
                        // 收起是操作,所以它在最上层 2D、永远点得到(docs/adr/0010)。
                        RoundControl {
                            icon: root.collapse-icon;
                            clicked => { root.play-page-open = false; }
                        }
                    }
                }

                // 视觉预设的选择列表。点控制簇里的预设键弹出,选完收起。
                // 摆在控制簇**上方**:列表向上长,不会把控制键顶出屏幕,
                // 也不遮住它们 —— 选的时候还看得见自己在放什么。
                //
                // 宽版与紧凑版共用这一个:两处的预设键开合的是同一个属性,
                // 列表本身只有一份。
                if root.viz-preset-list-open: Rectangle {
                    width: 150px;
                    height: root.viz-preset-names.length * 38px + 12px;
                    x: (parent.width - self.width) / 2;
                    y: parent.height - root.viz-controls-h
                        - root.safe-area-insets.bottom
                        - self.height - 34px;
                    background: #12141cee;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #ffffff1f;

                    VerticalLayout {
                        padding: 6px;

                        for name[i] in root.viz-preset-names: Rectangle {
                            height: 38px;
                            border-radius: 8px;
                            // 当前项高亮。只有一档时它恒亮 —— 那正是"你在这一档"。
                            background: i == root.viz-preset
                                ? #d9a86c33
                                : (item-touch.has-hover ? #ffffff12 : #00000000);
                            animate background { duration: 120ms; easing: ease-out; }

                            Text {
                                text: name;
                                // 预设名是硬编码中文,走子集字体。
                                font-family: "Maple Mono NF CN";
                                font-size: 14px;
                                color: i == root.viz-preset ? #f0e6d8 : #b9bdcc;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            item-touch := TouchArea {
                                clicked => {
                                    root.viz-preset = i;
                                    root.viz-preset-list-open = false;
                                }
                            }
                        }
                    }
                }
            }
        }
      }
    }

    // ── 断流横幅:压在所有页之上 ──
    // 状态行长在音乐页上,而播放页是覆层、盖住它 —— 断流恰恰发生在听歌时,
    // 写在状态行等于说给没人在的房间(docs/adr/0013)。
    // 摆窗口顶端:控制簇、收起键、底栏全在下半边,压不着任何操作。
    if root.banner-text != "": banner := Rectangle {
        y: root.safe-area-insets.top + 10px;
        x: (parent.width - self.width) / 2;
        width: min(parent.width - 32px, 420px);
        height: 44px;
        background: #33201fee;
        border-radius: 10px;
        border-width: 1px;
        border-color: #7a4f4a;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 6px;
            spacing: 6px;

            Text {
                text: root.banner-text;
                // 文案是硬编码中文,与状态行同一套子集字体。
                font-family: "Maple Mono NF CN";
                font-size: 13px;
                color: #f2dcd8;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            // 关掉。清空文案就等于收起,不必回 Rust 绕一圈。
            RoundControl {
                diameter: 32px;
                transparent-base: true;
                icon: "M7 7 L17 17 M17 7 L7 17";
                clicked => { root.banner-text = ""; }
            }
        }
    }
}
