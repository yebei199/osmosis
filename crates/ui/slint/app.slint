// 最小化单窗口手机 UI:一个点击计数器。
// 计数值保存在 Rust 一侧(crates/app-core),以 property 形式推送到这里;
// 按钮点击通过 `bump` 回调传回去。

// slint 自带的 Inter 没有汉字,wasm 上又没有系统字体可回退,健康状态那行中文
// 会渲染成豆腐块。这里内嵌一份裁到只剩所需字符的子集(见 `just font-subset`),
// 由 slint 编译器把字节打进产物,再按 family 名引用。
import "../fonts/cjk-subset.ttf";

// 带悬浮抬起效果的按钮:悬停时背景变亮、阴影变大变柔,呈现出凸起的
// 观感;按下时变暗下沉。全部带动画过渡。
//
// 触摸设备上没有"悬停但未按下"这个状态,因此只会看到按下时的下沉效果。
// 这是刻意的优雅降级,不是缺陷:slint 在触摸按下时同样会置 has-hover,
// 但优先级更高的 `down` 分支盖住了它。
component HoverButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    property <bool> hovered: touch.has-hover;
    property <bool> down: touch.pressed;

    height: 56px;
    width: 220px;
    border-radius: 14px;
    background: down ? #2f45c5 : hovered ? #5c7cfa : #4263eb;
    drop-shadow-color: #4263eb80;
    drop-shadow-blur: down ? 4px : hovered ? 24px : 10px;
    drop-shadow-offset-y: down ? 1px : hovered ? 8px : 3px;
    animate background, drop-shadow-blur, drop-shadow-offset-y {
        duration: 160ms;
        easing: ease-out;
    }

    Text {
        text: root.text;
        color: #ffffff;
        font-size: 18px;
        font-weight: 600;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    // 由 Rust 推送。
    in property <int> count: 0;
    // 帧率,由 Rust 测量并推送。仅在 `debug-fps` feature 下有意义。
    in property <float> fps: 0;
    // 是否显示帧率读数。由 Rust 根据 `debug-fps` feature 设置。
    in property <bool> show-fps: false;
    // 服务端健康状态的一行文案,由 Rust 根据领域状态渲染后推送。
    in property <string> health-text;
    // 用户点击触发,在 Rust 侧处理。
    callback bump();
    // 请求一次 GET /health。
    callback check-health();

    title: "Slint Study";
    background: #0f1117;

    // 只有一个顶层布局,窗口才会自动撑满且保持可调整大小。
    // (这里如果放一个兄弟元素,窗口就会变成固定大小。)
    VerticalLayout {
        // 基础内边距叠加安全区域,让内容在全面屏 Android 窗口上
        // 不被状态栏和导航栏遮挡。
        padding-top: 8px + root.safe-area-insets.top;
        padding-bottom: 32px + root.safe-area-insets.bottom;
        padding-left: 16px + root.safe-area-insets.left;
        padding-right: 16px + root.safe-area-insets.right;

        // 帧率读数,左上角显示。
        if root.show-fps: Text {
            text: "FPS " + round(root.fps);
            color: #51cf66;
            font-size: 14px;
            font-weight: 700;
        }

        // 主内容区,在帧率行下方的剩余空间中居中。
        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 24px;

            Text {
                text: "Slint on Android";
                color: #e6e8ef;
                font-size: 22px;
                horizontal-alignment: center;
            }

            Text {
                text: root.count;
                color: #7aa2f7;
                font-size: 72px;
                horizontal-alignment: center;
            }

            // 把固定宽度的按钮包在一个可伸缩的行里;否则它的 220px
            // 宽度会限制整列,进而把窗口宽度锁死。
            HorizontalLayout {
                alignment: center;
                HoverButton {
                    text: "Tap me";
                    clicked => { root.bump(); }
                }
            }

            // 穿透式示例:一次真实的网络往返,验证 contract → api →
            // app-core → ui 整条链路在各端都通。
            HorizontalLayout {
                alignment: center;
                HoverButton {
                    text: "Check server";
                    clicked => { root.check-health(); }
                }
            }

            // 全 UI 唯一一处中文。子集字体连 ASCII 一起裁了,所以这行中英混排
            // 的文案整体落在同一个字体上,不依赖 slint 的逐字形回退。
            Text {
                text: root.health-text;
                font-family: "Maple Mono NF CN";
                color: #9aa0b4;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
