// 主窗口:导航、内容面板、控制条与各种浮层摆在哪。

// 界面唯一的字族 Osmosis Sans(三档字重)。`@osmosis-fonts` 由 build.rs 按目标平台指到
// fonts/desktop(合并了中日韩子集)或 fonts/android(只有拉丁,中文走系统 Noto Sans CJK)。
import "@osmosis-fonts/osmosis-sans-400.ttf";
import "@osmosis-fonts/osmosis-sans-600.ttf";
import "@osmosis-fonts/osmosis-sans-700.ttf";

// 原生文本输入:热调 3D 场景参数用。不自己搓文本编辑(光标/选区/IME),用 Slint 自带的。
import { ListView, Palette } from "std-widgets.slint";


// 通用零件与控制条各自搬去了一个文件,本文件因此只剩「主窗口在摆什么」。
// 数据结构与 Nav 留在这里:它们是本窗口与 Rust 之间的契约,不是可复用的零件。
import { TrackRow, DeviceRow, PlaylistRow, ArtistRow, ArtistRankRow, LyricRow } from "types.slint";
import { Profile } from "globals/profile.slint";
import { Player } from "globals/player.slint";
import { Viz } from "globals/viz.slint";
import { Shell } from "globals/shell.slint";
import { Library } from "globals/library.slint";
import { Session } from "globals/session.slint";
import { PlaylistList } from "playlists.slint";
import { ArtistList } from "artists.slint";
import { NavItem, IconButton, Button, TextField, GlassPill } from "widgets.slint";
import { Icon, Icons } from "icons.slint";
import { PlayerBar, BarMetrics } from "playerbar.slint";
import { Theme, Type, Motion, Space, Radius, TextSize, Layout, Weight, Elevation } from "theme.slint";
// 再导出一次:全局要从**入口文件**导出,slint 才会给 Rust 生成访问器
// (crates/ui/src/theme.rs 靠 `ui.global::<Theme>()` 写那一位布尔值)。
export { Theme }
// 个人页的数据面同理:Rust 靠 `ui.global::<Profile>()` 写它。
export { Profile }
// 登录态同理:Rust 靠 `ui.global::<Session>()` 读写它。
export { Session }
// 曲库那一面同理:Rust 靠 `ui.global::<Library>()` 读写它。
export { Library }
export { Shell }
export { Viz }
import { DayNight } from "globals/daynight.slint";
export { DayNight }
export { Player }
import { LoginPage } from "login.slint";
import { Destinations, SideNavRow, MorePanel } from "musicnav.slint";
// Rust 靠 `ui.global::<Destinations>()` 读导航表(测试与调试开关)。
export { Destinations }
import { TrackList } from "tracklist.slint";
import { SettingsPage } from "settings.slint";
import { BlockedPage } from "blocked.slint";
import { ProfilePage } from "profile.slint";
import { LyricsPage } from "lyrics.slint";
import { MusicPage, Downloads } from "musicpage.slint";
export { Downloads }
import { PlayPage } from "playpage.slint";

export component MainWindow inherits Window {
    // 不设的话落到系统默认字体,这台开发机上就是等宽的 Maple Mono(MEO-1877 F-001)。
    default-font-family: Type.sans;
    // 只观察需要提醒的组投影，播放版本、曲目与进度不重新展开。
    property <string> group-notice-state: Shell.group-banner + "\n" + Shell.output-text
        + "\n" + Shell.group-text + (Shell.group-joinable ? "join" : "leave")
        + (Shell.output-stale ? "stale" : "online");
    // 完整提示与面板独立，读面板时状态更新保留面板。
    property <bool> group-expanded: false;
    property <bool> group-panel-open: false;
    // 按住操作键时暂停计时，松手重新给完整四秒。
    property <bool> group-action-pressed: false;
    // 展开立即出现，收起在二百毫秒内释放布局高度。
    property <length> group-notice-height: root.group-expanded ? 44px : 0px;
    animate group-notice-height { duration: root.group-expanded ? 0ms : Motion.fast; easing: Motion.ease; }
    changed group-notice-state => {
        if Shell.group-banner == "" {
            root.group-expanded = false;
            root.group-panel-open = false;
        } else if !root.group-panel-open {
            root.group-expanded = true;
            group-timer.restart();
        }
    }
    group-timer := Timer {
        interval: 4s;
        running: root.group-expanded && !root.group-action-pressed && !root.group-panel-open;
        triggered => { root.group-expanded = false; }
    }
    // 控制条左右内缩。**同一时刻全应用一个数** —— 此前三个调用点各给各的
    // (16 / 24 / 32px),切页时条的边沿在跳(docs/adr/0029)。
    // 随宽度收是另一回事:手机上 24px 的内缩会从本就不够的文字区里再拿走 48px。
    out property <length> bar-inset: Shell.compact ? 8px : 24px;
    // 帧率,由 Rust 测量并推送。仅在 `Shell.show-fps` 为真时被推送。
    // 名册里除本机之外的在线设备,由信令服务端主动推送(见 crates/syncplay)。

    // 版式(Layout Mode):窄→紧凑(底部导航),宽→侧栏。**由运行时窗口宽度决定,不由端决定**
    // —— 桌面把窗口拖窄一样变成紧凑版式,这既是要的体验,也是唯一能在桌面验证移动版式的办法。
    // 见 docs/adr/0007。600px 是 Material 的标准断点:手机竖屏(~393dp)紧凑,
    // 手机横屏(~850dp)回到侧栏 —— 横屏本来就矮,底栏再吃 64px 太亏。
    //
    // 用 changed 回调赋值、而不是写成 `Shell.compact: root.width < 600px` 的绑定:版式一变,子元素的
    // 约束(侧栏在不在、底栏在不在)就变,窗口的 layoutinfo 跟着变,宽度又回头喂给 Shell.compact ——
    // 那是一个真的求值环,Slint 1.18 起会警告并可能在运行时 panic。命令式赋值把环剪断:
    // 宽度先定下来,再单向推出版式。
    //
    // in-out 而不是私有:无头测试里 `set_size` 不驱动 `width`,版式因此推不出来。
    // 开放它之后测试能直接给定版式,验的是「这个版式该摆哪个导航」——
    // 「宽度推出版式」那半由下面两行自己保证,不在测试覆盖内。
    // 曲目行高跟着版式走:紧凑版式的行更高,封面更大(Layout.row-h-compact)。
    property <bool> compact-rows: Shell.compact;
    changed compact-rows => {
        Player.track-row-height = self.compact-rows ? Layout.row-h-compact : Layout.row-h;
    }
    init => { Shell.compact = root.width < Layout.compact; Shell.wide = root.width >= Layout.wide; }
    changed width => { Shell.compact = root.width < Layout.compact; Shell.wide = root.width >= Layout.wide; }
    // 内容区的最大宽度(MEO-1878)。再宽就两侧居中留白:歌名列被拉到上千像素,
    // 眼睛要横跨整屏才对得上同一行的时长。极光背景仍铺满,只有页面收窄。
    property <length> content-max-w: Layout.content-max;

    // ── 播放页(CONTEXT.md「播放页」):控制条展开的全窗沉浸层 ──
    // 展开/收起全在 .slint 内部;操作类功能仍由覆层里的 ControlCluster 走同一组
    // 回调 —— docs/adr/0010 的「功能等价路径」。


    // 歌词块的几何量,逻辑像素。**这里是唯一真相**:歌词摆位与遮挡层的裁剪
    // 负偏移都从这几个值算,别在别处重抄。歌词**不**参与深度合成,它与歌名同层
    // 画在粒子之上(docs/adr/0010 的「歌词是例外」);播放页的深度卡片是标注卡。
    //
    // 曾经这里还有一张 220px 的封面卡,它是第一张深度卡片。封面点云上线之后它成了
    // 同一张图的第二份拷贝,还正压在点云中央,遂删除(见 `docs/adr/0010` 的记录)。
    //
    // 歌词块的高度**钉死**,不随文本长度变。平台会把整段词压成「一行」(实测见过
    // 198 字符的行),放任折行会撑破布局、压到控制条上;超出的部分省略号收掉。
    // 原文最多三行、译文最多两行,按各自字号的行高估。
    // 播放页控制条的高度。紧凑版拆两行(见那一段的注释),故高一档。
    // 两颗只在播放页出现的键,图形在宽/紧凑两处版式里各用一次 —— 常量化,
    // 免得改一处漏一处。

    // 歌名与歌手在歌词块上方,与它一起居中成一组。
    // 正在播的封面(已解码)。取不到 / 解不出时为空图 —— 控制条上的小图用它。

    // ── 导航指示器(宽版式侧栏 / 紧凑版式底栏)──
    // 一颗玻璃药丸(docs/design.md「材质」),GPU 构建里由 render3d 的 navglass pass 连同导航的底
    // 一起画进 nav-bg;没有 GPU 时退回下面那颗 Slint 画的 GlassPill。两边读同一组几何。
    // 槽位常量是**唯一真相**:布局与指示器位置都从这里算,不各写各的。
    // 两种版式同一套数学,差别只在移动轴:侧栏沿 y,底栏沿 x(#70)。
    //
    // 侧栏:上 22、左右 12、下 16 的内边距;品牌一行 24px 高,下面空 26px;一行 40px,
    // 行距 2px,组与组之间 20px。
    property <length> nav-pad-top: 22px;
    property <length> nav-pad-x: 12px;
    property <length> nav-pad-bottom: 16px;
    property <length> nav-brand-h: 50px;
    property <length> nav-gap: 2px;
    property <length> nav-group-gap: 20px;
    // 单个导航项高。窗口矮到排不下十行时一起收(最小高 520),而不是让沉底组压上去。
    // 180px 是行之外的全部:内边距、品牌、十行的间距、两处分组间隔。
    out property <length> nav-slot-h: max(32px, min(40px, (root.height
        - root.safe-area-insets.top - root.safe-area-insets.bottom - 180px)
        / (Destinations.listen.length + Destinations.library.length + Destinations.account.length)));
    // 侧栏宽(Layout.nav-w)。out:Rust 读它定纹理尺寸。
    out property <length> nav-w: Layout.nav-w;
    // 侧栏纹理跟随状态条下方的页面高度,底部安全区仍由主行消化。
    out property <length> nav-h: page-stack.height
        - root.safe-area-insets.bottom;
    // 底栏(紧凑版式)的横条几何。宽由布局回写 —— 五格等分要它,而它随窗口变;
    // 高是图标那 64px 加手势条 inset,背景要铺到手势条底下。
    in-out property <length> nav-bar-w: 0px;
    out property <length> nav-bar-h: Layout.tab-h + root.safe-area-insets.bottom;
    property <length> nav-bar-pad-left: root.safe-area-insets.left;
    property <length> nav-bar-pad-right: root.safe-area-insets.right;
    // 五格:四个目的地加「更多」(Destinations.bar 的长度 + 1)。
    property <int> nav-bar-count: Destinations.bar.length + 1;
    property <length> nav-slot-w: (root.nav-bar-w - root.nav-bar-pad-left - root.nav-bar-pad-right)
        / root.nav-bar-count;
    // 底栏里那颗玻璃底:56×30,中心在格子上方 23px 处(图标那一带)。
    property <length> nav-pip-w: 56px;
    property <length> nav-pip-h: 30px;
    property <length> nav-pip-cy: 23px;

    // ── seam 出参:轴无关的一组数,Rust 照单喂 shader,不判版式 ──
    // 底栏的宽度没量出来之前不渲(首帧布局还没跑),避免拿 0 当条长。
    out property <bool> nav-visible: Shell.compact ? root.nav-bar-w > 1px : true;
    out property <bool> nav-horizontal: Shell.compact;
    out property <length> nav-strip-w: Shell.compact ? root.nav-bar-w : root.nav-w;
    out property <length> nav-strip-h: Shell.compact ? root.nav-bar-h : root.nav-h;
    // 药丸静止时沿移动轴的长度与在固定轴上的厚度,以及固定轴上的中心。
    out property <length> nav-slot: Shell.compact ? root.nav-pip-w : root.nav-slot-h;
    out property <length> nav-thick: Shell.compact ? root.nav-pip-h : root.nav-w - root.nav-pad-x * 2;
    out property <length> nav-cross: Shell.compact ? root.nav-pip-cy : root.nav-w / 2;

    // 侧栏的轨道:三组十行,摆放顺序即轨道下标。沉底那组(个人、已屏蔽、设置)也在轨道上 ——
    // 它贴着底,位置从栏底往上数。
    property <int> nav-listen-count: Destinations.listen.length;
    property <int> nav-library-count: Destinations.library.length;
    property <int> nav-track-index: Shell.destination == 0 ? 0
        : Shell.destination == 4 ? 1
        : Shell.destination == 2 ? 2
        : Shell.destination == 6 ? 3
        : Shell.destination == 1 ? 4
        : Shell.destination == 3 ? 5
        : Shell.destination == 5 ? 6
        : Shell.destination == 7 ? 7
        : Shell.destination == 9 ? 8
        : 9;
    property <int> nav-top-count: root.nav-listen-count + root.nav-library-count;
    property <length> nav-target-y: root.nav-track-index < root.nav-top-count
        ? root.nav-pad-top + root.nav-brand-h
            + root.nav-track-index * (root.nav-slot-h + root.nav-gap)
            + (root.nav-track-index >= root.nav-listen-count ? root.nav-group-gap - root.nav-gap : 0px)
            + root.nav-slot-h / 2
        : root.nav-h - root.nav-pad-bottom
            - (Destinations.account.length - (root.nav-track-index - root.nav-top-count)) * (root.nav-slot-h + root.nav-gap)
            + root.nav-gap + root.nav-slot-h / 2;
    // 底栏的格:四个目的地按 Destinations.bar 的顺序,其余都落在「更多」那一格。
    property <int> nav-bar-index: Shell.destination == 0 ? 0
        : Shell.destination == 2 ? 1
        : Shell.destination == 6 ? 2
        : Shell.destination == 1 ? 3
        : 4;
    property <length> nav-target-x: root.nav-bar-pad-left
        + root.nav-bar-index * root.nav-slot-w + root.nav-slot-w / 2;
    property <length> nav-target: Shell.compact ? root.nav-target-x : root.nav-target-y;
    // 播放组胶囊在宽版式侧栏里的纵向位置:上面两组七行之下留 8px。
    property <length> nav-capsule-y: root.nav-pad-top + root.nav-brand-h
        + root.nav-top-count * (root.nav-slot-h + root.nav-gap)
        + root.nav-group-gap + Space.md;
    // 药丸的两条边各跟一个弹簧:lead(快)那条先到,lag(慢)那条后到,走动时药丸被拉长、
    // 两头冲过头再落定(Motion.lead / Motion.trail)。out:Rust 每帧读这两个动画值喂 shader。
    out property <length> nav-lead: root.nav-target;
    out property <length> nav-lag: root.nav-target;
    animate nav-lead { duration: Motion.lead; easing: Motion.lead-ease; }
    animate nav-lag { duration: Motion.trail; easing: Motion.lead-ease; }
    // render3d 在转场期间渲出的导航纹理(底 + 药丸)。非 GPU 构建恒为空图(width 0),
    // 两种版式都退回 Slint 的平底 + GlassPill。
    in-out property <image> nav-bg;
    // 用关键词搜歌。
    // 设置页的主题三档(0 深 1 浅 2 跟随系统),选了喊一声,值由 Rust 写回。

    title: "Osmosis";
    background: Theme.window;
    // 开窗即宽版式;最小尺寸故意放到手机竖屏那么窄 —— 桌面上把窗口拖窄就能直接看到
    // 紧凑版式,不必开模拟器。
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 360px;
    min-height: 520px;

    // 输入探针(#153):整棵界面都挂在它下面。TouchArea 在子元素之前先过一遍每一个
    // 指针事件(`input_event_filter_before_children`),顺手写下 mouse-x / mouse-y ——
    // 子元素吃掉了事件也照写,拖动中被别人抓住也照写。坐标一变就是用户动了,
    // 环境动效据此续命(runtime::pace)。没人接的点击落到它身上,什么都不发生。
    // ponytail: 只认指针挪动。桌面上光标不动时的滚轮、同一像素上的连点与纯键盘
    // 操作不算输入 —— 要算就得在 slint fork 的窗口事件入口加钩子。
    input-probe := TouchArea {
        changed mouse-x => { Shell.user-input(); }
        changed mouse-y => { Shell.user-input(); }

        // ── 播放页覆层:盖住包括导航在内的整个窗口(CONTEXT.md「播放页」)──
        // 五层合成:糊封面背景 → 封面点云 → 标注卡 → 遮挡层(裁到标注卡)→ 控制簇。
        // 标注卡是深度卡片:遮挡层只含比它更近的粒子,盖上来就是「粒子从卡前面掠过」。
        // 歌名与歌词不走这条,它们画在粒子之上(docs/adr/0010 的「歌词是例外」)。
        // 功能(控制簇)永远在最上层 2D、点得到 —— docs/adr/0010。
        if Shell.play-page-open: PlayPage {
            width: 100%;
            height: 100%;
            bar-inset: root.bar-inset;
            safe-left: root.safe-area-insets.left;
            safe-right: root.safe-area-insets.right;
            safe-top: page-stack.y;
            safe-bottom: root.safe-area-insets.bottom;
        }

        // 登录背景铺满窗口，只有表单避让安全区和状态条。
        if !Session.logged-in: login-page := LoginPage {
            width: 100%;
            height: 100%;
            safe-top: page-stack.y;
            busy: Session.busy;
            error-text: Session.error;
            login(username, password) => {
                Session.login(username, password);
            }
            register(username, password, invite) => {
                Session.register(username, password, invite);
            }
        }

        // 顶部安全区只在窗口布局消化一次，状态条按实际高度让位。
        VerticalLayout {
            padding-top: root.safe-area-insets.top;
            spacing: 0px;
            if Shell.banner-text != "" || root.group-notice-height > 0px || Shell.download-text != "": HorizontalLayout {
                padding-top: Space.sm;
                padding-bottom: Space.sm;
                padding-left: 16px + root.safe-area-insets.left;
                padding-right: 16px + root.safe-area-insets.right;
                alignment: center;
                VerticalLayout {
                    max-width: 460px;
                    horizontal-stretch: 1;
                    spacing: Space.sm;
                    // 提示卡(docs/design.md「提示」):危险色的圆底图标、一行标题、可选的一段细节。
                    // 标题与细节由 notice.rs 从同一句话里拆出;绕过它直接写文案的,整句当标题。
                    if Shell.banner-text != "": banner := Rectangle {
                        height: toast-body.preferred-height;
                        background: Theme.raised;
                        border-radius: Radius.lg;
                        border-width: Theme.dark ? 0px : 1px;
                        border-color: Theme.line;
                        inner-shadow-offset-y: Theme.dark ? 1px : 0px;
                        inner-shadow-color: Theme.edge;
                        drop-shadow-offset-y: Elevation.overlay-y;
                        drop-shadow-blur: Elevation.overlay-blur;
                        drop-shadow-spread: Elevation.overlay-spread;
                        drop-shadow-color: Elevation.overlay-color;

                        // 有去处的提示可以点整块。摆在内容**之前**,于是右边那颗关闭键仍在它
                        // 上面 —— 反过来的话,想关掉提示会变成跳页。
                        // 断流那类提示没有去处(去处为 -1),这一块整个不在,横幅仍只是文字。
                        if Shell.banner-destination >= 0: jump := TouchArea {
                            // 屏幕阅读器要认得出这块能按;无头测试也只认无障碍动作,
                            // 裸 TouchArea 在那里点不动(见 crates/ui/tests/banner.rs)。
                            accessible-role: button;
                            accessible-label: Shell.banner-text;
                            accessible-action-default => { jump.clicked(); }
                            mouse-cursor: pointer;
                            clicked => {
                                Destinations.go(Shell.banner-destination);
                                Shell.banner-text = "";
                                Shell.banner-destination = -1;
                            }
                        }

                        toast-body := HorizontalLayout {
                            padding-left: Space.lg;
                            padding-right: Space.md;
                            padding-top: Space.lg;
                            padding-bottom: 14px;
                            spacing: Space.md;
                            alignment: stretch;

                            VerticalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: Theme.danger-wash;
                                    Icon {
                                        size: 18px;
                                        source: Icons.warning-circle;
                                        colorize: Theme.danger;
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    min-height: 32px;
                                    text: Shell.banner-title != "" ? Shell.banner-title : Shell.banner-text;
                                    // 读屏念整句,标题只是它的头一截。
                                    accessible-role: text;
                                    accessible-label: Shell.banner-text;
                                    font-size: TextSize.body;
                                    font-weight: Weight.semibold;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                if Shell.banner-title != "" && Shell.banner-detail != "": Text {
                                    text: Shell.banner-detail;
                                    accessible-role: none;
                                    font-size: TextSize.small;
                                    color: Theme.text-dim;
                                    wrap: word-wrap;
                                }
                            }

                            // 关掉。清空文案就等于收起,不必回 Rust 绕一圈。
                            VerticalLayout {
                                alignment: start;
                                padding-top: 2px;
                                IconButton {
                                    diameter: 28px;
                                    icon-size: 16px;
                                    icon: Icons.x;
                                    ink: Theme.text-faint;
                                    label: "关闭提示";
                                    clicked => { Shell.banner-text = ""; }
                                }
                            }
                        }
                    }

                    if Shell.group-banner != "" && root.group-notice-height > 0px: group-strip := Rectangle {
                        preferred-height: root.group-notice-height;
                        min-height: 0px;
                        max-height: root.group-notice-height;
                        clip: true;
                        background: Theme.surface.with-alpha(0.96);
                        border-radius: Radius.sm;
                        border-width: 1px;
                        border-color: Theme.accent;

                        HorizontalLayout {
                            padding-left: Space.md;
                            padding-right: Space.sm;
                            spacing: Space.sm;

                            Text {
                                text: Shell.group-banner;
                                // 固定部分是硬编码中文,设备名由对端自报 —— 与歌名同理,
                                // 走系统字体回退。
                                font-size: TextSize.small;
                                color: Theme.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: exit-label.preferred-width + 20px;
                                    height: 44px;
                                    border-radius: Radius.pill;
                                    background: exit-touch.has-hover ? Theme.accent : Theme.hover;
                                    animate background { duration: Motion.fast; easing: Motion.ease; }

                                    exit-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        changed pressed => { root.group-action-pressed = self.pressed; }
                                        clicked => {
                                            if Shell.group-joinable { Shell.join-group(); } else { Shell.leave-group(); }
                                        }

                                        accessible-role: button;
                                        accessible-label: Shell.group-joinable ? "加入播放组" : "退出";
                                        accessible-action-default => { self.clicked(); }
                                    }

                                    exit-label := Text {
                                        text: Shell.group-joinable ? "加入" : "退出";
                                        font-size: TextSize.small;
                                        color: exit-touch.has-hover ? Theme.accent-text : Theme.text;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    if Shell.download-text != "": download-strip := Rectangle {
                        height: 40px;
                        background: Theme.surface.with-alpha(0.96);
                        border-radius: Radius.sm;
                        border-width: 1px;
                        border-color: Theme.press;

                        HorizontalLayout {
                            padding-left: Space.md;
                            padding-right: Space.md;

                            Text {
                                text: Shell.download-text;
                                font-size: TextSize.small;
                                color: Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                }
            }
            page-stack := Rectangle {
                vertical-stretch: 1;
                // 音乐壳保持在流布局；全窗口覆层只借用这里的内容起点。
                //
                // 未登录时整块不建:登录页盖着的时候导航不该可达 —— 否则点进音乐页
                // 只会收获一屏 401。用 `if` 而不是 `visible: false`,是要让它真的不在树里,
                // 那样「绕不过去」这件事才测得到(见 tests/login.rs)。
                if Session.logged-in: VerticalLayout {
                    // 播放页只隐藏音乐壳，保留搜索、折叠和滚动状态。
                    visible: !Shell.play-page-open;

                    // ── 主体行:宽版式是「侧栏 + 内容」,紧凑版式只有内容 ──
                    HorizontalLayout {
                        vertical-stretch: 1;
                        padding-left: root.safe-area-insets.left;
                        padding-right: root.safe-area-insets.right;
                        // 紧凑版式的底部 inset 归底栏管 —— 它的背景要铺到手势条底下,不能在这里先留白,
                        // 否则手势条那一条会露出窗口底色,全面屏观感碎掉。
                        padding-bottom: Shell.compact ? 0 : root.safe-area-insets.bottom;

                        // ── 侧栏(宽版式)──
                        // 窗口底色上的一列:品牌、两组目的地、沉底的账户组。选中项背后是一颗玻璃药丸
                        // (docs/design.md「材质」)—— GPU 构建由 navglass 连底带丸画进 nav-bg,
                        // 否则由下面的 GlassPill 画;两者读同一组 nav-lead / nav-lag。
                        // ponytail: 底色不铺到左刘海底下(padding-left 已经把它推开了)。只有「横屏 +
                        // 左刘海」会露一条窗口底色,而这一列本来就是窗口底色。
                        if !Shell.compact: Rectangle {
                            width: root.nav-w;
                            background: Theme.window;

                            Image {
                                source: root.nav-bg;
                                width: 100%;
                                height: 100%;
                                image-fit: fill;
                            }

                            if root.nav-bg.width == 0: GlassPill {
                                x: root.nav-pad-x;
                                width: root.nav-thick;
                                y: min(root.nav-lead, root.nav-lag) - root.nav-slot / 2;
                                height: abs(root.nav-lead - root.nav-lag) + root.nav-slot;
                                spec-w: 120px;
                            }

                            VerticalLayout {
                                padding-top: root.nav-pad-top;
                                padding-left: root.nav-pad-x;
                                padding-right: root.nav-pad-x;
                                padding-bottom: root.nav-pad-bottom;
                                spacing: 0px;

                                // 品牌:实心的强调色圆叠一只空心圆,后面是名字。
                                HorizontalLayout {
                                    height: root.nav-brand-h;
                                    padding-left: Space.md;
                                    padding-bottom: root.nav-brand-h - 24px;
                                    spacing: 10px;
                                    accessible-role: none;
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        Rectangle {
                                            x: 0px;
                                            y: 4px;
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 8px;
                                            background: Theme.accent;
                                        }
                                        Rectangle {
                                            x: 8px;
                                            y: 4px;
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 8px;
                                            border-width: 2px;
                                            border-color: Theme.text;
                                        }
                                    }
                                    Text {
                                        text: "Osmosis";
                                        font-size: TextSize.title;
                                        font-weight: Weight.bold;
                                        letter-spacing: -0.2px;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: root.nav-gap;
                                    for item in Destinations.listen: SideNavRow {
                                        height: root.nav-slot-h;
                                        item: item;
                                        active: Shell.destination == item.id;
                                        clicked => { Destinations.go(item.id); }
                                    }
                                }

                                // 分组间隔:只是视觉上的一口气,不是父级页面。
                                // 与 nav-target-y 里的 nav-group-gap 是同一个数。
                                Rectangle { height: root.nav-group-gap; }

                                VerticalLayout {
                                    spacing: root.nav-gap;
                                    for item in Destinations.library: SideNavRow {
                                        height: root.nav-slot-h;
                                        item: item;
                                        active: Shell.destination == item.id;
                                        clicked => { Destinations.go(item.id); }
                                    }
                                }

                                // 把沉底组压到底。
                                Rectangle { vertical-stretch: 1; }

                                VerticalLayout {
                                    spacing: root.nav-gap;
                                    for item in Destinations.account: SideNavRow {
                                        height: root.nav-slot-h;
                                        item: item;
                                        active: Shell.destination == item.id;
                                        clicked => { Destinations.go(item.id); }
                                    }
                                }
                            }
                        }

                        // ── 内容区。按 Shell.destination 切换子内容 ──
                        content := Rectangle {
                            horizontal-stretch: 1;

                            // 内容面板(docs/design.md「表面」):宽版式在窗口底色上浮起一块圆角面板,
                            // 上、右、下各让出一道 gutter;紧凑版式铺满,不起角。页头那片 header-wash
                            // 从面板顶往下淡出,页面自己不再画底。
                            panel := Rectangle {
                                x: 0px;
                                y: Shell.compact ? 0px : Layout.gutter;
                                width: parent.width - (Shell.compact ? 0px : Layout.gutter);
                                height: parent.height - (Shell.compact ? 0px : Layout.gutter * 2);
                                background: Theme.base;
                                border-radius: Shell.compact ? 0px : Radius.lg;
                                clip: true;
                                drop-shadow-offset-y: Shell.compact ? 0px : Elevation.card-y;
                                drop-shadow-blur: Shell.compact ? 0px : Elevation.card-blur;
                                drop-shadow-color: Shell.compact ? transparent : Elevation.card-color;
                                inner-shadow-offset-y: Shell.compact ? 0px : 1px;
                                inner-shadow-color: Shell.compact ? transparent : Theme.edge;

                                Rectangle {
                                    y: 0px;
                                    height: 260px;
                                    background: @linear-gradient(180deg, Theme.header-wash 0%, Theme.base 100%);
                                }

                                // 个人主页(目的地 7)。进页即取统计,判断在 Rust 侧。
                                if Shell.destination == 7: ProfilePage {
                                    width: min(parent.width, root.content-max-w);
                                    x: (parent.width - self.width) / 2;
                                    height: 100%;
                                    // 与下面摆控制条那一行是同一个条件 —— 条在不在,
                                    // 决定这一页底部要不要多留出它那一块。
                                    bar-visible: Player.has-track && !Shell.play-page-open;
                                    init => { Profile.shown(); }
                                    username: Profile.username;
                                    loaded: Profile.loaded;
                                    error-text: Profile.error;
                                    month-plays: Profile.month-plays;
                                    distinct-tracks: Profile.distinct-tracks;
                                    streak-days: Profile.streak-days;
                                    top-artists: Profile.artists;
                                    devices: Shell.devices;
                                    output-current: Shell.output-id;
                                    set-output(id) => { Shell.set-output(id); }
                                    netease-bound: Profile.netease-bound;
                                    netease-nickname: Profile.netease-nickname;
                                    netease-qr: Profile.netease-qr;
                                    netease-hint: Profile.netease-hint;
                                    // 手机扫不了自己屏幕上的码,那一句提示只在安卓上说
                                    on-phone: Shell.platform == "android";
                                    unbind-netease => { Profile.unbind-netease(); }
                                }

                                // 设置(目的地 8,侧栏沉底最后一行)。
                                if Shell.destination == 8: SettingsPage {
                                    width: min(parent.width, root.content-max-w);
                                    x: (parent.width - self.width) / 2;
                                    height: 100%;
                                    // 与下面摆控制条那一行是同一个条件,理由同个人页。
                                    bar-visible: Player.has-track && !Shell.play-page-open;
                                    about-line: Profile.about-line;
                                    tier-line: Profile.tier-line;
                                    update-status: Profile.update-status;
                                    update-action: Profile.update-action;
                                    update-requested => { Profile.update-requested(); }
                                    motion-on: Shell.motion-on;
                                    motion-toggled => { Shell.motion-toggled(); }
                                    username: Profile.username;
                                    theme-mode-selected(mode) => { Shell.theme-mode-selected(mode); }
                                    logout => { Session.logout(); }
                                }

                                // 已屏蔽(目的地 9)。规则按原因分组,在这里恢复。
                                if Shell.destination == 9: BlockedPage {
                                    width: min(parent.width, root.content-max-w);
                                    x: (parent.width - self.width) / 2;
                                    height: 100%;
                                    bar-visible: Player.has-track && !Shell.play-page-open;
                                }

                                // 其余七个目的地共用音乐页。整页可滚,不裹玻璃卡片 ——
                                // 列表要吃满可用高度,套进定宽卡片在手机上只剩三四行可见。
                                if Shell.destination < 7: music-page := MusicPage {
                                    width: min(parent.width, root.content-max-w);
                                    height: 100%;
                                    x: (parent.width - self.width) / 2;
                                }

                            }

                            // 控制条:窗口持有、跨目的地常驻(CONTEXT.md「控制条」)。
                            // **一个实例管所有目的地** —— 不是每页各摆一根:各摆一根就有各自的
                            // 容器内缩与各自的形态,而那正是用户点名的「不统一」(docs/adr/0029)。
                            // 播放页开着时让位:覆层整个盖住这一层,它自己带一根同样的条。
                            // 条下面那一截列表渐隐进面板底色:条浮在上面时,最后几行不硬生生被切断。
                            if Player.has-track && !Shell.play-page-open: Rectangle {
                                x: panel.x;
                                width: panel.width;
                                y: panel.y + panel.height - self.height;
                                height: Shell.compact ? 230px : 190px;
                                border-radius: panel.border-radius;
                                background: @linear-gradient(180deg, Theme.base.with-alpha(0) 0%, Theme.base 62%, Theme.base 100%);
                            }

                            // 条按面板居中落位,不按内容区:宽版式的面板右边让出了一道 gutter。
                            if Player.has-track && !Shell.play-page-open: PlayerBar {
                                x: panel.x + (panel.width - self.width) / 2;
                                // 间隙与 BarMetrics.bottom-gap 是同一个数:页面按它留空,
                                // 条按它落位,两边对不上就会差出一条缝或者压住一行。
                                y: panel.y + panel.height - self.height - BarMetrics.bottom-gap;
                                width-cap: panel.width - root.bar-inset * 2;
                            }

                            // 「更多」面板:盖在内容区上,贴着底栏上沿。只在紧凑版式出现。
                            if Shell.compact && Destinations.more-open: MorePanel {
                                width: 100%;
                                height: 100%;
                            }

                            // Shell.fps 浮层:content 的最后一个子元素 → 画在最上层。
                            // 左上角,所有页可见。诚实即时帧率(见 lib.rs 的 Shell.fps 模块)。
                            if Shell.show-fps: Text {
                                x: 8px;
                                y: 8px;
                                text: "FPS " + round(Shell.fps);
                                color: #51cf66;
                                font-size: TextSize.body;
                                font-weight: 700;
                            }
                        }
                    }

                    // ── 底栏(紧凑版式)──
                    // 窗口底色,顶上一道细线;五格里选中那格的图标垫一颗玻璃小药丸。背景铺满到屏幕底边,
                    // 内部 padding-bottom 把图标顶到手势条之上 —— 与 MainActivity 的 edge-to-edge 一致。
                    if Shell.compact: bottom-bar := Rectangle {
                        height: root.nav-bar-h;
                        background: Theme.window;
                        // 横条几何回写给 seam:五格等分要窗口宽,而它随窗口变(#70)。
                        init => { root.nav-bar-w = self.width; }
                        changed width => { root.nav-bar-w = self.width; }

                        // GPU 构建:navglass 连底带丸画进 nav-bg,与侧栏同一条 pass,移动轴换成 x。
                        Image {
                            source: root.nav-bg;
                            width: 100%;
                            height: 100%;
                            image-fit: fill;
                        }
                        Rectangle {
                            y: 0px;
                            height: 1px;
                            background: Theme.line;
                        }
                        if root.nav-bg.width == 0: GlassPill {
                            x: min(root.nav-lead, root.nav-lag) - root.nav-slot / 2;
                            width: abs(root.nav-lead - root.nav-lag) + root.nav-slot;
                            y: root.nav-cross - root.nav-thick / 2;
                            height: root.nav-thick;
                            border-radius: Radius.pill;
                            spec-w: 40px;
                            spec-opacity: 0.7;
                        }

                        HorizontalLayout {
                            padding-left: root.nav-bar-pad-left;
                            padding-right: root.nav-bar-pad-right;
                            padding-bottom: root.safe-area-insets.bottom;
                            spacing: 0px;

                            for item in Destinations.bar: NavItem {
                                horizontal-stretch: 1;
                                label: item.short;
                                a11y-label: item.label;
                                icon: item.icon;
                                icon-on: item.icon-on;
                                active: Shell.destination == item.id;
                                clicked => { Destinations.go(item.id); }
                            }
                            // 「更多」:当前页在面板里时它亮着,再点一下收起面板。
                            NavItem {
                                horizontal-stretch: 1;
                                label: Destinations.more-entry.short;
                                a11y-label: Destinations.more-entry.label;
                                icon: Destinations.more-entry.icon;
                                icon-on: Destinations.more-entry.icon-on;
                                active: Destinations.in-more;
                                clicked => { Destinations.more-open = !Destinations.more-open; }
                            }
                        }
                    }
                }


            }
        }

        // 胶囊借页面起点定位，位于安全区内，完全不参与流布局。
        if Shell.group-banner != "" && !root.group-expanded: group-capsule := Rectangle {
            // 宽版式落在侧栏两组之下、沉底那组之上的空当里,水平居中。
            x: Shell.compact ? root.width - root.safe-area-insets.right - 60px
                : root.safe-area-insets.left + (root.nav-w - 44px) / 2;
            y: page-stack.y + (Shell.compact ? 16px : root.nav-capsule-y);
            width: 44px;
            height: 44px;
            border-radius: Radius.pill;
            background: Theme.surface;
            border-color: Theme.accent;
            border-width: 1px;
            accessible-role: button;
            accessible-label: "播放组";
            accessible-action-default => { root.group-panel-open = true; }
            capsule-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: "播放组";
                accessible-action-default => { root.group-panel-open = true; }
                clicked => { root.group-panel-open = true; }
            }
            // 双设备图标用语义色，在深浅主题共用同一轮廓。
            group-icon := Icon {
                size: 24px;
                source: Icons.devices;
                colorize: Theme.accent-ink;
            }
        }

        // 遮罩接住空白点击，面板自身截住事件；名册和播放状态直接读实时投影。
        if root.group-panel-open && Shell.group-banner != "": Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.scrim.with-alpha(0.5);
            TouchArea { clicked => { root.group-panel-open = false; } }

            group-panel := Rectangle {
                width: min(parent.width - root.safe-area-insets.left - root.safe-area-insets.right - 48px, 360px);
                height: group-body.preferred-height;
                x: root.safe-area-insets.left + (parent.width - root.safe-area-insets.left - root.safe-area-insets.right - self.width) / 2;
                y: root.safe-area-insets.top + (parent.height - root.safe-area-insets.top - root.safe-area-insets.bottom - self.height) / 2;
                background: Theme.surface;
                border-radius: Radius.md;
                border-width: 1px;
                border-color: Theme.press;
                TouchArea { }

                group-body := VerticalLayout {
                    padding: Space.lg;
                    spacing: Space.md;
                    Text {
                        text: Shell.group-banner;
                        color: Theme.text;
                        font-size: TextSize.title;
                        overflow: elide;
                    }
                    Text {
                        text: Shell.output-text;
                        color: Theme.accent-ink;
                        overflow: elide;
                    }
                    if Player.playback-text != "": Text {
                        text: Player.playback-text;
                        color: Theme.text-dim;
                        overflow: elide;
                    }
                    if Shell.group-text != "": Text {
                        text: Shell.group-text;
                        color: Theme.text-dim;
                        overflow: elide;
                    }
                    Text {
                        text: Shell.local-member ? "本机 · 出声端"
                            : Shell.group-joinable ? "本机 · 独奏" : "本机 · 遥控端";
                        color: Theme.text-dim;
                    }
                    ListView {
                        height: min(Shell.devices.length * 40px, 160px);
                        for device in Shell.devices: HorizontalLayout {
                            height: 40px;
                            Text {
                                text: device.name;
                                color: Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: device.member ? "出声端" : "未出声";
                                color: device.member ? Theme.accent-ink : Theme.text-dim;
                            }
                        }
                    }
                    Button {
                        width: 100%;
                        height: 44px;
                        text: Shell.group-joinable ? "加入播放组" : "退出组";
                        clicked => {
                            if Shell.group-joinable { Shell.join-group(); }
                            else { Shell.leave-group(); }
                            root.group-panel-open = false;
                        }
                    }
                }
            }
        }

        if Library.dislike-open: dislike-mask := Rectangle {
            width: 100%; height: 100%; background: #00000088;
            TouchArea { clicked => { Library.dislike-open = false; } }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 24px, 390px);
                height: dislike-body.preferred-height + 28px;
                background: Theme.surface; border-radius: Radius.md;
                TouchArea { }
                dislike-body := VerticalLayout {
                    padding: Space.md; spacing: 10px;
                    Text { text: Library.dislike-pick-artist ? "选择歌手" : "不喜欢"; color: Theme.text; font-size: TextSize.title; }
                    if !Library.dislike-pick-artist: Button { width: 100%; height: 48px; text: "不想再听这个歌手"; clicked => { Library.choose-dislike(0); } }
                    if !Library.dislike-pick-artist: Button { width: 100%; height: 48px; text: "不想再听这首歌（含其他版本）"; clicked => { Library.choose-dislike(1); } }
                    if !Library.dislike-pick-artist: Button { width: 100%; height: 48px; text: "太难听了"; clicked => { Library.choose-dislike(2); } }
                    for artist[index] in Library.dislike-artists: Button {
                        visible: Library.dislike-pick-artist;
                        width: 100%; height: 48px; text: artist;
                        clicked => { Library.choose-dislike-artist(index); }
                    }
                }
            }
        }

        // ── 曲目行的长按菜单 ──
        // 压在所有页之上、铺满整块:菜单开着的时候底下不该还点得动,而「点别处
        // 关掉」也正是靠这一整块接住的。只有一项是有意的 —— 这一期就下载一件事,
        // 为它先造一套通用菜单,是给一个不存在的第二项付账。
        if Library.track-menu-id != ""
            && !Library.tag-picker-open
            && !Library.block-tag-picker-open
            && !Library.dislike-open: track-menu := Rectangle {
            width: 100%;
            height: 100%;
            background: #000000.with-alpha(0.5);

            TouchArea {
                clicked => { Library.track-menu-id = ""; }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 48px, 360px);
                height: menu-body.preferred-height + 28px;
                background: Theme.surface;
                border-radius: Radius.md;
                border-width: 1px;
                border-color: Theme.press;

                // 挡住底下那块「点别处关掉」的区域 —— 没有它,点菜单自己也会把菜单关掉。
                TouchArea { }

                menu-body := VerticalLayout {
                    padding: Space.md;
                    spacing: Space.sm;

                    Text {
                        text: Library.track-menu-title;
                        font-size: TextSize.body;
                        color: Theme.text-dim;
                        overflow: elide;
                    }

                    Rectangle {
                        height: 44px;
                        border-radius: Radius.sm;
                        background: download-touch.has-hover
                            ? Theme.accent : Theme.hover;
                        animate background { duration: Motion.fast; easing: Motion.ease; }

                        download-touch := TouchArea {
                            mouse-cursor: pointer;
                            // 无头测试只认无障碍动作,裸 TouchArea 在那里点不动
                            // (见 crates/ui/tests/banner.rs)。
                            accessible-role: button;
                            accessible-label: "下载";
                            accessible-action-default => { download-touch.clicked(); }
                            clicked => {
                                Library.download-track(Library.track-menu-id);
                                Library.track-menu-id = "";
                            }
                        }

                        Text {
                            text: "下载";
                            font-size: TextSize.body;
                            color: download-touch.has-hover
                                ? Theme.accent-text : Theme.text;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // 标签(#158):打开选择器之前先把菜单藏起来,track-menu-id
                    // 留着不清 —— 选择器就靠它知道现在打的是哪一首。
                    Rectangle {
                        height: 44px;
                        border-radius: Radius.sm;
                        background: tag-touch.has-hover
                            ? Theme.accent : Theme.hover;
                        animate background { duration: Motion.fast; easing: Motion.ease; }

                        tag-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "标签";
                            accessible-action-default => { tag-touch.clicked(); }
                            clicked => {
                                Library.open-tag-picker();
                                Library.tag-picker-open = true;
                            }
                        }

                        Text {
                            text: "标签…";
                            font-size: TextSize.body;
                            color: tag-touch.has-hover
                                ? Theme.accent-text : Theme.text;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // 屏蔽(#161):屏蔽是规则,不是踩。命中的歌在所有列表里隐藏,
                    // 队列与电台跳过;设置页「已屏蔽」里能恢复。
                    Rectangle {
                        height: 44px;
                        border-radius: Radius.sm;
                        background: block-track-touch.has-hover
                            ? Theme.accent : Theme.hover;
                        animate background { duration: Motion.fast; easing: Motion.ease; }

                        block-track-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "不喜欢…";
                            accessible-action-default => { block-track-touch.clicked(); }
                            clicked => {
                                Library.open-dislike(Library.track-menu-id);
                                Library.track-menu-id = "";
                            }
                        }

                        Text {
                            text: "不喜欢…";
                            font-size: TextSize.body;
                            color: block-track-touch.has-hover
                                ? Theme.accent-text : Theme.text;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // 选哪个标签来屏蔽。列表与标签选择器同一张 all-tags,
                    // 开之前一样先喊 open-tag-picker 把它填上。
                    Rectangle {
                        height: 44px;
                        border-radius: Radius.sm;
                        background: block-tag-touch.has-hover
                            ? Theme.accent : Theme.hover;
                        animate background { duration: Motion.fast; easing: Motion.ease; }

                        block-tag-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "屏蔽标签";
                            accessible-action-default => { block-tag-touch.clicked(); }
                            clicked => {
                                Library.open-tag-picker();
                                Library.block-tag-picker-open = true;
                            }
                        }

                        Text {
                            text: "屏蔽 tag…";
                            font-size: TextSize.body;
                            color: block-tag-touch.has-hover
                                ? Theme.accent-text : Theme.text;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        // ── 屏蔽哪个标签(#161) ──
        //
        // 点一行就建一条标签规则并关掉。与标签选择器同一个外形,但不勾选:
        // 屏蔽是一下子的决定,撤销在「已屏蔽」页里。
        if Library.block-tag-picker-open: block-tag-picker := Rectangle {
            width: 100%;
            height: 100%;
            background: #000000.with-alpha(0.5);

            TouchArea {
                clicked => {
                    Library.block-tag-picker-open = false;
                    Library.track-menu-id = "";
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 48px, 360px);
                height: min(parent.height - 96px, block-tag-body.preferred-height + 28px);
                background: Theme.surface;
                border-radius: Radius.md;
                border-width: 1px;
                border-color: Theme.press;

                TouchArea { }

                block-tag-body := VerticalLayout {
                    padding: Space.md;
                    spacing: Space.sm;

                    Text {
                        text: "屏蔽哪个标签";
                        font-size: TextSize.body;
                        color: Theme.text-dim;
                    }

                    if Library.all-tags.length == 0: Text {
                        text: "还没有标签";
                        font-size: TextSize.small;
                        color: Theme.text-faint;
                    }

                    ListView {
                        height: min(Library.all-tags.length * 44px, 220px);

                        for row[i] in Library.all-tags: Rectangle {
                            height: 40px;
                            border-radius: Radius.sm;
                            background: block-row-touch.has-hover ? Theme.hover : transparent;

                            block-row-touch := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: "屏蔽标签 " + row.name;
                                accessible-action-default => { block-row-touch.clicked(); }
                                clicked => {
                                    Library.block-tag(row.name);
                                    Library.block-tag-picker-open = false;
                                    Library.track-menu-id = "";
                                }
                            }

                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: parent.height;
                                text: row.name;
                                color: Theme.text;
                                font-size: TextSize.body;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ── 标签选择器(#158) ──
        //
        // 打的是 track-menu-id 那一首:开票的是「标签…」那一下,菜单藏起来但
        // track-menu-id 没清,退出这个选择器时才连它一起清掉。
        if Library.tag-picker-open: tag-picker := Rectangle {
            width: 100%;
            height: 100%;
            background: #000000.with-alpha(0.5);

            TouchArea {
                clicked => {
                    Library.tag-picker-open = false;
                    Library.track-menu-id = "";
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 48px, 360px);
                height: min(parent.height - 96px, picker-body.preferred-height + 28px);
                background: Theme.surface;
                border-radius: Radius.md;
                border-width: 1px;
                border-color: Theme.press;

                TouchArea { }

                picker-body := VerticalLayout {
                    padding: Space.md;
                    spacing: Space.sm;

                    Text {
                        text: "标签 · " + Library.track-menu-title;
                        font-size: TextSize.body;
                        color: Theme.text-dim;
                        overflow: elide;
                    }

                    tag-list := ListView {
                        height: min(Library.all-tags.length * 44px, 220px);

                        for row[i] in Library.all-tags: Rectangle {
                            height: 40px;

                            row-touch := TouchArea {
                                accessible-role: checkbox;
                                accessible-label: row.name;
                                accessible-checkable: true;
                                accessible-checked: row.applied;
                                accessible-action-default => { row-touch.clicked(); }
                                clicked => {
                                    Library.toggle-track-tag(row.id, !row.applied);
                                }
                            }

                            HorizontalLayout {
                                padding-left: Space.xs;
                                padding-right: Space.xs;
                                spacing: Space.sm;

                                // 勾选框:矢量图标,不用 Unicode 符号 —— ☐ 在安卓字体里没有,
                                // ☑ 又被 emoji 字体接走,两端画出来的东西对不上(#158 F-001)。
                                // 与抽屉那排图标芯片同一种做法:关着透底描边,开着填强调色。
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        border-radius: Radius.sm;
                                        background: row.applied ? Theme.accent : transparent;
                                        border-width: 1.5px;
                                        border-color: row.applied ? Theme.accent : Theme.press;
                                        animate background, border-color { duration: Motion.fast; easing: Motion.ease; }

                                        if row.applied: Icon {
                                            size: 14px;
                                            source: Icons.check;
                                            colorize: Theme.accent-text;
                                        }
                                    }
                                }
                                Text {
                                    text: row.name;
                                    color: Theme.text;
                                    font-size: TextSize.body;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Space.sm;

                        new-tag-name := TextField {
                            horizontal-stretch: 1;
                            placeholder: "新建标签";
                            accepted => {
                                Library.create-track-tag(self.text);
                                self.text = "";
                            }
                        }
                        Rectangle {
                            width: 56px;
                            border-radius: Radius.sm;
                            background: create-tag-touch.has-hover
                                ? Theme.accent : Theme.hover;

                            create-tag-touch := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: "新建";
                                accessible-action-default => { create-tag-touch.clicked(); }
                                clicked => {
                                    Library.create-track-tag(new-tag-name.text);
                                    new-tag-name.text = "";
                                }
                            }

                            Text {
                                text: "新建";
                                font-size: TextSize.body;
                                color: create-tag-touch.has-hover
                                    ? Theme.accent-text : Theme.text;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
