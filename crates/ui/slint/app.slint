// 最小化单窗口手机 UI:一个点击计数器。
// 计数值保存在 Rust 一侧(crates/app-core),以 property 形式推送到这里;
// 按钮点击通过 `bump` 回调传回去。

// slint 自带的 Inter 没有汉字,wasm 上又没有系统字体可回退,健康状态那行中文
// 会渲染成豆腐块。这里内嵌一份裁到只剩所需字符的子集(见 `just font-subset`),
// 由 slint 编译器把字节打进产物,再按 family 名引用。
import "../fonts/cjk-subset.ttf";

// 原生文本输入:热调 3D 场景参数用。不自己搓文本编辑(光标/选区/IME),用 Slint 自带的。
import { LineEdit } from "std-widgets.slint";

// 玻璃拟态:供 Home / Server 页透出颜色的极光背景,以及装内容的玻璃卡片。
import { AuroraBackground, GlassCard } from "glass.slint";

// 带悬浮抬起效果的按钮:悬停时背景变亮、阴影变大变柔,呈现出凸起的
// 观感;按下时变暗下沉。全部带动画过渡。
//
// 触摸设备上没有"悬停但未按下"这个状态,因此只会看到按下时的下沉效果。
// 这是刻意的优雅降级,不是缺陷:slint 在触摸按下时同样会置 has-hover,
// 但优先级更高的 `down` 分支盖住了它。
component HoverButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    property <bool> hovered: touch.has-hover;
    property <bool> down: touch.pressed;

    height: 56px;
    width: 220px;
    border-radius: 14px;
    background: down ? #6b4520 : hovered ? #a9713c : #8a5a2b;
    drop-shadow-color: #8a5a2b80;
    drop-shadow-blur: down ? 4px : hovered ? 24px : 10px;
    drop-shadow-offset-y: down ? 1px : hovered ? 8px : 3px;
    animate background, drop-shadow-blur, drop-shadow-offset-y {
        duration: 160ms;
        easing: ease-out;
    }

    Text {
        text: root.text;
        color: #ffffff;
        font-size: 18px;
        font-weight: 600;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 导航的三项。**唯一真相** —— 侧栏(宽版式)和底栏(紧凑版式)都 `for` 它,
// 免得两处各抄一份图标 path,改了一处忘另一处。
struct NavEntry {
    label: string,
    icon: string, // SVG path 数据,viewbox 24×24
}

// 搜索结果里的一行。字段都是**已经格式化好的字符串** —— 歌手怎么拼、时长怎么写
// 由 Rust 侧决定并测过,`.slint` 里不做任何计算。
struct TrackRow {
    id: string,
    title: string,
    artists: string,
    duration: string,
}

// 同播名册里的一台设备。名字由对端自报,是任意文本 —— 与歌名同理,
// 这里不指定子集字体。
struct DeviceRow {
    id: string,
    name: string,
}

global Nav {
    out property <[NavEntry]> items: [
        {
            label: "Home",
            icon: "M3 12 L12 4 L21 12 M5.5 10 L5.5 20 L18.5 20 L18.5 10",
        },
        {
            label: "Music",
            icon: "M9 18 L9 5 L20 3 L20 16 M9 18 A2.5 2.5 0 1 1 6.5 15.5 A2.5 2.5 0 0 1 9 18 M20 16 A2.5 2.5 0 1 1 17.5 13.5 A2.5 2.5 0 0 1 20 16",
        },
        {
            label: "3D",
            icon: "M12 3 L20 7.5 L20 16.5 L12 21 L4 16.5 L4 7.5 Z M12 3 L12 12 M12 12 L20 7.5 M12 12 L4 7.5",
        },
    ];
}

// 导航栏的一项:矢量线条图标 + 英文标签,竖排。选中时背景高亮、图标与文字变亮。
// 图标用 Path 内嵌(不引外部资源);标签用英文,免得中文落到无 CJK 的默认字体上变豆腐。
//
// 不写死高度:竖排侧栏里由使用处给 68px,横排底栏里由布局撑满栏高。
component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    // 选中高亮是否已由背后的 GPU 液态玻璃提供。为真时(GPU 构建)自己让开 active 底,
    // 免得和玻璃叠两遍;为假时(非 GPU 兜底)照旧自己画 active 高亮。hover 两种情况都只留极淡一层。
    in property <bool> gpu-selected;
    callback clicked;

    border-radius: 12px;
    background: root.gpu-selected
        ? (touch.has-hover ? #ffffff14 : transparent)
        : (active ? #2a1e14 : (touch.has-hover ? #1d150f : transparent));
    animate background { duration: 120ms; easing: ease-out; }

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        HorizontalLayout {
            alignment: center;
            Path {
                width: 26px;
                height: 26px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                stroke: active ? #d9a86c : #8b91a5;
                stroke-width: 1.8px;
                fill: transparent;
            }
        }

        Text {
            text: root.label;
            color: active ? #e6e8ef : #8b91a5;
            font-size: 12px;
            font-weight: active ? 700 : 500;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 一个带标签的文本输入,3D 热调面板复用。text 双向绑定到外部属性。
//
// 宽度**不写死**,由所在行分配 —— 原先固定 72px:窗口宽在 600~900px 之间时,
// 「220px 按钮 + 4×72px」的固定内容比工具条还宽,后面的框直接被 GlassCard 裁掉。
// 给个 56px 下限保证还认得出内容,其余交给 horizontal-stretch。
component ParamField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    horizontal-stretch: 1;
    spacing: 2px;
    Text {
        text: root.label;
        color: #9aa0b4;
        font-size: 11px;
    }
    // 高度也得钉:LineEdit 在 fluent 风格下默认 56px 高,label 一叠就 72px —— 比整条
    // 64px 的工具条还高,下边框和清除按钮会被 GlassCard 的 clip 悄悄切掉(旧代码就这样,
    // 一直没人发现)。40px 是个正常的输入框高度,工具条也才收得住。
    LineEdit {
        min-width: 56px;
        height: 40px;
        text <=> root.text;
    }
}

// 四个参数框。宽版式一排四个;紧凑版式(stacked)排成 2×2 —— 手机上四个并排每个只剩
// ~76px,「#4a6bff」被 LineEdit 的清除按钮挤得只看得见一个「#」,读都读不出来。
//
// 两个分支的绑定都关在本组件里:外面两处使用点只需拨 stacked,不会改了一处漏了另一处。
component ParamRow inherits Rectangle {
    in property <bool> stacked;
    in-out property <string> count-text;
    in-out property <string> color-text;
    in-out property <string> speed-text;
    in-out property <string> spacing-text;

    if !root.stacked: HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 12px;
        ParamField { label: "实体数"; text <=> root.count-text; }
        ParamField { label: "基础色"; text <=> root.color-text; }
        ParamField { label: "自转速度"; text <=> root.speed-text; }
        ParamField { label: "间距"; text <=> root.spacing-text; }
    }

    if root.stacked: GridLayout {
        width: 100%;
        height: 100%;
        spacing: 8px;
        Row {
            ParamField { label: "实体数"; text <=> root.count-text; }
            ParamField { label: "基础色"; text <=> root.color-text; }
        }
        Row {
            ParamField { label: "自转速度"; text <=> root.speed-text; }
            ParamField { label: "间距"; text <=> root.spacing-text; }
        }
    }
}

// 圆形播放控制键:玻璃底 + Path 图标。悬停浮亮,按下微缩。
// 图标画法同 NavItem:SVG path 内嵌,viewbox 24×24,不引外部资源。
component RoundControl inherits Rectangle {
    in property <string> icon;
    in property <length> diameter: 44px;
    callback clicked;

    width: root.diameter;
    height: root.diameter;
    border-radius: self.width / 2;
    background: touch.pressed ? #b9885c50 : (touch.has-hover ? #ffffff1e : #ffffff10);
    border-width: 1px;
    border-color: touch.has-hover ? #d9a86c66 : #ffffff14;
    animate background, border-color { duration: 120ms; easing: ease-out; }

    Path {
        width: root.diameter * 0.5;
        height: root.diameter * 0.5;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: touch.has-hover ? #f0e6d8 : #d9cdbd;
        stroke-width: 1.6px;
        // 播放/暂停这类实心图形靠 fill;线条图形把 fill 关掉即可(这里统一填充,
        // 图标本身都画成闭合形)。
        fill: touch.has-hover ? #f0e6d8 : #d9cdbd;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 日月开关:白昼(顺序播放)⇄ 夜晚(随机播放)。
// 参考 StatIndet/dotfiles 的 QML DemoSwitch:天空底色渐变、云与星随昼夜升降、
// 太阳滑到对侧变月亮、贝塞尔回弹缓动、悬停时滑块向对侧探身 —— 全部纯 Slint,
// 圆角矩形 clip 裁掉出界的云星,不需要 bevy。
component DayNightSwitch inherits Rectangle {
    in-out property <bool> night: false;
    callback toggled;

    // QML 原作 180×70,这里等比压到控制条尺寸。
    width: 92px;
    height: 36px;
    border-radius: self.height / 2;
    clip: true;
    background: root.night ? #191e32 : #4685c0;
    animate background { duration: 700ms; easing: ease-in-out; }

    // 光晕:三层同心白圈跟着滑块走,昼夜都在,给按钮一点"发光体"的存在感。
    for halo[i] in [66px, 88px, 110px]: Rectangle {
        width: halo;
        height: halo;
        border-radius: self.width / 2;
        background: white;
        opacity: 0.20 - i * 0.07;
        x: knob.x + knob.width / 2 - self.width / 2;
        y: knob.y + knob.height / 2 - self.height / 2;
        animate x { duration: 500ms; easing: cubic-bezier(0.56, 1.35, 0.52, 1.0); }
    }

    // 云:三团白圆压在下缘,白天在场,入夜整体沉出画面。
    // 悬停(白天)时被太阳"推"远一点 —— 原作的斥力,只取其形。
    clouds := Rectangle {
        width: 100%;
        height: 100%;
        y: root.night ? root.height : 0;
        animate y { duration: 500ms; easing: cubic-bezier(0.56, 1.35, 0.52, 1.0); }

        for cloud[i] in [
            { cx: 52px, cy: 26px, d: 26px },
            { cx: 68px, cy: 20px, d: 30px },
            { cx: 84px, cy: 26px, d: 34px },
        ]: Rectangle {
            width: cloud.d;
            height: cloud.d;
            border-radius: self.width / 2;
            background: white;
            opacity: 0.9;
            x: cloud.cx - self.width / 2 + (touch.has-hover && !root.night ? 5px : 0px);
            y: cloud.cy - self.height / 2 + 6px;
            animate x { duration: 400ms; easing: ease-out; }
        }
    }

    // 星:小菱形散在上半,入夜降下来,白天升出画面。
    // 悬停(夜里)时被月亮推开一点。
    stars := Rectangle {
        width: 100%;
        height: 100%;
        y: root.night ? 0 : -root.height;
        animate y { duration: 500ms; easing: cubic-bezier(0.56, 1.35, 0.52, 1.0); }

        for star[i] in [
            { sx: 14px, sy: 8px, d: 7px },
            { sx: 30px, sy: 18px, d: 5px },
            { sx: 22px, sy: 27px, d: 4px },
            { sx: 42px, sy: 9px, d: 4px },
        ]: Path {
            width: star.d;
            height: star.d;
            x: star.sx + (touch.has-hover && root.night ? -4px : 0px);
            y: star.sy;
            viewbox-width: 10;
            viewbox-height: 10;
            // 四角星:四段二次曲线,腰收向圆心 —— 原作 Shape 的形状。
            commands: "M 5 0 Q 5 5 10 5 Q 5 5 5 10 Q 5 5 0 5 Q 5 5 5 0 Z";
            fill: white;
            animate x { duration: 400ms; easing: ease-out; }
        }
    }

    // 滑块:白天是太阳(暖黄 + 高光),入夜滑到右侧变月亮(冷灰 + 陨石坑)。
    // 悬停时向对侧探 4px,像在提示"按我会滑过去"。
    knob := Rectangle {
        property <length> margin: 4px;
        property <length> start-x: self.margin;
        property <length> end-x: root.width - self.width - self.margin;

        width: root.height - 8px;
        height: root.height - 8px;
        y: 4px;
        x: root.night
            ? (touch.has-hover ? knob.end-x - 4px : knob.end-x)
            : (touch.has-hover ? knob.start-x + 4px : knob.start-x);
        border-radius: self.width / 2;
        background: root.night ? #c3c8d2 : #ffc323;
        drop-shadow-blur: 6px;
        drop-shadow-offset-x: 1px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000080;
        animate x { duration: 500ms; easing: cubic-bezier(0.56, 1.35, 0.52, 1.0); }
        animate background { duration: 500ms; easing: ease-in-out; }

        // 太阳高光:偏心一点的亮斑,夜里淡出。
        Rectangle {
            width: parent.width * 0.8;
            height: parent.height * 0.8;
            x: parent.width * 0.06;
            y: parent.height * 0.06;
            border-radius: self.width / 2;
            background: #ffe650;
            opacity: root.night ? 0 : 0.6;
            animate opacity { duration: 500ms; }
        }

        // 陨石坑:三个灰圆,白天淡出,并跟着原作绕月心转 -90° 入场。
        // Rectangle 没有 rotation-angle,所以坑的位置直接用极坐标写:
        // 动 spin 一个角度,三个坑各自沿圆弧走 —— 与 transform: rotate 等价。
        craters := Rectangle {
            // 坑相对月心(14px, 14px)的极坐标,由原作的直角坐标换算而来。
            property <angle> spin: root.night ? 0deg : -90deg;

            width: 100%;
            height: 100%;
            opacity: root.night ? 1 : 0;
            animate opacity { duration: 300ms; }
            animate spin { duration: 300ms; easing: cubic-bezier(0.56, 1.35, 0.52, 1.0); }

            for crater[i] in [
                { r: 9.06px, a: 263.66deg, d: 7px },
                { r: 9.22px, a: 192.53deg, d: 10px },
                { r: 4.24px, a: 45deg, d: 6px },
            ]: Rectangle {
                width: crater.d;
                height: crater.d;
                border-radius: self.width / 2;
                background: #96a0b4;
                x: 14px + crater.r * Math.cos(crater.a + craters.spin) - self.width / 2;
                y: 14px + crater.r * Math.sin(crater.a + craters.spin) - self.height / 2;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.night = !root.night;
            root.toggled();
        }
    }
}

// 控制键簇:上一首 / 播放暂停 / 下一首 + 日月随机开关。
// 抽成组件是因为宽窄两种版式各摆一次 —— 摆法不同,键是同一套。
component ControlCluster inherits HorizontalLayout {
    in property <bool> is-playing;
    in-out property <bool> shuffle-on;
    callback prev();
    callback toggle();
    callback next();
    callback shuffle-toggled();

    spacing: 10px;

    VerticalLayout {
        alignment: center;
        RoundControl {
            // ⏮:竖杠 + 左向三角。
            icon: "M7 5 L7 19 M9 5 L9 19 M19 5 L11 12 L19 19 Z";
            clicked => { root.prev(); }
        }
    }
    VerticalLayout {
        alignment: center;
        RoundControl {
            diameter: 50px;
            // ▶ 或 ⏸,随播放状态换。
            icon: root.is-playing
                ? "M8 5 L10.5 5 L10.5 19 L8 19 Z M13.5 5 L16 5 L16 19 L13.5 19 Z"
                : "M8 5 L19 12 L8 19 Z";
            clicked => { root.toggle(); }
        }
    }
    VerticalLayout {
        alignment: center;
        RoundControl {
            // ⏭:右向三角 + 竖杠。
            icon: "M5 5 L13 12 L5 19 Z M15 5 L15 19 M17 5 L17 19";
            clicked => { root.next(); }
        }
    }
    VerticalLayout {
        alignment: center;
        DayNightSwitch {
            night <=> root.shuffle-on;
            toggled => { root.shuffle-toggled(); }
        }
    }
}

// 同播区:有设备列 chips,点一台推过去;一台都没有时写明原因 ——
// **常驻**,不随名册隐藏。上一版设备区在单实例时整块消失,同播功能等于不存在。
component SyncStrip inherits HorizontalLayout {
    in property <[DeviceRow]> devices;
    callback push-to(string);

    spacing: 8px;

    if root.devices.length == 0: VerticalLayout {
        alignment: center;
        Text {
            text: "同播: 没有其他设备";
            font-family: "Maple Mono NF CN";
            color: #6b7080;
            font-size: 12px;
        }
    }

    for device in root.devices: VerticalLayout {
        alignment: center;
        Rectangle {
            width: chip-label.preferred-width + 24px;
            height: 30px;
            background: chip.has-hover ? #b9885c66 : #ffffff0f;
            border-radius: 15px;

            chip := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.push-to(device.id); }
            }

            // 设备名由对端自报,可能是任意 CJK —— 与歌名同理,
            // 不指定 font-family,落到系统字体。
            chip-label := Text {
                text: device.name;
                color: #e6e8ef;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}

// Home 的入口卡片:大图标 + 名字,点了切页。悬停时上浮、描边亮起 ——
// 让"这是个门"一眼可见,不用靠猜。
component EntryCard inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    callback clicked;

    width: 148px;
    height: 168px;
    border-radius: 18px;
    background: touch.has-hover ? #2a1e1466 : #17110d66;
    border-width: 1px;
    border-color: touch.has-hover ? #d9a86c88 : #ffffff14;
    drop-shadow-blur: touch.has-hover ? 24px : 12px;
    drop-shadow-color: #00000055;
    drop-shadow-offset-y: touch.has-hover ? 8px : 4px;
    animate background, border-color, drop-shadow-blur, drop-shadow-offset-y {
        duration: 160ms;
        easing: ease-out;
    }

    VerticalLayout {
        alignment: center;
        spacing: 14px;

        HorizontalLayout {
            alignment: center;
            Path {
                width: 44px;
                height: 44px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                stroke: touch.has-hover ? #d9a86c : #9aa0b4;
                stroke-width: 1.6px;
                fill: transparent;
            }
        }
        Text {
            text: root.label;
            color: touch.has-hover ? #e6e8ef : #9aa0b4;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    // 帧率,由 Rust 测量并推送。仅在 `show-fps` 为真时被推送。
    in property <float> fps: 0;
    // 是否显示帧率读数。由 Rust 按 `SLINT_STUDY_FPS` 环境变量设置(见 lib.rs 的 fps_enabled)。
    in property <bool> show-fps: false;
    // 当前编译目标的平台名(wasm / android / linux / …),由 Rust 推送。
    in property <string> platform;
    // 搜索结果。每个字段都已在 Rust 侧格式化完毕,这里只负责摆。
    in property <[TrackRow]> tracks: [];
    // 播放状态的一行文案,由 Rust 根据 app-core 的 PlaybackState 渲染后推送。
    in property <string> playback-text;
    // 是否正在出声。决定控制条中键画 ⏸ 还是 ▶。
    in property <bool> is-playing: false;
    // 随机播放开关(日月开关的状态)。Rust 读它决定队列洗不洗牌。
    in-out property <bool> shuffle-on: false;
    // 同播名册里除本机之外的在线设备,由信令服务端主动推送(见 crates/syncplay)。
    in property <[DeviceRow]> devices: [];
    // 同播状态的一行文案,由 Rust 根据 syncplay 的 Role 渲染后推送。
    in property <string> sync-text;
    // bevy 离屏渲染的 3D 画面,由 render3d 每帧推送(见 crates/render3d)。
    // 桌面 / android 才会被设值;web / ios 上恒为空图(width == 0),下方面板据此隐藏,
    // 无需在此写任何平台判断 —— 这就是「余端 graceful 缺省」的落点。
    in property <image> scene-3d;
    // 遮挡层:同一个场景,但只含**比注释卡片更近**的片元,其余透明(由 render3d 的
    // 第二台相机画出)。盖在卡片之上,卡片就被 3D 物体逐像素挡住。
    in property <image> occluder-3d;
    // 3D 立方体的朝向(弧度),由「3D」页上的拖动累加得到,Rust 每帧读出后
    // 传给 render3d 设为立方体的绝对朝向。水平拖动改 yaw,垂直拖动改 pitch。
    in-out property <float> rot-yaw: 0;
    in-out property <float> rot-pitch: 0;
    // 当前选中的导航页:0=Home、1=Music、2=3D。由左侧导航栏点击设置。
    in-out property <int> current-tab: 0;
    // 3D 场景热调参数。Rust 每帧读这些原始文本,在信任边界解析+clamp(见 scene_params),
    // 非法/越界退回上一个好值。scene-index:0=形状画廊、1=实体阵列。
    in-out property <int> scene-index: 0;
    in-out property <string> count-text: "8";
    in-out property <string> color-text: "#4a6bff";
    in-out property <string> speed-text: "0.0";
    in-out property <string> spacing-text: "1.5";
    // 3D 内容区的逻辑尺寸。Rust 每帧乘窗口缩放系数得物理像素,让 bevy 按该分辨率渲染。
    out property <length> scene-w: content.width;
    out property <length> scene-h: content.height;
    // 版式(Layout Mode):窄→紧凑(底部导航),宽→侧栏。**由运行时窗口宽度决定,不由端决定**
    // —— 桌面把窗口拖窄一样变成紧凑版式,这既是要的体验,也是唯一能在桌面验证移动版式的办法。
    // 见 docs/adr/0007。600px 是 Material 的标准断点:手机竖屏(~393dp)紧凑,
    // 手机横屏(~850dp)回到侧栏 —— 横屏本来就矮,底栏再吃 64px 太亏。
    //
    // 用 changed 回调赋值、而不是写成 `compact: root.width < 600px` 的绑定:版式一变,子元素的
    // 约束(侧栏在不在、底栏在不在)就变,窗口的 layoutinfo 跟着变,宽度又回头喂给 compact ——
    // 那是一个真的求值环,Slint 1.18 起会警告并可能在运行时 panic。命令式赋值把环剪断:
    // 宽度先定下来,再单向推出版式。
    property <bool> compact;
    init => { root.compact = root.width < 600px; }
    changed width => { root.compact = root.width < 600px; }

    // 热调工具条的几何量,逻辑像素,相对 3D 内容区左上角。**这里是唯一真相** ——
    // Rust 每帧乘缩放系数交给 render3d 的玻璃 shader,让它精确模糊这块区域背后的画面
    // (见 crates/render3d/src/glass.rs)。别在 Rust 里重抄这几个常量,改了留白会静默错位。
    //
    // 紧凑版式换行成两行(按钮一行、四个参数框一行),故高度跟着版式变。shader 全从
    // uniform 读几何量,这里改完 Rust 和 WGSL 一行都不用动。
    out property <length> glass-x: 16px;
    out property <length> glass-y: 16px;
    out property <length> glass-w: content.width - 2 * root.glass-x;
    // 高度按内容算出来的。一个参数框 = 15(标签) + 2 + 40(LineEdit) = 57px。
    // 宽版:8 + 57 + 8 ≈ 76px。紧凑版 = 8 + 56(按钮) + 8 + (57×2 + 8) + 8 = 202 → 取 204px。
    out property <length> glass-h: root.compact ? 204px : 76px;
    out property <length> glass-r: 18px;

    // 注释卡片的几何量,逻辑像素,相对 3D 内容区左上角。**这里是唯一真相** ——
    // 盖在卡片上的遮挡层要靠这几个值反推负偏移,才能和场景那张图逐像素对齐。
    // 居中摆:转盘中心投影在画面正中,卡片钉在那儿,环上的形状转到近侧就压过来。
    out property <length> card-w: 300px;
    out property <length> card-h: 92px;
    out property <length> card-x: (content.width - root.card-w) / 2;
    out property <length> card-y: (content.height - root.card-h) / 2;
    // 仅当 3D 页激活**且没被播放页盖住**时才驱动 bevy(省电)。Rust 每帧读它决定是否渲染。
    out property <bool> render-active: root.current-tab == 2 && !root.play-page-open;

    // ── 播放页(CONTEXT.md「播放页」):控制条展开的全窗沉浸层 ──
    // 展开/收起全在 .slint 内部;操作类功能仍由覆层里的 ControlCluster 走同一组
    // 回调 —— docs/adr/0010 的「功能等价路径」。
    in-out property <bool> play-page-open: false;
    // warp 视觉纹理,render3d 的 WarpPass 每帧推送(见 crates/render3d/src/warp.rs)。
    // 无 GPU 构建恒空图(width 0),覆层退回纯色底 —— 与 scene-3d 同一个缺省模式。
    in property <image> viz-bg;
    // 播放页粒子场景(透明底)与其遮挡层,render3d 的 viz 模式每帧推送。
    // 空图时覆层退回第一步的 warp 形态 —— 同一个「余端 graceful 缺省」。
    in property <image> viz-scene;
    in property <image> viz-occluder;
    // 封面深度卡的几何,逻辑像素。**这里是唯一真相**:卡片摆位与遮挡层的裁剪
    // 负偏移都从这几个值算,别在别处重抄(与 3D 页 card-* 同一个模式)。
    out property <length> viz-card-size: 220px;
    out property <length> viz-card-x: (root.width - root.viz-card-size) / 2;
    out property <length> viz-card-y: (root.height - root.viz-card-size) / 2 - 60px;
    // 歌词块的几何量,同样是唯一真相:它与封面卡**同处一个 z 平面**,因此可以
    // 复用同一张遮挡图,只是裁剪矩形不同 —— 粒子于是也从字的前后穿过。
    out property <length> viz-lyric-h: 108px;
    out property <length> viz-lyric-y: root.viz-card-y + root.viz-card-size + 96px;
    // 正在播的封面(已解码)。取不到 / 解不出时为空图,封面卡整块隐藏。
    in property <image> cover-art;
    // 正在播的歌名与歌手,play_current 推送。任意 CJK,不指定子集字体。
    in property <string> now-title;
    in property <string> now-artists;
    // 当前歌词行与其译文,Rust 每帧按播放位置选出后推送(见 app_core::current_line)。
    // 没有歌词、或还在前奏时为空串,歌词区整块让位。
    in property <string> lyric-line;
    in property <string> lyric-translation;
    // 省电门的 .slint 半边:展开 ∧ 播放。第三条「窗口可见」在 Rust 侧
    // (lib.rs 渲染通知回调)判,三条齐了才渲 warp,暂停定格在最后一帧。
    out property <bool> viz-active: root.play-page-open && root.is-playing;

    // ── 宽版式侧栏「液态玻璃 metaball 选中器」──
    // 视觉由 render3d 的独立 wgpu pass 画进 nav-bg(见 crates/render3d/src/navglass),Slint 只出
    // 几何与交互。侧栏槽位常量是**唯一真相**:布局与选中块位置都从这里算,不各写各的。
    property <length> nav-pad: 8px;
    property <length> nav-gap: 6px;
    // 单个导航项高,也是选中块的参考高。out:Rust 读它定块尺寸。
    out property <length> nav-slot-h: 68px;
    // 侧栏纹理尺寸(逻辑像素)。Rust 每帧乘缩放系数得物理像素当目标纹理尺寸。
    out property <length> nav-w: 96px;
    out property <length> nav-h: content.height;
    // 紧凑版式(手机底栏)没有这条侧栏,Rust 据此整段跳过导航选中器的渲染。
    out property <bool> nav-visible: !root.compact;
    // 当前选中槽的中心 y(逻辑像素,相对侧栏顶):pad + i·(项高+间距) + 项高/2。
    property <length> nav-target-y: root.nav-pad + root.current-tab * (root.nav-slot-h + root.nav-gap) + root.nav-slot-h / 2;
    // metaball 的头(快)/尾(慢):都朝 nav-target-y 动,快慢不同 → 行走时一前一后被 shader
    // 的 smooth-union 拉出胶着的颈,静止时重合成单块。out:Rust 每帧读这两个动画值喂 shader。
    // 用两个不同时长的 animate,避开「同一处理器里 progress 先置 0 再置 1 会被合并、动不起来」那个坑。
    out property <length> nav-lead-y: root.nav-target-y;
    out property <length> nav-lag-y: root.nav-target-y;
    animate nav-lead-y { duration: 240ms; easing: ease-out; }
    animate nav-lag-y { duration: 440ms; easing: ease-out; }
    // render3d 每帧(转场期间)渲出的侧栏背景纹理。非 GPU 构建恒为空图(width 0),
    // 侧栏退回 Slint 平底 + NavItem 自带高亮(见侧栏与 NavItem)。
    in-out property <image> nav-bg;
    // 用关键词搜歌。
    callback search(string);
    // 取今日推荐,结果落进同一个 tracks 列表。
    callback daily();
    // 取我喜欢的音乐,同上。
    callback liked();
    // 放某首歌。参数是 TrackRow 的 id。
    callback play(string);
    // 播放/暂停。正在收听同播时按下等于退出收听(见 CONTEXT.md「听众」)。
    callback toggle-play();
    // 队列内切歌。
    callback next-track();
    callback prev-track();
    // 随机开关拨动之后。新状态在 shuffle-on 里。
    callback shuffle-toggled();
    // 把正在放的这首推给某台设备。参数是 DeviceRow 的 id。
    callback push-to(string);

    title: "Slint Study";
    background: #0f1117;
    // 开窗即宽版式;最小尺寸故意放到手机竖屏那么窄 —— 桌面上把窗口拖窄就能直接看到
    // 紧凑版式,不必开模拟器。
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 360px;
    min-height: 520px;

    // 顶层恒为一个 VerticalLayout(主体行 + 可选底栏)→ 窗口撑满且可调整大小。
    VerticalLayout {

        // ── 主体行:宽版式是「侧栏 + 内容」,紧凑版式只有内容 ──
        HorizontalLayout {
            vertical-stretch: 1;
            padding-top: root.safe-area-insets.top;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            // 紧凑版式的底部 inset 归底栏管 —— 它的背景要铺到手势条底下,不能在这里先留白,
            // 否则手势条那一条会露出窗口底色,全面屏观感碎掉。
            padding-bottom: root.compact ? 0 : root.safe-area-insets.bottom;

            // ── 侧栏(宽版式)──
            // ponytail: 深色底不铺到左刘海底下(padding-left 已经把它推开了)。桌面 inset 恒 0、
            // 安卓竖屏没有左 inset,只有「横屏 + 左刘海」这一种情况会露一条底色,不值得为它
            // 把侧栏也拆成「背景铺满 + 内部 padding」。
            if !root.compact: Rectangle {
                width: root.nav-w;
                // 兜底平底:非 GPU 构建就是这层纯色 + NavItem 自带高亮。
                background: #140f0b;

                // GPU 液态玻璃选中器:转场时 render3d 渲进 nav-bg,盖在平底之上、图标之下。
                // 非 GPU 构建 nav-bg 为空(width 0),这个 Image 不显示,露出上面的平底。
                Image {
                    source: root.nav-bg;
                    width: 100%;
                    height: 100%;
                    image-fit: fill;
                }

                VerticalLayout {
                    padding: root.nav-pad;
                    spacing: root.nav-gap;
                    alignment: start;

                    for item[i] in Nav.items: NavItem {
                        height: root.nav-slot-h;
                        label: item.label;
                        icon: item.icon;
                        active: root.current-tab == i;
                        // GPU 构建里选中高亮由玻璃提供,压掉自带 active 底,免得叠两遍。
                        gpu-selected: root.nav-bg.width > 0;
                        clicked => { root.current-tab = i; }
                    }
                }
            }

            // ── 内容区。三页共用这块矩形(scene-w/h 由它量出),按 current-tab 切换子内容 ──
            content := Rectangle {
                horizontal-stretch: 1;

                // 极光背景:玻璃卡片透出来的颜色全来自这里。3D 页不铺 —— 那边背后是
                // bevy 画面,本来就有内容可透。
                if root.current-tab != 2: AuroraBackground {
                    width: 100%;
                    height: 100%;
                }

                // Home:入口卡片页。标题 + 两扇门(Music / 3D)。
                // 与左侧导航栏功能重复,是刻意的:这里是"落地页",导航栏是"随时切"。
                if root.current-tab == 0: VerticalLayout {
                    alignment: center;
                    spacing: 28px;

                    Text {
                        text: "Slint on " + root.platform;
                        color: #e6e8ef;
                        font-size: 22px;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 20px;

                        EntryCard {
                            label: "Music";
                            icon: "M9 18 L9 5 L20 3 L20 16 M9 18 A2.5 2.5 0 1 1 6.5 15.5 A2.5 2.5 0 0 1 9 18 M20 16 A2.5 2.5 0 1 1 17.5 13.5 A2.5 2.5 0 0 1 20 16";
                            clicked => { root.current-tab = 1; }
                        }
                        EntryCard {
                            label: "3D";
                            icon: "M12 3 L20 7.5 L20 16.5 L12 21 L4 16.5 L4 7.5 Z M12 3 L12 12 M12 12 L20 7.5 M12 12 L4 7.5";
                            clicked => { root.current-tab = 2; }
                        }
                    }
                }

                // Music:搜歌 + 点一首放出声。整页可滚,不裹玻璃卡片 ——
                // 列表要吃满可用高度,套进定宽卡片在手机上只剩三四行可见。
                if root.current-tab == 1: VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;

                        // 搜索框。歌名是任意 CJK,不能指定子集字体,
                        // 否则输入的字大多不在子集里,直接是豆腐块。
                        keyword := LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "Search";
                            accepted => { root.search(self.text); }
                        }
                        // 三个按钮压窄:默认 220px 一排放不下,手机上更是直接溢出。
                        // 紧凑版再收一档,给搜索框留出还能打字的宽度。
                        HoverButton {
                            width: root.compact ? 60px : 84px;
                            text: "Go";
                            clicked => { root.search(keyword.text); }
                        }
                        HoverButton {
                            width: root.compact ? 68px : 92px;
                            text: "Daily";
                            clicked => { root.daily(); }
                        }
                        HoverButton {
                            width: root.compact ? 68px : 92px;
                            text: "Liked";
                            clicked => { root.liked(); }
                        }
                    }

                    // 播放状态行。文案是硬编码中文,走子集字体;
                    // 高度钉死,免得文案变长把下面的列表顶来顶去。
                    Text {
                        text: root.playback-text;
                        font-family: "Maple Mono NF CN";
                        color: #9aa0b4;
                        font-size: 13px;
                        height: 20px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // 同播状态行:推给几台 / 正在收听谁 / 出了什么错。
                    Text {
                        text: root.sync-text;
                        font-family: "Maple Mono NF CN";
                        color: #9aa0b4;
                        font-size: 13px;
                        height: 20px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: results.preferred-height;

                        results := VerticalLayout {
                            spacing: 4px;
                            alignment: start;

                            for row[i] in root.tracks: Rectangle {
                                height: 52px;
                                background: touch.has-hover ? #ffffff14 : #ffffff08;
                                border-radius: 8px;

                                touch := TouchArea {
                                    clicked => { root.play(row.id); }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        // 歌名与歌手来自平台,是任意 CJK/日文 ——
                                        // 不指定 font-family,落到系统字体。
                                        // web 端 wasm 里没有系统字体,那边会是豆腐块,
                                        // 已知缺口,见 README「音乐链路」。
                                        Text {
                                            text: row.title;
                                            color: #e6e8ef;
                                            font-size: 14px;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.artists;
                                            color: #9aa0b4;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                    Text {
                                        text: row.duration;
                                        color: #9aa0b4;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // 控制条:上一首 / 播放暂停 / 下一首 / 日月随机开关 │ 同播设备。
                    //
                    // 宽版一排放下;紧凑版(手机)拆两行 —— 一排的最小宽度约 470px,
                    // 而手机内容区只有 ~360px,硬挤会把按钮画出屏幕右缘。
                    controls := Rectangle {
                        height: root.compact ? 116px : 60px;
                        border-radius: 16px;
                        background: #17110daa;
                        border-width: 1px;
                        border-color: #ffffff10;

                        if !root.compact: HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;

                            ControlCluster {
                                alignment: start;
                                is-playing: root.is-playing;
                                shuffle-on <=> root.shuffle-on;
                                prev => { root.prev-track(); }
                                toggle => { root.toggle-play(); }
                                next => { root.next-track(); }
                                shuffle-toggled => { root.shuffle-toggled(); }
                            }
                            // 展开播放页:向上的小三角。「正在播放」是状态,展开是看它的方式。
                            RoundControl {
                                icon: "M12 7 L19 16 L5 16 Z";
                                clicked => { root.play-page-open = true; }
                            }
                            SyncStrip {
                                alignment: end;
                                devices: root.devices;
                                push-to(id) => { root.push-to(id); }
                            }
                        }

                        if root.compact: VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                ControlCluster {
                                    is-playing: root.is-playing;
                                    shuffle-on <=> root.shuffle-on;
                                    prev => { root.prev-track(); }
                                    toggle => { root.toggle-play(); }
                                    next => { root.next-track(); }
                                    shuffle-toggled => { root.shuffle-toggled(); }
                                }
                                // 展开播放页,同宽版那颗。
                                RoundControl {
                                    icon: "M12 7 L19 16 L5 16 Z";
                                    clicked => { root.play-page-open = true; }
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                SyncStrip {
                                    devices: root.devices;
                                    push-to(id) => { root.push-to(id); }
                                }
                            }
                        }
                    }
                }

                // 3D:bevy 离屏画面铺满内容区,分辨率随 content 尺寸动态变化,拖动控制朝向。
                // 空图(未就绪 / web·ios,或刚切进来还没渲染出首帧)时不渲染这块。
                if root.current-tab == 2 && root.scene-3d.width > 0: Image {
                    width: 100%;
                    height: 100%;
                    image-fit: fill;
                    source: root.scene-3d;

                    // 拖动累加朝向:按下记起点,拖动时把像素增量乘灵敏度加到 yaw/pitch。
                    drag := TouchArea {
                        property <length> last-x;
                        property <length> last-y;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                drag.last-x = drag.mouse-x;
                                drag.last-y = drag.mouse-y;
                            }
                        }
                        moved => {
                            root.rot-yaw += (drag.mouse-x - drag.last-x) / 1px * 0.01;
                            root.rot-pitch += (drag.mouse-y - drag.last-y) / 1px * 0.01;
                            drag.last-x = drag.mouse-x;
                            drag.last-y = drag.mouse-y;
                        }
                    }
                }

                // 深度正确的 UI:一张真正的 Slint 卡片,被 bevy 场景里的物体逐像素挡住。
                //
                // 合成拆成三层 —— 场景(上面那张 Image)→ 卡片 → 遮挡层。遮挡层是 bevy
                // 用第二台相机画的同一场景,深度缓冲预先清到卡片所在的深度,于是只剩
                // "比卡片更近"的片元,其余透明(见 crates/render3d 的 spawn_occluder_camera)。
                // Slint 这边只做寻常的 alpha 合成:它不需要懂深度,UI 也不必先渲进纹理。
                //
                // 外层 Rectangle 只干一件事:clip。遮挡层那张 Image 是**整块内容区**大小的
                // ——它必须和场景那张逐像素对齐,才谈得上是同一个场景——所以用负偏移把它
                // 推回内容区原点,再由这里裁到卡片范围。不裁的话,近处的物体会连工具条
                // 一起盖住,那是错的:工具条是界面外壳,不在场景里。
                if root.current-tab == 2 && root.occluder-3d.width > 0: Rectangle {
                    x: root.card-x;
                    y: root.card-y;
                    width: root.card-w;
                    height: root.card-h;
                    clip: true;

                    // passive:这是一张标签,不是控件。让开指针事件,拖动才能穿过它
                    // 转动场景 —— 它正压在画面中心,吃掉事件的话那一块就转不动了。
                    GlassCard {
                        width: 100%;
                        height: 100%;
                        passive: true;
                        VerticalLayout {
                            padding: 14px;
                            alignment: center;
                            spacing: 4px;

                            Text {
                                text: "转盘中心";
                                color: #e6e8ef;
                                font-size: 15px;
                            }
                            Text {
                                text: "近侧的物体会逐像素挡住它";
                                color: #9aa0b4;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Image {
                        x: -root.card-x;
                        y: -root.card-y;
                        width: content.width;
                        height: content.height;
                        image-fit: fill;
                        source: root.occluder-3d;
                    }
                }

                // 3D 热调面板:玻璃工具条浮在画面上,边调边看。场景切换用一个循环按钮(两个场景),
                // 四个参数用原生 LineEdit。始终随 3D 页显示(不等首帧),故独立于上面的 Image 块。
                //
                // 这里是玻璃最有说服力的落点 —— 背后是真实的、会动的 bevy 画面,不像 Home/Server
                // 那样得先铺一层极光出来给它透。四周留白 16px,让它"浮"在画面上而不是贴着顶边。
                //
                // 顺带修掉一个旧行为:原来是一个不吃事件的 Rectangle,在顶栏空白处拖动会**穿透**
                // 下去转动 3D 模型。GlassCard 自带 TouchArea(读指针位置用),现在拖工具条不会
                // 再误转场景了。
                // 几何量取自上面的 glass-* 属性 —— 同一组值也交给了 render3d 的玻璃 shader,
                // 两边必须严丝合缝对齐,否则模糊区和边框会错位。
                //
                // backdrop: true —— 背后那层模糊 + 折射 + 淡染由 shader 在 GPU 上做完了
                // (bevy 的画面是我们自己画的,所以采样得到),这里只负责边框、厚度、阴影
                // 和指针高光,自身的淡白底必须让开,否则白色叠两遍。
                //
                // 两个版式:宽版一行(按钮 + 四个参数框,参数框吃掉剩余宽度),紧凑版两行
                // (按钮撑满一行,四个参数框一行)。参数框都会伸缩,所以任何宽度下都不被裁。
                if root.current-tab == 2: GlassCard {
                    x: root.glass-x;
                    y: root.glass-y;
                    width: root.glass-w;
                    height: root.glass-h;
                    radius: root.glass-r;
                    backdrop: true;

                    if !root.compact: HorizontalLayout {
                        padding: 8px;
                        padding-left: 12px;
                        spacing: 12px;

                        HoverButton {
                            width: 160px;
                            text: root.scene-index == 0 ? "形状画廊" : "实体阵列";
                            clicked => { root.scene-index = 1 - root.scene-index; }
                        }
                        ParamRow {
                            count-text <=> root.count-text;
                            color-text <=> root.color-text;
                            speed-text <=> root.speed-text;
                            spacing-text <=> root.spacing-text;
                        }
                    }

                    if root.compact: VerticalLayout {
                        padding: 8px;
                        padding-left: 12px;
                        spacing: 8px;

                        HoverButton {
                            width: root.glass-w - 20px;
                            text: root.scene-index == 0 ? "形状画廊" : "实体阵列";
                            clicked => { root.scene-index = 1 - root.scene-index; }
                        }
                        ParamRow {
                            stacked: true;
                            count-text <=> root.count-text;
                            color-text <=> root.color-text;
                            speed-text <=> root.speed-text;
                            spacing-text <=> root.spacing-text;
                        }
                    }
                }

                // fps 浮层:content 的最后一个子元素 → 画在最上层,覆盖 3D 铺满的 Image。
                // 左上角,所有页可见。诚实即时帧率(见 lib.rs 的 fps 模块)。
                if root.show-fps: Text {
                    x: 8px;
                    y: 8px;
                    text: "FPS " + round(root.fps);
                    color: #51cf66;
                    font-size: 14px;
                    font-weight: 700;
                }
            }
        }

        // ── 底栏(紧凑版式)──
        // 背景铺满到屏幕底边,内部 padding-bottom 把图标顶到手势条之上 —— 与 MainActivity 的
        // edge-to-edge 一致:手势条底下是导航栏的深色,不是一条露出来的窗口底色。
        if root.compact: Rectangle {
            height: 64px + root.safe-area-insets.bottom;
            background: #140f0b;
            HorizontalLayout {
                padding-left: root.safe-area-insets.left + 8px;
                padding-right: root.safe-area-insets.right + 8px;
                padding-bottom: root.safe-area-insets.bottom;
                spacing: 4px;

                for item[i] in Nav.items: NavItem {
                    horizontal-stretch: 1;
                    label: item.label;
                    icon: item.icon;
                    active: root.current-tab == i;
                    clicked => { root.current-tab = i; }
                }
            }
        }
    }

    // ── 播放页覆层:盖住包括导航在内的整个窗口(CONTEXT.md「播放页」)──
    // 五层合成:warp 背景 → 粒子场景 → 封面深度卡 → 遮挡层(裁到卡片)→ 控制簇。
    // 封面是第一张深度卡片:遮挡层只含比卡片锚点更近的粒子,盖上来就是「粒子从
    // 封面前面掠过」;功能(控制簇)永远在最上层 2D、点得到 —— docs/adr/0010。
    if root.play-page-open: Rectangle {
        // 兜底纯色底:无 GPU 构建(viz-bg 恒空)也得是完整的深色沉浸层。
        background: #0b0d13;

        if root.viz-bg.width > 0: Image {
            width: 100%;
            height: 100%;
            image-fit: fill;
            source: root.viz-bg;
        }

        // 粒子场景:透明底,叠在 warp 上。远侧粒子在这层被封面卡盖住,
        // 近侧粒子由下面的遮挡层重新盖回卡片之上 —— 深度由此闭环。
        if root.viz-scene.width > 0: Image {
            width: 100%;
            height: 100%;
            image-fit: fill;
            source: root.viz-scene;
        }

        // 点视觉区任意处收起。压在视觉之上、内容之下 —— 控制键各有 TouchArea,
        // 不会误触到这层;封面与文字是纯展示,点它们也算「点空白」。
        TouchArea {
            clicked => { root.play-page-open = false; }
        }

        // 封面深度卡。几何取 viz-card-*(唯一真相);无封面时留半透明玻璃底,
        // 深度遮挡的观感不依赖封面是否取到。
        Rectangle {
            x: root.viz-card-x;
            y: root.viz-card-y;
            width: root.viz-card-size;
            height: root.viz-card-size;
            border-radius: 20px;
            clip: true;
            background: #17110daa;
            // 描一圈细边,封面亮色时不至于和视觉糊在一起。
            border-width: 1px;
            border-color: #ffffff22;

            if root.cover-art.width > 0: Image {
                width: 100%;
                height: 100%;
                image-fit: cover;
                source: root.cover-art;
            }
        }

        // 歌名与歌手:卡片正下方。平台数据任意 CJK,不指定子集字体。
        Text {
            y: root.viz-card-y + root.viz-card-size + 24px;
            width: 100%;
            text: root.now-title;
            color: #e6e8ef;
            font-size: 22px;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            y: root.viz-card-y + root.viz-card-size + 58px;
            width: 100%;
            text: root.now-artists;
            color: #9aa0b4;
            font-size: 14px;
            horizontal-alignment: center;
            overflow: elide;
        }

        // 歌词:深度卡片的首个真载荷(issue #16)。当前行 + 译文,居中排在
        // 封面下方;取不到歌词或还在前奏时为空串,这块自然让位。
        if root.lyric-line != "": VerticalLayout {
            y: root.viz-lyric-y;
            height: root.viz-lyric-h;
            alignment: start;
            spacing: 10px;

            Text {
                width: root.width;
                text: root.lyric-line;
                color: #f2f5ff;
                font-size: 30px;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                width: root.width;
                text: root.lyric-translation;
                color: #aab2c8;
                font-size: 16px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        // 遮挡层:整窗大小的图必须与场景那张逐像素对齐,故用负偏移推回窗口原点,
        // 再裁到各自的矩形 —— 与 3D 演示页「转盘中心」卡同一套机关。封面与歌词
        // 同处一个 z 平面,故**同一张遮挡图**盖两处,各裁各的。
        if root.viz-occluder.width > 0: Rectangle {
            x: root.viz-card-x;
            y: root.viz-card-y;
            width: root.viz-card-size;
            height: root.viz-card-size;
            clip: true;

            Image {
                x: -root.viz-card-x;
                y: -root.viz-card-y;
                width: root.width;
                height: root.height;
                image-fit: fill;
                source: root.viz-occluder;
            }
        }
        if root.viz-occluder.width > 0 && root.lyric-line != "": Rectangle {
            y: root.viz-lyric-y;
            width: root.width;
            height: root.viz-lyric-h;
            clip: true;

            Image {
                y: -root.viz-lyric-y;
                width: root.width;
                height: root.height;
                image-fit: fill;
                source: root.viz-occluder;
            }
        }

        // 功能层:同一组回调,与音乐页的控制条完全等价。
        HorizontalLayout {
            y: root.height - 60px - root.safe-area-insets.bottom - 24px;
            height: 60px;
            alignment: center;
            Rectangle {
                width: 340px;
                height: 60px;
                border-radius: 16px;
                background: #17110daa;
                border-width: 1px;
                border-color: #ffffff10;

                HorizontalLayout {
                    alignment: center;
                    ControlCluster {
                        is-playing: root.is-playing;
                        shuffle-on <=> root.shuffle-on;
                        prev => { root.prev-track(); }
                        toggle => { root.toggle-play(); }
                        next => { root.next-track(); }
                        shuffle-toggled => { root.shuffle-toggled(); }
                    }
                }
            }
        }
    }
}
