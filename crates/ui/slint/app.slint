// 最小化单窗口手机 UI:一个点击计数器。
// 计数值保存在 Rust 一侧(crates/app-core),以 property 形式推送到这里;
// 按钮点击通过 `bump` 回调传回去。

// slint 自带的 Inter 没有汉字,wasm 上又没有系统字体可回退,健康状态那行中文
// 会渲染成豆腐块。这里内嵌一份裁到只剩所需字符的子集(见 `just font-subset`),
// 由 slint 编译器把字节打进产物,再按 family 名引用。
import "../fonts/cjk-subset.ttf";

// 改版字体四件(见 docs/design.md「字体」,族名统一从 theme.slint 的 Type 取):
// 中文标题走思源宋体 Heavy 子集,拉丁标题 Caprasimo,正文 Figtree,读数 DM Mono。
import "../fonts/cjk-title-subset.otf";
import "../fonts/caprasimo.ttf";
import "../fonts/figtree-400.ttf";
import "../fonts/figtree-600.ttf";
import "../fonts/figtree-700.ttf";
import "../fonts/dm-mono.ttf";

// 原生文本输入:热调 3D 场景参数用。不自己搓文本编辑(光标/选区/IME),用 Slint 自带的。
import { LineEdit, Palette } from "std-widgets.slint";

// 玻璃拟态:供 Home / Server 页透出颜色的极光背景,以及装内容的玻璃卡片。
import { AuroraBackground, GlassCard } from "glass.slint";

// 通用零件与控制条各自搬去了一个文件,本文件因此只剩「主窗口在摆什么」。
// 数据结构与 Nav 留在这里:它们是本窗口与 Rust 之间的契约,不是可复用的零件。
import { NavEntry, TrackRow, DeviceRow, PlaylistRow, ArtistRow, ArtistRankRow, LyricRow } from "types.slint";
import { Profile } from "globals/profile.slint";
import { Player } from "globals/player.slint";
import { Viz } from "globals/viz.slint";
import { Shell } from "globals/shell.slint";
import { Library } from "globals/library.slint";
import { Session } from "globals/session.slint";
import { PlaylistList } from "playlists.slint";
import { ArtistList } from "artists.slint";
import { NavItem, RoundControl } from "widgets.slint";
import { PlayerBar } from "playerbar.slint";
import { Theme, Type } from "theme.slint";
// 再导出一次:全局要从**入口文件**导出,slint 才会给 Rust 生成访问器
// (crates/ui/src/theme.rs 靠 `ui.global::<Theme>()` 写那一位布尔值)。
export { Theme }
// 个人页的数据面同理:Rust 靠 `ui.global::<Profile>()` 写它。
export { Profile }
// 登录态同理:Rust 靠 `ui.global::<Session>()` 读写它。
export { Session }
// 曲库那一面同理:Rust 靠 `ui.global::<Library>()` 读写它。
export { Library }
export { Shell }
export { Viz }
export { Player }
import { LoginPage } from "login.slint";
import { MusicRail, MusicBar, SearchTabBar } from "musicnav.slint";
import { TrackList } from "tracklist.slint";
import { SettingsPage } from "settings.slint";
import { ProfilePage } from "profile.slint";
import { LyricsPage } from "lyrics.slint";
import { MusicPage } from "musicpage.slint";
import { PlayPage } from "playpage.slint";

global Nav {
    out property <[NavEntry]> items: [
        {
            label: "Home",
            icon: "M3 12 L12 4 L21 12 M5.5 10 L5.5 20 L18.5 20 L18.5 10",
        },
        {
            label: "Music",
            icon: "M9 18 L9 5 L20 3 L20 16 M9 18 A2.5 2.5 0 1 1 6.5 15.5 A2.5 2.5 0 0 1 9 18 M20 16 A2.5 2.5 0 1 1 17.5 13.5 A2.5 2.5 0 0 1 20 16",
        },
    ];
    // 沉底那组(docs/design.md「壳与导航」)。tab 序号接着上面排:
    // 个人 = 2,设置 = 3。
    out property <[NavEntry]> bottom-items: [
        {
            label: "个人",
            icon: "M12 4 A4 4 0 1 1 12 12 A4 4 0 1 1 12 4 M4 20 C4 16 8 14 12 14 C16 14 20 16 20 20",
        },
        {
            label: "设置",
            icon: "M12 9 A3 3 0 1 1 12 15 A3 3 0 1 1 12 9 M12 2 L12 5 M12 19 L12 22 M2 12 L5 12 M19 12 L22 12 M4.9 4.9 L7 7 M17 17 L19.1 19.1 M19.1 4.9 L17 7 M7 17 L4.9 19.1",
        },
    ];
}

export component MainWindow inherits Window {
    // 帧率,由 Rust 测量并推送。仅在 `Shell.show-fps` 为真时被推送。
    // fluid 正在播放胶囊(#68):条身背景由 aurora 管线渲好推进来,空图即素底
    // (无 GPU 渐进降级)。胶囊把自己的逻辑尺寸回写,Rust 按它渲物理像素。
    // 同播名册里除本机之外的在线设备,由信令服务端主动推送(见 crates/syncplay)。

    // 当前选中的导航页:0=Home、1=Music。由左侧导航栏点击设置。
    // 版式(Layout Mode):窄→紧凑(底部导航),宽→侧栏。**由运行时窗口宽度决定,不由端决定**
    // —— 桌面把窗口拖窄一样变成紧凑版式,这既是要的体验,也是唯一能在桌面验证移动版式的办法。
    // 见 docs/adr/0007。600px 是 Material 的标准断点:手机竖屏(~393dp)紧凑,
    // 手机横屏(~850dp)回到侧栏 —— 横屏本来就矮,底栏再吃 64px 太亏。
    //
    // 用 changed 回调赋值、而不是写成 `Shell.compact: root.width < 600px` 的绑定:版式一变,子元素的
    // 约束(侧栏在不在、底栏在不在)就变,窗口的 layoutinfo 跟着变,宽度又回头喂给 Shell.compact ——
    // 那是一个真的求值环,Slint 1.18 起会警告并可能在运行时 panic。命令式赋值把环剪断:
    // 宽度先定下来,再单向推出版式。
    //
    // in-out 而不是私有:无头测试里 `set_size` 不驱动 `width`,版式因此推不出来。
    // 开放它之后测试能直接给定版式,验的是「这个版式该摆哪个导航」——
    // 「宽度推出版式」那半由下面两行自己保证,不在测试覆盖内。
    init => { Shell.compact = root.width < 600px; }
    changed width => { Shell.compact = root.width < 600px; }

    // ── 播放页(CONTEXT.md「播放页」):控制条展开的全窗沉浸层 ──
    // 展开/收起全在 .slint 内部;操作类功能仍由覆层里的 ControlCluster 走同一组
    // 回调 —— docs/adr/0010 的「功能等价路径」。

    // ── Music 页的二级导航 ──
    // 当前分区:0=每日推荐、1=我的歌单、2=搜索、3=最近播放。
    // 编号即 musicnav.slint 里 MusicSections.items 的下标,Rust 按它决定拉什么。

    // 歌词块的几何量,逻辑像素。**这里是唯一真相**:歌词摆位与遮挡层的裁剪
    // 负偏移都从这几个值算,别在别处重抄。歌词**不**参与深度合成,它与歌名同层
    // 画在粒子之上(docs/adr/0010 的「歌词是例外」);播放页的深度卡片是标注卡。
    //
    // 曾经这里还有一张 220px 的封面卡,它是第一张深度卡片。封面点云上线之后它成了
    // 同一张图的第二份拷贝,还正压在点云中央,遂删除(见 `docs/adr/0010` 的记录)。
    //
    // 歌词块的高度**钉死**,不随文本长度变。平台会把整段词压成「一行」(实测见过
    // 198 字符的行),放任折行会撑破布局、压到控制条上;超出的部分省略号收掉。
    // 原文最多三行、译文最多两行,按各自字号的行高估。
    // 播放页控制条的高度。紧凑版拆两行(见那一段的注释),故高一档。
    // 两颗只在播放页出现的键,图形在宽/紧凑两处版式里各用一次 —— 常量化,
    // 免得改一处漏一处。

    // 歌名与歌手在歌词块上方,与它一起居中成一组。
    // 正在播的封面(已解码)。取不到 / 解不出时为空图 —— 控制条上的小图用它。

    // ── 「液态玻璃 metaball 选中器」(宽版式侧栏 / 紧凑版式底栏)──
    // 视觉由 render3d 的独立 wgpu pass 画进 nav-bg(见 crates/render3d/src/navglass),Slint 只出
    // 几何与交互。槽位常量是**唯一真相**:布局与选中块位置都从这里算,不各写各的。
    // 两种版式同一套数学,差别只在移动轴:侧栏沿 y,底栏沿 x(#70,handoff §11)。
    property <length> nav-pad: 8px;
    property <length> nav-gap: 6px;
    // 单个导航项高,也是选中块的参考高。out:Rust 读它定块尺寸。
    out property <length> nav-slot-h: 68px;
    // 侧栏纹理尺寸(逻辑像素)。Rust 每帧乘缩放系数得物理像素当目标纹理尺寸。
    out property <length> nav-w: 96px;
    // 侧栏只在宽版式出现,而宽版式没有底栏 —— 所以它的高度**就是**窗口高减去
    // 上下安全区。此前写的是 `content.height`,那是同一个值绕了一圈拿到的;
    // 内容区被登录页那层 `if` 包起来之后,外面也就引不到它了。
    out property <length> nav-h: root.height
        - root.safe-area-insets.top
        - root.safe-area-insets.bottom;
    // 底栏(紧凑版式)的横条几何。宽由布局回写 —— 四格等分要它,而它随窗口变;
    // 高是图标那 64px 加手势条 inset,背景要铺到手势条底下。
    in-out property <length> nav-bar-w: 0px;
    out property <length> nav-bar-h: 64px + root.safe-area-insets.bottom;
    property <length> nav-bar-gap: 4px;
    property <length> nav-bar-pad-left: root.safe-area-insets.left + 8px;
    property <length> nav-bar-pad-right: root.safe-area-insets.right + 8px;
    // 四格:主项两个加沉底那两个,手机上接着排(见底栏)。加导航项时跟着改。
    property <int> nav-bar-count: 4;
    property <length> nav-slot-w: (root.nav-bar-w - root.nav-bar-pad-left - root.nav-bar-pad-right
        - (root.nav-bar-count - 1) * root.nav-bar-gap) / root.nav-bar-count;

    // ── seam 出参:轴无关的一组数,Rust 照单喂 shader,不判版式 ──
    // 底栏的宽度没量出来之前不渲(首帧布局还没跑),避免拿 0 当条长。
    out property <bool> nav-visible: Shell.compact ? root.nav-bar-w > 1px : true;
    out property <bool> nav-horizontal: Shell.compact;
    out property <length> nav-strip-w: Shell.compact ? root.nav-bar-w : root.nav-w;
    out property <length> nav-strip-h: Shell.compact ? root.nav-bar-h : root.nav-h;
    // 移动轴上一格的长度:侧栏是项高,底栏是等分出来的格宽。
    out property <length> nav-slot: Shell.compact ? root.nav-slot-w : root.nav-slot-h;
    // 固定轴上的可用厚度与中心:侧栏是整条栏宽;底栏是图标那一带的高,
    // 手势条那段不算 —— 把 inset 算进厚度的话,水滴会压到手势条上去。
    out property <length> nav-thick: Shell.compact
        ? root.nav-bar-h - root.safe-area-insets.bottom
        : root.nav-w;
    out property <length> nav-cross: root.nav-thick / 2;

    // 当前选中槽在移动轴上的中心(逻辑像素,相对条首)。
    // 侧栏只有主项两格在轨道上:沉底那组(个人 = 2、设置 = 3)自 #71 起是 glass 圆钮,
    // 自己表达选中,水滴不去。选中它们时轨道位置停在最后一格主项上、球缩没,
    // 免得「Home 亮着而人在设置页」。
    property <int> nav-track-tab: min(Shell.current-tab, 1);
    property <length> nav-target-y: root.nav-pad
        + root.nav-track-tab * (root.nav-slot-h + root.nav-gap) + root.nav-slot-h / 2;
    // 球体缩放:1 是常态,0 是缩没。底栏四格全在轨道上,所以只有侧栏会缩。
    out property <float> nav-ball: Shell.compact || Shell.current-tab < 2 ? 1.0 : 0.0;
    animate nav-ball { duration: 260ms; easing: ease-out; }
    // 底栏四格等分,沉底那组不沉底,所以一路等距算下去。
    property <length> nav-target-x: root.nav-bar-pad-left
        + Shell.current-tab * (root.nav-slot-w + root.nav-bar-gap) + root.nav-slot-w / 2;
    property <length> nav-target: Shell.compact ? root.nav-target-x : root.nav-target-y;
    // metaball 的头(快)/尾(慢):都朝 nav-target 动,快慢不同 → 行走时一前一后被 shader
    // 的 smooth-union 拉出胶着的颈,静止时重合成单块。out:Rust 每帧读这三个动画值喂 shader。
    // 用三个不同时长的 animate,避开「同一处理器里 progress 先置 0 再置 1 会被合并、动不起来」那个坑。
    out property <length> nav-lead: root.nav-target;
    out property <length> nav-lag: root.nav-target;
    // 第三颗:小水滴,最慢的那份(§11 三球;系数差用时长差实现)。
    out property <length> nav-drop: root.nav-target;
    animate nav-lead { duration: 240ms; easing: ease-out; }
    animate nav-lag { duration: 440ms; easing: ease-out; }
    animate nav-drop { duration: 680ms; easing: ease-out; }
    // render3d 每帧(转场期间)渲出的导航背景纹理。非 GPU 构建恒为空图(width 0),
    // 两种版式都退回 Slint 平底 + NavItem 自带高亮。
    in-out property <image> nav-bg;
    // 用关键词搜歌。
    // 设置页的主题三档(0 深 1 浅 2 跟随系统),选了喊一声,值由 Rust 写回。

    title: "Osmosis";
    background: Theme.window;
    // 开窗即宽版式;最小尺寸故意放到手机竖屏那么窄 —— 桌面上把窗口拖窄就能直接看到
    // 紧凑版式,不必开模拟器。
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 360px;
    min-height: 520px;

    // 顶层恒为一个 VerticalLayout(主体行 + 可选底栏)→ 窗口撑满且可调整大小。
    //
    // 未登录时整块不建:登录页盖着的时候导航不该可达 —— 否则点进音乐页
    // 只会收获一屏 401。用 `if` 而不是 `visible: false`,是要让它真的不在树里,
    // 那样「绕不过去」这件事才测得到(见 tests/login.rs)。
    if Session.logged-in: VerticalLayout {

        // ── 主体行:宽版式是「侧栏 + 内容」,紧凑版式只有内容 ──
        HorizontalLayout {
            vertical-stretch: 1;
            padding-top: root.safe-area-insets.top;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            // 紧凑版式的底部 inset 归底栏管 —— 它的背景要铺到手势条底下,不能在这里先留白,
            // 否则手势条那一条会露出窗口底色,全面屏观感碎掉。
            padding-bottom: Shell.compact ? 0 : root.safe-area-insets.bottom;

            // ── 侧栏(宽版式)──
            // ponytail: 深色底不铺到左刘海底下(padding-left 已经把它推开了)。桌面 inset 恒 0、
            // 安卓竖屏没有左 inset,只有「横屏 + 左刘海」这一种情况会露一条底色,不值得为它
            // 把侧栏也拆成「背景铺满 + 内部 padding」。
            if !Shell.compact: Rectangle {
                width: root.nav-w;
                // 兜底平底:非 GPU 构建就是这层纯色 + NavItem 自带高亮。
                background: Theme.base;

                // GPU 液态玻璃选中器:转场时 render3d 渲进 nav-bg,盖在平底之上、图标之下。
                // 非 GPU 构建 nav-bg 为空(width 0),这个 Image 不显示,露出上面的平底。
                Image {
                    source: root.nav-bg;
                    width: 100%;
                    height: 100%;
                    image-fit: fill;
                }

                VerticalLayout {
                    padding: root.nav-pad;
                    spacing: root.nav-gap;

                    for item[i] in Nav.items: NavItem {
                        height: root.nav-slot-h;
                        label: item.label;
                        icon: item.icon;
                        active: Shell.current-tab == i;
                        // GPU 构建里选中高亮由玻璃提供,压掉自带 active 底,免得叠两遍。
                        gpu-selected: root.nav-bg.width > 0;
                        clicked => { Shell.current-tab = i; }
                    }

                    // 把沉底组压到底。
                    Rectangle { vertical-stretch: 1; }

                    // 沉底那组是 glass 圆钮(#71):水滴的轨道只覆盖上面两格,
                    // 这两颗自己表达选中 —— 一块大胶囊压在小圆钮下面,两者会互相抵消。
                    for item[i] in Nav.bottom-items: HorizontalLayout {
                        alignment: center;
                        RoundControl {
                            icon: item.icon;
                            label: item.label;
                            checkable: true;
                            checked: Shell.current-tab == i + 2;
                            backdrop: i == 0
                                ? Shell.nav-key-a-bg
                                : Shell.nav-key-b-bg;
                            clicked => { Shell.current-tab = i + 2; }
                        }
                    }
                }
            }

            // ── 内容区。两页共用这块矩形,按 Shell.current-tab 切换子内容 ──
            content := Rectangle {
                horizontal-stretch: 1;

                // 极光背景:玻璃卡片透出来的颜色全来自这里。3D 页不铺 —— 那边背后是
                // bevy 画面,本来就有内容可透。
                AuroraBackground {
                    width: 100%;
                    height: 100%;
                    // §4:封面取色喂极光。颜色由 aurora.rs 取好推进来。
                    cover-active: Shell.aurora-cover-active;
                    cover-warm: Shell.aurora-cover-warm;
                    cover-deep: Shell.aurora-cover-deep;
                    cover-soft: Shell.aurora-cover-soft;
                }

                // Home:壳的应用启动器(docs/adr/0024)。瓦片数据驱动:只放真实
                // 存在的应用与一个空槽,加应用就是加一张瓦片。3D 漂移与视差归
                // Bevy 瓦片场,与卡墙同期做(#66),这里先是 2D 摆法。
                if Shell.current-tab == 0: Rectangle {

                    VerticalLayout {
                        x: Shell.compact ? 24px : 48px;
                        y: Shell.compact ? 32px : 56px;
                        width: min(parent.width - (Shell.compact ? 48px : 96px), 880px);
                        alignment: start;
                        spacing: 10px;

                        Text {
                            text: "OSMOSIS";
                            font-family: Type.mono;
                            font-size: 11px;
                            letter-spacing: 3px;
                            color: Theme.accent;
                        }
                        Text {
                            text: "今天做点什么";
                            font-family: Type.display-cjk;
                            font-weight: 900;
                            font-size: Shell.compact ? 30px : 40px;
                            color: Theme.text;
                        }
                        Text {
                            text: "选一个应用开始";
                            font-family: "Maple Mono NF CN";
                            font-size: 13px;
                            color: Theme.text-dim;
                        }

                        // 标题区与瓦片场之间的一口气。
                        Rectangle { height: 22px; }

                        HorizontalLayout {
                            alignment: start;
                            spacing: 20px;

                            // 音乐:唯一的真瓦片。紧凑版式收一档,免得连空槽
                            // 一起超出 420px 的内容宽。
                            Rectangle {
                                width: Shell.compact ? 150px : 210px;
                                height: Shell.compact ? 150px : 210px;
                                border-radius: 22px;
                                clip: true;
                                background: @linear-gradient(150deg, Theme.hues-bright[0], Theme.hues-deep[0]);
                                drop-shadow-blur: 30px;
                                drop-shadow-offset-y: 14px;
                                drop-shadow-color: Theme.glass-shadow;

                                // 压字渐变:上轻下重,左下角的字才读得出来。
                                Rectangle {
                                    background: @linear-gradient(180deg, Theme.overlay-weak 0%, Theme.shadow.with-alpha(0.4) 100%);
                                }
                                VerticalLayout {
                                    alignment: end;
                                    padding: 16px;
                                    spacing: 4px;
                                    Text {
                                        text: "音乐";
                                        font-family: Type.display-cjk;
                                        font-weight: 900;
                                        font-size: 17px;
                                        color: Theme.immersive-text;
                                    }
                                    Text {
                                        text: Player.is-playing ? "MUSIC · " + Viz.now-title : "MUSIC";
                                        font-family: Type.mono;
                                        font-size: 11px;
                                        letter-spacing: 1px;
                                        color: Theme.immersive-text-dim;
                                        overflow: elide;
                                    }
                                }
                                music-tile := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { Shell.current-tab = 1; }
                                    accessible-role: button;
                                    accessible-label: "音乐";
                                    accessible-action-default => { Shell.current-tab = 1; }
                                }
                            }

                            // 空槽:留给下一个应用。不是按钮,也不装成按钮 ——
                            // 没有 TouchArea,点了不会假装发生什么(硬规则 8)。
                            Rectangle {
                                width: Shell.compact ? 120px : 168px;
                                height: Shell.compact ? 150px : 210px;
                                border-radius: 22px;
                                background: Theme.overlay-weak;
                                border-width: 1px;
                                border-color: Theme.divider;
                                clip: true;

                                // §9:星云纹理垫底(render3d 画,尺寸在 lib.rs 有一份镜像)。
                                if Shell.aurora-buttons-on && Shell.home-slot-bg.width > 0: Image {
                                    width: 100%;
                                    height: 100%;
                                    source: Shell.home-slot-bg;
                                }
                                // 只追 hover 喂给星云的指针涡旋;这仍不是按钮 ——
                                // 没有点击行为(硬规则 8)。
                                TouchArea {
                                    changed has-hover => {
                                        Shell.home-slot-hover = self.has-hover;
                                    }
                                    moved => {
                                        Shell.home-slot-px = self.mouse-x / max(self.width, 1px);
                                        Shell.home-slot-py = 1 - self.mouse-y / max(self.height, 1px);
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "+";
                                        font-size: 22px;
                                        color: Theme.text-faint;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "装一个";
                                        font-family: Type.display-cjk;
                                        font-weight: 900;
                                        font-size: 13px;
                                        color: Theme.text-faint;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                }

                // 个人主页(tab 2)。进页即取统计,判断在 Rust 侧。
                if Shell.current-tab == 2: ProfilePage {
                    width: 100%;
                    height: 100%;
                    init => { Profile.shown(); }
                    username: Profile.username;
                    loaded: Profile.loaded;
                    error-text: Profile.error;
                    month-plays: Profile.month-plays;
                    distinct-tracks: Profile.distinct-tracks;
                    streak-days: Profile.streak-days;
                    top-artists: Profile.artists;
                    devices: Shell.devices;
                }

                // 设置(tab 3,rail 沉底最后一颗)。
                if Shell.current-tab == 3: SettingsPage {
                    width: 100%;
                    height: 100%;
                    about-line: Profile.about-line;
                    aurora-on: Shell.aurora-buttons-on;
                    aurora-toggled => { Shell.aurora-buttons-toggled(); }
                    theme-mode-selected(mode) => { Shell.theme-mode-selected(mode); }
                    logout => { Session.logout(); }
                }

                // Music:搜歌 + 点一首放出声。整页可滚,不裹玻璃卡片 ——
                // 列表要吃满可用高度,套进定宽卡片在手机上只剩三四行可见。
                // Music:二级导航 + 四个分区。整页可滚,不裹玻璃卡片 ——
                // 列表要吃满可用高度,套进定宽卡片在手机上只剩三四行可见。
                if Shell.current-tab == 1: MusicPage { }

                // 迷你播放条:壳持有、跨应用常驻,有歌才摆(docs/adr/0024)。
                // 一份管三页 —— 音乐页有完整条,别处摆这颗小胶囊,点它就地展开。
                // 改版前只有首页有,个人主页与设置页整个没有控制入口(#81)。
                if Player.has-track && Shell.current-tab != 1: PlayerBar {
                    mini: true;
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 22px;
                    width-cap: parent.width - 48px;
                }

                // Shell.fps 浮层:content 的最后一个子元素 → 画在最上层。
                // 左上角,所有页可见。诚实即时帧率(见 lib.rs 的 Shell.fps 模块)。
                if Shell.show-fps: Text {
                    x: 8px;
                    y: 8px;
                    text: "FPS " + round(Shell.fps);
                    color: #51cf66;
                    font-size: 14px;
                    font-weight: 700;
                }
            }
        }

        // ── 底栏(紧凑版式)──
        // 背景铺满到屏幕底边,内部 padding-bottom 把图标顶到手势条之上 —— 与 MainActivity 的
        // edge-to-edge 一致:手势条底下是导航栏的深色,不是一条露出来的窗口底色。
        if Shell.compact: Rectangle {
            height: root.nav-bar-h;
            // 兜底平底:非 GPU 构建就是这层纯色 + NavItem 自带高亮。
            background: Theme.base;
            // 横条几何回写给 seam:四格等分要窗口宽,而它随窗口变(#70)。
            init => { root.nav-bar-w = self.width; }
            changed width => { root.nav-bar-w = self.width; }

            // GPU 水滴选中器:与侧栏同一条 pass,只是移动轴换成 x。
            // 非 GPU 构建 nav-bg 为空(width 0),这个 Image 不显示,露出上面的平底。
            Image {
                source: root.nav-bg;
                width: 100%;
                height: 100%;
                image-fit: fill;
            }

            HorizontalLayout {
                padding-left: root.nav-bar-pad-left;
                padding-right: root.nav-bar-pad-right;
                padding-bottom: root.safe-area-insets.bottom;
                spacing: root.nav-bar-gap;

                for item[i] in Nav.items: NavItem {
                    horizontal-stretch: 1;
                    label: item.label;
                    icon: item.icon;
                    active: Shell.current-tab == i;
                    // GPU 构建里选中高亮由水滴提供,压掉自带 active 底,免得叠两遍。
                    gpu-selected: root.nav-bg.width > 0;
                    clicked => { Shell.current-tab = i; }
                }
                // 沉底那组在底栏里接着排:手机没有"栏底"可沉,四项等分。
                // 设计稿的第三位是搜索,但搜索已经住在 Music 页的分段条里;
                // 设置不上底栏的话,手机上就没有任何入口能到它 —— 等价路径优先。
                for item[i] in Nav.bottom-items: NavItem {
                    horizontal-stretch: 1;
                    label: item.label;
                    icon: item.icon;
                    active: Shell.current-tab == i + 2;
                    gpu-selected: root.nav-bg.width > 0;
                    clicked => { Shell.current-tab = i + 2; }
                }
            }
        }
    }

    // ── 播放页覆层:盖住包括导航在内的整个窗口(CONTEXT.md「播放页」)──
    // 五层合成:warp 背景 → 封面点云 → 标注卡 → 遮挡层(裁到标注卡)→ 控制簇。
    // 标注卡是深度卡片:遮挡层只含比它更近的粒子,盖上来就是「粒子从卡前面掠过」。
    // 歌名与歌词不走这条,它们画在粒子之上(docs/adr/0010 的「歌词是例外」)。
    // 功能(控制簇)永远在最上层 2D、点得到 —— docs/adr/0010。
    if Shell.play-page-open: PlayPage {
        width: 100%;
        height: 100%;
        safe-left: root.safe-area-insets.left;
        safe-right: root.safe-area-insets.right;
        safe-top: root.safe-area-insets.top;
        safe-bottom: root.safe-area-insets.bottom;
    }

    // ── 登录页:未登录时盖住整个窗口 ──
    // 排在横幅之前,所以横幅仍压在它之上 —— 登录页上也可能断网,
    // 那句话必须看得见。
    if !Session.logged-in: login-page := LoginPage {
        width: 100%;
        height: 100%;
        busy: Session.busy;
        error-text: Session.error;
        login(username, password) => {
            Session.login(username, password);
        }
        register(username, password, invite) => {
            Session.register(username, password, invite);
        }
    }

    // ── 横幅:压在所有页之上 ──
    // 状态行长在音乐页上,而播放页是覆层、盖住它 —— 断流恰恰发生在听歌时,
    // 写在状态行等于说给没人在的房间(docs/adr/0013)。一次性提示同理:
    // 它们各自发生在哪一页并不确定,唯有压在所有页之上才一定被看见。
    // 摆窗口顶端:控制簇、收起键、底栏全在下半边,压不着任何操作。
    if Shell.banner-text != "": banner := Rectangle {
        y: root.safe-area-insets.top + 10px;
        x: (parent.width - self.width) / 2;
        width: min(parent.width - 32px, 420px);
        height: 44px;
        background: Theme.danger-surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.danger-line;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 6px;
            spacing: 6px;

            Text {
                text: Shell.banner-text;
                // 文案是硬编码中文,与状态行同一套子集字体。
                font-family: "Maple Mono NF CN";
                font-size: 13px;
                color: Theme.danger-text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            // 关掉。清空文案就等于收起,不必回 Rust 绕一圈。
            RoundControl {
                diameter: 32px;
                transparent-base: true;
                icon: "M7 7 L17 17 M17 7 L7 17";
                clicked => { Shell.banner-text = ""; }
            }
        }
    }
}
