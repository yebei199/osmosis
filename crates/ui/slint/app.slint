// 最小化单窗口手机 UI:一个点击计数器。
// 计数值保存在 Rust 一侧(crates/app-core),以 property 形式推送到这里;
// 按钮点击通过 `bump` 回调传回去。

// slint 自带的 Inter 没有汉字,wasm 上又没有系统字体可回退,健康状态那行中文
// 会渲染成豆腐块。这里内嵌一份裁到只剩所需字符的子集(见 `just font-subset`),
// 由 slint 编译器把字节打进产物,再按 family 名引用。
import "../fonts/cjk-subset.ttf";

// 原生文本输入:热调 3D 场景参数用。不自己搓文本编辑(光标/选区/IME),用 Slint 自带的。
import { LineEdit } from "std-widgets.slint";

// 玻璃拟态:供 Home / Server 页透出颜色的极光背景,以及装内容的玻璃卡片。
import { AuroraBackground, GlassCard } from "glass.slint";

// 带悬浮抬起效果的按钮:悬停时背景变亮、阴影变大变柔,呈现出凸起的
// 观感;按下时变暗下沉。全部带动画过渡。
//
// 触摸设备上没有"悬停但未按下"这个状态,因此只会看到按下时的下沉效果。
// 这是刻意的优雅降级,不是缺陷:slint 在触摸按下时同样会置 has-hover,
// 但优先级更高的 `down` 分支盖住了它。
component HoverButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    property <bool> hovered: touch.has-hover;
    property <bool> down: touch.pressed;

    height: 56px;
    width: 220px;
    border-radius: 14px;
    background: down ? #2f45c5 : hovered ? #5c7cfa : #4263eb;
    drop-shadow-color: #4263eb80;
    drop-shadow-blur: down ? 4px : hovered ? 24px : 10px;
    drop-shadow-offset-y: down ? 1px : hovered ? 8px : 3px;
    animate background, drop-shadow-blur, drop-shadow-offset-y {
        duration: 160ms;
        easing: ease-out;
    }

    Text {
        text: root.text;
        color: #ffffff;
        font-size: 18px;
        font-weight: 600;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 左侧导航栏的一项:矢量线条图标 + 英文标签,竖排。选中时背景高亮、图标与文字变亮。
// 图标用 Path 内嵌(不引外部资源);标签用英文,免得中文落到无 CJK 的默认字体上变豆腐。
component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon; // SVG path 数据,viewbox 24×24
    in property <bool> active;
    callback clicked;

    height: 68px;
    border-radius: 12px;
    background: active ? #1c2233 : (touch.has-hover ? #141824 : transparent);
    animate background { duration: 120ms; easing: ease-out; }

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        HorizontalLayout {
            alignment: center;
            Path {
                width: 26px;
                height: 26px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                stroke: active ? #7aa2f7 : #8b91a5;
                stroke-width: 1.8px;
                fill: transparent;
            }
        }

        Text {
            text: root.label;
            color: active ? #e6e8ef : #8b91a5;
            font-size: 12px;
            font-weight: active ? 700 : 500;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 一个带标签的窄文本输入,3D 热调面板复用。text 双向绑定到外部属性。
component ParamField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    spacing: 2px;
    Text {
        text: root.label;
        color: #9aa0b4;
        font-size: 11px;
    }
    LineEdit {
        width: 72px;
        text <=> root.text;
    }
}

export component MainWindow inherits Window {
    // 由 Rust 推送。
    in property <int> count: 0;
    // 帧率,由 Rust 测量并推送。仅在 `debug-fps` feature 下有意义。
    in property <float> fps: 0;
    // 是否显示帧率读数。由 Rust 根据 `debug-fps` feature 设置。
    in property <bool> show-fps: false;
    // 当前编译目标的平台名(wasm / android / linux / …),由 Rust 推送。
    in property <string> platform;
    // 服务端健康状态的一行文案,由 Rust 根据领域状态渲染后推送。
    in property <string> health-text;
    // bevy 离屏渲染的 3D 画面,由 render3d 每帧推送(见 crates/render3d)。
    // 桌面 / android 才会被设值;web / ios 上恒为空图(width == 0),下方面板据此隐藏,
    // 无需在此写任何平台判断 —— 这就是「余端 graceful 缺省」的落点。
    in property <image> scene-3d;
    // 3D 立方体的朝向(弧度),由「3D」页上的拖动累加得到,Rust 每帧读出后
    // 传给 render3d 设为立方体的绝对朝向。水平拖动改 yaw,垂直拖动改 pitch。
    in-out property <float> rot-yaw: 0;
    in-out property <float> rot-pitch: 0;
    // 当前选中的导航页:0=Home、1=Server、2=3D。由左侧导航栏点击设置。
    in-out property <int> current-tab: 0;
    // 3D 场景热调参数。Rust 每帧读这些原始文本,在信任边界解析+clamp(见 scene_params),
    // 非法/越界退回上一个好值。scene-index:0=形状画廊、1=实体阵列。
    in-out property <int> scene-index: 0;
    in-out property <string> count-text: "8";
    in-out property <string> color-text: "#4a6bff";
    in-out property <string> speed-text: "0.0";
    in-out property <string> spacing-text: "1.5";
    // 3D 内容区的逻辑尺寸。Rust 每帧乘窗口缩放系数得物理像素,让 bevy 按该分辨率渲染。
    out property <length> scene-w: content.width;
    out property <length> scene-h: content.height;
    // 仅当 3D 页激活时才驱动 bevy(省电)。Rust 每帧读它决定是否渲染。
    out property <bool> render-active: root.current-tab == 2;
    // 用户点击触发,在 Rust 侧处理。
    callback bump();
    // 请求一次 GET /health。
    callback check-health();

    title: "Slint Study";
    background: #0f1117;

    // safe-area 内边距包在最外层;单一顶层布局 → 窗口撑满且可调整大小。
    HorizontalLayout {
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.safe-area-insets.bottom;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;

        // ── 左侧导航栏 ──
        Rectangle {
            width: 96px;
            background: #0b0d13;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                alignment: start;

                NavItem {
                    label: "Home";
                    icon: "M3 12 L12 4 L21 12 M5.5 10 L5.5 20 L18.5 20 L18.5 10";
                    active: root.current-tab == 0;
                    clicked => { root.current-tab = 0; }
                }
                NavItem {
                    label: "Server";
                    icon: "M4 5 L20 5 L20 10 L4 10 Z M4 13 L20 13 L20 18 L4 18 Z";
                    active: root.current-tab == 1;
                    clicked => { root.current-tab = 1; }
                }
                NavItem {
                    label: "3D";
                    icon: "M12 3 L20 7.5 L20 16.5 L12 21 L4 16.5 L4 7.5 Z M12 3 L12 12 M12 12 L20 7.5 M12 12 L4 7.5";
                    active: root.current-tab == 2;
                    clicked => { root.current-tab = 2; }
                }
            }
        }

        // ── 右侧内容区。三页共用这块矩形(尺寸恒定,故 scene-w/h 始终有效),
        //    按 current-tab 切换子内容 ──
        content := Rectangle {
            horizontal-stretch: 1;

            // 极光背景:玻璃卡片透出来的颜色全来自这里。3D 页不铺 —— 那边背后是
            // bevy 画面,本来就有内容可透。
            if root.current-tab != 2: AuroraBackground {
                width: 100%;
                height: 100%;
            }

            // Home:平台标题 + 计数器,装进玻璃卡片
            if root.current-tab == 0: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    GlassCard {
                        width: 340px;
                        height: 320px;
                        VerticalLayout {
                            padding: 28px;
                            alignment: center;
                            spacing: 20px;

                            Text {
                                text: "Slint on " + root.platform;
                                color: #e6e8ef;
                                font-size: 22px;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.count;
                                color: #7aa2f7;
                                font-size: 72px;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: center;
                                HoverButton {
                                    text: "Tap me";
                                    clicked => { root.bump(); }
                                }
                            }
                        }
                    }
                }
            }

            // Server:一次真实网络往返,验证 contract → api → app-core → ui 全链路
            if root.current-tab == 1: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    GlassCard {
                        width: 340px;
                        height: 220px;
                        VerticalLayout {
                            padding: 24px;
                            alignment: center;
                            spacing: 20px;

                            HorizontalLayout {
                                alignment: center;
                                HoverButton {
                                    text: "Check server";
                                    clicked => { root.check-health(); }
                                }
                            }
                            // 固定高度:文案变长变短不改变本行占位,居中列不回流 → 点击不抖。
                            // 子集字体连 ASCII 一起裁,中英混排整体落在同一字体,不依赖逐字形回退。
                            Text {
                                text: root.health-text;
                                font-family: "Maple Mono NF CN";
                                color: #9aa0b4;
                                font-size: 13px;
                                height: 56px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // 3D:bevy 离屏画面铺满内容区,分辨率随 content 尺寸动态变化,拖动控制朝向。
            // 空图(未就绪 / web·ios,或刚切进来还没渲染出首帧)时不渲染这块。
            if root.current-tab == 2 && root.scene-3d.width > 0: Image {
                width: 100%;
                height: 100%;
                image-fit: fill;
                source: root.scene-3d;

                // 拖动累加朝向:按下记起点,拖动时把像素增量乘灵敏度加到 yaw/pitch。
                drag := TouchArea {
                    property <length> last-x;
                    property <length> last-y;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            drag.last-x = drag.mouse-x;
                            drag.last-y = drag.mouse-y;
                        }
                    }
                    moved => {
                        root.rot-yaw += (drag.mouse-x - drag.last-x) / 1px * 0.01;
                        root.rot-pitch += (drag.mouse-y - drag.last-y) / 1px * 0.01;
                        drag.last-x = drag.mouse-x;
                        drag.last-y = drag.mouse-y;
                    }
                }
            }

            // 3D 热调面板:顶栏叠在画面上,边调边看。场景切换用一个循环按钮(两个场景),
            // 四个参数用原生 LineEdit。始终随 3D 页显示(不等首帧),故独立于上面的 Image 块。
            if root.current-tab == 2: Rectangle {
                y: 0;
                height: 64px;
                background: #0b0d13cc;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 12px;
                    alignment: start;

                    HoverButton {
                        text: root.scene-index == 0 ? "形状画廊" : "实体阵列";
                        clicked => { root.scene-index = 1 - root.scene-index; }
                    }
                    ParamField { label: "实体数"; text <=> root.count-text; }
                    ParamField { label: "基础色"; text <=> root.color-text; }
                    ParamField { label: "自转速度"; text <=> root.speed-text; }
                    ParamField { label: "间距"; text <=> root.spacing-text; }
                }
            }

            // fps 浮层:content 的最后一个子元素 → 画在最上层,覆盖 3D 铺满的 Image。
            // 左上角,所有页可见。诚实即时帧率(见 lib.rs 的 fps 模块)。
            if root.show-fps: Text {
                x: 8px;
                y: 8px;
                text: "FPS " + round(root.fps);
                color: #51cf66;
                font-size: 14px;
                font-weight: 700;
            }
        }
    }
}
