// 控制条:全应用唯一的一根,主条 + 向上展开的抽屉(docs/adr/0029)。
//
// **只有一种形态。** 这是本文件最要紧的一条:此前 `mini` / `immersive` /
// `tight` / `compact` 四个开关交叉出六种几何 —— 圆环五档直径、条高六档、
// 三处水平内缩各不相同、迷你形态还少了上一曲与时间。共用一份源码不等于
// 长得一样,用户点名的「不统一」正是那个。所以下面所有尺寸都是常量:
// 改一个数,全应用一起变。
//
// `immersive` 只用来分辨「这是覆层里那份」——它决定尺寸回写给哪一槽、
// 抽屉里有没有视觉预设那一行,**不参与任何几何**。
//
// 宽度只由调用点的 width-cap 给。窄了让位的是曲名那一列,不是按键
// (钉 #68 那次挤爆回归)。
//
// 三面轮换随棱柱一起退场(#83 not planned):它是给棱柱当面的,棱柱撤回后
// 只剩代价 —— 每面内容不一样多、宽度就不一样,翻一次面条变一次长。

import { Theme, Type, Elevation, Radius, Motion, Space, TextSize, Layout, Weight } from "theme.slint";
import { IconButton } from "widgets.slint";
import { Icon, Icons } from "icons.slint";
import { PlayLens } from "controls.slint";
import { ProgressBar } from "progress.slint";
import { Drawer, DrawerMetrics } from "drawer.slint";
import { Player } from "globals/player.slint";
import { Shell } from "globals/shell.slint";
import { Library } from "globals/library.slint";
import { Viz } from "globals/viz.slint";

// 控制条占掉页面底部多少 —— 给**页面**用,不给条自己用。
//
// 条长在一个 `if` 里,而条件子元素在 slint 里既引用不到、也不给父元素贡献
// preferred 尺寸(与 DrawerMetrics 同一个理由,ADR 0028 栽过一次)。页面要
// 在底部留出这么多,否则最后一行内容就压在条底下 —— 看得见、点不着,而
// Flickable 也滚不出来:能滚的余量少于条身高度时,那一段永远够不到(#108 AC-8)。
export global BarMetrics {
    // 条身高度(Layout.bar-h / bar-h-compact)。**唯一的一份** —— PlayerBar 自己的
    // `bar-h` 也读这里,免得页面按一个数留空、条按另一个数画。
    out property <length> bar-h: Shell.compact ? Layout.bar-h-compact : Layout.bar-h;
    // 条底到面板底的间隙,与 app.slint 摆条那一行是同一个数。
    out property <length> bottom-gap: Shell.compact ? 8px : 20px;
    // 页面底部该留的空:条身 + 上下两头的空气。
    out property <length> page-reserve: self.bar-h + self.bottom-gap * 2;
}

export component PlayerBar inherits Rectangle {
    // 覆层里那份。只影响:回写哪一槽、配色走不走沉浸色。不碰几何。
    in property <bool> immersive: false;
    // 可用宽度的上限,由调用点按容器给。
    in property <length> width-cap: 100000px;

    // 抽屉开着没有。私有于界面:Rust 不关心用户把抽屉拉没拉开。
    property <bool> drawer-open: false;

    // ── 唯一的一套尺寸(docs/design.md「播放条」)──
    property <length> bar-h: BarMetrics.bar-h;
    property <length> cover-size: Shell.compact ? 46px : 48px;
    property <length> lens-size: Shell.compact ? 46px : 52px;
    property <length> key-size: Shell.compact ? 34px : 36px;
    property <length> pad-left: Shell.compact ? 8px : 12px;
    property <length> pad-right: Shell.compact ? 8px : 14px;
    property <length> gap: Shell.compact ? 10px : 14px;
    property <length> drawer-gap: 10px;
    // 时间读数让位:紧凑版式不摆,窄到放不下也不摆。曲名永远优先。
    property <bool> show-time: !Shell.compact;

    width: min(Layout.bar-w, root.width-cap);
    // 抽屉在 `if` 里,引用不到它的 height,所以高度从同一个 global 取 ——
    // 不是在这里抄一遍行高(ADR 0028 那次就是抄出来的债)。
    property <length> drawer-h: DrawerMetrics.total-h;
    height: root.drawer-open
        ? root.drawer-h + root.drawer-gap + root.bar-h
        : root.bar-h;

    // 抽屉开着时,一层压暗的幕布盖住整个窗口;点条外任意处收起。
    //
    // **必须声明在最前面。** slint 里后声明即在上层,命中测试也从上往下走;
    // 这块盖住整根条的 TouchArea 一旦排在后面,随机、循环、音量乃至主条上的
    // 上下曲全都点不动 —— 每一次点击都被它吃成「收起抽屉」。
    // 无障碍动作那条路不过命中测试,所以这个 bug 能骗过一整组按标签点的测试
    // (真按一下的探针见 tests/player_bar.rs 的 click_at)。
    if root.drawer-open: Rectangle {
        x: -4000px;
        y: -4000px;
        width: 8000px;
        height: 8000px;
        background: Theme.scrim;
        TouchArea {
            clicked => { root.drawer-open = false; }
        }
    }

    // ── 抽屉:摆在主条**上方**,所以条身长高时向上长,底边不动 ──
    if root.drawer-open: drawer := Drawer {
        x: 0;
        y: 0;
        width: 100%;
        height: root.drawer-h;
        shuffle-on: Player.shuffle-on;
        loop-mode: Player.loop-mode;
        volume: Player.volume;
        devices: Shell.devices;
        output-current: Shell.output-id;
        can-download: Player.now-id != "";
        download-state: Shell.download-text;
        liked: Player.now-liked;
        // 三态赞踩(#157),挨着喜欢:红心管收藏,这两块管评价。
        feedback: Player.now-feedback;
        feedback-toggled(v) => {
            if (v < 0) { root.drawer-open = false; Library.open-dislike(Player.now-id); }
            else { Library.toggle-feedback(v); }
        }
        like-toggled => { Library.toggle-liked(Player.now-id, !Player.now-liked); }
        download-clicked => { Library.download-track(Player.now-id); }
        radio-clicked => {
            root.drawer-open = false;
            Player.radio-from(Player.now-id);
        }
        shuffle-toggled => { Player.shuffle-toggled(); }
        loop-cycled => { Player.loop-cycled(); }
        loop-set(mode) => { Player.loop-mode-set(mode); }
        volume-changed(v) => { Player.volume-changed(v); }
        set-output(id) => { Shell.set-output(id); }
    }

    capsule := Rectangle {
        x: 0;
        y: parent.height - root.bar-h;
        width: 100%;
        height: root.bar-h;
        border-radius: self.height / 2;
        background: root.immersive ? Theme.immersive-raised : Theme.raised;
        border-width: Theme.dark || root.immersive ? 0px : 1px;
        border-color: Theme.line;
        inner-shadow-offset-y: Theme.dark || root.immersive ? 1px : 0px;
        inner-shadow-color: root.immersive ? #ffffff14 : Theme.edge;
        drop-shadow-offset-y: Elevation.float-y;
        drop-shadow-blur: Elevation.float-blur;
        drop-shadow-spread: Elevation.float-spread;
        drop-shadow-color: Elevation.float-color;

        // 尺寸回写给 GPU 背景通道。覆层那份走另一槽 —— 两条可能同时在场,
        // 共用一槽会互相踩掉对方的尺寸。
        init => { root.mirror-size(); }
        changed width => { root.mirror-size(); }
        changed height => { root.mirror-size(); }

        HorizontalLayout {
            padding-left: root.pad-left;
            padding-right: root.pad-right;
            spacing: root.gap;

            // 封面兼任播放页的进出口:条外点它展开,覆层里点它收起。
            // 覆层里那份压一层暗、叠一个向下的箭头,说明「点这里收起」。
            VerticalLayout {
                alignment: center;
                cover := Rectangle {
                    width: root.cover-size;
                    height: root.cover-size;
                    border-radius: self.width / 2;
                    clip: true;

                    // 无障碍属性长在封面本身,而不是底下那层 TouchArea ——
                    // 封面就是那颗按钮,读屏与无头测试找的都该是它。
                    accessible-role: button;
                    accessible-label: root.immersive ? "收起播放页" : "展开播放页";
                    accessible-action-default => {
                        Shell.play-page-open = !root.immersive;
                    }
                    // 封面没到位时的占位:副色板 0 号渐变。
                    background: @linear-gradient(150deg, Theme.hues-bright[0], Theme.hues-deep[0]);

                    if Viz.cover-art.width > 0: Image {
                        width: 100%;
                        height: 100%;
                        image-fit: ImageFit.cover;
                        source: Viz.cover-art;
                    }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: root.immersive ? #00000073
                            : cover-touch.has-hover ? #00000040 : transparent;
                        animate background { duration: Motion.fast; easing: Motion.ease; }
                    }
                    if root.immersive || cover-touch.has-hover: Icon {
                        size: 20px;
                        source: root.immersive ? Icons.caret-down : Icons.caret-up;
                        colorize: #ffffff;
                    }

                    cover-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Shell.play-page-open = !root.immersive;
                        }
                    }
                }
            }

            // 正在放什么:曲名一行,歌手与时间一行。窄了让位的是这一列,不是按键。
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                min-width: 0px;

                title := Text {
                    text: Viz.now-title;
                    color: root.immersive ? Theme.immersive-text : Theme.text;
                    font-size: TextSize.body;
                    font-weight: Weight.semibold;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: Space.sm;
                    Text {
                        horizontal-stretch: 0;
                        min-width: 0px;
                        text: Viz.now-artists;
                        color: root.immersive ? Theme.immersive-dim : Theme.text-dim;
                        font-size: TextSize.small;
                        overflow: elide;
                    }
                    // 缓冲时这一格是唯一说明「还在动」的东西,提亮。
                    if root.show-time: clock := Text {
                        horizontal-stretch: 0;
                        text: Player.buffering ? "缓冲中…" : Player.progress-text;
                        color: Player.buffering ? Theme.accent-ink
                            : root.immersive ? Theme.immersive-faint : Theme.text-faint;
                        font-size: TextSize.small;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            HorizontalLayout {
                spacing: Shell.compact ? 0px : 6px;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        diameter: root.key-size;
                        icon-size: 22px;
                        ink: root.immersive ? Theme.immersive-text : Theme.text;
                        icon: Icons.skip-back-fill;
                        label: "上一首";
                        clicked => { Player.prev-track(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    PlayLens {
                        is-playing: Player.is-playing;
                        ratio: Player.progress-ratio;
                        cover: Viz.cover-art;
                        diameter: root.lens-size;
                        toggle => { Player.toggle-play(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        diameter: root.key-size;
                        icon-size: 22px;
                        ink: root.immersive ? Theme.immersive-text : Theme.text;
                        icon: Icons.skip-forward-fill;
                        label: "下一首";
                        clicked => { Player.next-track(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 2px;
                // 喜欢:宽版式常驻在条上,紧凑版式进抽屉。
                if !Shell.compact: VerticalLayout {
                    alignment: center;
                    IconButton {
                        diameter: 36px;
                        icon-size: 20px;
                        icon: Player.now-liked ? Icons.heart-fill : Icons.heart;
                        ink: Player.now-liked ? Theme.accent-ink
                            : root.immersive ? Theme.immersive-dim : Theme.text-dim;
                        label: Player.now-liked ? "取消喜欢" : "喜欢";
                        enabled: Player.now-id != "";
                        clicked => { Library.toggle-liked(Player.now-id, !Player.now-liked); }
                    }
                }
                // 抽屉键:随机、循环、音量、输出设备都在里面。
                VerticalLayout {
                    alignment: center;
                    more := IconButton {
                        diameter: 36px;
                        icon-size: 20px;
                        icon: root.drawer-open ? Icons.caret-down : Icons.caret-up;
                        ink: root.immersive ? Theme.immersive-text : Theme.text-dim;
                        label: root.drawer-open ? "收起更多" : "更多";
                        checkable: true;
                        checked: root.drawer-open;
                        clicked => { root.drawer-open = !root.drawer-open; }
                    }
                }
            }
        }

        // 精确拖动的细轨:贴着条身下缘,从曲名那一列起,到抽屉键前收住。
        // 环报进度,它管落点。**恒常驻**:触屏没有悬停。
        track := ProgressBar {
            slim: true;
            pinned: true;
            x: root.pad-left + root.cover-size + 16px;
            width: parent.width - self.x - (Shell.compact ? 28px : 36px);
            y: parent.height - self.height + (Shell.compact ? 2px : 1px);
            ratio: Player.progress-ratio;
            seek(at) => { Player.seek(at); }
        }
    }

    function mirror-size() {
        if (root.immersive) {
            Shell.viz-bar-w = capsule.width;
            Shell.viz-bar-h = capsule.height;
        } else {
            Shell.bar-w = capsule.width;
            Shell.bar-h = capsule.height;
        }
    }
}
