// 控制条:全应用唯一的一根,主条 + 向上展开的抽屉(docs/adr/0029)。
//
// **只有一种形态。** 这是本文件最要紧的一条:此前 `mini` / `immersive` /
// `tight` / `compact` 四个开关交叉出六种几何 —— 圆环五档直径、条高六档、
// 三处水平内缩各不相同、迷你形态还少了上一曲与时间。共用一份源码不等于
// 长得一样,用户点名的「不统一」正是那个。所以下面所有尺寸都是常量:
// 改一个数,全应用一起变。
//
// `immersive` 只用来分辨「这是覆层里那份」——它决定尺寸回写给哪一槽、
// 抽屉里有没有视觉预设那一行,**不参与任何几何**。
//
// 宽度只由调用点的 width-cap 给。窄了让位的是曲名那一列,不是按键
// (钉 #68 那次挤爆回归)。
//
// 三面轮换随棱柱一起退场(#83 not planned):它是给棱柱当面的,棱柱撤回后
// 只剩代价 —— 每面内容不一样多、宽度就不一样,翻一次面条变一次长。

import { Theme, Type } from "theme.slint";
import { RoundControl } from "widgets.slint";
import { RingControl } from "controls.slint";
import { ProgressBar } from "progress.slint";
import { Drawer, DrawerMetrics } from "drawer.slint";
import { Player } from "globals/player.slint";
import { Shell } from "globals/shell.slint";
import { Viz } from "globals/viz.slint";

export component PlayerBar inherits Rectangle {
    // 覆层里那份。只影响:回写哪一槽、抽屉里有没有视觉预设。不碰几何。
    in property <bool> immersive: false;
    // 可用宽度的上限,由调用点按容器给。
    in property <length> width-cap: 100000px;

    // 抽屉开着没有。私有于界面:Rust 不关心用户把抽屉拉没拉开。
    property <bool> drawer-open: false;

    // ── 唯一的一套尺寸 ──
    property <length> bar-h: 62px;
    property <length> cover-size: 44px;
    property <length> key-size: 40px;
    property <length> ring-size: 48px;
    property <length> ring-inner: 40px;
    // 间距随可用宽度收 —— **控件尺寸不变**。手机上 360px 减去内缩只剩 336px,
    // 而封面 44 + 三键 120 + 环 48 已经吃掉 212;间距按宽版的 10px 排,
    // 文字区只剩 20px(实拍确认,一个字都放不下)。收的是空白,不是键:
    // 键一小,同一根条在不同页上就又长得不一样了,那正是这次要消灭的东西。
    property <length> pad-x: Shell.compact ? 8px : 10px;
    property <length> gap: Shell.compact ? 6px : 10px;
    // 固定开销:内边距 + 封面 + 三颗键 + 抽屉键 + 各段间距。
    // 曲名那一列拿走剩下的,窄到放不下就省略号收尾。
    property <length> fixed-w: root.pad-x * 2 + root.cover-size
        + root.key-size * 3 + root.ring-size + root.gap * 6;
    property <length> drawer-gap: 8px;
    // 文字区的让位顺序:**曲名 > 时间 > 歌手**。
    // 窄到只放得下一样时留曲名 —— 「在放哪首」比「第几秒」要紧,而位置
    // 本来就有下缘那道进度轨在报。放不下就整格收起,不留一个被切成「…」的读数。
    property <length> time-w: 78px;
    property <length> min-title-w: 96px;
    property <bool> show-time: root.width
        >= root.fixed-w + root.min-title-w + root.time-w + root.gap;

    width: min(root.fixed-w + 320px, root.width-cap);
    // 抽屉在 `if` 里,引用不到它的 height,所以高度从同一个 global 函数取 ——
    // 不是在这里抄一遍行高(ADR 0028 那次就是抄出来的债)。
    property <length> drawer-h: DrawerMetrics.height-for(root.immersive);
    height: root.drawer-open
        ? root.drawer-h + root.drawer-gap + root.bar-h
        : root.bar-h;

    // ── 抽屉:摆在主条**上方**,所以条身长高时向上长,底边不动 ──
    if root.drawer-open: drawer := Drawer {
        x: 0;
        y: 0;
        width: 100%;
        height: root.drawer-h;
        shuffle-on: Player.shuffle-on;
        loop-mode: Player.loop-mode;
        volume: Player.volume;
        devices: Shell.devices;
        show-preset: root.immersive;
        preset-icon: root.preset-icon;
        shuffle-toggled => { Player.shuffle-toggled(); }
        loop-cycled => { Player.loop-cycled(); }
        volume-changed(v) => { Player.volume-changed(v); }
        push-to(id) => { Shell.push-to(id); }
        preset-clicked => { Viz.viz-preset-list-open = !Viz.viz-preset-list-open; }
    }

    capsule := Rectangle {
        x: 0;
        y: parent.height - root.bar-h;
        width: 100%;
        height: root.bar-h;
        border-radius: self.height / 2;
        background: Theme.surface.with-alpha(0.9);
        border-width: 1px;
        border-color: Theme.glass-edge;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 14px;
        drop-shadow-color: Theme.glass-shadow;

        // 尺寸回写给 GPU 背景通道。覆层那份走另一槽 —— 两条可能同时在场,
        // 共用一槽会互相踩掉对方的尺寸。
        init => { root.mirror-size(); }
        changed width => { root.mirror-size(); }
        changed height => { root.mirror-size(); }

        if root.backdrop.width > 0: Image {
            width: 100%;
            height: 100%;
            source: root.backdrop;
        }

        HorizontalLayout {
            padding-left: root.pad-x;
            padding-right: root.pad-x;
            spacing: root.gap;

            // 封面兼任播放页的进出口:条外点它展开,覆层里点它收起。
            // 一个入口管两个方向,专用的 ▲/▼ 键因此退场 —— 手机上那一颗
            // 值 40px,全给了曲名。
            VerticalLayout {
                alignment: center;
                cover := Rectangle {
                    width: root.cover-size;
                    height: root.cover-size;
                    border-radius: 11px;
                    clip: true;

                    // 无障碍属性长在封面本身,而不是底下那层 TouchArea ——
                    // 封面就是那颗按钮,读屏与无头测试找的都该是它。
                    accessible-role: button;
                    accessible-label: root.immersive ? "收起播放页" : "展开播放页";
                    accessible-action-default => {
                        Shell.play-page-open = !root.immersive;
                    }
                    // 封面没到位时的占位:副色板 0 号渐变。
                    background: @linear-gradient(150deg, Theme.hues-bright[0], Theme.hues-deep[0]);

                    if Viz.cover-art.width > 0: Image {
                        width: 100%;
                        height: 100%;
                        image-fit: ImageFit.cover;
                        source: Viz.cover-art;
                    }
                    // 指过来时压一层,让「它是可以点的」看得出来。
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: cover-touch.has-hover
                            ? Theme.accent.with-alpha(0.22) : transparent;
                        animate background { duration: 120ms; easing: ease-out; }
                    }

                    cover-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Shell.play-page-open = !root.immersive;
                        }
                    }
                }
            }

            // 正在放什么。这一列是唯一会让位的东西,让位顺序见上面的 show-time:
            // 曲名 > 时间 > 歌手。此前时间跟歌手串成一行,末尾先被吃掉,
            // 手机上永远看不见读数;而给时间一个不让位的槽又会把曲名压成
            // 一个「…」——两次实拍才试出这个顺序。
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: 8px;
                    title := Text {
                        horizontal-stretch: 1;
                        text: Viz.now-title;
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    // 缓冲时这一格是唯一说明「还在动」的东西,提亮。
                    // 两种文案都走等宽:读数逐秒跳,变宽字体会让整行左右抖。
                    if root.show-time: clock := Text {
                        horizontal-stretch: 0;
                        min-width: root.time-w;
                        font-family: Type.mono;
                        text: Player.buffering ? "缓冲中…" : Player.progress-text;
                        color: Player.buffering ? Theme.accent : Theme.text-dim;
                        font-size: 12px;
                        vertical-alignment: bottom;
                    }
                }
                Text {
                    text: Viz.now-artists;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;
                RoundControl {
                    diameter: root.key-size;
                    icon: root.prev-icon;
                    label: "上一首";
                    clicked => { Player.prev-track(); }
                }
            }
            VerticalLayout {
                alignment: center;
                RingControl {
                    is-playing: Player.is-playing;
                    ratio: Player.progress-ratio;
                    diameter: root.ring-size;
                    inner-diameter: root.ring-inner;
                    // 环里那圈随音乐翻涌的画面。#87 把它改成常驻之前,
                    // 只有播放页开着时才有图,别处空图退回纯色内圈。
                    pulse: Viz.viz-bg;
                    toggle => { Player.toggle-play(); }
                }
            }
            VerticalLayout {
                alignment: center;
                RoundControl {
                    diameter: root.key-size;
                    icon: root.next-icon;
                    label: "下一首";
                    clicked => { Player.next-track(); }
                }
            }
            // 抽屉键:随机、循环、音量、同播都在里面。
            VerticalLayout {
                alignment: center;
                RoundControl {
                    diameter: root.key-size;
                    icon: root.more-icon;
                    label: root.drawer-open ? "收起更多" : "更多";
                    checkable: true;
                    checked: root.drawer-open;
                    backdrop: root.immersive ? Shell.viz-glass-bg : root.no-image;
                    clicked => { root.drawer-open = !root.drawer-open; }
                }
            }
        }

        // 精确拖动的细轨:贴着条身下缘。环报进度,它管落点。
        // **恒常驻**:此前只在紧凑版式钉住,而桌面上要指过来才现形 ——
        // 同一根条两种行为,正是这次要消灭的东西。
        track := ProgressBar {
            slim: true;
            pinned: true;
            x: 28px;
            width: parent.width - 56px;
            y: parent.height - self.height - 1px;
            ratio: Player.progress-ratio;
            seek(at) => { Player.seek(at); }
        }
    }

    // 抽屉开着时,点条外任意处收起。垫在最底下、只在开着时存在,
    // 不挡任何常态操作。
    if root.drawer-open: TouchArea {
        x: -4000px;
        y: -4000px;
        width: 8000px;
        height: 8000px;
        clicked => { root.drawer-open = false; }
    }

    // 覆层那份读另一槽,两条同时在场时各渲各的底。
    property <image> backdrop: root.immersive
        ? Shell.viz-bar-bg
        : Shell.bar-fluid-bg;
    // 空图常量:某些位置要显式地「没有图」,而 slint 没有 image 字面量。
    property <image> no-image;

    property <string> prev-icon: "M7 5 L7 19 M9 5 L9 19 M19 5 L11 12 L19 19 Z";
    property <string> next-icon: "M5 5 L13 12 L5 19 Z M15 5 L15 19 M17 5 L17 19";
    // ⋯:三个点,「还有更多」最不容易认错的画法。
    property <string> more-icon: "M6 10 A2 2 0 1 1 6 14 A2 2 0 1 1 6 10 Z M12 10 A2 2 0 1 1 12 14 A2 2 0 1 1 12 10 Z M18 10 A2 2 0 1 1 18 14 A2 2 0 1 1 18 10 Z";
    property <string> preset-icon: "M12 4 A8 8 0 1 1 4 12 L7 12 L3 17 L-1 12 L2 12 A10 10 0 1 0 12 2 Z";

    function mirror-size() {
        if (root.immersive) {
            Shell.viz-bar-w = capsule.width;
            Shell.viz-bar-h = capsule.height;
        } else {
            Shell.bar-w = capsule.width;
            Shell.bar-h = capsule.height;
        }
    }
}
