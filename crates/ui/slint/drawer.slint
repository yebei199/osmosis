// 控制条的抽屉:向上展开的一张卡(docs/adr/0029,docs/design.md「抽屉」)。
//
// 上面一排六块动作磁贴(喜欢、点赞、特别喜欢、不喜欢、下载、从这首开电台),下面四行设置:
// 随机(开关)、循环(三段)、音量(滑块)、输出(设备 chips)。
// **状态由填充底色表达,不由图标明暗表达** —— 开着的磁贴是强调色的淡底加一圈线,
// 开关与分段各有各的填充;三态直接写字,不让人辨认图标里那个小小的 1。

import { Theme, Type, Radius, Motion, Space, TextSize, Elevation, Weight } from "theme.slint";
import { DeviceRow } from "types.slint";
import { OutputStrip } from "controls.slint";
import { VolumeControl } from "progress.slint";
import { Icon, Icons } from "icons.slint";
import { Switch, Segmented, Segment } from "widgets.slint";
import { Shell } from "globals/shell.slint";

// 抽屉的行度量。抽出成 global 是因为**条身要在抽屉实例化之前就知道它有多高**:
// 抽屉长在一个 `if` 里,而条件子元素在 slint 里既引用不到、也不给父元素贡献
// preferred 尺寸(ADR 0028 已经为这条栽过一次)。让两边读同一个数,
// 好过在条身里再抄一遍行高。
export global DrawerMetrics {
    // 内边距:宽版式 20,紧凑版式 16。
    out property <length> pad: Shell.compact ? 16px : 20px;
    // 动作磁贴的高。
    out property <length> tile-h: Shell.compact ? 68px : 72px;
    // 磁贴与设置行之间。
    out property <length> gap: 8px;
    // 设置行的高(随机、循环、音量、输出)。
    out property <length> row-h: 52px;

    // 一排磁贴 + 四行。**到处都是这个数** —— 抽屉在播放页里与在别处一样高、
    // 一样几行,否则「展开」在两处就不是同一件事了。
    out property <length> total-h: self.pad * 2 + self.tile-h + self.gap + self.row-h * 4;
}

// 抽屉里一个可点的东西:磁贴(`tile`)或一整行的标签区。整块可点;
// 读屏念的那句含状态 —— 三态开关光靠 checked 说不清自己是哪一态。
export component DrawerRow inherits Rectangle {
    in property <image> icon;
    // 磁贴下面那行字 / 行左边的名字。
    in property <string> title;
    // 行名字右边那句说明(「关着:按列表顺序放」)。磁贴不画它。
    in property <string> state;
    in property <string> label;
    in property <bool> checked: false;
    // 这一块是开关还是动作。动作那种没有"开着没有"可言 —— 读屏把它念成
    // 一个复选框的话,用户会以为按下去会留在按下的状态。
    in property <bool> checkable: true;
    in property <bool> tile: false;
    in property <bool> enabled: true;

    callback clicked();

    border-radius: root.tile ? Radius.md : 0px;
    background: root.tile
        ? (root.checked ? Theme.accent-wash : touch.has-hover ? Theme.press : Theme.hover)
        : transparent;
    border-width: root.tile && root.checked ? 1px : 0px;
    border-color: Theme.accent-line;
    opacity: root.enabled ? 1.0 : 0.4;
    animate background { duration: Motion.fast; easing: Motion.ease; }

    if root.tile: VerticalLayout {
        alignment: center;
        spacing: 7px;
        HorizontalLayout {
            alignment: center;
            Icon {
                size: 22px;
                source: root.icon;
                colorize: root.checked ? Theme.accent-ink : Theme.text;
                transform-scale: touch.pressed ? 0.88 : 1.0;
                animate transform-scale { duration: Motion.press; easing: Motion.press-ease; }
            }
        }
        Text {
            text: root.title;
            color: root.checked ? Theme.accent-ink : Theme.text-dim;
            font-size: Shell.compact ? TextSize.micro : TextSize.caption;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    if !root.tile: HorizontalLayout {
        padding-left: Space.xs;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Text {
                width: 64px;
                text: root.title;
                color: Theme.text;
                font-size: TextSize.body;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            state-text := Text {
                text: root.state;
                color: Theme.text-faint;
                font-size: TextSize.small;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }

        accessible-role: button;
        accessible-label: root.label;
        accessible-checkable: root.checkable;
        accessible-checked: root.checked;
        accessible-action-default => { if (root.enabled) { root.clicked(); } }
    }
}

// 设置行之间的那道细线。
component RowLine inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

// 抽屉本体。
export component Drawer inherits Rectangle {
    in property <bool> shuffle-on;
    // 0 关 / 1 列表 / 2 单曲。int 镜像的理由同 Player 那边:
    // builtin 枚举不生成 Rust 访问器。
    in property <int> loop-mode;
    in property <float> volume;
    in property <[DeviceRow]> devices;
    // 当前输出设备的 id,空串 = 本机(docs/adr/0030)。
    in property <string> output-current;

    // 手上有没有一首歌可下。没有时那几块灰着 —— 摆一个按了没反应的键,
    // 比不摆更让人以为功能坏了。
    in property <bool> can-download;
    // 下载那块的状态:空串 / 「下载中 42%」/ 「已保存」。有字时替掉「下载」二字。
    in property <string> download-state;
    // 正在放的这首红心没有。
    in property <bool> liked;
    // 正在放的这首赞踩(#157):2 特别喜欢、1 赞、-1 踩、0 没表态(ADR 0042)。
    // 独立于红心 —— 红心管收藏,这几块管评价(喜爱度的锚),挨着喜欢摆。
    in property <int> feedback: 0;

    callback like-toggled();
    // 参数是 2(特别喜欢)、1(赞)或 -1(踩)。再点已生效的那一档时界面传的还是
    // 同一个值,Rust 据此判断该设还是该取消;点另一档就换成那一档
    // (与 `ui/src/library/feedback.rs` 同一套)。
    callback feedback-toggled(int);

    callback download-clicked();
    callback radio-clicked();
    callback shuffle-toggled();
    callback loop-cycled();
    // 循环直接拨到某一态(分段那三格)。
    callback loop-set(int);
    callback volume-changed(float);
    callback set-output(string);

    border-radius: Shell.compact ? 24px : Radius.xl;
    background: Theme.raised;
    border-width: Theme.dark ? 0px : 1px;
    border-color: Theme.line;
    inner-shadow-offset-y: Theme.dark ? 1px : 0px;
    inner-shadow-color: Theme.edge;
    drop-shadow-offset-y: Elevation.overlay-y;
    drop-shadow-blur: Elevation.overlay-blur;
    drop-shadow-spread: Elevation.overlay-spread;
    drop-shadow-color: Elevation.overlay-color;

    height: DrawerMetrics.total-h;

    // 吞掉卡上的空白点击,免得落到条外那层「点外面收起」上。
    TouchArea { }

    VerticalLayout {
        padding: DrawerMetrics.pad;
        spacing: 0px;

        HorizontalLayout {
            height: DrawerMetrics.tile-h;
            spacing: Shell.compact ? 6px : Space.sm;

            // 喜欢:正在放的这一首进不进红心。曲目行的红心是同一件事的另一个入口,
            // 两处读同一个集合,点哪边另一边都跟着变(ui/src/library/liked.rs)。
            DrawerRow {
                tile: true;
                horizontal-stretch: 1;
                icon: root.liked ? Icons.heart-fill : Icons.heart;
                title: root.liked ? "已喜欢" : "喜欢";
                label: "喜欢这一首";
                checked: root.liked;
                enabled: root.can-download;
                clicked => { root.like-toggled(); }
            }
            // 三态赞踩(#157)。元素 id 保留 `feedback-up`/`feedback-down`(#157 F-004),
            // e2e 脚本按这两个 id 找。
            feedback-up := DrawerRow {
                tile: true;
                horizontal-stretch: 1;
                icon: root.feedback == 1 ? Icons.thumbs-up-fill : Icons.thumbs-up;
                title: root.feedback == 1 ? "已点赞" : "点赞";
                label: root.feedback == 1 ? "取消点赞" : "点赞";
                checked: root.feedback == 1;
                enabled: root.can-download;
                clicked => { root.feedback-toggled(1); }
            }
            // 特别喜欢(ADR 0042):赞的上一档,同一套点法 —— 再点取消,点赞就降回赞。
            // 一排六块,手机上一块约 47px,四个字(11px)刚好放得下。
            feedback-love := DrawerRow {
                tile: true;
                horizontal-stretch: 1;
                icon: root.feedback == 2 ? Icons.star-fill : Icons.star;
                title: "特别喜欢";
                label: root.feedback == 2 ? "取消特别喜欢" : "特别喜欢";
                checked: root.feedback == 2;
                enabled: root.can-download;
                clicked => { root.feedback-toggled(2); }
            }
            feedback-down := DrawerRow {
                tile: true;
                horizontal-stretch: 1;
                icon: Icons.thumbs-down;
                title: "不喜欢";
                label: "不喜欢";
                checked: false;
                enabled: root.can-download;
                clicked => { root.feedback-toggled(-1); }
            }
            // 下载:把正在放的这一首存到本机(统一 mp3)。曲目行的「更多」菜单是同一件事
            // 的另一个入口,两处都在,播放页因此没有独占的操作。
            DrawerRow {
                tile: true;
                horizontal-stretch: 1;
                icon: Icons.download-simple;
                title: root.download-state != "" ? root.download-state : "下载";
                label: "下载这一首";
                checkable: false;
                enabled: root.can-download;
                clicked => { root.download-clicked(); }
            }
            // 从这首开电台(#159):以正在放的这首为种子开心动模式,队列换成它推的歌。
            DrawerRow {
                tile: true;
                horizontal-stretch: 1;
                icon: Icons.radio;
                // 磁贴六等分,手机上一块放不下六个字;完整说法留给读屏。
                title: "开电台";
                label: "从这首开电台";
                checkable: false;
                enabled: root.can-download;
                clicked => { root.radio-clicked(); }
            }
        }

        Rectangle { height: DrawerMetrics.gap; }

        // 随机:整行可点,右边的开关是同一件事。
        HorizontalLayout {
            height: DrawerMetrics.row-h;
            padding-right: Space.xs;
            DrawerRow {
                horizontal-stretch: 1;
                title: "随机";
                state: root.shuffle-on ? "开着:随机顺序放" : "关着:按列表顺序放";
                label: "随机播放";
                checked: root.shuffle-on;
                clicked => { root.shuffle-toggled(); }
            }
            VerticalLayout {
                alignment: center;
                Switch {
                    on: root.shuffle-on;
                    label: "随机开关";
                    toggled => { root.shuffle-toggled(); }
                }
            }
        }
        RowLine { }

        // 循环:名字那一块点一下换到下一态,右边三格直接拨到某一态。
        HorizontalLayout {
            height: DrawerMetrics.row-h - 1px;
            padding-right: Space.xs;
            DrawerRow {
                horizontal-stretch: 1;
                title: "循环";
                state: "";
                // 三态写进标签:checked 只说得出开没开,说不出列表还是单曲。
                label: "循环: " + root.loop-name;
                checked: root.loop-mode > 0;
                clicked => { root.loop-cycled(); }
            }
            VerticalLayout {
                alignment: center;
                Segmented {
                    items: [
                        { label: "关" },
                        { label: "列表", icon: Icons.repeat },
                        { label: "单曲", icon: Icons.repeat-once },
                    ];
                    current: root.loop-mode;
                    selected(i) => { root.loop-set(i); }
                }
            }
        }
        RowLine { }

        // 音量:抽屉里有地方,滑块常驻,不必再点开一层。
        HorizontalLayout {
            height: DrawerMetrics.row-h - 1px;
            padding-left: Space.xs;
            padding-right: Space.xs;
            spacing: 14px;
            VerticalLayout {
                alignment: center;
                Text {
                    width: 64px;
                    text: "音量";
                    color: Theme.text;
                    font-size: TextSize.body;
                }
            }
            VolumeControl {
                horizontal-stretch: 1;
                expanded: true;
                fill: true;
                volume: root.volume;
                changed(v) => { root.volume-changed(v); }
            }
        }
        RowLine { }

        // 输出设备:点歌之前先选它。设备多了往左划。
        HorizontalLayout {
            height: DrawerMetrics.row-h - 1px;
            padding-left: Space.xs;
            spacing: 14px;
            VerticalLayout {
                alignment: center;
                Text {
                    width: Shell.compact ? 40px : 64px;
                    text: "输出";
                    color: Theme.text;
                    font-size: TextSize.body;
                }
            }
            Flickable {
                horizontal-stretch: 1;
                content-width: max(self.width, outputs.preferred-width);
                outputs := HorizontalLayout {
                    alignment: end;
                    VerticalLayout {
                        alignment: center;
                        OutputStrip {
                            caption: false;
                            devices: root.devices;
                            current: root.output-current;
                            set-output(id) => { root.set-output(id); }
                        }
                    }
                }
            }
        }
    }

    property <string> loop-name: root.loop-mode == 0 ? "关"
        : (root.loop-mode == 1 ? "列表" : "单曲");
}
