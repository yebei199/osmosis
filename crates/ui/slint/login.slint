// 登录页。未登录时盖住整个窗口,不占导航位。
//
// 与播放页同一个模式(见 CONTEXT.md「播放页」):它是**状态的展开形态**,
// 不是一个去处。给它一个 tab 反而要回答「没登录时点它去哪」。
//
// 注册与登录共用这一个页面,靠 `registering` 切换 —— 两者只差一个邀请码输入框,
// 各写一遍布局与错误区,改一处必然漏另一处。


import { Button, ButtonKind, Sheet, TextField } from "widgets.slint";
import { Icon, Icons } from "icons.slint";
import { Theme, Space, TextSize, Weight, Tracking } from "theme.slint";

export component LoginPage inherits Rectangle {
    // 正在等服务端答复。按钮据此变灰,免得连点发出两次注册。
    in property <bool> busy: false;
    // 背景铺满窗口，表单从安全区和状态条下方开始居中。
    in property <length> safe-top;
    // 给人看的失败说明。空串 = 没有失败,那一行整块让位。
    in property <string> error-text;

    // 注册还是登录。私有:Rust 侧不关心用户此刻在填哪个表单。
    property <bool> registering: false;
    // 邀请码的当前值。用属性接住而不是提交时去读那个输入框:
    // 输入框在 `if` 里面,不在注册模式时它压根不在树上,引不到。
    property <string> invite-value;

    callback login(string, string);
    callback register(string, string, string);

    background: Theme.window;

    Sheet {
        width: min(root.width - 32px, 380px);
        height: form.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(root.safe-top, root.safe-top + (root.height - root.safe-top - self.height) / 2);

        form := VerticalLayout {
            padding: Space.xl;
            padding-top: Space.xxl;
            spacing: Space.md;
            alignment: start;

            // 与侧栏顶上同一个品牌行:实心的强调色圆叠一只空心圆,后面是名字。
            // 没有侧栏的这一页上,它是唯一能认出「这是哪个应用」的地方。
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                accessible-role: none;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    Rectangle {
                        x: 0px;
                        y: 4px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: Theme.accent;
                    }
                    Rectangle {
                        x: 8px;
                        y: 4px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        border-width: 2px;
                        border-color: Theme.text;
                    }
                }
                Text {
                    text: "Osmosis";
                    font-size: TextSize.title;
                    font-weight: Weight.bold;
                    letter-spacing: -0.2px;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                padding-top: Space.sm;
                padding-bottom: Space.xs;
                spacing: Space.xs;
                Text {
                    text: root.registering ? "注册" : "登录";
                    color: Theme.text;
                    font-size: TextSize.display-compact;
                    font-weight: Weight.bold;
                    letter-spacing: Tracking.display-compact;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.registering
                        ? "注册需要邀请码。红心、歌单和播放组都跟着账号走"
                        : "红心、歌单和播放组都跟着账号走";
                    color: Theme.text-dim;
                    font-size: TextSize.small;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }

            username := TextField {
                placeholder: "用户名";
                // 回车直接提交:表单只有两三个框,让人去够按钮是多余的一步
                accepted => { root.submit(); }
            }

            password := TextField {
                placeholder: "密码";
                input-type: InputType.password;
                accepted => { root.submit(); }
            }

            // 邀请码只在注册时出现。服务面向公网,没有它任何人都能开户
            // (见 docs/adr/0017)。
            if root.registering: TextField {
                placeholder: "邀请码";
                text: root.invite-value;
                edited => { root.invite-value = self.text; }
                accepted => { root.submit(); }
            }

            // 失败说明。有话说才占位置 —— 常驻一个空行会把布局撑得莫名其妙。
            // 图标用 danger,字仍是正文色:红字压在深底上读不清,颜色只给那个圆标。
            if root.error-text != "": HorizontalLayout {
                spacing: Space.sm;
                VerticalLayout {
                    alignment: start;
                    padding-top: 1px;
                    Icon {
                        size: 18px;
                        source: Icons.warning-circle-fill;
                        colorize: Theme.danger;
                    }
                }
                error := Text {
                    horizontal-stretch: 1;
                    text: root.error-text;
                    color: Theme.text;
                    font-size: TextSize.small;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }

            Button {
                kind: ButtonKind.primary;
                // 字走 `text` 属性而不是塞子 Text:Button 的无障碍标签
                // 绑的是这个属性,子 Text 画得出来、读屏却念不出 —— 真机驱动
                // 曾因此只能从截图上量坐标点它。
                text: root.busy
                    ? "…"
                    : (root.registering ? "注册并登录" : "登录");
                // 等答复时不给按 —— 连点会发出两次注册,第二次注定撞用户名重复,
                // 而那句报错会盖掉第一次的成功。
                enabled: !root.busy;
                clicked => { root.submit(); }
            }

            switch-mode := TouchArea {
                height: 32px;
                mouse-cursor: pointer;

                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: root.registering ? "已有账号?" : "没有账号?";
                        color: Theme.text-dim;
                        font-size: TextSize.small;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.registering ? "去登录" : "去注册";
                        color: switch-mode.has-hover ? Theme.text : Theme.accent-ink;
                        font-size: TextSize.small;
                        font-weight: Weight.semibold;
                        vertical-alignment: center;
                    }
                }

                clicked => { root.registering = !root.registering; }
            }
        }
    }

    // 提交。哪一个回调由当前表单决定 —— 让 Rust 侧再判一次的话,
    // 两边对"现在是注册还是登录"的理解就有了两个来源。
    function submit() {
        if (root.busy) {
            return;
        }
        if (root.registering) {
            root.register(username.text, password.text, root.invite-value);
        } else {
            root.login(username.text, password.text);
        }
    }
}
